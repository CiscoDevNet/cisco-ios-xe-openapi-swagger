# Patterns lychee should ignore when scanning HTML/Markdown links.
# Format: one regex per line; comments allowed.

# Archive trees — historical artifacts kept for reference only
^.*/archive/.*$
^archive/.*$

# Per-release artifact trees — content is enumerated by deploy workflow,
# scanning their HTML pulls in tens of thousands of spec URLs
^releases/.*$
^.*/releases/.*$

# Local file:// or relative example paths
^file://

# Internal Cisco URLs that may require auth (skip rather than 401)
^https?://[^/]*\.cisco\.com/(internal|secure|auth)/
