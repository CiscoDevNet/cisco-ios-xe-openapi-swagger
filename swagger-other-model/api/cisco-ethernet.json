  "components": {
    "schemas": {
      "cisco-ethernet_ethernet": {
        "type": "object",
        "description": "ethernet",
        "properties": {
          "duplex": {
            "type": "string",
            "description": "duplex"
          },
          "min-mtu-size": {
            "type": "integer",
            "description": "min-mtu-size",
            "minimum": 0,
            "maximum": 65535
          },
          "max-mtu-size": {
            "type": "integer",
            "description": "max-mtu-size",
            "minimum": 0,
            "maximum": 65535
          },
          "supported-mtu-range": {
            "type": "object",
            "description": "supported-mtu-range",
            "properties": {
              "min-mtu-size": {
                "type": "integer",
                "description": "min-mtu-size",
                "minimum": 0,
                "maximum": 65535
              },
              "max-mtu-size": {
                "type": "integer",
                "description": "max-mtu-size",
                "minimum": 0,
                "maximum": 65535
              }
            }
          }
        }
      },
      "cisco-ethernet_supported-mtu-range": {
        "type": "object",
        "description": "Configuration/state data for supported mtu range"
      },
      "cisco-ethernet_transmission-params": {
        "type": "object",
        "description": "Configuration/state data for transmission params"
      },
      "restconf-error": {
        "type": "object",
        "description": "Standard RESTCONF error response (RFC 8040 Section 7.1)",
        "properties": {
          "ietf-restconf:errors": {
            "type": "object",
            "properties": {
              "error": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "error-type": {
                      "type": "string",
                      "enum": [
                        "transport",
                        "rpc",
                        "protocol",
                        "application"
                      ],
                      "description": "Layer where the error occurred"
                    },
                    "error-tag": {
                      "type": "string",
                      "description": "Enumerated error tag (e.g. invalid-value, data-missing, access-denied)"
                    },
                    "error-severity": {
                      "type": "string",
                      "enum": [
                        "error",
                        "warning"
                      ],
                      "description": "Error severity"
                    },
                    "error-app-tag": {
                      "type": "string",
                      "description": "Application-specific error tag"
                    },
                    "error-path": {
                      "type": "string",
                      "description": "YANG instance-identifier of the error node"
                    },
                    "error-message": {
                      "type": "string",
                      "description": "Human-readable error description"
                    }
                  },
                  "required": [
                    "error-type",
                    "error-tag"
                  ]
                }
              }
            }
          }
        },
        "example": {
          "ietf-restconf:errors": {
            "error": [
              {
                "error-type": "protocol",
                "error-tag": "invalid-value",
                "error-severity": "error",
                "error-message": "Invalid input parameter"
              }
            ]
          }
        }
      }
    },
