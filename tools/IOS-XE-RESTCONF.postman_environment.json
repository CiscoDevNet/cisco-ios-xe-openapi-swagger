{
  "id": "ios-xe-restconf-env",
  "name": "IOS-XE RESTCONF Environment",
  "values": [
    {
      "key": "device",
      "value": "10.1.1.1",
      "type": "default",
      "enabled": true,
      "description": "Device IP address or hostname (e.g. 10.1.1.1 or switch1.lab.local)"
    },
    {
      "key": "port",
      "value": "443",
      "type": "default",
      "enabled": true,
      "description": "RESTCONF HTTPS port (default: 443)"
    },
    {
      "key": "username",
      "value": "admin",
      "type": "default",
      "enabled": true,
      "description": "Device username with privilege 15"
    },
    {
      "key": "password",
      "value": "YOUR_PASSWORD",
      "type": "secret",
      "enabled": true,
      "description": "Device password"
    },
    {
      "key": "baseUrl",
      "value": "https://{{device}}:{{port}}/restconf",
      "type": "default",
      "enabled": true,
      "description": "RESTCONF base URL (auto-composed from device + port)"
    },
    {
      "key": "contentType",
      "value": "application/yang-data+json",
      "type": "default",
      "enabled": true,
      "description": "RESTCONF Content-Type header for JSON payloads"
    },
    {
      "key": "accept",
      "value": "application/yang-data+json",
      "type": "default",
      "enabled": true,
      "description": "RESTCONF Accept header for JSON responses"
    }
  ],
  "_postman_variable_scope": "environment"
}
