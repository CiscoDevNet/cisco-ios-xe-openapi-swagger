{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE Native Config - Platform & System",
    "description": "Platform and system-level configuration from Cisco-IOS-XE-native model.\n\n**Includes:** boot, memory, location, banner, clock, default, hardware, stack-power, upgrade, setup, exception, card, hw-module, module, software, system, power\n\n**Modules covered:** Cisco-IOS-XE-power (Power over Ethernet / power supply)\n\n**Key Features:**\n- Boot configuration\n- System banners\n- Memory settings\n- Hardware modules\n- Software upgrade\n- Platform settings\n- PoE power management\n\n**Base Path:** `/data/Cisco-IOS-XE-native:native/`\n\n**Related:** See 'License' for software licensing",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/iosxe/"
    }
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        },
        "port": {
          "default": "443",
          "description": "HTTPS port"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-native:native/boot": {
      "get": {
        "summary": "Get boot configuration",
        "operationId": "get-boot",
        "tags": [
          "platform"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "Cisco-IOS-XE-native:boot": {
                    "system": {
                      "flash": "bootflash:cat9k-universalk9.17.18.01.SPA.bin"
                    }
                  }
                }
              }
            }
          }
        },
        "description": "Retrieve boot configuration from the RESTCONF interface"
      },
      "put": {
        "summary": "Configure boot",
        "operationId": "put-boot",
        "tags": [
          "platform"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-native:boot": {
                  "system": {
                    "flash": "bootflash:cat9k-universalk9.17.18.01.SPA.bin"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully configured"
          }
        },
        "description": "Create or replace boot via the RESTCONF interface"
      },
      "patch": {
        "summary": "Update boot",
        "operationId": "patch-boot",
        "tags": [
          "platform"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-native:boot": {
                  "manual": [
                    null
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully updated"
          }
        },
        "description": "Partially update boot via the RESTCONF interface"
      },
      "delete": {
        "summary": "Delete boot",
        "operationId": "delete-boot",
        "tags": [
          "platform"
        ],
        "responses": {
          "204": {
            "description": "Successfully deleted"
          }
        },
        "description": "Remove boot from the device configuration via the RESTCONF interface"
      }
    },
