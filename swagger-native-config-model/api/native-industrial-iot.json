              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-coap:coap": {
                  "dtls": {
                    "port": 5684
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully configured"
          }
        }
      },
      "patch": {
        "summary": "Update CoAP proxy configuration",
        "description": "Merge update to CoAP configuration.",
        "operationId": "patch-coap",
