                "schema": {
                  "type": "object"
                },
                "example": {
                  "Cisco-IOS-XE-coap:coap": {
                    "http": {
                      "proxy": {
                        "security-list": [
                          {
                            "name": "COAP-ACL",
                            "group-name": "IOT-DEVICES"
                          }
                        ]
                      }
                    },
                    "dtls": {
                      "port": 5684,
                      "verify": {
                        "client-certificate": true
                      }
                    }
                  }
                }
              }
            }
