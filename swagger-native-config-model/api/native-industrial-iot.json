{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE Native Config - Industrial & IoT",
    "description": "Industrial Ethernet and IoT protocol configuration for Cisco-IOS-XE-native model (IE switches, IR routers).\n\n**Modules covered:** cellular (LTE/5G controllers), coap (Constrained Application Protocol), dapr (Digital Alarm Processing Relay), digitalio (Digital I/O ports), dlr (Device Level Ring), irig (Inter-Range Instrumentation Group time code), lorawan (LoRa WAN gateway), lte450 (LTE 450MHz controllers), mrp (Media Redundancy Protocol), prp (Parallel Redundancy Protocol), rawsocket (Raw Socket UDP/TCP)\n\n**YANG Augments:** Cisco-IOS-XE-cellular, Cisco-IOS-XE-coap, Cisco-IOS-XE-dapr, Cisco-IOS-XE-digitalio, Cisco-IOS-XE-dlr, Cisco-IOS-XE-irig, Cisco-IOS-XE-lorawan, Cisco-IOS-XE-lte450, Cisco-IOS-XE-mrp, Cisco-IOS-XE-prp, Cisco-IOS-XE-rawsocket",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/docs/ios-xe/"
    }
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        },
        "port": {
          "default": "443",
          "description": "HTTPS port"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-native:native/controller/Cisco-IOS-XE-cellular:Cellular": {
      "get": {
        "summary": "Get Cellular controller configuration",
        "description": "Retrieve LTE/5G cellular controller configuration for IR routers.\n\nCLI equivalent: `show running-config | section controller Cellular`\n\nYANG module: Cisco-IOS-XE-cellular",
        "operationId": "get-cellular",
        "tags": [
          "cellular"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "Cisco-IOS-XE-cellular:Cellular": [
                    {
                      "id": "0/2/0",
                      "lte": {
                        "sim": {
                          "data-profile-list": [
                            {
                              "slot": 0,
                              "data-profile": 1,
                              "attach-profile": 1
                            }
                          ]
                        },
                        "modem": {
                          "link-recovery": {
                            "rssi": -110,
                            "monitor-timer": 60
                          }
                        },
                        "sms": {
                          "archive": {
                            "path": "flash:"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace Cellular controller configuration",
        "description": "Replace cellular controller configuration.",
        "operationId": "put-cellular",
        "tags": [
          "cellular"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-cellular:Cellular": [
                  {
                    "id": "0/2/0",
                    "lte": {
                      "sim": {
                        "data-profile-list": [
                          {
                            "slot": 0,
                            "data-profile": 1,
                            "attach-profile": 1
                          }
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully configured"
          }
        }
      },
      "patch": {
        "summary": "Update Cellular controller configuration",
        "description": "Merge update to cellular controller configuration.",
        "operationId": "patch-cellular",
        "tags": [
          "cellular"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-cellular:Cellular": [
                  {
                    "id": "0/2/0",
                    "lte": {
                      "modem": {
                        "link-recovery": {
                          "monitor-timer": 120
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully updated"
          }
        }
      },
      "delete": {
        "summary": "Delete Cellular controller configuration",
        "description": "Remove cellular controller configuration.",
        "operationId": "delete-cellular",
        "tags": [
          "cellular"
        ],
        "responses": {
          "204": {
            "description": "Successfully deleted"
          }
        }
      }
    },
    "/data/Cisco-IOS-XE-native:native/Cisco-IOS-XE-coap:coap": {
      "get": {
        "summary": "Get CoAP proxy configuration",
        "description": "Retrieve Constrained Application Protocol (CoAP) proxy/server configuration for IoT.\n\nCLI equivalent: `show running-config | section coap`\n\nYANG module: Cisco-IOS-XE-coap",
