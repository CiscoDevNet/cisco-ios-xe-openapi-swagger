{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE Native Config - L2 Discovery & Adjacency",
    "description": "Layer 2 discovery and adjacency protocol configuration for Cisco-IOS-XE-native model.\n\n**Modules covered:** lldp (Link Layer Discovery Protocol), arp (Address Resolution Protocol), icmp (Internet Control Message Protocol), loop-detect, uplink-autoconfig\n\n**YANG Augments:** Cisco-IOS-XE-lldp, Cisco-IOS-XE-arp, Cisco-IOS-XE-icmp, Cisco-IOS-XE-switch, Cisco-IOS-XE-switch",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/iosxe/"
    }
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        },
        "port": {
          "default": "443",
          "description": "HTTPS port"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-native:native/lldp": {
      "get": {
        "summary": "Get LLDP global configuration",
        "description": "Retrieve global Link Layer Discovery Protocol (LLDP) configuration including timers, TLV selection, and system capabilities.\n\nCLI equivalent: `show running-config | section ^lldp`\n\nYANG module: Cisco-IOS-XE-lldp",
        "operationId": "get-lldp",
        "tags": [
          "lldp"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "Cisco-IOS-XE-native:lldp": {
                    "run": [
                      null
                    ],
                    "holdtime": 120,
                    "reinit": 2,
                    "timer": 30,
                    "tlv-select": {
                      "system-name": true,
                      "system-description": true,
                      "system-capabilities": true,
                      "port-description": true,
                      "management-address": true,
                      "port-vlan": true,
                      "power-management": true
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "Limit the depth of returned sub-tree data (RFC 8040 Section 4.8.2). Use 'unbounded' for full depth.",
            "schema": {
              "type": "string",
              "default": "unbounded"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Select specific fields to return (RFC 8040 Section 4.8.3). Example: fields=name;status",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "description": "Filter by config state: 'config' (config true only), 'nonconfig' (config false only), or 'all'.",
            "schema": {
              "type": "string",
              "enum": [
                "config",
                "nonconfig",
                "all"
              ],
              "default": "all"
            }
          }
        ]
      },
      "put": {
        "summary": "Replace LLDP global configuration",
        "description": "Replace all global LLDP settings.\n\nCLI equivalent: `lldp run` / `lldp holdtime 120`",
        "operationId": "put-lldp",
        "tags": [
          "lldp"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-native:lldp": {
                  "run": [
                    null
                  ],
                  "holdtime": 120,
                  "timer": 30,
                  "tlv-select": {
                    "system-name": true,
                    "port-description": true,
                    "management-address": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully configured"
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": false,
            "description": "RESTCONF request body media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          }
        ]
      },
      "patch": {
        "summary": "Update LLDP global configuration",
        "description": "Merge update to global LLDP settings.",
        "operationId": "patch-lldp",
        "tags": [
          "lldp"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-native:lldp": {
                  "holdtime": 180,
                  "timer": 60
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully updated"
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": false,
            "description": "RESTCONF request body media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          }
        ]
      },
      "delete": {
        "summary": "Delete LLDP global configuration",
        "description": "Remove global LLDP configuration (disables LLDP).\n\nCLI equivalent: `no lldp run`",
        "operationId": "delete-lldp",
        "tags": [
          "lldp"
        ],
        "responses": {
          "204": {
            "description": "Successfully deleted"
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
