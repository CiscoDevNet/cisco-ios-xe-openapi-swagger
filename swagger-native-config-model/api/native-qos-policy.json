{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE Native Config - QoS & Policy",
    "description": "Quality of Service configuration from Cisco-IOS-XE-native model.\n\n**Includes:** qos, parameter-map\n\n**Note:** The large 'policy' container (109K+ lines) is excluded from this spec for performance reasons.\n\n**Key Features:**\n- QoS global settings\n- Parameter maps\n- Traffic policies\n\n**Base Path:** `/data/Cisco-IOS-XE-native:native/`\n\n**Related:** See 'IP Configuration' for IP-based QoS features",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/iosxe/"
    }
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        },
        "port": {
          "default": "443",
          "description": "HTTPS port"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-native:native/qos": {
      "get": {
        "summary": "Get QoS configuration",
        "operationId": "get-qos",
        "tags": [
          "qos"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "Cisco-IOS-XE-native:qos": {
                    "queue-softmax-multiplier": 100
                  }
                }
              }
            }
          }
        },
        "description": "Retrieve qoS configuration from the RESTCONF interface"
      },
      "put": {
        "summary": "Configure QoS",
        "operationId": "put-qos",
        "tags": [
          "qos"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-native:qos": {
                  "queue-softmax-multiplier": 100
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully configured"
          }
        },
        "description": "Create or replace qoS via the RESTCONF interface"
      },
      "patch": {
        "summary": "Update QoS",
        "operationId": "patch-qos",
        "tags": [
          "qos"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-native:qos": {
                  "preserve": {
                    "marking": [
                      null
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully updated"
          }
        },
        "description": "Partially update qoS via the RESTCONF interface"
      },
      "delete": {
        "summary": "Delete QoS",
        "operationId": "delete-qos",
        "tags": [
          "qos"
        ],
        "responses": {
          "204": {
            "description": "Successfully deleted"
          }
        },
        "description": "Remove qoS from the device configuration via the RESTCONF interface"
      }
    },
    "/data/Cisco-IOS-XE-native:native/parameter-map": {
      "get": {
        "summary": "Get parameter maps",
        "operationId": "get-parameter-map",
        "tags": [
          "qos"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "Cisco-IOS-XE-native:parameter-map": {
                    "type": {
                      "inspect": [
                        {
                          "name": "INSPECT-MAP",
                          "sessions": {
                            "maximum": 10000
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "description": "Retrieve parameter maps from the RESTCONF interface"
      },
      "put": {
        "summary": "Configure parameter map",
        "operationId": "put-parameter-map",
        "tags": [
          "qos"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-native:parameter-map": {
                  "type": {
                    "inspect": [
                      {
                        "name": "INSPECT-MAP",
                        "sessions": {
                          "maximum": 10000
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully configured"
          }
        },
        "description": "Create or replace parameter map via the RESTCONF interface"
      },
      "patch": {
        "summary": "Update parameter map",
        "operationId": "patch-parameter-map",
        "tags": [
          "qos"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-native:parameter-map": {
                  "type": {
                    "protocol-info": [
                      {
                        "name": "PROTOCOL-MAP"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully updated"
          }
        },
        "description": "Partially update parameter map via the RESTCONF interface"
      },
      "delete": {
        "summary": "Delete parameter map",
        "operationId": "delete-parameter-map",
        "tags": [
          "qos"
        ],
        "responses": {
          "204": {
            "description": "Successfully deleted"
          }
        },
        "description": "Remove parameter map from the device configuration via the RESTCONF interface"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "qos",
      "description": "Quality of Service"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE Native YANG Configuration Guide - Cisco DevNet",
    "url": "https://developer.cisco.com/iosxe/"
  }
}
