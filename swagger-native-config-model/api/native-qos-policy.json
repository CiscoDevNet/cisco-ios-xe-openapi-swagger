{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE Native Config - QoS & Policy",
    "description": "Quality of Service configuration from Cisco-IOS-XE-native model.\n\n**Includes:** qos, parameter-map\n\n**Note:** The large 'policy' container (109K+ lines) is excluded from this spec for performance reasons.\n\n**Key Features:**\n- QoS global settings\n- Parameter maps\n- Traffic policies\n\n**Base Path:** `/data/Cisco-IOS-XE-native:native/`\n\n**Related:** See 'IP Configuration' for IP-based QoS features\n\n**YANG Model:** [Cisco IOS-XE Native Config - QoS & Policy.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Cisco IOS-XE Native Config - QoS & Policy.yang)",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/iosxe/"
    },
    "x-yang-module": "Cisco-IOS-XE-native",
    "x-model-type": "native"
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        },
        "port": {
          "default": "443",
          "description": "HTTPS port"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-native:native/qos": {
      "get": {
        "summary": "Get QoS configuration",
        "operationId": "get-qos",
        "tags": [
          "qos"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "Cisco-IOS-XE-native:qos": {
                    "queue-softmax-multiplier": 100
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden \u2014 insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "description": "Retrieve qoS configuration from the RESTCONF interface",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "Limit the depth of returned sub-tree data (RFC 8040 Section 4.8.2). Use 'unbounded' for full depth.",
            "schema": {
              "type": "string",
              "default": "unbounded"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Select specific fields to return (RFC 8040 Section 4.8.3). Example: fields=name;status",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "description": "Filter by config state: 'config' (config true only), 'nonconfig' (config false only), or 'all'.",
            "schema": {
              "type": "string",
              "enum": [
                "config",
                "nonconfig",
                "all"
              ],
              "default": "all"
            }
          }
        ]
      },
      "put": {
        "summary": "Configure QoS",
        "operationId": "put-qos",
        "tags": [
          "qos"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-native:qos": {
                  "queue-softmax-multiplier": 100
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully configured"
          },
          "403": {
            "description": "Forbidden \u2014 insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "description": "Create or replace qoS via the RESTCONF interface",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": false,
            "description": "RESTCONF request body media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          }
        ]
      },
      "patch": {
        "summary": "Update QoS",
        "operationId": "patch-qos",
        "tags": [
          "qos"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-native:qos": {
                  "preserve": {
                    "marking": [
                      null
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully updated"
          },
          "403": {
            "description": "Forbidden \u2014 insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "description": "Partially update qoS via the RESTCONF interface",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": false,
            "description": "RESTCONF request body media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          }
        ]
      },
      "delete": {
        "summary": "Delete QoS",
        "operationId": "delete-qos",
        "tags": [
          "qos"
        ],
        "responses": {
          "204": {
            "description": "Successfully deleted"
          },
          "403": {
            "description": "Forbidden \u2014 insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "description": "Remove qoS from the device configuration via the RESTCONF interface",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          }
        ]
      },
      "x-yang-path": "/native/qos",
      "x-restconf-kind": "container"
    },
    "/data/Cisco-IOS-XE-native:native/parameter-map": {
