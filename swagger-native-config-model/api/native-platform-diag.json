{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE Native Config - Platform & Diagnostics",
    "description": "Platform hardware, diagnostics, and system monitoring configuration for Cisco-IOS-XE-native model.\n\n**Modules covered:** alarm-profile, diagnostics, buffers, dying-gasp, geo (geographic location), gnss (GPS/GNSS), synce (Synchronous Ethernet), qfp-stats (QFP statistics), ida (Intelligent Digital Assistant), rmi-dad (RMI DAD), ethinternal-subslot, ucse (UCS-E blade), mmode (maintenance mode)\n\n**YANG Augments:** Cisco-IOS-XE-switch, Cisco-IOS-XE-diagnostics, Cisco-IOS-XE-platform, Cisco-IOS-XE-geo, Cisco-IOS-XE-gnss, Cisco-IOS-XE-synce, Cisco-IOS-XE-ucse, Cisco-IOS-XE-mmode",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/docs/ios-xe/"
    }
  },
  "servers": [
    {
      "url": "https://{device}:{port}",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        },
        "port": {
          "default": "443",
          "description": "HTTPS port"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-native:native/Cisco-IOS-XE-switch:alarm-profile": {
      "get": {
        "summary": "Get alarm profile configuration",
        "description": "Retrieve alarm profile configuration for environmental and hardware monitoring thresholds.\n\nCLI equivalent: `show running-config | section alarm-profile`\n\nYANG module: Cisco-IOS-XE-switch (alarm-profile augment)",
        "operationId": "get-alarm-profile",
        "tags": ["alarm-profile"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": { "type": "object" },
                "example": {
                  "Cisco-IOS-XE-switch:alarm-profile": [
                    {
                      "name": "TEMP-ALARM",
                      "temperature": {
                        "minor": 45,
                        "major": 55,
                        "critical": 65
                      }
                    },
                    {
                      "name": "VOLTAGE-ALARM",
                      "voltage": {
                        "minor-low": 11,
                        "minor-high": 13
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace alarm profile configuration",
        "description": "Replace alarm profile definitions.",
        "operationId": "put-alarm-profile",
        "tags": ["alarm-profile"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-switch:alarm-profile": [
                  {
                    "name": "DEFAULT-ALARM",
                    "temperature": { "minor": 40, "major": 50, "critical": 60 }
                  }
                ]
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully configured" } }
      },
      "patch": {
        "summary": "Update alarm profile configuration",
        "description": "Merge update to alarm profile definitions.",
        "operationId": "patch-alarm-profile",
        "tags": ["alarm-profile"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-switch:alarm-profile": [
                  {
                    "name": "TEMP-ALARM",
                    "temperature": { "critical": 70 }
                  }
                ]
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully updated" } }
      },
      "delete": {
        "summary": "Delete alarm profile configuration",
        "description": "Remove all alarm profile definitions.",
        "operationId": "delete-alarm-profile",
        "tags": ["alarm-profile"],
        "responses": { "204": { "description": "Successfully deleted" } }
      }
    },
    "/data/Cisco-IOS-XE-native:native/diagnostic": {
      "get": {
        "summary": "Get diagnostic test configuration",
        "description": "Retrieve diagnostic test scheduling and monitoring configuration.\n\nCLI equivalent: `show running-config | section diagnostic`\n\nYANG module: Cisco-IOS-XE-diagnostics",
        "operationId": "get-diagnostics",
        "tags": ["diagnostics"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": { "type": "object" },
                "example": {
                  "Cisco-IOS-XE-native:diagnostic": {
                    "bootup": {
                      "level": "minimal"
                    },
                    "monitor": {
                      "interval": [
                        {
                          "switch-number": 1,
                          "test": "all",
                          "number-of-days": 1,
                          "hh-mm-ss": "00:00:00"
                        }
                      ],
                      "threshold": [
                        {
                          "switch-number": 1,
                          "test": "all",
                          "failure-count": 5
                        }
                      ]
                    },
                    "schedule": {
                      "switch-schedule": [
                        {
                          "switch-number": 1,
                          "test": "all",
                          "daily": { "hh-mm-ss": "03:00:00" }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace diagnostic test configuration",
        "description": "Replace diagnostic test configuration.",
        "operationId": "put-diagnostics",
        "tags": ["diagnostics"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-native:diagnostic": {
                  "bootup": { "level": "complete" },
                  "schedule": {
                    "switch-schedule": [
                      {
                        "switch-number": 1,
                        "test": "all",
                        "daily": { "hh-mm-ss": "02:00:00" }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully configured" } }
      },
      "patch": {
        "summary": "Update diagnostic test configuration",
        "description": "Merge update to diagnostic test configuration.",
        "operationId": "patch-diagnostics",
        "tags": ["diagnostics"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-native:diagnostic": {
                  "bootup": { "level": "minimal" }
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully updated" } }
      },
      "delete": {
        "summary": "Delete diagnostic test configuration",
        "description": "Remove diagnostic test configuration.",
        "operationId": "delete-diagnostics",
        "tags": ["diagnostics"],
        "responses": { "204": { "description": "Successfully deleted" } }
      }
    },
    "/data/Cisco-IOS-XE-native:native/buffers": {
      "get": {
        "summary": "Get buffer tuning configuration",
        "description": "Retrieve system buffer pool tuning configuration.\n\nCLI equivalent: `show running-config | include buffers`\n\nYANG module: Cisco-IOS-XE-native (buffers augment)",
        "operationId": "get-buffers",
        "tags": ["buffers"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": { "type": "object" },
                "example": {
                  "Cisco-IOS-XE-native:buffers": {
                    "small": {
                      "permanent": 120,
                      "max-free": 150,
                      "min-free": 25
                    },
                    "middle": {
                      "permanent": 90
                    },
                    "big": {
                      "permanent": 90
                    },
                    "huge": {
                      "size": 65535
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace buffer tuning configuration",
        "description": "Replace system buffer configuration.\n\nCLI equivalent: `buffers small permanent 120`",
        "operationId": "put-buffers",
        "tags": ["buffers"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-native:buffers": {
                  "small": { "permanent": 150 },
                  "big": { "permanent": 100 }
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully configured" } }
      },
      "patch": {
        "summary": "Update buffer tuning configuration",
        "description": "Merge update to buffer configuration.",
        "operationId": "patch-buffers",
        "tags": ["buffers"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-native:buffers": {
                  "huge": { "size": 131070 }
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully updated" } }
      },
      "delete": {
        "summary": "Delete buffer tuning configuration",
        "description": "Remove buffer tuning (revert to defaults).",
        "operationId": "delete-buffers",
        "tags": ["buffers"],
        "responses": { "204": { "description": "Successfully deleted" } }
      }
    },
