{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE Native Config - Security & Access",
    "description": "Security and access control configuration from Cisco-IOS-XE-native model.\n\n**Includes:** tacacs, tacacs-server, radius, radius-server, dot1x, eap, mab, identity, cts, device-tracking, device-sensor, password, enable, login, privilege, mka\n\n**Modules covered:** Cisco-IOS-XE-device-sensor (device profiling)\n\n**Key Features:**\n- TACACS+ authentication\n- RADIUS authentication\n- 802.1X port security\n- MAC Authentication Bypass (MAB)\n- Identity services\n- TrustSec (CTS)\n- Device tracking & sensor\n- Password and privilege management\n\n**Base Path:** `/data/Cisco-IOS-XE-native:native/`\n\n**Related:** See 'AAA' for authentication/authorization/accounting",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/iosxe/"
    }
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        },
        "port": {
          "default": "443",
          "description": "HTTPS port"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-native:native/tacacs": {
      "get": {
        "summary": "Get TACACS configuration",
        "operationId": "get-tacacs",
        "tags": [
          "security"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "Cisco-IOS-XE-native:tacacs": {
                    "timeout": 5
                  }
                }
              }
            }
          }
        },
        "description": "Retrieve tACACS configuration from the RESTCONF interface"
      },
      "put": {
        "summary": "Configure TACACS",
        "operationId": "put-tacacs",
        "tags": [
          "security"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-native:tacacs": {
                  "timeout": 5
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully configured"
          }
        },
        "description": "Create or replace tACACS via the RESTCONF interface"
      },
      "patch": {
        "summary": "Update TACACS",
        "operationId": "patch-tacacs",
        "tags": [
          "security"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-native:tacacs": {
                  "source-interface": "Loopback0"
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully updated"
          }
        },
        "description": "Partially update tACACS via the RESTCONF interface"
      },
      "delete": {
        "summary": "Delete TACACS",
        "operationId": "delete-tacacs",
        "tags": [
          "security"
        ],
        "responses": {
          "204": {
            "description": "Successfully deleted"
          }
        },
        "description": "Remove tACACS from the device configuration via the RESTCONF interface"
      }
    },
