{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE Native Config - Interface \u2014 Physical Ethernet",
    "description": "Physical Ethernet interface configuration for all speed variants.\n\n**Types covered (13):** Ethernet, FastEthernet, GigabitEthernet, TwoGigabitEthernet, FiveGigabitEthernet, AppGigabitEthernet, TenGigabitEthernet, TwentyFiveGigE, FortyGigabitEthernet, FiftyGigabitEthernet, HundredGigE, TwoHundredGigE, FourHundredGigE\n\n**Common features per interface:** IP addressing, switchport, description, shutdown, speed/duplex, service-policy, access-group, spanning-tree\n\n**YANG:** Cisco-IOS-XE-native interface container + augments from policy, acl, spanning-tree, etc.",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/docs/ios-xe/"
    }
  },
  "servers": [
    {
      "url": "https://{device}:{port}",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        },
        "port": {
          "default": "443",
          "description": "HTTPS port"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-native:native/interface/Ethernet": {
      "get": {
        "summary": "Get Ethernet interface list",
        "description": "Retrieve all Ethernet interface configurations.\n\nCLI equivalent: `show running-config | section interface Ethernet`\n\nReturns a list of Ethernet interfaces with their name (key), IP addressing, shutdown state, description, and augmented features (QoS service-policy, ACL bindings, etc.).",
        "operationId": "get-intf-ethernet",
        "tags": [
          "ethernet"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "Cisco-IOS-XE-native:Ethernet": [
                    {
                      "name": "0/0",
                      "shutdown": [
                        null
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace Ethernet interface list",
        "description": "Replace all Ethernet interface configurations.",
        "operationId": "put-intf-ethernet",
        "tags": [
          "ethernet"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-native:Ethernet": [
                  {
                    "name": "0/0",
                    "shutdown": [
                      null
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully configured"
          }
        }
      },
      "patch": {
        "summary": "Update Ethernet interface configuration",
        "description": "Merge update to Ethernet interface configurations.",
        "operationId": "patch-intf-ethernet",
        "tags": [
          "ethernet"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-native:Ethernet": [
                  {
                    "name": "0/0",
                    "shutdown": [
                      null
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully updated"
          }
        }
      },
      "delete": {
        "summary": "Delete Ethernet interface configuration",
        "description": "Remove all Ethernet interface configurations.",
        "operationId": "delete-intf-ethernet",
        "tags": [
          "ethernet"
        ],
        "responses": {
          "204": {
            "description": "Successfully deleted"
          }
        }
      }
    },
