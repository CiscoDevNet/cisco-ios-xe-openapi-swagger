    "/data/Cisco-IOS-XE-native:native/crypto/ipsec": {
      "get": {
        "summary": "Get IPsec configuration",
        "description": "Retrieve IPsec configuration",
        "operationId": "get-crypto-ipsec",
        "tags": [
          "vpn"
        ],
        "responses": {
