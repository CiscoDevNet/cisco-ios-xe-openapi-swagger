              "application/yang-data+json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "Cisco-IOS-XE-crypto:ipsec": {
                    "transform-set": [
                      {
                        "tag": "IPSEC-TRANSFORM",
                        "esp": "esp-aes",
                        "esp-hmac": "esp-sha256-hmac"
                      }
                    ],
                    "profile": [
                      {
                        "name": "IPSEC-PROFILE",
                        "set": {
                          "transform-set": [
                            "IPSEC-TRANSFORM"
                          ]
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
