{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE Native Config - Line Configuration (Console, VTY, AUX)",
    "description": "Line access configuration for Cisco-IOS-XE-native model. This container includes console, VTY (virtual terminal), and AUX line configurations for device access.\n\n**What's included:** Complete line configuration hierarchy under /native/line\n\n**Line types:** Console (CON), VTY (Telnet/SSH), AUX\n\n**Common use cases:** SSH/Telnet access, timeout settings, exec configuration, privilege levels, access-class\n\n**Related:** See 'AAA' for authentication methods, 'IP' for SSH configuration",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/iosxe/"
    },
    "x-yang-module": "Cisco-IOS-XE-native",
    "x-model-type": "native"
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        },
        "port": {
          "default": "443",
          "description": "HTTPS port"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-native:native/line": {
      "get": {
        "summary": "Get all line configuration",
        "description": "Retrieve all line configurations (console, VTY, AUX)",
        "operationId": "get-line-all",
        "tags": [
          "line-root"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Cisco-IOS-XE-native:line": {
                      "type": "object",
                      "description": "Complete line configuration"
                    }
                  }
                },
                "example": {
                  "Cisco-IOS-XE-native:line": {
                    "console": {
                      "first": "0",
                      "exec-timeout": {
                        "minutes": 5,
                        "seconds": 0
                      },
                      "logging": {
                        "synchronous": [
                          null
                        ]
                      }
                    },
                    "vty": [
                      {
                        "first": 0,
                        "last": 4,
                        "transport": {
                          "input": {
                            "input": "ssh"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "Limit the depth of returned sub-tree data (RFC 8040 Section 4.8.2). Use 'unbounded' for full depth.",
            "schema": {
              "type": "string",
              "default": "unbounded"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Select specific fields to return (RFC 8040 Section 4.8.3). Example: fields=name;status",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "description": "Filter by config state: 'config' (config true only), 'nonconfig' (config false only), or 'all'.",
            "schema": {
              "type": "string",
              "enum": [
                "config",
                "nonconfig",
                "all"
              ],
              "default": "all"
            }
          }
        ]
      },
