{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE Native Config - VRF (Virtual Routing and Forwarding)",
    "description": "VRF configuration for Cisco-IOS-XE-native model. This container includes virtual routing and forwarding instance configurations for network segmentation.\n\n**What's included:** Complete VRF configuration hierarchy under /native/vrf\n\n**Common use cases:** Multi-tenancy, network segmentation, MPLS VPN, route isolation\n\n**Related:** See 'Router' for routing protocols, 'IP' for routing configuration\n\n**YANG Model:** [Cisco IOS-XE Native Config - VRF (Virtual Routing and Forwarding).yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Cisco IOS-XE Native Config - VRF (Virtual Routing and Forwarding).yang)",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/iosxe/"
    },
    "x-yang-module": "Cisco-IOS-XE-native",
    "x-model-type": "native"
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        },
        "port": {
          "default": "443",
          "description": "HTTPS port"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-native:native/vrf": {
      "get": {
        "summary": "Get all VRF configuration",
        "description": "Retrieve all VRF definitions",
        "operationId": "get-vrf-all",
        "tags": [
          "vrf-root"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Cisco-IOS-XE-native:vrf": {
                      "type": "object",
                      "description": "Complete VRF configuration"
                    }
                  }
                },
                "example": {
                  "Cisco-IOS-XE-native:vrf": {
                    "definition": [
                      {
                        "name": "CUSTOMER-A",
                        "rd": "65000:100",
                        "address-family": {
                          "ipv4": {
                            "route-target": {
                              "export": [
                                {
                                  "asn-ip": "65000:100"
                                }
                              ],
                              "import": [
                                {
                                  "asn-ip": "65000:100"
                                }
                              ]
                            }
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden \u2014 insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "Limit the depth of returned sub-tree data (RFC 8040 Section 4.8.2). Use 'unbounded' for full depth.",
            "schema": {
              "type": "string",
              "default": "unbounded"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Select specific fields to return (RFC 8040 Section 4.8.3). Example: fields=name;status",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "description": "Filter by config state: 'config' (config true only), 'nonconfig' (config false only), or 'all'.",
            "schema": {
              "type": "string",
              "enum": [
                "config",
                "nonconfig",
                "all"
              ],
              "default": "all"
            }
          }
        ]
      },
