                "example": {
                  "Cisco-IOS-XE-bba-group:bba-group": {
                    "pppoe": [
                      {
                        "name": "BBA-PPPoE",
                        "virtual-template": 1,
                        "sessions": {
                          "per-vc": 1000,
                          "per-mac": 10
