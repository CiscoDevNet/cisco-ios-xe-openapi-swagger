              "application/yang-data+json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "Cisco-IOS-XE-atm:ATM": [
                    {
                      "name": "0/0/0",
                      "no-ip-address": true,
                      "pvc": [
                        {
                          "vpi-vci": "0/35",
                          "encapsulation": "aal5snap",
                          "protocol": {
                            "pppoe": true
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace ATM interface configuration",
        "description": "Replace ATM interface configuration.",
        "operationId": "put-atm",
        "tags": [
          "atm"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-atm:ATM": [
                  {
                    "name": "0/0/0",
                    "pvc": [
                      {
                        "vpi-vci": "0/35",
                        "encapsulation": "aal5snap"
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully configured"
          }
        }
      },
      "patch": {
        "summary": "Update ATM interface configuration",
        "description": "Merge update to ATM interface configuration.",
        "operationId": "patch-atm",
        "tags": [
          "atm"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-atm:ATM": [
                  {
                    "name": "0/0/0",
                    "pvc": [
                      {
                        "vpi-vci": "0/36",
                        "encapsulation": "aal5mux"
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully updated"
          }
        }
      },
      "delete": {
        "summary": "Delete ATM interface configuration",
        "description": "Remove ATM interface configuration.",
        "operationId": "delete-atm",
        "tags": [
          "atm"
        ],
        "responses": {
          "204": {
            "description": "Successfully deleted"
          }
        }
      }
    },
    "/data/Cisco-IOS-XE-native:native/Cisco-IOS-XE-bba-group:bba-group": {
