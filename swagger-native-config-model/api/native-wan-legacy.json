                  ]
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully configured"
          }
        }
      },
      "patch": {
        "summary": "Update BBA group configuration",
        "description": "Merge update to BBA group configuration.",
        "operationId": "patch-bba-group",
