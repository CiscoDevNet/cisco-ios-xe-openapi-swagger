{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE Native Config - WAN & Legacy Services",
    "description": "WAN interface, broadband, and legacy service configuration for Cisco-IOS-XE-native model.\n\n**Modules covered:** adsl (DSL controllers), atm (ATM interfaces), bba-group (Broadband Aggregation), dialer (Dialer interfaces), isdn (ISDN), pppoe (PPPoE), vpdn (VPDN L2 tunnels), isg (Intelligent Services Gateway), ipc (IPC), ipmux (IP Multiplexing), l2nat (Layer 2 NAT), l3nat-iox (Layer 3 NAT IOx)\n\n**YANG Augments:** Cisco-IOS-XE-adsl, Cisco-IOS-XE-atm, Cisco-IOS-XE-bba-group, Cisco-IOS-XE-dialer, Cisco-IOS-XE-isdn, Cisco-IOS-XE-pppoe, Cisco-IOS-XE-vpdn, Cisco-IOS-XE-isg, Cisco-IOS-XE-ipc, Cisco-IOS-XE-ipmux, Cisco-IOS-XE-l2nat, Cisco-IOS-XE-l3nat-iox",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/iosxe/"
    }
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        },
        "port": {
          "default": "443",
          "description": "HTTPS port"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-native:native/controller/Cisco-IOS-XE-adsl:ADSL": {
      "get": {
        "summary": "Get ADSL controller configuration",
        "description": "Retrieve ADSL controller configuration for DSL interfaces.\n\nCLI equivalent: `show running-config | section controller ADSL`\n\nYANG module: Cisco-IOS-XE-adsl",
        "operationId": "get-adsl",
        "tags": [
          "adsl"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "Cisco-IOS-XE-adsl:ADSL": [
                    {
                      "name": "0/0/0",
                      "operating": {
                        "mode": "auto"
                      },
                      "dmt": {
                        "line-rate": {
                          "downstream": 8000,
                          "upstream": 1000
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace ADSL controller configuration",
        "description": "Replace ADSL controller configuration.",
        "operationId": "put-adsl",
        "tags": [
          "adsl"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-adsl:ADSL": [
                  {
                    "name": "0/0/0",
                    "operating": {
                      "mode": "auto"
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully configured"
          }
        }
      },
      "patch": {
        "summary": "Update ADSL controller configuration",
        "description": "Merge update to ADSL controller configuration.",
        "operationId": "patch-adsl",
        "tags": [
          "adsl"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-adsl:ADSL": [
                  {
                    "name": "0/0/0",
                    "operating": {
                      "mode": "adsl2+"
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully updated"
          }
        }
      },
      "delete": {
        "summary": "Delete ADSL controller configuration",
        "description": "Remove ADSL controller configuration.",
        "operationId": "delete-adsl",
        "tags": [
          "adsl"
        ],
        "responses": {
          "204": {
            "description": "Successfully deleted"
          }
        }
      }
    },
    "/data/Cisco-IOS-XE-native:native/interface/Cisco-IOS-XE-atm:ATM": {
      "get": {
        "summary": "Get ATM interface configuration",
        "description": "Retrieve ATM (Asynchronous Transfer Mode) interface configuration.\n\nCLI equivalent: `show running-config | section interface ATM`\n\nYANG module: Cisco-IOS-XE-atm",
