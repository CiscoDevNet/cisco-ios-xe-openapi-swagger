            "application/yang-data+json": {
              "schema": {
                "type": "object"
              },
              "example": {
                "Cisco-IOS-XE-sanet:access-session": {
                  "mac-move": {
                    "deny": false
                  },
                  "interface-template": {
                    "sticky": {
                      "timer": 60
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successfully configured"
          }
        }
      },
      "patch": {
        "summary": "Update SANET access-session configuration",
        "description": "Merge update to session-aware networking configuration.",
        "operationId": "patch-sanet",
        "tags": [
          "sanet"
        ],
        "requestBody": {
          "required": true,
          "content": {
