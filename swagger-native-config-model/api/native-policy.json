{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE Native Config - Policy & QoS Framework",
    "description": "Policy framework configuration for Cisco-IOS-XE-native model.\n\n**Modules covered:** Cisco-IOS-XE-policy (class-map, policy-map, parameter-map, service-group, control-plane service-policy)\n\n**YANG Augments:** Cisco-IOS-XE-policy augments:\n- `/native` → service-group\n- `/native/policy` → class-map, policy-map\n- `/native/parameter-map/type` → inspect, regex, webauth, cws-tunnel\n- `/native/control-plane` → service-policy (CoPP)\n- 32 interface types → per-interface service-policy (covered by interface specs)\n\n**Common use cases:** QoS policy definition, traffic classification, CoPP, NBAR matching, zone-based firewall parameter maps\n\n**Related:** See 'QoS' for queue/scheduler tuning, 'Interface' specs for per-interface service-policy binding",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/docs/ios-xe/"
    }
  },
  "servers": [
    {
      "url": "https://{device}:{port}",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        },
        "port": {
          "default": "443",
          "description": "HTTPS port"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-native:native/Cisco-IOS-XE-policy:service-group": {
      "get": {
        "summary": "Get all service-group configuration",
        "description": "Retrieve service-group list entries with input/output policy bindings.\n\nCLI equivalent: `show running-config | section service-group`\n\nYANG module: Cisco-IOS-XE-policy\n\nService groups bind service-policy maps to numbered group IDs used for subscriber/session policy application.",
        "operationId": "get-service-group",
        "tags": ["service-group"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": { "type": "object" },
                "example": {
                  "Cisco-IOS-XE-policy:service-group": [
                    {
                      "group-id": 1,
                      "description": "GOLD-SLA-USERS",
                      "service-policy": {
                        "input": "PM-GOLD-INPUT",
                        "output": "PM-GOLD-OUTPUT"
                      }
                    },
                    {
                      "group-id": 2,
                      "description": "SILVER-SLA-USERS",
                      "service-policy": {
                        "input": "PM-SILVER-INPUT"
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace service-group configuration",
        "description": "Replace all service-group entries.",
        "operationId": "put-service-group",
        "tags": ["service-group"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-policy:service-group": [
                  {
                    "group-id": 1,
                    "description": "PREMIUM",
                    "service-policy": { "input": "PM-PREMIUM-IN", "output": "PM-PREMIUM-OUT" }
                  }
                ]
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully configured" } }
      },
      "patch": {
        "summary": "Update service-group configuration",
        "description": "Merge update to service-group entries.",
        "operationId": "patch-service-group",
        "tags": ["service-group"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-policy:service-group": [
                  { "group-id": 3, "service-policy": { "input": "PM-BASIC-IN" } }
                ]
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully updated" } }
      },
      "delete": {
        "summary": "Delete all service-group configuration",
        "description": "Remove all service-group entries.",
        "operationId": "delete-service-group",
        "tags": ["service-group"],
        "responses": { "204": { "description": "Successfully deleted" } }
      }
    },
    "/data/Cisco-IOS-XE-native:native/policy/Cisco-IOS-XE-policy:class-map": {
      "get": {
        "summary": "Get all class-map definitions",
        "description": "Retrieve class-map definitions used for traffic classification.\n\nCLI equivalent: `show running-config | section class-map`\n\nYANG module: Cisco-IOS-XE-policy\n\nClass-maps define match criteria (ACL, DSCP, protocol/NBAR, VLAN, etc.) used by policy-maps to classify traffic for QoS, firewall, or subscriber policies.",
        "operationId": "get-class-map",
        "tags": ["class-map"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": { "type": "object" },
                "example": {
                  "Cisco-IOS-XE-policy:class-map": [
                    {
                      "name": "CM-VOICE",
                      "prematch": "match-all",
                      "match": {
                        "dscp": ["ef"]
                      }
                    },
                    {
                      "name": "CM-VIDEO",
                      "prematch": "match-any",
                      "match": {
                        "dscp": ["af41", "af42"]
                      }
                    },
                    {
                      "name": "CM-CRITICAL",
                      "prematch": "match-all",
                      "match": {
                        "access-group": { "name": ["ACL-CRITICAL"] }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace all class-map definitions",
        "description": "Replace all class-map entries.",
        "operationId": "put-class-map",
        "tags": ["class-map"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-policy:class-map": [
                  {
                    "name": "CM-MGMT",
                    "prematch": "match-all",
                    "match": {
                      "access-group": { "name": ["ACL-MGMT"] }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully configured" } }
      },
      "patch": {
        "summary": "Update class-map definitions",
        "description": "Merge update to class-map entries.",
        "operationId": "patch-class-map",
        "tags": ["class-map"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-policy:class-map": [
                  { "name": "CM-SCAVENGER", "prematch": "match-any", "match": { "dscp": ["cs1"] } }
                ]
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully updated" } }
      },
      "delete": {
        "summary": "Delete all class-map definitions",
        "description": "Remove all class-map definitions.",
        "operationId": "delete-class-map",
        "tags": ["class-map"],
        "responses": { "204": { "description": "Successfully deleted" } }
      }
    },
    "/data/Cisco-IOS-XE-native:native/policy/Cisco-IOS-XE-policy:policy-map": {
      "get": {
        "summary": "Get all policy-map definitions",
        "description": "Retrieve policy-map definitions with class actions for QoS, policing, and security.\n\nCLI equivalent: `show running-config | section policy-map`\n\nYANG module: Cisco-IOS-XE-policy\n\nPolicy-maps associate class-maps with actions (bandwidth, police, shape, queue-limit, set DSCP, drop, etc.) and are applied to interfaces via service-policy.",
        "operationId": "get-policy-map",
        "tags": ["policy-map"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": { "type": "object" },
                "example": {
                  "Cisco-IOS-XE-policy:policy-map": [
                    {
                      "name": "PM-WAN-OUT",
                      "class": [
                        {
                          "name": "CM-VOICE",
                          "action-list": {
                            "priority": { "kilo-bits": 256 },
                            "set": { "dscp": { "value": "ef" } }
                          }
                        },
                        {
                          "name": "CM-VIDEO",
                          "action-list": {
                            "bandwidth": { "kilo-bits": 2048 },
                            "set": { "dscp": { "value": "af41" } }
                          }
                        },
                        {
                          "name": "class-default",
                          "action-list": {
                            "bandwidth": { "kilo-bits": 1024 },
                            "queue-limit": { "queue-limit-value": 64, "queue-limit-type": "packets" }
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace all policy-map definitions",
        "description": "Replace all policy-map entries.",
        "operationId": "put-policy-map",
        "tags": ["policy-map"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-policy:policy-map": [
                  {
                    "name": "PM-SHAPE-100M",
                    "class": [
                      {
                        "name": "class-default",
                        "action-list": {
                          "shape": { "average": { "bit-rate": 100000000 } }
                        }
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully configured" } }
      },
      "patch": {
        "summary": "Update policy-map definitions",
        "description": "Merge update to policy-map entries.",
        "operationId": "patch-policy-map",
        "tags": ["policy-map"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-policy:policy-map": [
                  {
                    "name": "PM-POLICE-1G",
                    "class": [
                      { "name": "class-default", "action-list": { "police": { "cir": 1000000000, "bc": 31250 } } }
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully updated" } }
      },
      "delete": {
        "summary": "Delete all policy-map definitions",
        "description": "Remove all policy-map definitions.",
        "operationId": "delete-policy-map",
        "tags": ["policy-map"],
        "responses": { "204": { "description": "Successfully deleted" } }
      }
    },
    "/data/Cisco-IOS-XE-native:native/parameter-map/type": {
      "get": {
        "summary": "Get parameter-map type configuration",
        "description": "Retrieve parameter-map type definitions for zone-based firewall, regex, webauth, and CWS tunnel.\n\nCLI equivalent: `show running-config | section parameter-map type`\n\nYANG module: Cisco-IOS-XE-policy\n\nParameter maps define advanced parameters for inspection engines (inspect, inspect-global), regex patterns, web authentication portals, and cloud web security tunnels.",
        "operationId": "get-parameter-map-type",
        "tags": ["parameter-map"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": { "type": "object" },
                "example": {
                  "Cisco-IOS-XE-native:type": {
                    "Cisco-IOS-XE-policy:inspect": [
                      {
                        "name": "ZBFW-INSPECT-MAP",
                        "alert": "on",
                        "max-incomplete": {
                          "low": 400,
                          "high": 500
                        },
                        "tcp": {
                          "idle-time": 3600,
                          "synwait-time": 30
                        },
                        "dns-timeout": 5
                      }
                    ],
                    "Cisco-IOS-XE-policy:inspect-global": {
                      "alert": "on",
                      "log": { "dropped-packets": true },
                      "tcp": { "idle-time": 3600 }
                    },
                    "Cisco-IOS-XE-policy:regex": [
                      {
                        "name": "MATCH-URL",
                        "pattern": ".*example\\.com.*"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace parameter-map type configuration",
        "description": "Replace all parameter-map type definitions.",
        "operationId": "put-parameter-map-type",
        "tags": ["parameter-map"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-native:type": {
                  "Cisco-IOS-XE-policy:inspect": [
                    {
                      "name": "INSPECT-DEFAULT",
                      "tcp": { "idle-time": 1800 },
                      "dns-timeout": 3
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully configured" } }
      },
      "patch": {
        "summary": "Update parameter-map type configuration",
        "description": "Merge update to parameter-map type definitions.",
        "operationId": "patch-parameter-map-type",
        "tags": ["parameter-map"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-native:type": {
                  "Cisco-IOS-XE-policy:inspect-global": {
                    "tcp": { "idle-time": 7200 }
                  }
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully updated" } }
      },
      "delete": {
        "summary": "Delete parameter-map type configuration",
        "description": "Remove all parameter-map type definitions.",
        "operationId": "delete-parameter-map-type",
        "tags": ["parameter-map"],
        "responses": { "204": { "description": "Successfully deleted" } }
      }
    },
    "/data/Cisco-IOS-XE-native:native/control-plane/Cisco-IOS-XE-policy:service-policy": {
      "get": {
        "summary": "Get control-plane service-policy (CoPP)",
        "description": "Retrieve control-plane policing (CoPP) service-policy binding.\n\nCLI equivalent: `show running-config | section control-plane`\n\nYANG module: Cisco-IOS-XE-policy\n\nCoPP protects the route processor by applying a policy-map to the control-plane that rate-limits or drops unwanted traffic destined to the CPU.",
        "operationId": "get-control-plane-service-policy",
        "tags": ["control-plane"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": { "type": "object" },
                "example": {
                  "Cisco-IOS-XE-policy:service-policy": {
                    "input": "PM-COPP-INPUT",
                    "output": "PM-COPP-OUTPUT"
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace control-plane service-policy",
        "description": "Replace CoPP service-policy binding.",
        "operationId": "put-control-plane-service-policy",
        "tags": ["control-plane"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-policy:service-policy": {
                  "input": "PM-COPP"
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully configured" } }
      },
      "patch": {
        "summary": "Update control-plane service-policy",
        "description": "Merge update to CoPP service-policy binding.",
        "operationId": "patch-control-plane-service-policy",
        "tags": ["control-plane"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-policy:service-policy": {
                  "output": "PM-COPP-OUT-V2"
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully updated" } }
      },
      "delete": {
        "summary": "Delete control-plane service-policy",
        "description": "Remove CoPP service-policy binding from control-plane.",
        "operationId": "delete-control-plane-service-policy",
        "tags": ["control-plane"],
        "responses": { "204": { "description": "Successfully deleted" } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    { "name": "service-group", "description": "Service groups — numbered groups with input/output policy bindings" },
    { "name": "class-map", "description": "Class-maps — traffic classification rules (match ACL, DSCP, protocol, VLAN)" },
    { "name": "policy-map", "description": "Policy-maps — traffic actions (bandwidth, police, shape, priority, set, drop)" },
    { "name": "parameter-map", "description": "Parameter-maps — inspection engine, regex, webauth, CWS tunnel parameters" },
    { "name": "control-plane", "description": "Control-plane — CoPP service-policy binding for route-processor protection" }
  ]
}
