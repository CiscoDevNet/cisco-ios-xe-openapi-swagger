    "/data/Cisco-IOS-XE-native:native/ip/Cisco-IOS-XE-igmp:igmp": {
      "get": {
        "summary": "Get IGMP global configuration",
        "description": "Retrieve global Internet Group Management Protocol (IGMP) configuration including SSM maps, IGMP snooping, and profile settings.\n\nCLI equivalent: `show running-config | section ip igmp`\n\nYANG module: Cisco-IOS-XE-igmp",
        "operationId": "get-igmp",
        "tags": ["igmp"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": { "type": "object" },
                "example": {
                  "Cisco-IOS-XE-igmp:igmp": {
                    "snooping-conf": {
                      "snooping": true
                    },
                    "snooping": {
                      "querier": [null],
                      "tcn": {
                        "flood": {
                          "query": {
                            "count": 2
                          }
                        }
                      },
                      "vlan": [
                        {
                          "id": 100,
                          "static-group": [
                            {
                              "group-addr": "239.1.1.1",
                              "interface": "GigabitEthernet1/0/1"
                            }
                          ]
                        }
                      ]
                    },
                    "ssm-map": {
                      "enable": true,
                      "static": [
                        {
                          "acl": "SSM-RANGE",
                          "source-ip": "10.0.0.100"
                        }
                      ]
                    },
                    "profile": [
                      {
                        "id": 1,
                        "action": "permit",
                        "range": [
                          { "low-ip": "239.0.0.0", "high-ip": "239.255.255.255" }
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace IGMP global configuration",
        "description": "Replace global IGMP configuration.",
        "operationId": "put-igmp",
        "tags": ["igmp"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-igmp:igmp": {
                  "snooping-conf": { "snooping": true },
                  "ssm-map": { "enable": true },
                  "profile": [
                    {
                      "id": 1,
                      "action": "permit",
                      "range": [
                        { "low-ip": "239.0.0.0", "high-ip": "239.255.255.255" }
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully configured" } }
      },
      "patch": {
        "summary": "Update IGMP global configuration",
        "description": "Merge update to global IGMP configuration.",
        "operationId": "patch-igmp",
        "tags": ["igmp"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-igmp:igmp": {
                  "snooping": {
                    "vlan": [
                      {
                        "id": 200,
                        "mrouter": { "interface": "GigabitEthernet1/0/24" }
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully updated" } }
      },
      "delete": {
        "summary": "Delete IGMP global configuration",
        "description": "Remove global IGMP configuration.",
        "operationId": "delete-igmp",
        "tags": ["igmp"],
        "responses": { "204": { "description": "Successfully deleted" } }
      }
    },
    "/data/Cisco-IOS-XE-native:native/ip/Cisco-IOS-XE-multicast:multicast": {
      "get": {
        "summary": "Get IP multicast global configuration",
        "description": "Retrieve global IP multicast routing configuration including RPF, multicast topology, and VRF-aware multicast.\n\nCLI equivalent: `show running-config | section ip multicast`\n\nYANG module: Cisco-IOS-XE-multicast",
        "operationId": "get-multicast",
        "tags": ["multicast"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": { "type": "object" },
                "example": {
                  "Cisco-IOS-XE-multicast:multicast": {
                    "multicast-routing-conf": {
                      "multicast-routing": true
                    },
                    "route-limit": 2147483647,
                    "rpf": {
                      "select": [
                        {
                          "vrf": "MCAST-VRF",
                          "group-list-acl": "MCAST-GROUPS"
                        }
                      ]
                    },
                    "vrf": [
                      {
                        "name": "MCAST-VRF",
                        "multicast-routing": true
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace IP multicast global configuration",
        "description": "Replace global IP multicast configuration.\n\nCLI equivalent: `ip multicast-routing`",
        "operationId": "put-multicast",
        "tags": ["multicast"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-multicast:multicast": {
                  "multicast-routing-conf": { "multicast-routing": true },
                  "route-limit": 100000
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully configured" } }
      },
      "patch": {
        "summary": "Update IP multicast global configuration",
        "description": "Merge update to global multicast configuration.",
        "operationId": "patch-multicast",
        "tags": ["multicast"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-multicast:multicast": {
                  "vrf": [
                    {
                      "name": "NEW-VRF",
                      "multicast-routing": true
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully updated" } }
      },
      "delete": {
        "summary": "Delete IP multicast global configuration",
        "description": "Remove global multicast configuration (disables multicast routing).\n\nCLI equivalent: `no ip multicast-routing`",
        "operationId": "delete-multicast",
        "tags": ["multicast"],
        "responses": { "204": { "description": "Successfully deleted" } }
      }
    },
