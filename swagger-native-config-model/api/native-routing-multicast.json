        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-nhrp:nhrp": {
                  "group": [
                    {
                      "group-name": "DMVPN-GROUP",
                      "max-send": { "pkt-count": 200 }
                    }
                  ]
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully updated" } }
      },
      "delete": {
        "summary": "Delete NHRP global configuration",
        "description": "Remove global NHRP configuration.",
        "operationId": "delete-nhrp",
        "tags": ["nhrp"],
        "responses": { "204": { "description": "Successfully deleted" } }
      }
    },
