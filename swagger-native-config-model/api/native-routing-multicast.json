    "/data/Cisco-IOS-XE-native:native/ipv6/Cisco-IOS-XE-nd:nd": {
      "get": {
        "summary": "Get IPv6 Neighbor Discovery (ND) configuration",
        "description": "Retrieve global IPv6 Neighbor Discovery configuration including RA guard, cache management, and NUD parameters.\n\nCLI equivalent: `show running-config | section ipv6 nd`\n\nYANG module: Cisco-IOS-XE-nd\n\nIPv6 ND controls router advertisement handling, neighbour cache behaviour, reachability detection, and RA Guard policies for first-hop security.",
        "operationId": "get-ipv6-nd",
        "tags": ["nd"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": { "type": "object" },
                "example": {
                  "Cisco-IOS-XE-nd:nd": {
                    "cache": {
                      "expire": 14400
                    },
                    "raguard": {
                      "policy": [
                        {
                          "raguard-policy-name": "HOST-POLICY",
                          "device-role": "host"
                        },
                        {
                          "raguard-policy-name": "ROUTER-POLICY",
                          "device-role": "router",
                          "trusted-port": [null]
                        }
                      ]
                    },
                    "inspection": {
                      "policy": [
                        {
                          "nd-inspection-policy-name": "ND-INSPECT",
                          "device-role": "host",
                          "drop-unsecure": [null]
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace IPv6 ND configuration",
        "description": "Replace IPv6 Neighbor Discovery configuration.",
        "operationId": "put-ipv6-nd",
        "tags": ["nd"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-nd:nd": {
                  "cache": { "expire": 7200 },
                  "raguard": {
                    "policy": [
                      { "raguard-policy-name": "HOST-ONLY", "device-role": "host" }
