{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE Native Config - Routing & Multicast",
    "description": "Routing protocol extensions and multicast configuration for Cisco-IOS-XE-native model.\n\n**Modules covered:** ospfv3 (OSPFv3 IPv6), rsvp (Resource Reservation Protocol), nhrp (Next Hop Resolution Protocol), mobileip (Mobile IP), igmp (Internet Group Management Protocol), multicast (IP Multicast), mld (Multicast Listener Discovery), nd (IPv6 Neighbor Discovery)\n\n**YANG Augments:** Cisco-IOS-XE-ospfv3, Cisco-IOS-XE-rsvp, Cisco-IOS-XE-nhrp, Cisco-IOS-XE-mobileip, Cisco-IOS-XE-igmp, Cisco-IOS-XE-multicast, Cisco-IOS-XE-mld, Cisco-IOS-XE-nd",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/docs/ios-xe/"
    }
  },
  "servers": [
    {
      "url": "https://{device}:{port}",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        },
        "port": {
          "default": "443",
          "description": "HTTPS port"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-native:native/router/Cisco-IOS-XE-ospfv3:router-ospfv3/ospfv3": {
      "get": {
        "summary": "Get OSPFv3 router configuration",
        "description": "Retrieve OSPFv3 router process configuration including area definitions, address families, and redistribution.\n\nCLI equivalent: `show running-config | section router ospfv3`\n\nYANG module: Cisco-IOS-XE-ospfv3\n\n**Note:** OSPFv3 supports both IPv4 and IPv6 address families within a single process.",
        "operationId": "get-ospfv3",
        "tags": ["ospfv3"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": { "type": "object" },
                "example": {
                  "Cisco-IOS-XE-ospfv3:ospfv3": [
                    {
                      "id": 1,
                      "router-id": "10.0.0.1",
                      "address-family": {
                        "ipv4": {
                          "unicast": {
                            "area": [
                              {
                                "area-id": 0,
                                "normal": [null]
                              },
                              {
                                "area-id": 1,
                                "stub": { "no-summary": true }
                              }
                            ],
                            "redistribute": {
                              "connected": { "subnets": true }
                            },
                            "default-information": {
                              "originate": true
                            }
                          }
                        },
                        "ipv6": {
                          "unicast": {
                            "area": [
                              { "area-id": 0, "normal": [null] }
                            ]
                          }
                        }
                      },
                      "auto-cost": {
                        "reference-bandwidth": 10000
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace OSPFv3 router configuration",
        "description": "Replace all OSPFv3 process definitions.\n\nCLI equivalent: `router ospfv3 1`",
        "operationId": "put-ospfv3",
        "tags": ["ospfv3"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-ospfv3:ospfv3": [
                  {
                    "id": 1,
                    "router-id": "10.0.0.1",
                    "address-family": {
                      "ipv4": {
                        "unicast": {
                          "area": [
                            { "area-id": 0, "normal": [null] }
                          ]
                        }
                      }
                    },
                    "auto-cost": { "reference-bandwidth": 10000 }
                  }
                ]
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully configured" } }
      },
      "patch": {
        "summary": "Update OSPFv3 router configuration",
        "description": "Merge update to OSPFv3 processes.",
        "operationId": "patch-ospfv3",
        "tags": ["ospfv3"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-ospfv3:ospfv3": [
                  {
                    "id": 1,
                    "auto-cost": { "reference-bandwidth": 40000 }
                  }
                ]
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully updated" } }
      },
      "delete": {
        "summary": "Delete OSPFv3 router configuration",
        "description": "Remove all OSPFv3 processes.\n\nCLI equivalent: `no router ospfv3 1`",
        "operationId": "delete-ospfv3",
        "tags": ["ospfv3"],
        "responses": { "204": { "description": "Successfully deleted" } }
      }
    },
    "/data/Cisco-IOS-XE-native:native/ip/Cisco-IOS-XE-rsvp:rsvp": {
      "get": {
        "summary": "Get RSVP configuration",
        "description": "Retrieve Resource Reservation Protocol (RSVP) configuration.\n\nCLI equivalent: `show running-config | section ip rsvp`\n\nYANG module: Cisco-IOS-XE-rsvp",
        "operationId": "get-rsvp",
        "tags": ["rsvp"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": { "type": "object" },
                "example": {
                  "Cisco-IOS-XE-rsvp:rsvp": {
                    "signalling": {
                      "hello": {
                        "graceful-restart": {
                          "mode": "full"
                        }
                      },
                      "refresh": {
                        "reduction": true
                      }
                    },
                    "authentication": {
                      "type": "sha-1",
                      "key-chain": "RSVP-KEYS",
                      "window-size": 1
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace RSVP configuration",
        "description": "Replace RSVP configuration.\n\nCLI equivalent: `ip rsvp signalling hello graceful-restart mode full`",
        "operationId": "put-rsvp",
        "tags": ["rsvp"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-rsvp:rsvp": {
                  "signalling": {
                    "hello": {
                      "graceful-restart": { "mode": "full" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully configured" } }
      },
      "patch": {
        "summary": "Update RSVP configuration",
        "description": "Merge update to RSVP configuration.",
        "operationId": "patch-rsvp",
        "tags": ["rsvp"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-rsvp:rsvp": {
                  "signalling": {
                    "refresh": { "reduction": true }
                  }
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully updated" } }
      },
      "delete": {
        "summary": "Delete RSVP configuration",
        "description": "Remove RSVP configuration.",
        "operationId": "delete-rsvp",
        "tags": ["rsvp"],
        "responses": { "204": { "description": "Successfully deleted" } }
      }
    },
