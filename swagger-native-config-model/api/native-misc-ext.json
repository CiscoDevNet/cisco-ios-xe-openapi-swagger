        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-vstack:vstack": {
                  "basic": { "management-vlan": 100 }
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully updated" } }
      },
      "delete": {
        "summary": "Delete Smart Install configuration",
        "description": "Remove Smart Install configuration (recommended for security).\n\nCLI equivalent: `no vstack`",
