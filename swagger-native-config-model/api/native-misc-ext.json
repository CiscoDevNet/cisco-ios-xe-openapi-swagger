{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE Native Config - Miscellaneous Extensions",
    "description": "Miscellaneous service and management extensions for Cisco-IOS-XE-native model.\n\n**Modules covered:** wccp (Web Cache Communication Protocol), vstack (Smart Install), vservice (Virtual Services), ezpm (EasyPerf Monitor), iwanfabric (IWAN/SD-WAN domain), pathmgr (SD-WAN path manager), perf-measure (Performance Measurement), site-manager (SD-WAN site manager), voice-port (Voice Port), interfaces (interface container overview)\n\n**YANG Augments:** Cisco-IOS-XE-wccp, Cisco-IOS-XE-vstack, Cisco-IOS-XE-vservice, Cisco-IOS-XE-ezpm, Cisco-IOS-XE-iwanfabric, Cisco-IOS-XE-pathmgr, Cisco-IOS-XE-perf-measure, Cisco-IOS-XE-site-manager, Cisco-IOS-XE-voice, Cisco-IOS-XE-interfaces",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/docs/ios-xe/"
    }
  },
  "servers": [
    {
      "url": "https://{device}:{port}",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        },
        "port": {
          "default": "443",
          "description": "HTTPS port"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-native:native/ip/Cisco-IOS-XE-wccp:wccp": {
      "get": {
        "summary": "Get WCCP configuration",
        "description": "Retrieve Web Cache Communication Protocol (WCCP) configuration for transparent traffic redirection to cache engines.\n\nCLI equivalent: `show running-config | section ip wccp`\n\nYANG module: Cisco-IOS-XE-wccp",
        "operationId": "get-wccp",
        "tags": ["wccp"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": { "type": "object" },
                "example": {
                  "Cisco-IOS-XE-wccp:wccp": {
                    "web-cache": {
                      "group-address": "239.128.1.100",
                      "redirect-list": "WCCP-REDIRECT",
                      "group-list": "WCCP-ROUTERS"
                    },
                    "wccp-list": [
                      {
                        "id": 61,
                        "redirect-list": "WCCP-DNS-REDIRECT",
                        "group-list": "WCCP-ROUTERS"
                      },
                      {
                        "id": 62,
                        "redirect-list": "WCCP-HTTPS-REDIRECT"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace WCCP configuration",
        "description": "Replace WCCP configuration.\n\nCLI equivalent: `ip wccp web-cache`",
        "operationId": "put-wccp",
        "tags": ["wccp"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-wccp:wccp": {
                  "web-cache": { "redirect-list": "WCCP-ACL" },
                  "wccp-list": [ { "id": 61, "redirect-list": "DNS-ACL" } ]
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully configured" } }
      },
      "patch": {
        "summary": "Update WCCP configuration",
        "description": "Merge update to WCCP configuration.",
        "operationId": "patch-wccp",
        "tags": ["wccp"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-wccp:wccp": {
                  "wccp-list": [ { "id": 90, "redirect-list": "NEW-REDIRECT" } ]
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully updated" } }
      },
      "delete": {
        "summary": "Delete WCCP configuration",
        "description": "Remove WCCP configuration.",
        "operationId": "delete-wccp",
        "tags": ["wccp"],
        "responses": { "204": { "description": "Successfully deleted" } }
      }
    },
    "/data/Cisco-IOS-XE-native:native/Cisco-IOS-XE-vstack:vstack": {
