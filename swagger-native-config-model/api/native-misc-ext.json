    "/data/Cisco-IOS-XE-native:native/performance/Cisco-IOS-XE-perf-measure:measurement": {
      "get": {
        "summary": "Get Performance Measurement configuration",
        "description": "Retrieve Segment Routing performance measurement configuration (delay, loss, liveness).\n\nCLI equivalent: `show running-config | section performance measurement`\n\nYANG module: Cisco-IOS-XE-perf-measure",
        "operationId": "get-perf-measure",
        "tags": ["perf-measure"],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": { "type": "object" },
                "example": {
                  "Cisco-IOS-XE-perf-measure:measurement": {
                    "delay": {
                      "profile": {
                        "name": "DELAY-PROFILE",
                        "probe": {
                          "measurement-mode": "one-way",
                          "burst-interval": 30000,
                          "computation-interval": 60
                        }
                      }
                    },
                    "liveness-detection": {
                      "profile": {
                        "name": "LIVENESS-PROFILE",
                        "probe": {
                          "burst-interval": 30000
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replace Performance Measurement configuration",
        "description": "Replace performance measurement configuration.",
        "operationId": "put-perf-measure",
        "tags": ["perf-measure"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-perf-measure:measurement": {
                  "delay": {
                    "profile": { "name": "MY-DELAY", "probe": { "measurement-mode": "two-way" } }
                  }
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully configured" } }
      },
      "patch": {
        "summary": "Update Performance Measurement configuration",
        "description": "Merge update to performance measurement configuration.",
        "operationId": "patch-perf-measure",
        "tags": ["perf-measure"],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": { "type": "object" },
              "example": {
                "Cisco-IOS-XE-perf-measure:measurement": {
                  "delay": { "profile": { "probe": { "computation-interval": 120 } } }
                }
              }
            }
          }
        },
        "responses": { "204": { "description": "Successfully updated" } }
      },
      "delete": {
        "summary": "Delete Performance Measurement configuration",
        "description": "Remove performance measurement configuration.",
        "operationId": "delete-perf-measure",
        "tags": ["perf-measure"],
        "responses": { "204": { "description": "Successfully deleted" } }
      }
    },
