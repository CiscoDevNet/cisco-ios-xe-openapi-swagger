          "400": {
            "description": "Invalid input"
          }
        },
        "description": "Create or replace mka configuration on the device.\n\nThis replaces the entire resource — any fields not included will be removed."
      },
      "patch": {
        "summary": "Update mka configuration",
        "operationId": "patch-mka",
        "tags": [
          "native-crypto"
