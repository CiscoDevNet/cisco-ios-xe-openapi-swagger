        },
        "description": "Partially update mka configuration on the device.\n\nOnly the fields included in the request body are modified; other fields remain unchanged."
      },
      "delete": {
        "summary": "Delete mka configuration",
        "operationId": "delete-mka",
        "tags": [
          "native-crypto"
        ],
        "responses": {
          "204": {
            "description": "Deleted successfully"
          },
