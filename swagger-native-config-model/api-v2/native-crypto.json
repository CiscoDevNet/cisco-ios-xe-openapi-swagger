{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE Native Config - Cryptography & PKI",
    "description": "Crypto: IKEv2, IPsec, PKI trustpoints, MACsec MKA, certificates.",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/iosxe/"
    },
    "x-yang-module": "Cisco-IOS-XE-native",
    "x-model-type": "native"
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        },
        "port": {
          "default": "443",
          "description": "HTTPS port"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-native:native/crypto": {
      "get": {
        "summary": "Get crypto configuration",
        "operationId": "get-crypto",
        "tags": [
          "native-crypto"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/accept"
          },
          {
            "$ref": "#/components/parameters/depth"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "example": "configured-value"
                },
                "example": {
                  "Cisco-IOS-XE-native:crypto": {
                    "key": {
                      "generate": {
                        "rsa": {
                          "general-keys": {
                            "modulus": 2048
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource not found"
          }
        },
        "description": "Retrieve crypto configuration from the device via RESTCONF.\n\nReturns the current operational or configuration state of this resource."
      },
      "put": {
        "summary": "Replace crypto configuration",
        "operationId": "put-crypto",
        "tags": [
          "native-crypto"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "example": "configured-value"
              },
              "example": {
                "Cisco-IOS-XE-native:crypto": {
                  "key": {
                    "generate": {
                      "rsa": {
                        "general-keys": {
                          "modulus": 2048
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "204": {
            "description": "Updated successfully"
          },
          "400": {
            "description": "Invalid input"
          }
        },
        "description": "Create or replace crypto configuration on the device.\n\nThis replaces the entire resource — any fields not included will be removed."
      },
      "patch": {
        "summary": "Update crypto configuration",
        "operationId": "patch-crypto",
        "tags": [
          "native-crypto"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "example": "configured-value"
              },
              "example": {
                "Cisco-IOS-XE-native:crypto": {
                  "key": {
                    "generate": {
                      "rsa": {
                        "general-keys": {
                          "modulus": 2048
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Updated successfully"
          },
          "400": {
            "description": "Invalid input"
          }
        },
        "description": "Partially update crypto configuration on the device.\n\nOnly the fields included in the request body are modified; other fields remain unchanged."
      },
      "delete": {
        "summary": "Delete crypto configuration",
        "operationId": "delete-crypto",
        "tags": [
          "native-crypto"
        ],
        "responses": {
          "204": {
            "description": "Deleted successfully"
          },
          "404": {
            "description": "Resource not found"
          }
        },
        "description": "Remove crypto configuration from the device configuration.\n\nThis deletes the resource and all descendant data."
      }
    },
