{
  "openapi": "3.0.0",
  "info": {
    "title": "openconfig-openflow",
    "description": "OpenConfig OpenFlow configuration and operational state data.\n\nThis module defines configuration and operational state data for OpenFlow, including controller connections and agent settings. It augments the OpenConfig system model (`/openconfig-system:system`) with an `openflow` container.\n\n**Module:** `openconfig-openflow`\n**Namespace:** `http://openconfig.net/yang/openflow`\n**Augments:** `/openconfig-system:system`\n**Version:** 0.1.1\n**Paths:** 5",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/docs/ios-xe/"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    }
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        }
      }
    }
  ],
  "paths": {
    "/data/openconfig-system:system/openconfig-openflow:openflow": {
      "get": {
        "summary": "Get OpenFlow configuration",
        "description": "Retrieve the full OpenFlow configuration including controllers and agent settings.\n\n**CLI equivalent:** `show openflow`",
        "operationId": "get-openflow",
        "tags": [
          "openconfig-openflow"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/openconfig-openflow-openflow"
                },
                "example": {
                  "openconfig-openflow:openflow": {
                    "controllers": {
                      "controller": [
                        {
                          "name": "main-controller",
                          "config": {
                            "name": "main-controller"
                          },
                          "connections": {
                            "connection": [
                              {
                                "aux-id": 0,
                                "config": {
                                  "aux-id": 0,
                                  "priority": 1,
                                  "address": "10.1.1.100",
                                  "port": 6653,
                                  "transport": "TLS"
                                }
                              }
                            ]
                          }
                        }
                      ]
                    },
                    "agent": {
                      "config": {
                        "datapath-id": "00:00:00:00:00:00:00:01",
                        "failure-mode": "SECURE",
                        "backoff-interval": 8,
                        "max-backoff": 8,
                        "inactivity-probe": 10
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Resource not found"
          }
        }
      },
      "put": {
        "summary": "Create or replace OpenFlow configuration",
        "description": "Create or replace the full OpenFlow configuration.\n\n**CLI equivalent:** `openflow` configuration mode",
        "operationId": "put-openflow",
        "tags": [
          "openconfig-openflow"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "$ref": "#/components/schemas/openconfig-openflow-openflow"
              },
              "example": {
                "openconfig-openflow:openflow": {
                  "controllers": {
                    "controller": [
                      {
                        "name": "main-controller",
                        "config": {
                          "name": "main-controller"
                        }
                      }
                    ]
                  },
                  "agent": {
                    "config": {
                      "datapath-id": "00:00:00:00:00:00:00:01",
                      "failure-mode": "SECURE"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "204": {
            "description": "Updated"
          },
          "400": {
            "description": "Bad request"
          }
        }
      },
      "patch": {
        "summary": "Modify OpenFlow configuration",
        "description": "Partially modify the OpenFlow configuration.",
        "operationId": "patch-openflow",
        "tags": [
          "openconfig-openflow"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "$ref": "#/components/schemas/openconfig-openflow-openflow"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Updated"
          },
          "400": {
            "description": "Bad request"
          }
        }
      },
      "delete": {
        "summary": "Delete OpenFlow configuration",
        "description": "Remove the entire OpenFlow configuration.",
        "operationId": "delete-openflow",
        "tags": [
          "openconfig-openflow"
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
