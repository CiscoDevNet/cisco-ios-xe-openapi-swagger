        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "openconfig-openflow-openflow": {
        "type": "object",
        "description": "Top-level OpenFlow container with controllers and agent",
        "properties": {
          "controllers": {
            "$ref": "#/components/schemas/openconfig-openflow-controllers"
          },
          "agent": {
            "$ref": "#/components/schemas/openconfig-openflow-agent"
          }
        }
      },
      "openconfig-openflow-controllers": {
        "type": "object",
        "description": "Container for OpenFlow controllers",
        "properties": {
          "controller": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/openconfig-openflow-controller"
            }
          }
        }
      },
      "openconfig-openflow-controller": {
        "type": "object",
        "description": "An OpenFlow controller instance",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the OpenFlow controller"
          },
          "config": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            }
          },
          "connections": {
            "type": "object",
            "properties": {
              "connection": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/openconfig-openflow-connection"
                }
              }
            }
          }
        }
      },
      "openconfig-openflow-connection": {
        "type": "object",
        "description": "An OpenFlow controller connection",
        "properties": {
          "aux-id": {
            "type": "integer",
            "description": "Auxiliary connection ID (0 for main connection)"
          },
          "config": {
            "type": "object",
            "properties": {
              "aux-id": {
                "type": "integer"
              },
              "priority": {
                "type": "integer",
                "description": "Priority for this controller connection"
              },
              "address": {
                "type": "string",
                "description": "IP address of the controller"
              },
              "port": {
                "type": "integer",
                "description": "Port number for the connection (default: 6653)"
              },
              "transport": {
                "type": "string",
                "enum": [
                  "TLS",
                  "TCP"
                ],
                "description": "Transport protocol"
              }
            }
          },
          "state": {
            "type": "object",
            "properties": {
              "aux-id": {
                "type": "integer"
              },
              "priority": {
                "type": "integer"
              },
              "address": {
                "type": "string"
              },
              "port": {
                "type": "integer"
              },
              "transport": {
                "type": "string"
              },
              "connected": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "openconfig-openflow-agent": {
        "type": "object",
        "description": "OpenFlow agent configuration and state",
        "properties": {
          "config": {
            "type": "object",
            "properties": {
              "datapath-id": {
                "type": "string",
                "description": "Unique datapath identifier for this switch"
              },
              "failure-mode": {
                "type": "string",
                "enum": [
                  "SECURE",
                  "STANDALONE"
                ],
                "description": "Behavior when controller connection is lost"
              },
              "backoff-interval": {
                "type": "integer",
                "description": "Initial interval between controller connection attempts (seconds)"
              },
              "max-backoff": {
                "type": "integer",
                "description": "Maximum interval between controller connection attempts (seconds)"
              },
              "inactivity-probe": {
                "type": "integer",
                "description": "Interval before probing an idle controller connection (seconds)"
              }
            }
          },
          "state": {
            "type": "object",
            "properties": {
              "datapath-id": {
                "type": "string"
              },
              "failure-mode": {
                "type": "string"
              },
              "backoff-interval": {
                "type": "integer"
              },
              "max-backoff": {
                "type": "integer"
              },
              "inactivity-probe": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "openconfig-openflow",
      "description": "OpenFlow SDN controller and agent configuration — controllers, connections, and agent settings via OpenConfig model"
    }
  ]
}
