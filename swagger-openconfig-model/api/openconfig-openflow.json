    "/data/openconfig-system:system/openconfig-openflow:openflow/agent": {
      "get": {
        "summary": "Get OpenFlow agent configuration",
        "description": "Retrieve OpenFlow agent configuration including datapath-id, failure mode, and timing parameters.",
        "operationId": "get-openflow-agent",
        "tags": [
          "openconfig-openflow"
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/openconfig-openflow-agent"
                },
                "example": {
                  "openconfig-openflow:agent": {
                    "config": {
                      "datapath-id": "00:00:00:00:00:00:00:01",
                      "failure-mode": "SECURE",
                      "backoff-interval": 8,
                      "max-backoff": 8,
                      "inactivity-probe": 10
                    },
                    "state": {
                      "datapath-id": "00:00:00:00:00:00:00:01",
                      "failure-mode": "SECURE",
                      "backoff-interval": 8,
                      "max-backoff": 8,
                      "inactivity-probe": 10
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Resource not found"
          }
        }
      },
      "put": {
        "summary": "Create or replace OpenFlow agent configuration",
        "description": "Create or replace the OpenFlow agent settings.\n\n**Key parameters:**\n- `datapath-id`: Unique identifier for the OpenFlow datapath\n- `failure-mode`: Behavior when controller connection is lost (SECURE or STANDALONE)\n- `backoff-interval`: Initial interval between controller connection attempts\n- `max-backoff`: Maximum interval between connection attempts\n- `inactivity-probe`: Interval before probing idle controller connections",
        "operationId": "put-openflow-agent",
        "tags": [
          "openconfig-openflow"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "$ref": "#/components/schemas/openconfig-openflow-agent"
              },
              "example": {
                "openconfig-openflow:agent": {
                  "config": {
                    "datapath-id": "00:00:00:00:00:00:00:01",
                    "failure-mode": "SECURE",
                    "backoff-interval": 8,
                    "max-backoff": 8,
                    "inactivity-probe": 10
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "204": {
            "description": "Updated"
          }
        }
      },
      "patch": {
        "summary": "Modify OpenFlow agent configuration",
        "operationId": "patch-openflow-agent",
        "tags": [
          "openconfig-openflow"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "$ref": "#/components/schemas/openconfig-openflow-agent"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Updated"
          }
        }
      },
      "delete": {
        "summary": "Delete OpenFlow agent configuration",
        "operationId": "delete-openflow-agent",
        "tags": [
          "openconfig-openflow"
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          }
        }
      }
    },
    "/data/openconfig-system:system/openconfig-openflow:openflow/controllers/controller={name}/connections/connection={aux-id}": {
      "get": {
        "summary": "Get a specific OpenFlow connection",
        "description": "Retrieve a specific OpenFlow connection by controller name and auxiliary ID.",
        "operationId": "get-openflow-connection",
        "tags": [
          "openconfig-openflow"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "description": "Name of the OpenFlow controller",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "aux-id",
            "in": "path",
            "required": true,
            "description": "Auxiliary connection ID (0 for main connection)",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/openconfig-openflow-connection"
                },
                "example": {
                  "openconfig-openflow:connection": [
                    {
                      "aux-id": 0,
                      "config": {
                        "aux-id": 0,
                        "priority": 1,
                        "address": "10.1.1.100",
                        "port": 6653,
                        "transport": "TLS"
                      },
                      "state": {
                        "aux-id": 0,
                        "priority": 1,
                        "address": "10.1.1.100",
                        "port": 6653,
                        "transport": "TLS",
                        "connected": true
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Connection not found"
          }
        }
      },
      "put": {
        "summary": "Create or replace a specific OpenFlow connection",
        "operationId": "put-openflow-connection",
        "tags": [
          "openconfig-openflow"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "aux-id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "$ref": "#/components/schemas/openconfig-openflow-connection"
              },
              "example": {
                "openconfig-openflow:connection": [
                  {
                    "aux-id": 0,
                    "config": {
                      "aux-id": 0,
                      "priority": 1,
                      "address": "10.1.1.100",
                      "port": 6653,
                      "transport": "TLS"
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "204": {
            "description": "Updated"
          }
        }
      },
      "patch": {
        "summary": "Modify a specific OpenFlow connection",
        "operationId": "patch-openflow-connection",
        "tags": [
          "openconfig-openflow"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "aux-id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "$ref": "#/components/schemas/openconfig-openflow-connection"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Updated"
          }
        }
      },
      "delete": {
        "summary": "Delete a specific OpenFlow connection",
        "operationId": "delete-openflow-connection",
        "tags": [
          "openconfig-openflow"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "aux-id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
