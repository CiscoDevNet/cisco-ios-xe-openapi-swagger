  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "openconfig-packet-match-l2": {
        "type": "object",
        "properties": {
          "source-mac": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$",
            "description": "Source IEEE 802 MAC address."
          },
          "source-mac-mask": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$",
            "description": "Source IEEE 802 MAC address mask."
          },
          "destination-mac": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$",
            "description": "Destination IEEE 802 MAC address."
          },
          "destination-mac-mask": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$",
            "description": "Destination IEEE 802 MAC address mask."
          },
          "ethertype": {
            "type": "string",
            "description": "Ethertype field to match in Ethernet packets"
          },
          "config": {
            "type": "object",
            "properties": {
              "source-mac": {
                "type": "string",
