  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "openconfig-system-terminal-terminal-servers": {
        "type": "object",
        "properties": {
          "timeout": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "Set the idle timeout in seconds on terminal connections to\n        the system for the protocol."
          },
          "rate-limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "Set a limit on the number of connection attempts per\n        minute to the system for the protocol."
          },
          "session-limit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "Set a limit on the number of simultaneous active terminal\n        sessions to the system for the protocol (e.g., ssh,\n        telnet, ...)"
          },
          "config": {
            "type": "object",
            "properties": {
              "timeout": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535,
                "description": "Set the idle timeout in seconds on terminal connections to\n        the system for the protocol."
              },
              "rate-limit": {
                "type": "integer",
                "minimum": 0,
