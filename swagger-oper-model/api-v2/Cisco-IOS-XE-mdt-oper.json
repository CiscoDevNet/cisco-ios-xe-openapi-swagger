                      "maximum": 4294967295
                    },
                    "source-address": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "Cisco-IOS-XE-mdt-oper:mdt-connections": {
                    "transport": "example",
                    "peer-id": 1,
