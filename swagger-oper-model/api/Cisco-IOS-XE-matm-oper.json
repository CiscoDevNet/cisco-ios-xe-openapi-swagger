    "schemas": {
      "Cisco-IOS-XE-matm-oper-matm-oper-data": {
        "type": "object",
        "properties": {
          "mat-addr-type": {
            "type": "string",
            "description": "MAC address type associated with this MAC entry",
            "readOnly": true
          },
          "port": {
            "type": "string",
            "description": "Port associated with the MAC entry",
            "readOnly": true
          },
          "vlan-all": {
            "type": "object",
            "description": "Indicates all VLAN associated with this MAC entry",
            "readOnly": true
          },
          "table-type": {
            "type": "string",
            "description": "MATM table type",
            "readOnly": true
          },
          "vlan-id-number": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "MATM VLAN id",
            "readOnly": true
          },
          "mac": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$",
            "description": "MAC associated with the VLAN",
            "readOnly": true
          },
          "aging-time": {
            "type": "integer",
