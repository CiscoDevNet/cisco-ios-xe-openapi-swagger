    "schemas": {
      "Cisco-IOS-XE-ipv6-oper-ipv6-data": {
        "type": "object",
        "properties": {
          "vrf-name": {
            "type": "string",
            "description": "The Virtual Router and Forwarding instance that\n         this neighbor information is associated with",
            "readOnly": true
          },
          "if-name": {
            "type": "string",
            "description": "The Interface name.",
            "readOnly": true
          },
          "ip": {
            "type": "string",
            "description": "IPv6 address of this neighbor entry",
            "readOnly": true
          },
          "mac-address": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$",
            "description": "MAC address",
            "readOnly": true
          },
          "state": {
            "type": "string",
            "description": "State of the entry",
            "readOnly": true
          },
          "idle-timer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "Time before expiration, in seconds.",
            "readOnly": true
          },
          "uptime": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "Indicates how long this neighbor entry has\n         been active, in seconds",
            "readOnly": true
          }
        }
      },
