            "type": "string",
            "description": "Cloudwatch VRF",
            "readOnly": true
          },
          "cw-trace": {
            "type": "string",
            "description": "Cloudwatch trace level",
            "readOnly": true
          },
          "cw-region": {
            "type": "string",
            "description": "Cloudwatch region",
            "readOnly": true
          },
          "cw-profile-descr": {
            "type": "string",
            "description": "Cloudwatch profile description",
            "readOnly": true
          },
          "cw-shutdown": {
            "type": "boolean",
            "description": "Cloudwatch shutdown variable",
            "readOnly": true
          },
          "cw-proxy": {
            "type": "object",
            "properties": {
              "http-url": {
                "type": "string",
