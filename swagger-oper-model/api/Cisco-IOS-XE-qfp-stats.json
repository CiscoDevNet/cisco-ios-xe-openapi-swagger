{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco-IOS-XE-qfp-stats",
    "description": "This module contains a collection of YANG definitions for data plane statistics.\nCopyright (c) 2018-2024 by Cisco Systems, Inc.\nAll rights reserved.\n\nCisco IOS-XE operational state data (read-only).\n**Category:** Platform & Forwarding\n**Paths:** 1\n\n**YANG Model:** [Cisco-IOS-XE-qfp-stats.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Cisco-IOS-XE-qfp-stats.yang)\n\nProvides QFP (Memory Forwarding Processor) global drop statistics including packet/octet counters for various drop causes such as UIDB, encapsulation, tunnel, ACL, NAT, crypto, QoS, and many other forwarding-plane drop reasons. Contains 1,062 counter leaves across forwarding subsystems.",
    "version": "17.18.1",
    "x-yang-module": "Cisco-IOS-XE-qfp-stats",
    "x-model-type": "oper"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-qfp-stats:global-drop-statistics": {
      "get": {
        "summary": "Get QFP global drop statistics",
        "description": "Returns all QFP (Quantum Flow Processor) global drop statistics including packet and octet counters for every forwarding-plane drop cause. This provides deep visibility into data plane packet drops across all forwarding subsystems.\n\n**Common use cases:**\n- Monitor data plane health and identify packet loss causes\n- Troubleshoot forwarding issues (ACL drops, NAT failures, crypto errors)\n- Track QoS policer/shaper drops\n- Identify tunnel encap/decap failures\n- Monitor security-related drops (firewall, zone-based policy)\n\n**Note:** All counters are cumulative since last clear. Use periodic polling to calculate rates.",
        "operationId": "get-qfp-global-drop-statistics",
        "tags": [
          "Cisco-IOS-XE-qfp-stats"
        ],
        "responses": {
          "200": {
            "description": "QFP global drop statistics retrieved successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/global-drop-statistics"
                },
                "example": {
                  "Cisco-IOS-XE-qfp-stats:global-drop-statistics": {
                    "uidb-not-cfgd-pkts": 0,
                    "uidb-not-cfgd-octets": 0,
                    "bad-uidb-idx-pkts": 0,
                    "bad-uidb-idx-octets": 0,
                    "unknown-encap-pkts": 0,
                    "unknown-encap-octets": 0,
                    "ipv4-acl-deny-pkts": 1523,
                    "ipv4-acl-deny-octets": 152300,
                    "ipv6-acl-deny-pkts": 0,
                    "ipv6-acl-deny-octets": 0,
                    "nat-in2out-drops-pkts": 45,
                    "nat-in2out-drops-octets": 3600,
                    "qos-policer-drops-pkts": 892,
                    "qos-policer-drops-octets": 571488
                  }
                }
              }
            }
          },
          "404": {
            "description": "Resource not found — the target resource does not exist",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "security": [
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "Limit the depth of returned sub-tree data (RFC 8040 Section 4.8.2). Use 'unbounded' for full depth.",
            "schema": {
              "type": "string",
              "default": "unbounded"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Select specific fields to return (RFC 8040 Section 4.8.3). Example: fields=name;status",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "description": "Filter by config state: 'config' (config true only), 'nonconfig' (config false only), or 'all'.",
            "schema": {
              "type": "string",
              "enum": [
                "config",
                "nonconfig",
                "all"
              ],
              "default": "all"
            }
          }
        ]
      },
      "x-yang-path": "/global-drop-statistics",
      "x-restconf-kind": "container"
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "global-drop-statistics": {
        "type": "object",
        "description": "QFP global drop statistics container. Contains 1,062 counter leaves organized by forwarding subsystem. All counters are uint64 representing cumulative packet or octet counts since last clear.",
        "properties": {
          "uidb-not-cfgd-pkts": {
            "type": "integer",
            "format": "int64",
            "description": "Packets dropped - UIDB not configured"
          },
          "uidb-not-cfgd-octets": {
            "type": "integer",
            "format": "int64",
            "description": "Octets dropped - UIDB not configured"
          },
          "bad-uidb-idx-pkts": {
            "type": "integer",
            "format": "int64",
            "description": "Packets dropped - bad UIDB index"
          },
          "bad-uidb-idx-octets": {
            "type": "integer",
            "format": "int64",
            "description": "Octets dropped - bad UIDB index"
          },
          "unknown-encap-pkts": {
            "type": "integer",
            "format": "int64",
            "description": "Packets dropped - unknown encapsulation"
          },
          "unknown-encap-octets": {
            "type": "integer",
            "format": "int64",
            "description": "Octets dropped - unknown encapsulation"
          },
          "ipv4-acl-deny-pkts": {
            "type": "integer",
            "format": "int64",
            "description": "Packets dropped - IPv4 ACL deny"
          },
          "ipv4-acl-deny-octets": {
            "type": "integer",
            "format": "int64",
            "description": "Octets dropped - IPv4 ACL deny"
          },
          "ipv6-acl-deny-pkts": {
            "type": "integer",
            "format": "int64",
            "description": "Packets dropped - IPv6 ACL deny"
          },
          "ipv6-acl-deny-octets": {
            "type": "integer",
            "format": "int64",
            "description": "Octets dropped - IPv6 ACL deny"
          },
          "nat-in2out-drops-pkts": {
            "type": "integer",
            "format": "int64",
            "description": "Packets dropped - NAT inside-to-outside"
          },
          "nat-in2out-drops-octets": {
            "type": "integer",
            "format": "int64",
            "description": "Octets dropped - NAT inside-to-outside"
          },
          "qos-policer-drops-pkts": {
            "type": "integer",
            "format": "int64",
            "description": "Packets dropped - QoS policer"
          },
          "qos-policer-drops-octets": {
            "type": "integer",
            "format": "int64",
            "description": "Octets dropped - QoS policer"
          }
        }
      },
      "restconf-error": {
        "type": "object",
        "description": "Standard RESTCONF error response (RFC 8040 Section 7.1)",
        "properties": {
          "ietf-restconf:errors": {
            "type": "object",
            "properties": {
              "error": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "error-type": {
                      "type": "string",
                      "enum": [
                        "transport",
                        "rpc",
                        "protocol",
                        "application"
                      ],
                      "description": "Layer where the error occurred"
                    },
                    "error-tag": {
                      "type": "string",
                      "description": "Enumerated error tag (e.g. invalid-value, data-missing, access-denied)"
                    },
                    "error-severity": {
                      "type": "string",
                      "enum": [
                        "error",
                        "warning"
                      ],
                      "description": "Error severity"
                    },
                    "error-app-tag": {
                      "type": "string",
                      "description": "Application-specific error tag"
                    },
                    "error-path": {
                      "type": "string",
                      "description": "YANG instance-identifier of the error node"
                    },
                    "error-message": {
                      "type": "string",
                      "description": "Human-readable error description"
                    }
                  },
                  "required": [
                    "error-type",
                    "error-tag"
                  ]
                }
              }
            }
          }
        },
        "example": {
          "ietf-restconf:errors": {
            "error": [
              {
                "error-type": "protocol",
                "error-tag": "invalid-value",
                "error-severity": "error",
                "error-message": "Invalid input parameter"
              }
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Cisco-IOS-XE-qfp-stats",
      "description": "Operational state data for Cisco-IOS-XE-qfp-stats"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE YANG Operational Models - Cisco DevNet",
    "url": "https://developer.cisco.com/iosxe/"
  }
}
