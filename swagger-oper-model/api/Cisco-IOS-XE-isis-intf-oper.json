          "nbr-ipv6-addr": {
            "type": "string",
            "format": "ipv6",
            "description": "IPv6 Address of the neighbor"
          },
          "adj-state": {
            "type": "string",
            "description": "Current state of the adjacency"
          },
          "nbr-snpa": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$",
            "description": "ISIS Neighbor sub-network point of attachment"
          },
          "local-ext-ckt-id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "Local extended circuit ID"
          },
          "nbr-ext-ckt-id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "Neighbor extended circuit ID"
          },
          "pri": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "Priority of the neighboring IS"
          },
          "dis-system-id": {
            "type": "string",
            "description": "Designated intermediate system id"
          },
          "nbr-ckt-type": {
            "type": "string",
            "description": "Received ISIS circuit type"
          },
          "adj-type": {
            "type": "string",
            "description": "Formed ISIS adjacency type"
          },
          "up-time": {
            "type": "string",
            "description": "Time at which adjacency transitioned into UP state"
          },
          "restart-support": {
            "type": "boolean",
            "description": "When set to true, ISIS graceful restart is supported"
          },
          "restart-status": {
            "type": "boolean",
            "description": "When set to true, neighbor is being helped"
          },
          "multi-topo": {
            "type": "boolean",
            "description": "When set to true, ISIS multi-topology is supported"
          },
          "nlpid": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "Supported protocol, as per TLV 129"
            }
          },
          "topo": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295,
              "description": "List of ISIS multi-topology IDs supported\n             MT ID 0: Equivalent to the standard topology\n             MT ID 1: IPv4 in-band management purposes\n             MT ID 2: IPv6 routing topology\n             MT ID 3: IPv4 multicast routing topology\n             MT ID 4: IPv6 multicast routing topology\n             MT ID 5: IPv6 in-band management purposes\n             MT ID 6-3995: Reserved for IETF consensus"
            }
          },
          "area-addr": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "List of ISIS area addresses"
            }
          },
          "system-id": {
            "type": "string",
            "description": "System ID of the neighbor"
          },
          "level": {
            "type": "string",
            "description": "Level of the adjacency formed"
          },
          "tag": {
            "type": "string",
            "description": "IS-IS router tag"
          }
        }
      },
      "restconf-error": {
        "type": "object",
        "description": "Standard RESTCONF error response (RFC 8040 Section 7.1)",
        "properties": {
          "ietf-restconf:errors": {
            "type": "object",
            "properties": {
              "error": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "error-type": {
                      "type": "string",
                      "enum": [
                        "transport",
                        "rpc",
                        "protocol",
                        "application"
                      ],
                      "description": "Layer where the error occurred"
                    },
                    "error-tag": {
                      "type": "string",
                      "description": "Enumerated error tag (e.g. invalid-value, data-missing, access-denied)"
                    },
                    "error-severity": {
                      "type": "string",
                      "enum": [
                        "error",
                        "warning"
                      ],
                      "description": "Error severity"
                    },
                    "error-app-tag": {
                      "type": "string",
                      "description": "Application-specific error tag"
                    },
                    "error-path": {
                      "type": "string",
                      "description": "YANG instance-identifier of the error node"
                    },
                    "error-message": {
                      "type": "string",
                      "description": "Human-readable error description"
                    }
                  },
                  "required": [
                    "error-type",
                    "error-tag"
                  ]
                }
              }
            }
          }
        },
        "example": {
          "ietf-restconf:errors": {
            "error": [
              {
                "error-type": "protocol",
                "error-tag": "invalid-value",
                "error-severity": "error",
                "error-message": "Invalid input parameter"
              }
            ]
          }
        }
      }
    }
  },
