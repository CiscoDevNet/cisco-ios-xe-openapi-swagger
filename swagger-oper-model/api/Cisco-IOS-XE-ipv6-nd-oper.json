    "schemas": {
      "Cisco-IOS-XE-ipv6-nd-oper-ipv6-nd-oper-data": {
        "type": "object",
        "properties": {
          "v6addr": {
            "type": "string",
            "format": "ipv6",
            "description": "IPv6 address of this neighbor entry",
            "readOnly": true
          },
          "if-name": {
            "type": "string",
            "description": "Interface associated with this IPv6 Neighbor-Discovery entry",
            "readOnly": true
          },
          "mac-addr": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$",
            "description": "MAC address of this neighbor entry",
            "readOnly": true
          },
          "mode": {
            "type": "string",
            "description": "The mode that this entry is running in",
            "readOnly": true
          },
          "state": {
            "type": "string",
            "description": "Neighboring state of this entry",
            "readOnly": true
          },
          "update-time": {
            "type": "string",
            "description": "Update time of IPv6 Neighbour entry",
            "readOnly": true
          },
          "is-router": {
            "type": "boolean",
            "description": "The device is router or not",
            "readOnly": true
          },
          "ni-name": {
            "type": "string",
            "description": "Network Instance name that the IPv6 Neighbour table entries are tied to",
            "readOnly": true
          },
          "ni-type": {
            "type": "string",
            "description": "Network Instance type that the IPv6 Neighbour table entries are tied to",
