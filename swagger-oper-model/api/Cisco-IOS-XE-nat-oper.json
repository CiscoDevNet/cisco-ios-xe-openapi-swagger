  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "Cisco-IOS-XE-nat-oper-nat-data": {
        "type": "object",
        "properties": {
          "initialized": {
            "type": "boolean",
            "description": "Indicates if the NAT feature has been initialized"
          },
          "entries": {
            "type": "integer",
            "minimum": 0,
            "description": "Total translations"
          },
          "statics": {
            "type": "integer",
            "minimum": 0,
            "description": "Total static translations"
          },
          "flows": {
            "type": "integer",
            "minimum": 0,
            "description": "Total flows"
          },
          "insides": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of inside interfaces"
          },
          "outsides": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of outside interfaces"
          },
          "entry-timeouts": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of entries which timed out"
          },
          "hits": {
            "type": "integer",
            "minimum": 0,
            "description": "Successful searches with matching NAT session"
          },
          "misses": {
            "type": "integer",
            "minimum": 0,
            "description": "Unsuccessful searches without matching NAT session"
          },
          "interrupt-switched": {
            "type": "integer",
            "minimum": 0,
            "description": "Translated in interrupt switching"
          },
          "packets-punted": {
            "type": "integer",
            "minimum": 0,
            "description": "Packets punted to process"
          },
          "frag-pak-count": {
            "type": "integer",
            "minimum": 0,
            "description": "Counter for saved fragment packets"
          },
          "pool-stats-drop": {
            "type": "integer",
            "minimum": 0,
            "description": "Dropped pool stats from platform"
          },
          "mapping-stats-drop": {
            "type": "integer",
            "minimum": 0,
            "description": "Dropped mapping stats from platform"
          },
          "portlist-req-fail": {
            "type": "integer",
            "minimum": 0,
            "description": "Counter for port block allocation request failures"
          },
          "ipalias-add-fail": {
            "type": "integer",
            "minimum": 0,
            "description": "Counter for add IP alias fails drops"
          },
          "limit-entry-add-fail": {
            "type": "integer",
            "minimum": 0,
            "description": "Counter for add limit entry fails drops"
          },
          "in2out-drops": {
            "type": "integer",
            "minimum": 0,
            "description": "Counter for NAT inside->outside drops"
          },
          "out2in-drops": {
            "type": "integer",
            "minimum": 0,
            "description": "Counter for NAT outside->inside drops"
          },
          "mib-addr-binds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "MIB counter for address binds"
          },
          "mib-addport-binds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "MIB counter for address port binds"
          },
          "statics-sorted": {
            "type": "array",
