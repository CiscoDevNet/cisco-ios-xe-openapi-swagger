    "schemas": {
      "Cisco-IOS-XE-wireless-cts-sxp-oper-cts-sxp-oper-data": {
        "type": "object",
        "properties": {
          "wtp-mac": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$",
            "description": "SXP connection status for a specific AP MAC",
            "readOnly": true
          },
          "peer-ip": {
            "type": "string",
            "description": "SXP Connection peer IP",
            "readOnly": true
          },
          "conn-mode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "SXP Connection mode like SPEAKER, LISTENER\n         or BOTH.\n         A value of '1' indicates connection in 'Speaker'.\n         A value of '2' indicates connection in 'Listener'.\n         A value of '3' indicates connection in 'Bi-directional'.",
            "readOnly": true
          },
          "src-ip": {
            "type": "string",
            "description": "SXP Connection source IP",
            "readOnly": true
          },
          "nego-version": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "SXP Version running on the device\n         A value of '1' indicates connection in 'SXP 1.0'.\n         A value of '2' indicates connection in 'SXP 2.0'.\n         A value of '3' indicates connection in 'SXP 3.0'.\n         A value of '4' indicates connection in 'SXP 4.0'.",
            "readOnly": true
          },
          "conn-status": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "SXP connection status like ON, OFF or PENDING_ON\n         A value of '0' indicates connection in 'off' state.\n         A value of '1' indicates connection in 'pending on' state.\n         A value of '2' indicates connection in 'on' state.\n         A value of '3' indicates connection in 'delete hold down' state.\n         Otherwise it indicates connection in off state.",
            "readOnly": true
          },
          "password-type": {
            "type": "string",
            "description": "SXP Connection password type like default password\n         or None",
            "readOnly": true
          }
        }
      },
