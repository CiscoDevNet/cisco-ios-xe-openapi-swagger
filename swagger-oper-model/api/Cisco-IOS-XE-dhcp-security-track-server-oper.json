    "schemas": {
      "Cisco-IOS-XE-dhcp-security-track-server-oper-dhcp-security-track-server-oper-data": {
        "type": "object",
        "properties": {
          "ack-time": {
            "type": "string",
            "description": "Represents the time when this DHCP ACK was received.",
            "readOnly": true
          },
          "ip-address": {
            "type": "string",
            "description": "The client IP Address as specified in the YIADDR (your IP address) field\n         of DHCPACK/DHCPOFFER message.",
            "readOnly": true
          },
          "srv-id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "DHCP Server Identifier, this is assigned internally and remains\n         unique within the network-element.",
            "readOnly": true
          },
          "last-updated-time": {
            "type": "string",
            "description": "Represents the time when device received last DHCPACK or DHCPOFFER message\n         from this server.",
            "readOnly": true
          },
          "num-of-acks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "Total number of DHCPACK messages received from this server.",
            "readOnly": true
          },
          "num-of-offers": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "Total number of DHCPOFFER messages received from this server.",
            "readOnly": true
          },
          "if-name": {
            "type": "string",
            "description": "Represents the name of the interface this server was discovered on.",
            "readOnly": true
          },
          "subnet-mask": {
            "type": "string",
            "description": "DHCP Server subnet mask.",
            "readOnly": true
          },
          "relay-agent-ip": {
            "type": "string",
            "description": "DHCP relay agent IP address.",
            "readOnly": true
          },
          "dhcp-msg": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255,
              "description": "Last DHCP message in network byte order as received over the wire."
            },
            "readOnly": true
          },
          "vlan": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "VLAN the DHCP server was discovered on.",
            "readOnly": true
          },
          "ip": {
            "type": "string",
            "description": "IP Address of the DHCP server, it is (a) the server identifier in\n         the DHCP option of the packet or if that is empty it is (b) the server\n         IP address field in the packet or if that is also empty it is (c) the\n         source IP in the packet.",
            "readOnly": true
          },
          "hwaddr": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$",
            "description": "MAC Address of the DHCP server. This is really the\n         source MAC of L2 adjacent endpoint, and it might not be actual server.\n         It might happen that the same DHCP server is responding via different\n         adjacent endpoints.",
            "readOnly": true
          },
          "subnet-ip": {
            "type": "string",
            "description": "Subnet IP based on offered/acknowledged client IP address and Subnet Mask",
            "readOnly": true
          }
        }
      },
