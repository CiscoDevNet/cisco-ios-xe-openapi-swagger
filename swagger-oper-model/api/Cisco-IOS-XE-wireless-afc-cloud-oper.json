    "schemas": {
      "Cisco-IOS-XE-wireless-afc-cloud-oper-afc-cloud-oper-data": {
        "type": "object",
        "properties": {
          "request-id": {
            "type": "integer",
            "minimum": 0,
            "description": "Request ID"
          },
          "ap-mac": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$",
            "description": "AP MAC address"
          },
          "msg-timestamp": {
            "type": "string",
            "description": "Timestamp"
          },
          "num-afc-ap": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "Number of APs requiring AFC service"
          },
          "afc-msg-sent": {
            "type": "integer",
            "minimum": 0,
            "description": "Messages sent to AFC"
          },
          "afc-msg-rcvd": {
            "type": "integer",
            "minimum": 0,
            "description": "Successful messages received from AFC"
          },
          "afc-msg-err": {
            "type": "integer",
            "minimum": 0,
            "description": "Errored AFC messages"
          },
          "afc-msg-pending": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "Pending AFC messages"
          },
          "min-msg-rtt": {
            "type": "integer",
            "minimum": 0,
            "description": "Minimum response time"
          },
          "max-msg-rtt": {
            "type": "integer",
            "minimum": 0,
            "description": "Maximum response time"
          },
          "avg-rtt": {
            "type": "integer",
            "minimum": 0,
            "description": "Average response time"
          },
          "num-6ghz-ap": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "Number of APs with 6GHz radio"
          },
          "last-msg-sent": {
            "type": "object",
            "properties": {
              "request-id": {
                "type": "integer",
                "minimum": 0,
                "description": "Request ID"
              },
              "ap-mac": {
                "type": "string",
                "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$",
                "description": "AP MAC address"
              },
              "msg-timestamp": {
                "type": "string",
                "description": "Timestamp"
              }
            },
            "description": "Last inquired channel message sent"
          },
          "last-msg-rcvd": {
            "type": "object",
            "properties": {
              "request-id": {
                "type": "integer",
                "minimum": 0,
                "description": "Request ID"
              },
              "ap-mac": {
                "type": "string",
                "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$",
                "description": "AP MAC address"
              },
              "msg-timestamp": {
                "type": "string",
                "description": "Timestamp"
              }
            },
            "description": "Last inquired channel message received"
          },
          "healthcheck": {
            "type": "object",
            "description": "AFC cloud health check"
          },
          "afc-cloud-stats": {
