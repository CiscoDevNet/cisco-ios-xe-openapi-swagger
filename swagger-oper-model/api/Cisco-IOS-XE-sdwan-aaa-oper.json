      "Cisco-IOS-XE-sdwan-aaa-oper-sdwan-aaa-oper-data": {
        "type": "object",
        "properties": {
          "active-sessions": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of active config-transaction sessions"
          },
          "cmds-authorized": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of config-transaction commands that went through authorization"
          },
          "cmds-authorized-success": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of config-transaction commands that were successfully authorized"
          },
          "cmds-authorized-failure": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of config-transaction commands that failed to get authorized"
          },
          "cmds-accounted": {
            "type": "integer",
            "minimum": 0,
            "description": "The number of config-transaction commands that were accounted"
          },
