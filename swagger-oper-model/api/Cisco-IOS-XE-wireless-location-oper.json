      "Cisco-IOS-XE-wireless-location-oper-location-oper-data": {
        "type": "object",
        "properties": {
          "client-mac-addr": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$",
            "description": "Wireless client MAC address"
          },
          "lrad-addr": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$",
            "description": "AP MAC address which heard the client"
          },
          "rssi-value-a": {
            "type": "integer",
            "minimum": -128,
            "maximum": 127,
            "description": "RSSI value of antenna A"
          },
          "rssi-value-b": {
            "type": "integer",
            "minimum": -128,
            "maximum": 127,
