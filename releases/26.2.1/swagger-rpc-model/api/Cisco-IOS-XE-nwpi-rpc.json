{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco-IOS-XE-nwpi-rpc - RPC Operations",
    "description": "This module contains a collection of YANG definitions for\n     network wide path insight RPC.\n     Copyright (c) 2020-2026 by Cisco Systems, Inc.\n     All rights reserved.\n\n**Module:** `Cisco-IOS-XE-nwpi-rpc`\n**Version:** 2026-08-01\n**Operations:** 3",
    "version": "2026-08-01"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/nwpi_rpc:device-nwpi": {
      "post": {
        "summary": "Device network wide path insight RPC",
        "description": "Device network wide path insight RPC\n\n**Endpoint:** `POST /restconf/operations/nwpi_rpc:device-nwpi`",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-nwpi-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nwpi_rpc:device-nwpi": {
                    "type": "object",
                    "properties": {
                      "trace-id": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535,
                        "description": "Global unique trace identifier",
                        "example": 1
                      },
                      "action": {
                        "type": "string",
                        "description": "Specifies the action to perform on the trace, such as start, stop, or clean.",
                        "example": "configured-value"
                      },
                      "target": {
                        "type": "string",
                        "description": "Specifies the type of target for the trace action, such as VPN, VRF, or interface.",
                        "example": "configured-value"
                      },
                      "vpn-id": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 65531,
                        "description": "SD-WAN VPN identifier",
                        "example": 1
                      },
                      "vrf-name": {
                        "type": "string",
                        "description": "Name of the VRF (Virtual Routing and Forwarding instance) targeted by the trace action.",
                        "example": "default"
                      },
                      "src-ip": {
                        "type": "string",
                        "description": "Source IP to filter",
                        "example": "10.1.1.1"
                      },
                      "dst-ip": {
                        "type": "string",
                        "description": "Specifies the destination IP address used as a filter criterion for network path insight trace operations.",
                        "example": "10.1.1.1"
                      },
                      "app": {
                        "type": "string",
                        "description": "Specifies the application name or identifier used as a filter criterion in network path insight trace operations.",
                        "example": "configured-value"
                      },
                      "src-if": {
                        "type": "string",
                        "description": "Specifies the source network interface used as a filter criterion for network path insight trace operations.",
                        "example": "configured-value"
                      },
                      "protocol": {
                        "type": "string",
                        "description": "IP protocol field in IP header to filter",
                        "example": "tcp"
                      },
                      "src-port": {
                        "type": "string",
                        "description": "Specifies the source port number used as a filter criterion for network path insight trace operations.",
                        "example": "443"
                      },
                      "dst-port": {
                        "type": "string",
                        "description": "Specifies the destination port number used as a filter criterion for network path insight trace operations.",
                        "example": "443"
                      },
                      "dscp-is-valid": {
                        "type": "string",
                        "description": "Indicates whether a DSCP filter is configured.",
                        "example": "1"
                      },
                      "dscp": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 63,
                        "description": "Specifies the DSCP (Differentiated Services Code Point) value used as a filter criterion for network path insight trace operations.",
                        "example": 46
                      },
                      "duration": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535,
                        "description": "Option to change default trace duration of 60 minutes.\n         The duration value is in minutes and in range between\n         1 and 65535 minutes. A trace will auto stop if specified\n         duration expired. If duration not specified and user didn't\n         issue on-demand stop action, the trace will auto stop in\n         60 minutes",
                        "example": 300
                      },
                      "src-pfx": {
                        "type": "string",
                        "description": "Specifies the source IP prefix used as a filter criterion for network path insight trace operations.",
                        "example": "configured-value"
                      },
                      "src-pfx-len": {
                        "type": "string",
                        "description": "Specifies the length, in bits, of the source IP prefix used to filter network path traces.",
                        "example": "configured-value"
                      },
                      "dst-pfx": {
                        "type": "string",
                        "description": "Specifies the destination IP address prefix used to filter network path traces.",
                        "example": "configured-value"
                      },
                      "dst-pfx-len": {
                        "type": "string",
                        "description": "Specifies the length, in bits, of the destination IP prefix used to filter network path traces.",
                        "example": "configured-value"
                      },
                      "app-grp": {
                        "type": "string",
                        "description": "Specifies the application group, as defined by vendor classification, used to filter network path traces.",
                        "example": "configured-value"
                      },
                      "domain-mon": {
                        "type": "string",
                        "description": "Enable domain monitor",
                        "example": "configured-value"
                      },
                      "art-vis": {
                        "type": "string",
                        "description": "Enable ART visibility",
                        "example": "configured-value"
                      },
                      "app-vis": {
                        "type": "string",
                        "description": "Enable application visibility",
                        "example": "configured-value"
                      },
                      "dia-vis": {
                        "type": "string",
                        "description": "Enable direct internet access visibility",
                        "example": "configured-value"
                      },
                      "hub-wan-vis": {
                        "type": "string",
                        "description": "Enable HUB WAN ingress visibility",
                        "example": "configured-value"
                      },
                      "sampling": {
                        "type": "string",
                        "description": "Enable trace flow sampling",
                        "example": "configured-value"
                      },
                      "spl-intvl": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 86400000,
                        "description": "Option to change default trace flow sample interval of\n         60000 milliseconds. The sample interval value is in milliseconds\n         and in range between 1 and 86400000 milliseconds. Only one flow\n         will be traced within a given interval",
                        "example": 1
                      },
                      "qos-mon": {
                        "type": "string",
                        "description": "Indicates whether QoS monitoring is enabled for the trace",
                        "example": "configured-value"
                      },
                      "model": {
                        "type": "string",
                        "description": "Trace model, different trace models have different behaviors\n         and separate trace identifier space. Combination of trace model\n         and trace identifier can uniquely identify a trace.",
                        "example": "C9300-48P"
                      },
                      "agg-client-prefix": {
                        "type": "string",
                        "description": "Enable client prefix as a grouping factor in flexible aggregation",
                        "example": "10.0.0.0/24"
                      },
                      "agg-svr-prefix": {
                        "type": "string",
                        "description": "Enable server prefix as a grouping factor in flexible aggregation",
                        "example": "10.0.0.0/24"
                      },
                      "agg-src-sgt": {
                        "type": "string",
                        "description": "Enable source SGT as a grouping factor in flexible aggregation",
                        "example": "configured-value"
                      },
                      "agg-dst-sgt": {
                        "type": "string",
                        "description": "Enable destination SGT as a grouping factor in flexible aggregation",
                        "example": "configured-value"
                      },
                      "username": {
                        "type": "string",
                        "description": "Username classified by Cisco identity service engine to filter traffic",
                        "example": "admin"
                      },
                      "user-grp": {
                        "type": "string",
                        "description": "User group classified by Cisco identity service engine to filter traffic",
                        "example": "configured-value"
                      },
                      "src-sgt": {
                        "type": "string",
                        "description": "Source security group tag to filter traffic",
                        "example": "configured-value"
                      },
                      "dst-sgt": {
                        "type": "string",
                        "description": "Security Group Tag (SGT) assigned to the destination, used for traffic filtering or classification.",
                        "example": "configured-value"
                      },
                      "flow-mon": {
                        "type": "string",
                        "description": "Enable flow monitor to collect statistics of per application TCP and UDP flow count,\n         flow setup rate, and average flow living time.",
                        "example": "configured-value"
                      },
                      "pol-mon": {
                        "type": "string",
                        "description": "Enable SD-WAN policy monitor to collect statistics of per application\n         policy sequence match rate.",
                        "example": "configured-value"
                      },
                      "full-vis": {
                        "type": "string",
                        "description": "Enable full traffic visibility to process flexible aggregation on all traffic flows,\n         flexible aggregation only process sampled flows when this option disabled.",
                        "example": "configured-value"
                      },
                      "agg-user-name": {
                        "type": "string",
                        "description": "Enable username as a grouping factor in flexible aggregation",
                        "example": "example-1"
                      },
                      "te-mon": {
                        "type": "string",
                        "description": "Enable ThousandEyes agent monitor to collect statistics of ThousandEyes synthetic\n         probes.",
                        "example": "configured-value"
                      },
                      "enable-cmd-header": {
                        "type": "string",
                        "description": "Indicates whether the CMD (Control Message Data) header is enabled for SD-Routing in this trace.",
                        "example": "configured-value"
                      },
                      "qos-congest-dur": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 65535,
                        "description": "Duration of QoS congestion to raise an alarm",
                        "example": 1
                      },
                      "ar-drop-rate": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100,
                        "description": "Anti-replay drop rate on SD-WAN session",
                        "example": 0
                      },
                      "wan-loss-rate": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 100,
                        "description": "WAN loss rate on SD-WAN session",
                        "example": 128000
                      },
                      "vpn-list": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "description": "List of SD-WAN VPN identifiers associated with this trace.",
                          "example": "configured-value"
                        },
                        "example": "item-1"
                      },
                      "trnspt-if-name": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "description": "List of transport interface names used for forwarding or monitoring traffic in this trace.",
                          "example": "configured-value"
                        },
                        "example": "example-1"
                      },
                      "te-agent": {
                        "type": "object",
                        "description": "Container for ThousandEyes agent IP addresses used to filter monitored network traffic for this trace instance.",
                        "example": "configured-value"
                      }
                    },
                    "required": [
                      "trace-id",
                      "action",
                      "target",
                      "vpn-id",
                      "vrf-name",
                      "dscp"
                    ],
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "nwpi_rpc:device-nwpi": {
                  "trace-id": 10,
                  "action": "configured-value",
                  "target": "GigabitEthernet1/0/1",
                  "vpn-id": 10,
                  "vrf-name": "Mgmt-vrf",
                  "src-ip": "10.1.1.1",
                  "dst-ip": "192.168.1.1",
                  "app": "configured-value",
                  "src-if": "GigabitEthernet1/0/1",
                  "protocol": "tcp",
                  "src-port": "443",
                  "dst-port": "443",
                  "dscp-is-valid": "1",
                  "dscp": 10,
                  "duration": 10,
                  "src-pfx": "192.168.1.0/24",
                  "src-pfx-len": "192.168.1.0/24",
                  "dst-pfx": "192.168.1.1",
                  "dst-pfx-len": "192.168.1.0/24",
                  "app-grp": "configured-value",
                  "domain-mon": "configured-value",
                  "art-vis": "configured-value",
                  "app-vis": "configured-value",
                  "dia-vis": "configured-value",
                  "hub-wan-vis": "configured-value",
                  "sampling": "configured-value",
                  "spl-intvl": 10,
                  "qos-mon": "configured-value",
                  "model": "C9300-48P",
                  "agg-client-prefix": "192.168.1.0/24",
                  "agg-svr-prefix": "192.168.1.0/24",
                  "agg-src-sgt": "configured-value",
                  "agg-dst-sgt": "configured-value",
                  "username": "admin",
                  "user-grp": "admin",
                  "src-sgt": "configured-value",
                  "dst-sgt": "configured-value",
                  "flow-mon": "configured-value",
                  "pol-mon": "configured-value",
                  "full-vis": "configured-value",
                  "agg-user-name": "admin",
                  "te-mon": "configured-value",
                  "enable-cmd-header": "configured-value",
                  "qos-congest-dur": 10,
                  "ar-drop-rate": 10,
                  "wan-loss-rate": 10,
                  "vpn-list": [
                    "example-string"
                  ],
                  "trnspt-if-name": [
                    "GigabitEthernet1/0/1"
                  ],
                  "te-agent": [
                    null
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "nwpi_rpc:device-nwpi": {
                      "type": "object",
                      "example": "configured-value"
                    }
                  }
                },
                "example": {
                  "nwpi_rpc:device-nwpi": {}
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/operations/nwpi_rpc:device-pcap-replay": {
      "post": {
        "summary": "Device PCAP replay RPC for starting/stopping PCAP replay",
        "description": "Device PCAP replay RPC for starting/stopping PCAP replay\n\n**Endpoint:** `POST /restconf/operations/nwpi_rpc:device-pcap-replay`",
        "operationId": "post-root-3",
        "tags": [
          "Cisco-IOS-XE-nwpi-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nwpi_rpc:device-pcap-replay": {
                    "type": "object",
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "nwpi_rpc:device-pcap-replay": {
                  "nwpi_rpc:device-pcap-replay": [
                    null
                  ]
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "nwpi_rpc:device-pcap-replay": {
                      "type": "object",
                      "example": "configured-value"
                    }
                  }
                },
                "example": {
                  "nwpi_rpc:device-pcap-replay": {}
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/operations/nwpi_rpc:device-nwpi-global": {
      "post": {
        "summary": "Device network wide path insight global control RPC",
        "description": "Device network wide path insight global control RPC\n\n**Endpoint:** `POST /restconf/operations/nwpi_rpc:device-nwpi-global`",
        "operationId": "post-root-2",
        "tags": [
          "Cisco-IOS-XE-nwpi-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nwpi_rpc:device-nwpi-global": {
                    "type": "object",
                    "properties": {
                      "control": {
                        "type": "string",
                        "description": "Global enable/disable control",
                        "example": "configured-value"
                      }
                    },
                    "required": [
                      "control"
                    ],
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "nwpi_rpc:device-nwpi-global": {
                  "control": "configured-value"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "nwpi_rpc:device-nwpi-global": {
                      "type": "object",
                      "example": "configured-value"
                    }
                  }
                },
                "example": {
                  "nwpi_rpc:device-nwpi-global": {}
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
