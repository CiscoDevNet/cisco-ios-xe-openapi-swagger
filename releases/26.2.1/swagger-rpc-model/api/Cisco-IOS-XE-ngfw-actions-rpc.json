    "/operations/ngfw_actions_rpc:ngfw-upd-file": {
      "post": {
        "summary": "Next-Generation Firewall (NGFW) update file action RPC.",
        "description": "Next-Generation Firewall (NGFW) update file action RPC.\n\n**Endpoint:** `POST /restconf/operations/ngfw_actions_rpc:ngfw-upd-file`",
        "operationId": "post-root-6",
        "tags": [
          "Cisco-IOS-XE-ngfw-actions-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ngfw_actions_rpc:ngfw-upd-file": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "description": "Specifies the Next-Generation Firewall (NGFW) update type, either LSP or VDB.",
                        "example": "default"
                      },
                      "file-name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255,
                        "pattern": "(bootflash:|flash:|harddisk:)[-A-Za-z_.0-9/]*",
                        "description": "Next-Generation Firewall (NGFW) file name",
                        "example": "example-1"
                      }
                    },
                    "required": [
                      "type",
                      "file-name"
                    ],
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "ngfw_actions_rpc:ngfw-upd-file": {
                  "type": "default",
                  "file-name": "flash:/config.txt"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ngfw_actions_rpc:ngfw-upd-file": {
                      "type": "object",
                      "example": "configured-value"
                    }
                  }
                },
                "example": {
                  "ngfw_actions_rpc:ngfw-upd-file": {}
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/operations/ngfw_actions_rpc:ngfw-cust-sig-apply": {
      "post": {
        "summary": "Applies a custom-signature file to an NGFW profile.",
        "description": "Applies a custom-signature file to an NGFW profile.\n\n**Endpoint:** `POST /restconf/operations/ngfw_actions_rpc:ngfw-cust-sig-apply`",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-ngfw-actions-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ngfw_actions_rpc:ngfw-cust-sig-apply": {
                    "type": "object",
                    "properties": {
                      "profile-name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "[-A-Za-z_0-9]+",
                        "description": "Specifies the NGFW custom-signature profile name used by the RPC.",
                        "example": "example-1"
                      },
                      "file-name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "((boot)?flash|harddisk):[/A-Za-z0-9_-]+\\.(rules|txt)",
                        "description": "Specifies the path to the custom-signature file used by the RPC.",
                        "example": "example-1"
                      }
                    },
                    "required": [
                      "profile-name"
                    ],
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "ngfw_actions_rpc:ngfw-cust-sig-apply": {
                  "profile-name": "flash:/config.txt",
                  "file-name": "flash:/config.txt"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ngfw_actions_rpc:ngfw-cust-sig-apply": {
                      "type": "object",
                      "example": "configured-value"
                    }
                  }
                },
                "example": {
                  "ngfw_actions_rpc:ngfw-cust-sig-apply": {}
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
