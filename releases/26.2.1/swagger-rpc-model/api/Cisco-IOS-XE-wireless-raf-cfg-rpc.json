  "paths": {
    "/operations/wireless_raf_cfg_rpc:set-raf-name": {
      "post": {
        "summary": "Configures regulatory activation file name",
        "description": "Configures regulatory activation file name\n\n**Endpoint:** `POST /restconf/operations/wireless_raf_cfg_rpc:set-raf-name`",
        "operationId": "post-root-4",
        "tags": [
          "Cisco-IOS-XE-wireless-raf-cfg-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "wireless_raf_cfg_rpc:set-raf-name": {
                    "type": "object",
                    "properties": {
                      "file-name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "[!-~]+",
                        "description": "Name of the regulatory activation file to configure",
                        "example": "example-1"
                      }
                    },
                    "required": [
                      "file-name"
                    ],
                    "example": "example-1"
                  }
                },
                "example": "example-1"
              },
              "example": {
                "wireless_raf_cfg_rpc:set-raf-name": {
                  "file-name": "flash:/config.txt"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "wireless_raf_cfg_rpc:set-raf-name": {
                      "type": "object",
                      "example": "example-1"
                    }
                  }
                },
                "example": {
                  "wireless_raf_cfg_rpc:set-raf-name": {}
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
