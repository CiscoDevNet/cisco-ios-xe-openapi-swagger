{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco-IOS-XE-cts-rpc - RPC Operations",
    "description": "NED CTS RPC YANG module for IOS\n     Copyright (c) 2016-2019 by Cisco Systems, Inc.\n     All rights reserved.\n\n**Module:** `Cisco-IOS-XE-cts-rpc`\n**Version:** 2026-08-01\n**Operations:** 1",
    "version": "2026-08-01"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/cts_rpc:cts": {
      "post": {
        "summary": "Cisco Trusted Security Exec Commands",
        "description": "Cisco Trusted Security Exec Commands\n\n**Endpoint:** `POST /restconf/operations/cts_rpc:cts`",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-cts-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cts_rpc:cts": {
                    "type": "object",
                    "properties": {
                      "credentials": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 32,
                            "description": "Specify the CTS device ID for this switch or router(upto 32 char)",
                            "example": "1"
                          },
                          "password": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 24,
                            "description": "specify this device's CTS password(upto 24 char)",
                            "example": "***"
                          }
                        },
                        "description": "Insert CTS device ID and password into the keystore",
                        "example": "configured-value"
                      },
                      "refresh": {
                        "type": "object",
                        "properties": {
                          "environment-data": {
                            "type": "string",
                            "description": "Refresh Environment Data",
                            "example": "configured-value"
                          },
                          "pac": {
                            "type": "string",
                            "description": "Trigger PAC refresh",
                            "example": "configured-value"
                          },
                          "policy": {
                            "type": "object",
                            "properties": {
                              "sgt": {
                                "type": "object",
                                "properties": {
                                  "sgt-drop-node-name": {
                                    "type": "integer",
                                    "minimum": 2,
                                    "maximum": 65521,
                                    "description": "SGT to trigger an immediate policy refresh for",
                                    "example": 0
                                  },
                                  "default": {
                                    "type": "string",
                                    "description": "refresh default policy",
                                    "example": "configured-value"
                                  },
                                  "unknown": {
                                    "type": "string",
                                    "description": "refresh unknown policy",
                                    "example": "configured-value"
                                  }
                                },
                                "description": "SGT policy refresh",
                                "x-yang-choices": [
                                  {
                                    "name": "sgt-choice",
                                    "mandatory": false,
                                    "cases": [
                                      {
                                        "name": "sgt-number-case",
                                        "properties": [
                                          "sgt-drop-node-name"
                                        ]
                                      },
                                      {
                                        "name": "default-case",
                                        "properties": [
                                          "default"
                                        ]
                                      },
                                      {
                                        "name": "unknown-case",
                                        "properties": [
                                          "unknown"
                                        ]
                                      }
                                    ]
                                  }
                                ],
                                "example": "configured-value"
                              }
                            },
                            "description": "Refresh all peer and Role-Based Access Control List policies",
                            "example": "configured-value"
                          }
                        },
                        "description": "Refresh CTS data",
                        "x-yang-choices": [
                          {
                            "name": "refresh-choice",
                            "mandatory": false,
                            "cases": [
                              {
                                "name": "environment-data-case",
                                "properties": [
                                  "environment-data"
                                ]
                              },
                              {
                                "name": "pac-case",
                                "properties": [
                                  "pac"
                                ]
                              },
                              {
                                "name": "policy-case",
                                "properties": [
                                  "policy"
                                ]
                              }
                            ]
                          }
                        ],
                        "example": "configured-value"
                      }
                    },
                    "description": " (presence container)",
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "cts_rpc:cts": {
                  "credentials": {
                    "id": "1",
                    "password": "Cisco123!"
                  },
                  "refresh": {
                    "environment-data": "configured-value",
                    "pac": "configured-value",
                    "policy": {
                      "sgt": {
                        "sgt-drop-node-name": 10,
                        "default": "configured-value",
                        "unknown": "configured-value"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cts_rpc:cts": {
                      "type": "object",
                      "example": "configured-value"
                    }
                  }
                },
                "example": {
                  "cts_rpc:cts": {}
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ]
}
