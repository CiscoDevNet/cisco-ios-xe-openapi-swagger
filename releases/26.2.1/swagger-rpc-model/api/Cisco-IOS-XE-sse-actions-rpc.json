    "/operations/sse_actions_rpc:set-sse-root-ca-bdl-upd": {
      "post": {
        "summary": "Updates the Secure Service Edge (SSE) Root CA bundle on the device using the specified bundle file path and SHA-256 digest; returns the operation status and, on failure, a reason code and optional detail message",
        "description": "Updates the Secure Service Edge (SSE) Root CA bundle on the device using the specified bundle file path and SHA-256 digest; returns the operation status and, on failure, a reason code and optional detail message\n\n**Endpoint:** `POST /restconf/operations/sse_actions_rpc:set-sse-root-ca-bdl-upd`",
        "operationId": "post-root-3",
        "tags": [
          "Cisco-IOS-XE-sse-actions-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sse_actions_rpc:set-sse-root-ca-bdl-upd": {
                    "type": "object",
                    "properties": {
                      "sse-root-ca-bdl-path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255,
                        "pattern": "/[A-Za-z0-9/+_=.:-]+",
                        "description": "Absolute path to the Secure Service Edge (SSE) Root Certificate Authority (CA) bundle on the device",
                        "example": "/data/example"
                      },
                      "sse-root-ca-bdl-sha256": {
                        "type": "string",
                        "description": "SHA-256 digest of the Secure Service Edge (SSE) Root Certificate Authority (CA) bundle file",
                        "example": "configured-value"
                      }
                    },
                    "required": [
                      "sse-root-ca-bdl-path",
                      "sse-root-ca-bdl-sha256"
                    ],
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "sse_actions_rpc:set-sse-root-ca-bdl-upd": {
                  "sse-root-ca-bdl-path": "flash:/config.txt",
                  "sse-root-ca-bdl-sha256": "configured-value"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sse_actions_rpc:set-sse-root-ca-bdl-upd": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "description": "Status of the Root Certificate Authority (CA) bundle update operation",
                          "example": "active"
                        },
                        "reason": {
                          "type": "string",
                          "description": "Failure reason when the Root Certificate Authority (CA) bundle update fails",
                          "example": "administrative"
                        },
                        "detail": {
                          "type": "string",
                          "description": "Human-readable message providing additional context about the outcome of the Root CA bundle update operation; may be empty if no additional detail is available",
                          "example": "configured-value"
                        }
                      },
                      "example": "configured-value"
                    }
                  }
                },
                "example": {
                  "sse_actions_rpc:set-sse-root-ca-bdl-upd": {
                    "status": "active",
                    "reason": "administrative",
                    "detail": "configured-value"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
