          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/ngfw_ctrl_actions_rpc:ngfw-upd": {
      "post": {
        "summary": "NGFW periodic update action (controller-initiated)",
        "description": "NGFW periodic update action (controller-initiated)\n\n**Endpoint:** `POST /restconf/operations/ngfw_ctrl_actions_rpc:ngfw-upd`",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-ngfw-ctrl-actions-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ngfw_ctrl_actions_rpc:ngfw-upd": {
                    "type": "object",
                    "properties": {
                      "json": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 8192,
                        "pattern": ".*",
                        "description": "Metadata containing NGFW update package information.\n         Includes package paths, protocols, and authentication credentials.",
                        "example": "configured-value"
                      },
                      "dwnld-timeout": {
                        "type": "string",
                        "description": "Download timeout, in minutes (default: 5)",
                        "example": "10:30:45"
                      }
                    },
                    "required": [
                      "json",
                      "dwnld-timeout"
                    ],
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "ngfw_ctrl_actions_rpc:ngfw-upd": {
                  "json": "configured-value",
                  "dwnld-timeout": "10:30:45"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ngfw_ctrl_actions_rpc:ngfw-upd": {
                      "type": "object",
                      "properties": {
                        "resp-msg": {
                          "type": "string",
                          "description": "Response message indicating success or failure details",
                          "example": "configured-value"
                        }
                      },
                      "example": "configured-value"
                    }
                  }
                },
                "example": {
                  "ngfw_ctrl_actions_rpc:ngfw-upd": {
                    "resp-msg": "configured-value"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
