    "schemas": {
      "Cisco-IOS-XE-stack-info-oper-stack-info-oper-data": {
        "type": "object",
        "properties": {
          "if-name": {
            "type": "string",
            "description": "Represents the stack port interface name"
          },
          "mac-addr": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$",
            "description": "The hardware address of each individual switch in the stack"
          },
          "num-links": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "Number of physical links aggregated in the stack"
          },
          "port-state": {
            "type": "string",
            "description": "The status of stack ports connecting switches"
          },
          "cable-length-cm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "Stack cable length in centimetres"
          },
          "nbr-switch-num": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "Neighbor switch number connected to this port"
          },
          "nbr-port-num": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "Neighbor port number"
          },
          "presence": {
            "type": "string",
            "description": "The stack cable presence status"
          },
          "cable-auth-status": {
            "type": "string",
            "description": "The stack cable authentication status"
          },
          "cable-serial-num": {
            "type": "string",
            "description": "Serial number of the stack cable"
          },
          "port-in-loopback": {
            "type": "boolean",
            "description": "Boolean indicating if port is in loopback mode"
          },
          "node-num": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "Represents the node number within the stack"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255,
            "description": "The priority value assigned to each switch, influencing active switch election"
          },
          "stack-mode": {
            "type": "string",
            "description": "Represents stack mode of the switch"
          },
          "serial-number": {
            "type": "string",
            "description": "Represents the switch serial number"
          },
          "role": {
            "type": "string",
            "description": "The role of the switch in the stack, such as Active, Standby, or Member"
          },
          "node-state": {
            "type": "string",
