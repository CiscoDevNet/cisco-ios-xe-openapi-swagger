              },
              "matm-secure-flg": {
                "type": "boolean",
                "description": "Secure MAC address flag.\n         Indicates the MAC address entry is secured statically\n         on a specific port"
              }
            },
            "description": "MAC address info associated with this MAC entry"
          },
          "phys-ports": {
            "type": "object",
            "properties": {
              "port": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "List of physical ports associated with the MAC entry"
                }
              }
            },
            "description": "Physical port list"
          },
          "vlan-id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "VLAN id associated with MAC entry"
          },
          "mac": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$",
            "description": "MAC associated with the VLAN"
