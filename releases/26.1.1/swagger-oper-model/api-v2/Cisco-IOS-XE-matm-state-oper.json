        "type": "object",
        "properties": {
          "matm-addr-type": {
            "type": "string",
            "description": "The address type associated with this MAC entry.\n         Indicates whether the MAC address is configured\n         statically or learned dynamically"
          },
          "matm-secure-flg": {
            "type": "boolean",
            "description": "Secure MAC address flag.\n         Indicates the MAC address entry is secured statically\n         on a specific port"
          },
          "port": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "List of physical ports associated with the MAC entry"
            }
          },
          "drop": {
            "type": "object",
            "description": "Drop port"
          },
          "svi-port": {
            "type": "string",
            "description": "SVI port"
          },
          "mac-addr-info": {
            "type": "object",
            "properties": {
              "matm-addr-type": {
                "type": "string",
