            "minimum": 0,
            "maximum": 65535,
            "description": "Vlan assigned to the port"
          },
          "port-proto": {
            "type": "string",
            "description": "Protocol used to discover the IAD device.\n          Can be: CDP, LLDP, PROFINET, CIP, IPDT, MODBUS\n          or a combination, as two protocol discover the device"
          },
          "serial-no": {
            "type": "string",
            "description": "Serial number of the discovered device"
          },
          "sw-version": {
