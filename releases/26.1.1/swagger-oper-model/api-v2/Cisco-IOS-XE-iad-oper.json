            "minimum": 0,
            "maximum": 4294967295,
            "description": "Index number of the device"
          },
          "if-name": {
            "type": "string",
            "description": "Name of the network interface associated with the device.\n         (for example, 'GigabitEthernet1/0/1')."
          },
          "port-state": {
            "type": "string",
            "description": "State of the port belonging to the IAD interface"
