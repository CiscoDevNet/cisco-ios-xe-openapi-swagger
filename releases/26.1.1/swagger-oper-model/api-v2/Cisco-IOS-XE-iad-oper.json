          },
          "mac-addr": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$",
            "description": "Mac address of the interface"
          },
          "ip-addr": {
            "type": "string",
            "description": "IP Address of the device"
          },
          "vlan": {
