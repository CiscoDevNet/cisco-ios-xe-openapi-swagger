{
  "openapi": "3.0.0",
  "info": {
    "title": "openconfig-pcep",
    "description": "OpenConfig configuration data model\n\n**Module:** `openconfig-pcep`\n**Paths:** 1",
    "version": "17.18.1"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        }
      }
    }
  ],
  "paths": {
    "/data/openconfig-pcep:pcep": {
      "get": {
        "summary": "Get pcep",
        "description": "Top-level PCEP configuration and operational state.",
        "operationId": "get-root",
        "tags": [
          "openconfig-pcep"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "openconfig-pcep:pcep": {
                      "$ref": "#/components/schemas/openconfig-pcep-pcep"
                    }
                  },
                  "example": "configured-value"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found"
          }
        }
      },
      "put": {
        "summary": "Create or replace pcep",
        "description": "Create or replace Top-level PCEP configuration and operational state.",
        "operationId": "put-root",
        "tags": [
          "openconfig-pcep"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "openconfig-pcep:pcep": {
                    "$ref": "#/components/schemas/openconfig-pcep-pcep"
                  }
                },
                "example": "configured-value"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "204": {
            "description": "Updated"
          },
          "400": {
            "description": "Bad request"
          }
        }
      },
      "patch": {
        "summary": "Modify pcep",
        "description": "Partially modify Top-level PCEP configuration and operational state.",
        "operationId": "patch-root",
        "tags": [
          "openconfig-pcep"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "openconfig-pcep:pcep": {
                    "$ref": "#/components/schemas/openconfig-pcep-pcep"
                  }
                },
                "example": "configured-value"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Updated"
          },
          "400": {
            "description": "Bad request"
          }
        }
      },
      "delete": {
        "summary": "Delete pcep",
        "description": "Delete Top-level PCEP configuration and operational state.",
        "operationId": "delete-root",
        "tags": [
          "openconfig-pcep"
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "openconfig-pcep-pcep": {
        "type": "object",
        "properties": {
          "path-computation-servers": {
            "type": "object",
            "properties": {
              "path-computation-server": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "timers": {
                      "type": "object",
                      "properties": {
                        "config": {
                          "type": "object",
                          "properties": {
                            "keepalive": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 255,
                              "description": "Interval for sending keepalive messages over PCE session.",
                              "example": 1
                            },
                            "dead-timer": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 255,
                              "description": "Interval after which PCE session is declared dead.",
                              "example": 1
                            },
                            "redelegation-timeout-interval": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 65535,
                              "description": "When a PCEP session is terminated, the period of time a PCC waits\n        before revoking LSP delegation and attempting to redelegate LSPs\n        associated with the terminated PCEP session to an alternate PCE.",
                              "example": 1
                            },
                            "state-timeout-interval": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 65535,
                              "description": "When a PCEP session is terminated, the period of time a PCC waits\n\tbefore before flushing LSP state associated with that PCEP session\n\tand reverting to operator-defined default parameters or behaviors.",
                              "example": 1
                            }
                          },
                          "description": "This container defines PCEP timers configuration.",
                          "example": "configured-value"
                        },
                        "state": {
                          "type": "object",
                          "properties": {
                            "keepalive": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 255,
                              "description": "Interval for sending keepalive messages over PCE session.",
                              "example": 1
                            },
                            "dead-timer": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 255,
                              "description": "Interval after which PCE session is declared dead.",
                              "example": 1
                            },
                            "redelegation-timeout-interval": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 65535,
                              "description": "When a PCEP session is terminated, the period of time a PCC waits\n        before revoking LSP delegation and attempting to redelegate LSPs\n        associated with the terminated PCEP session to an alternate PCE.",
                              "example": 1
                            },
                            "state-timeout-interval": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 65535,
                              "description": "When a PCEP session is terminated, the period of time a PCC waits\n\tbefore before flushing LSP state associated with that PCEP session\n\tand reverting to operator-defined default parameters or behaviors.",
                              "example": 1
                            }
                          },
                          "description": "This container defines state information for PCEP timers.",
                          "example": "active"
                        }
                      },
                      "description": "This container defines PCEP timers.",
                      "example": "10:30:45"
                    },
                    "authentication": {
                      "type": "object",
                      "properties": {
                        "config": {
                          "type": "object",
                          "properties": {
                            "enable": {
                              "type": "boolean",
                              "description": "Enables PCEP authentication on the node.",
                              "example": true
                            },
                            "authentication-key": {
                              "type": "string",
                              "description": "Password (key) used for securing a PCEP session using\n        TCP-MD5 authentication",
                              "example": "configured-value"
                            },
                            "keychain": {
                              "type": "string",
                              "description": "Reference to a predefined keychain that should be used to secure\n       PCEP session",
                              "example": "MY-KEY-CHAIN"
                            }
                          },
                          "description": "Configuration of PCEP authentication attributes",
                          "example": "configured-value"
                        },
                        "state": {
                          "type": "object",
                          "properties": {
                            "enable": {
                              "type": "boolean",
                              "description": "Enables PCEP authentication on the node.",
                              "example": true
                            },
                            "authentication-key": {
                              "type": "string",
                              "description": "Password (key) used for securing a PCEP session using\n        TCP-MD5 authentication",
                              "example": "configured-value"
                            },
                            "keychain": {
                              "type": "string",
                              "description": "Reference to a predefined keychain that should be used to secure\n       PCEP session",
                              "example": "MY-KEY-CHAIN"
                            }
                          },
                          "description": "PCEP authentication state.",
                          "example": "active"
                        }
                      },
                      "description": "Global PCEP authentication",
                      "example": "configured-value"
                    },
                    "pce-server-address": {
                      "type": "string",
                      "description": "IPv4 address of PCE server.",
                      "example": "10.1.1.1"
                    },
                    "config": {
                      "type": "object",
                      "properties": {
                        "pce-server-address": {
                          "type": "string",
                          "description": "The destination IP address of the PCE server for PCEP service.\n\tSpecify multiple entries in the path-computation-server-list to provide redundancy.\n\tWhen multiple candidate servers are specified for a single client,\n\tthey are prioritized according to preference.",
                          "example": "10.1.1.1"
                        },
                        "id": {
                          "type": "string",
                          "description": "A unique name for the PCE server.",
                          "example": "1"
                        },
                        "port": {
                          "type": "string",
                          "description": "The destination TCP port used for PCEP service in the PCE server.",
                          "example": "443"
                        },
                        "source-address": {
                          "type": "string",
                          "description": "The source IP address used by PCC(Router) to establish PCEP session.",
                          "example": "10.1.1.1"
                        },
                        "pce-type": {
                          "type": "string",
                          "description": "The type of PCEP capability supported which is advertised in the Open\n        message when a PCEP session is established.",
                          "example": "default"
                        },
                        "preference": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255,
                          "description": "When multiple PCE servers are specified, the candidate PCE server\n        with the highest preference is selected to calculate paths.\n        The greater or lower the value, the higher the preference could\n        dependon vendor implementation. If no preference value is set, indicate\n        the lowest preference or no preference at all.",
                          "example": 110
                        },
                        "report-local-lsp": {
                          "type": "boolean",
                          "description": "Specifies whether the PCC (Router) will advertise LSP existence and state\n\tfor LSPs that are not controlled by any PCE (for example, LSPs that are\n\tstatically configured at the PCC) but without delegating them.",
                          "example": true
                        },
                        "pce-initiated-capability": {
                          "type": "boolean",
                          "description": "Indicates to PCE that PCC (Router) supports PCE-initiated LSP paths instantiation.\n\t A PCE can initiate LSPs only for PCCs that advertised this capability.",
                          "example": true
                        },
                        "sr-support": {
                          "type": "boolean",
                          "description": "Indicates to PCE that PCC (Router) supports Segment-Routing\n\t to set up LSP paths in addition to RSVP-TE.",
                          "example": true
                        }
                      },
                      "description": "PCE server configuration.",
                      "example": "configured-value"
                    },
                    "state": {
                      "type": "object",
                      "properties": {
                        "pce-server-address": {
                          "type": "string",
                          "description": "The destination IP address of the PCE server for PCEP service.\n\tSpecify multiple entries in the path-computation-server-list to provide redundancy.\n\tWhen multiple candidate servers are specified for a single client,\n\tthey are prioritized according to preference.",
                          "example": "10.1.1.1"
                        },
                        "id": {
                          "type": "string",
                          "description": "A unique name for the PCE server.",
                          "example": "1"
                        },
                        "port": {
                          "type": "string",
                          "description": "The destination TCP port used for PCEP service in the PCE server.",
                          "example": "443"
                        },
                        "source-address": {
                          "type": "string",
                          "description": "The source IP address used by PCC(Router) to establish PCEP session.",
                          "example": "10.1.1.1"
                        },
                        "pce-type": {
                          "type": "string",
                          "description": "The type of PCEP capability supported which is advertised in the Open\n        message when a PCEP session is established.",
                          "example": "default"
                        },
                        "preference": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255,
                          "description": "When multiple PCE servers are specified, the candidate PCE server\n        with the highest preference is selected to calculate paths.\n        The greater or lower the value, the higher the preference could\n        dependon vendor implementation. If no preference value is set, indicate\n        the lowest preference or no preference at all.",
                          "example": 110
                        },
                        "report-local-lsp": {
                          "type": "boolean",
                          "description": "Specifies whether the PCC (Router) will advertise LSP existence and state\n\tfor LSPs that are not controlled by any PCE (for example, LSPs that are\n\tstatically configured at the PCC) but without delegating them.",
                          "example": true
                        },
                        "pce-initiated-capability": {
                          "type": "boolean",
                          "description": "Indicates to PCE that PCC (Router) supports PCE-initiated LSP paths instantiation.\n\t A PCE can initiate LSPs only for PCCs that advertised this capability.",
                          "example": true
                        },
                        "sr-support": {
                          "type": "boolean",
                          "description": "Indicates to PCE that PCC (Router) supports Segment-Routing\n\t to set up LSP paths in addition to RSVP-TE.",
                          "example": true
                        }
                      },
                      "description": "PCE server state.",
                      "example": "active"
                    }
                  },
                  "example": "configured-value"
                },
                "example": "/data/example"
              }
            },
            "description": "Defines PCE server parameters.",
            "example": "/data/example"
          }
        },
        "example": "configured-value"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "openconfig-pcep",
      "description": "OpenConfig configuration data model"
    }
  ]
}
