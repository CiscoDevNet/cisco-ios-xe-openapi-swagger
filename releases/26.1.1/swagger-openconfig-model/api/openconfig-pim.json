{
  "openapi": "3.0.0",
  "info": {
    "title": "openconfig-pim",
    "description": "An OpenConfig model for Protocol Independent Multicast (PIM).\n\n**Module:** `openconfig-pim`\n**Paths:** 2",
    "version": "17.18.1"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        }
      }
    }
  ],
  "paths": {
    "/data/openconfig-pim:pim": {
      "get": {
        "summary": "Get pim",
        "description": "Top-level PIM configuration and operational state.",
        "operationId": "get-root",
        "tags": [
          "openconfig-pim"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
