                        "join-prune-interval": {
                          "type": "string",
                          "description": "Interval at which the router sends the PIM join/prune messages\n        toward the upstream RPF neighbor.",
                          "example": "configured-value"
                        },
                        "hello-interval": {
                          "type": "string",
                          "description": "Interval at which the router sends the PIM hello messages.",
                          "example": "configured-value"
                        },
                        "dead-timer": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65535,
                          "description": "Number of missed hello messages after which a neighbor is\n        expired.",
                          "example": 1
                        },
                        "maximum-groups": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295,
                          "description": "Limit the number of (S, G) and (*, G) PIM \n        entries accepted on the interface. \n        This feature depends on hardware implementation.",
                          "example": 1
                        },
                        "counters": {
                          "type": "object",
                          "properties": {
                            "hello-messages": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 4294967295,
                              "description": "Number of hello messages received.",
                              "example": 1
                            },
                            "join-prune-messages": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 4294967295,
                              "description": "Number of join/prune messages received.",
                              "example": 1
                            },
                            "bootstrap-messages": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 4294967295,
                              "description": "Number of bootstrap router messages received.",
                              "example": 1
                            }
                          },
                          "description": "PIM counters for each interface.",
                          "example": 10
                        }
                      },
                      "description": "State information for PIM interfaces.",
                      "example": "active"
                    }
                  },
                  "example": "configured-value"
                },
                "example": "GigabitEthernet1/0/1",
                "description": "Interface name (e.g., GigabitEthernet1/0/1)"
              }
            },
            "description": "Configuration and state data for PIM on each interface.",
            "example": "configured-value"
