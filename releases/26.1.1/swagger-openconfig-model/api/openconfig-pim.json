    "schemas": {
      "openconfig-pim-pim": {
        "type": "object",
        "properties": {
          "interfaces": {
            "type": "object",
            "properties": {
              "interface": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "neighbors": {
                      "type": "object",
                      "properties": {
                        "neighbor": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "neighbor-address": {
                                "type": "string",
                                "description": "IPv4 address of neighbor router.",
                                "example": "10.1.1.1"
                              },
                              "state": {
                                "type": "object",
                                "properties": {
                                  "neighbor-address": {
                                    "type": "string",
                                    "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$",
                                    "description": "IPv4 address of neighbor router.",
                                    "example": "10.1.1.1"
                                  },
                                  "dr-address": {
                                    "type": "string",
                                    "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$",
                                    "description": "IPv4 address of designated router.",
                                    "example": "10.1.1.1"
                                  },
                                  "neighbor-established": {
                                    "type": "string",
                                    "description": "This timestamp indicates the time that the\n        PIM neighbor adjacency established. It is expressed\n        relative to the Unix Epoch (Jan 1, 1970 00:00:00 UTC).\n\n        The PIM session uptime can be computed by clients\n        as the difference between this value and the\n        current time in UTC.",
                                    "example": "configured-value"
                                  },
                                  "neighbor-expires": {
                                    "type": "string",
                                    "description": "This timestamp indicates the time that the\n        PIM neighbor adjacency will expire should hello\n        messages fail to arrive from the neighbor. The value\n        is expressed relative to the Unix Epoch (Jan 1, 1970\n        00:00:00 UTC).",
                                    "example": "configured-value"
                                  },
                                  "mode": {
                                    "type": "string",
                                    "description": "PIM mode in use when delivering multicast traffic\n        via this neighbor.",
                                    "example": "normal"
                                  }
                                },
                                "description": "Details about a specific PIM neighbor.",
                                "example": "active"
                              }
                            },
                            "example": "configured-value"
                          },
                          "example": "configured-value"
                        }
                      },
                      "description": "Details about PIM neighbors.",
                      "example": "configured-value"
                    },
                    "interface-ref": {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "object",
                          "properties": {
                            "interface": {
                              "type": "string",
                              "description": "Reference to a base interface.  If a reference to a\n        subinterface is required, this leaf must be specified\n        to indicate the base interface.",
                              "example": "GigabitEthernet1/0/1"
                            },
                            "subinterface": {
                              "type": "string",
                              "description": "Reference to a subinterface -- this requires the base\n        interface to be specified using the interface leaf in\n        this container.  If only a reference to a base interface\n        is requuired, this leaf should not be set.",
                              "example": "configured-value"
                            }
                          },
                          "description": "Operational state for interface-ref",
                          "example": "active"
                        },
                        "config": {
                          "type": "object",
                          "properties": {
                            "interface": {
                              "type": "string",
                              "description": "Reference to a base interface.  If a reference to a\n        subinterface is required, this leaf must be specified\n        to indicate the base interface.",
                              "example": "GigabitEthernet1/0/1"
                            },
                            "subinterface": {
                              "type": "string",
                              "description": "Reference to a subinterface -- this requires the base\n        interface to be specified using the interface leaf in\n        this container.  If only a reference to a base interface\n        is requuired, this leaf should not be set.",
                              "example": "configured-value"
                            }
                          },
                          "description": "Configured reference to interface / subinterface",
                          "example": "configured-value"
                        }
                      },
                      "description": "Reference to an interface or subinterface. The interface\n         that is being referenced is uniquely referenced based on\n         the specified interface and subinterface leaves. In contexts\n         where a Layer 3 interface is to be referenced, both the\n         interface and subinterface leaves must be populated, as\n         Layer 3 configuration within the OpenConfig models is\n         associated with a subinterface. In the case where a\n         Layer 2 interface is to be referenced, only the\n         interface is specified.\n \n         The interface/subinterface leaf tuple must be used as\n         the means by which the interface is specified, regardless\n         of any other context information (e.g., key in a list).",
                      "example": "configured-value"
                    },
                    "enable-bfd": {
                      "type": "object",
                      "properties": {
                        "config": {
                          "type": "object",
                          "properties": {
                            "enabled": {
                              "type": "boolean",
                              "description": "When this leaf is set to true, BFD is used to detect the\n        liveliness of the remote peer or next-hop.",
                              "example": true
                            }
                          },
                          "description": "Configuration parameters relating to enabling BFD.",
                          "example": "configured-value"
                        },
                        "state": {
                          "type": "object",
                          "properties": {
                            "enabled": {
                              "type": "boolean",
                              "description": "When this leaf is set to true, BFD is used to detect the\n        liveliness of the remote peer or next-hop.",
                              "example": true
                            }
                          },
                          "description": "Operational state parameters relating to enabing BFD.",
                          "example": "active"
                        }
                      },
                      "description": "Enable BFD for liveliness detection to the next-hop or\n        neighbour.",
                      "example": "configured-value"
                    },
                    "interface-id": {
