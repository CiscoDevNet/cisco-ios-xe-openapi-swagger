                      "description": "Reference to an interface on which PIM is enabled.",
                      "example": "1"
                    },
                    "config": {
                      "type": "object",
                      "properties": {
                        "enabled": {
                          "type": "boolean",
                          "description": "When set to true, the functionality within which this\n        leaf is defined is enabled, when set to false it is\n        explicitly disabled.",
                          "example": true
                        },
                        "interface-id": {
                          "type": "string",
                          "description": "Reference to an interface on which PIM is enabled.",
                          "example": "1"
                        },
                        "mode": {
                          "type": "string",
                          "description": "PIM mode to use when delivering multicast traffic via this\n        interface.",
                          "example": "normal"
                        },
                        "bsr-border": {
                          "type": "boolean",
                          "description": "When set to true the device will not send bootstrap router\n        messages over this interface. By default these are transmitted\n        over all PIM sparse mode (PIM-SM) enabled interfaces.",
                          "example": true
                        },
                        "border-router": {
                          "type": "boolean",
                          "description": "When set to true the interface is set as MBR (multicast border\n        router) and allows multicast traffic from sources that are\n        outside of the PIM domain.",
                          "example": true
                        },
                        "dr-priority": {
                          "type": "string",
                          "description": "The designated router priority of this interface. Larger always\n        preferred.",
                          "example": "configured-value"
                        },
                        "join-prune-interval": {
                          "type": "string",
                          "description": "Interval at which the router sends the PIM join/prune messages\n        toward the upstream RPF neighbor.",
                          "example": "configured-value"
                        },
                        "hello-interval": {
                          "type": "string",
                          "description": "Interval at which the router sends the PIM hello messages.",
                          "example": "configured-value"
                        },
                        "dead-timer": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65535,
                          "description": "Number of missed hello messages after which a neighbor is\n        expired.",
                          "example": 1
                        },
                        "maximum-groups": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295,
                          "description": "Limit the number of (S, G) and (*, G) PIM \n        entries accepted on the interface. \n        This feature depends on hardware implementation.",
                          "example": 1
                        }
                      },
                      "description": "PIM interface configuration.",
                      "example": "configured-value"
                    },
                    "state": {
                      "type": "object",
                      "properties": {
                        "enabled": {
                          "type": "boolean",
                          "description": "When set to true, the functionality within which this\n        leaf is defined is enabled, when set to false it is\n        explicitly disabled.",
                          "example": true
                        },
                        "interface-id": {
                          "type": "string",
                          "description": "Reference to an interface on which PIM is enabled.",
                          "example": "1"
                        },
                        "mode": {
                          "type": "string",
                          "description": "PIM mode to use when delivering multicast traffic via this\n        interface.",
                          "example": "normal"
                        },
                        "bsr-border": {
                          "type": "boolean",
                          "description": "When set to true the device will not send bootstrap router\n        messages over this interface. By default these are transmitted\n        over all PIM sparse mode (PIM-SM) enabled interfaces.",
                          "example": true
                        },
                        "border-router": {
                          "type": "boolean",
                          "description": "When set to true the interface is set as MBR (multicast border\n        router) and allows multicast traffic from sources that are\n        outside of the PIM domain.",
                          "example": true
                        },
                        "dr-priority": {
                          "type": "string",
                          "description": "The designated router priority of this interface. Larger always\n        preferred.",
                          "example": "configured-value"
