                "schema": {
                  "type": "object",
                  "properties": {
                    "openconfig-pim:pim": {
                      "$ref": "#/components/schemas/openconfig-pim-pim"
                    }
                  },
                  "example": "configured-value"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found"
          }
        }
      },
      "put": {
        "summary": "Create or replace pim",
