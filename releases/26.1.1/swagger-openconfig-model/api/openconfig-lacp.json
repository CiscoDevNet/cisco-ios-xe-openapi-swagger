{
  "openapi": "3.0.0",
  "info": {
    "title": "openconfig-lacp",
    "description": "This module describes configuration and operational state\n    data for Link Aggregation Control Protocol (LACP) for\n    managing aggregate interfaces.   It works in conjunction with\n    the OpenConfig interfaces and aggregate interfaces models.\n\n**Module:** `openconfig-lacp`\n**Paths:** 3",
    "version": "17.18.1"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        }
      }
    }
  ],
  "paths": {
    "/data/openconfig-lacp:lacp": {
