        "summary": "Get lacp",
        "description": "Configuration and operational state data for LACP protocol\n        operation on the aggregate interface",
        "operationId": "get-root",
        "tags": [
          "openconfig-lacp"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "openconfig-lacp:lacp": {
                      "$ref": "#/components/schemas/openconfig-lacp-lacp"
                    }
                  },
                  "example": "configured-value"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found"
