  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "openconfig-lacp-lacp": {
        "type": "object",
        "properties": {
          "interfaces": {
            "type": "object",
            "properties": {
              "interface": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "members": {
                      "type": "object",
                      "properties": {
                        "member": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "interface": {
                                "type": "string",
                                "description": "Reference to aggregate member interface",
                                "example": "GigabitEthernet1/0/1"
                              },
                              "state": {
                                "type": "object",
                                "properties": {
                                  "interface": {
                                    "type": "string",
                                    "description": "Reference to interface member of the LACP aggregate",
                                    "example": "GigabitEthernet1/0/1"
                                  },
                                  "activity": {
                                    "type": "string",
                                    "description": "Indicates participant is active or passive",
                                    "example": "configured-value"
                                  },
                                  "timeout": {
                                    "type": "string",
                                    "description": "The timeout type (short or long) used by the\n        participant",
                                    "example": "10:30:45"
                                  },
                                  "synchronization": {
                                    "type": "string",
                                    "description": "Indicates whether the participant is in-sync or\n        out-of-sync",
                                    "example": "configured-value"
                                  },
                                  "aggregatable": {
                                    "type": "boolean",
                                    "description": "A true value indicates that the participant will allow\n        the link to be used as part of the aggregate. A false\n        value indicates the link should be used as an individual\n        link",
                                    "example": true
                                  },
                                  "collecting": {
                                    "type": "boolean",
                                    "description": "If true, the participant is collecting incoming frames\n        on the link, otherwise false",
                                    "example": true
                                  },
                                  "distributing": {
                                    "type": "boolean",
                                    "description": "When true, the participant is distributing outgoing\n        frames; when false, distribution is disabled",
                                    "example": true
                                  },
                                  "system-id": {
                                    "type": "string",
                                    "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$",
                                    "description": "MAC address that defines the local system ID for the\n        aggregate interface",
                                    "example": "1"
                                  },
                                  "oper-key": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 65535,
                                    "description": "Current operational value of the key for the aggregate\n        interface",
                                    "example": 1
                                  },
                                  "partner-id": {
                                    "type": "string",
                                    "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$",
                                    "description": "MAC address representing the protocol partner's interface\n        system ID",
                                    "example": "1"
                                  },
                                  "partner-key": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 65535,
                                    "description": "Operational value of the protocol partner's key",
                                    "example": 1
                                  },
                                  "port-num": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 65535,
                                    "description": "Port number of the local (actor) aggregation member",
                                    "example": 10
                                  },
                                  "partner-port-num": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 65535,
                                    "description": "Port number of the partner (remote) port for this member\n        port",
                                    "example": 10
                                  },
                                  "counters": {
                                    "type": "object",
                                    "properties": {
                                      "lacp-in-pkts": {
                                        "type": "string",
                                        "description": "Number of LACPDUs received",
                                        "example": "configured-value"
                                      },
                                      "lacp-out-pkts": {
                                        "type": "string",
                                        "description": "Number of LACPDUs transmitted",
                                        "example": "configured-value"
                                      },
                                      "lacp-rx-errors": {
                                        "type": "string",
                                        "description": "Number of LACPDU receive packet errors",
                                        "example": "0"
                                      },
                                      "lacp-tx-errors": {
                                        "type": "string",
                                        "description": "Number of LACPDU transmit packet errors",
                                        "example": "0"
                                      },
                                      "lacp-unknown-errors": {
                                        "type": "string",
                                        "description": "Number of LACPDU unknown packet errors",
                                        "example": "0"
                                      },
                                      "lacp-errors": {
                                        "type": "string",
                                        "description": "Number of LACPDU illegal packet errors",
                                        "example": "0"
                                      }
                                    },
                                    "description": "LACP protocol counters",
                                    "example": 10
                                  }
                                },
                                "description": "Operational state data for aggregate members",
                                "example": "active"
                              }
                            },
                            "example": "configured-value"
                          },
                          "example": "configured-value"
                        }
                      },
                      "description": "Enclosing container for the list of members interfaces of\n        the aggregate. This list is considered operational state\n        only so is labeled config false and has no config container",
                      "example": "configured-value"
                    },
                    "name": {
                      "type": "string",
                      "description": "Reference to the list key",
                      "example": "example-1"
                    },
                    "config": {
                      "type": "object",
                      "properties": {
                        "system-priority": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65535,
                          "description": "Sytem priority used by the node on this LAG interface.\n        Lower value is higher priority for determining which node\n        is the controlling system.",
                          "example": 1
                        },
                        "name": {
                          "type": "string",
                          "description": "Reference to the interface on which LACP should be\n        configured.   The type of the target interface must be\n        ieee8023adLag",
                          "example": "example-1"
                        },
                        "interval": {
                          "type": "string",
                          "description": "Set the period between LACP messages -- uses\n        the lacp-period-type enumeration.",
                          "example": "60"
                        },
                        "lacp-mode": {
                          "type": "string",
                          "description": "ACTIVE is to initiate the transmission of LACP packets.\n         PASSIVE is to wait for peer to initiate the transmission of\n         LACP packets.",
                          "example": "configured-value"
                        },
                        "system-id-mac": {
                          "type": "string",
                          "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$",
                          "description": "The MAC address portion of the node's System ID. This is\n        combined with the system priority to construct the 8-octet\n        system-id",
                          "example": "00:1a:2b:3c:4d:5e"
                        }
                      },
                      "description": "Configuration data for each LACP aggregate interface",
                      "example": "configured-value"
                    },
                    "state": {
                      "type": "object",
                      "properties": {
                        "system-priority": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65535,
                          "description": "Sytem priority used by the node on this LAG interface.\n        Lower value is higher priority for determining which node\n        is the controlling system.",
                          "example": 1
                        },
                        "name": {
                          "type": "string",
                          "description": "Reference to the interface on which LACP should be\n        configured.   The type of the target interface must be\n        ieee8023adLag",
                          "example": "example-1"
                        },
                        "interval": {
                          "type": "string",
                          "description": "Set the period between LACP messages -- uses\n        the lacp-period-type enumeration.",
                          "example": "60"
                        },
                        "lacp-mode": {
                          "type": "string",
                          "description": "ACTIVE is to initiate the transmission of LACP packets.\n         PASSIVE is to wait for peer to initiate the transmission of\n         LACP packets.",
                          "example": "configured-value"
                        },
                        "system-id-mac": {
                          "type": "string",
                          "pattern": "^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$",
                          "description": "The MAC address portion of the node's System ID. This is\n        combined with the system priority to construct the 8-octet\n        system-id",
                          "example": "00:1a:2b:3c:4d:5e"
                        }
                      },
                      "description": "Operational state data for each LACP aggregate\n            interface",
                      "example": "active"
                    }
                  },
                  "example": "configured-value"
                },
                "example": "GigabitEthernet1/0/1",
                "description": "Interface name (e.g., GigabitEthernet1/0/1)"
              }
            },
            "description": "Enclosing container for the list of LACP-enabled\n        interfaces",
            "example": "configured-value"
          },
          "config": {
            "type": "object",
            "properties": {
              "system-priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535,
                "description": "Sytem priority used by the node on this LAG interface.\n        Lower value is higher priority for determining which node\n        is the controlling system.",
                "example": 1
              }
            },
            "description": "Configuration data for LACP",
            "example": "configured-value"
          },
          "state": {
            "type": "object",
            "properties": {
              "system-priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535,
                "description": "Sytem priority used by the node on this LAG interface.\n        Lower value is higher priority for determining which node\n        is the controlling system.",
                "example": 1
              }
            },
            "description": "Operational state data for LACP",
            "example": "active"
          }
        },
        "example": "configured-value"
      },
      "openconfig-lacp-config": {
        "type": "object",
        "properties": {
          "system-priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "Sytem priority used by the node on this LAG interface.\n        Lower value is higher priority for determining which node\n        is the controlling system.",
            "example": 1
          }
        },
        "example": "configured-value"
      },
      "openconfig-lacp-state": {
        "type": "object",
        "properties": {
          "system-priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "Sytem priority used by the node on this LAG interface.\n        Lower value is higher priority for determining which node\n        is the controlling system.",
            "example": 1
          }
        },
        "example": "active"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "openconfig-lacp",
      "description": "This module describes configuration and operational state\n    data for Link Aggregation Control Protocol (LACP) for\n    managing aggregate interfaces.   It works in conjunction with\n    the OpenConfig interfaces and aggregate interfaces models."
    }
  ]
}
