  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/chassis_rpc:set-chassis-priority": {
      "post": {
        "summary": "Set chassis priority RPC.\n       Chassis with higher priority will become active module\n       on next reboot of active and standby modules.",
        "description": "Set chassis priority RPC.\n       Chassis with higher priority will become active module\n       on next reboot of active and standby modules.\n\n**Endpoint:** `POST /restconf/operations/chassis_rpc:set-chassis-priority`",
        "operationId": "post-root-2",
        "tags": [
          "Cisco-IOS-XE-chassis-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "chassis_rpc:set-chassis-priority": {
                    "type": "object",
                    "properties": {
                      "number": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2,
                        "description": "Chassis number",
                        "example": 10
                      },
                      "priority": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2,
                        "description": "Chassis priority",
                        "example": 100
                      }
                    },
                    "required": [
                      "number",
                      "priority"
                    ],
                    "example": true
                  }
                },
                "example": true
              },
              "example": {
                "chassis_rpc:set-chassis-priority": {
                  "number": 2,
                  "priority": 2
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "chassis_rpc:set-chassis-priority": {
                      "type": "object",
                      "example": true
                    }
                  },
                  "example": true
                },
                "example": {
                  "chassis_rpc:set-chassis-priority": {
                    "chassis_rpc:set-chassis-priority": true
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/operations/chassis_rpc:set-chassis-number": {
      "post": {
        "summary": "Set chassis number RPC.\n       Changing the chassis number may result in a configuration change.\n       The interface configuration associated with the old chassis number\n       will remain as a provisioned configuration.\n       New chassis number will be effective after next reboot.",
        "description": "Set chassis number RPC.\n       Changing the chassis number may result in a configuration change.\n       The interface configuration associated with the old chassis number\n       will remain as a provisioned configuration.\n       New chassis number will be effective after next reboot.\n\n**Endpoint:** `POST /restconf/operations/chassis_rpc:set-chassis-number`",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-chassis-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "chassis_rpc:set-chassis-number": {
                    "type": "object",
                    "properties": {
                      "number": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2,
                        "description": "Current chassis number",
                        "example": 10
                      },
                      "renumber": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2,
                        "description": "New chassis number",
                        "example": 10
                      }
                    },
                    "required": [
                      "number",
                      "renumber"
                    ],
                    "example": 10
                  }
                },
                "example": 10
              },
              "example": {
                "chassis_rpc:set-chassis-number": {
                  "number": 2,
                  "renumber": 2
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "chassis_rpc:set-chassis-number": {
                      "type": "object",
                      "example": 10
                    }
                  },
                  "example": 10
                },
                "example": {
                  "chassis_rpc:set-chassis-number": {
                    "chassis_rpc:set-chassis-number": 10
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
