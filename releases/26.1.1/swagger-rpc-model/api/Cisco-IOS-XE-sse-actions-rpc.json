  "paths": {
    "/operations/sse_actions_rpc:set-sse-ipsec-tunnel": {
      "post": {
        "summary": "RPC to set IPSEC tunnel parameters",
        "description": "RPC to set IPSEC tunnel parameters\n\n**Endpoint:** `POST /restconf/operations/sse_actions_rpc:set-sse-ipsec-tunnel`",
        "operationId": "post-root-2",
        "tags": [
          "Cisco-IOS-XE-sse-actions-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sse_actions_rpc:set-sse-ipsec-tunnel": {
                    "type": "object",
                    "properties": {
                      "tunnel-name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 127,
                        "description": "Tunnel name"
                      },
                      "dc-ip-addr": {
                        "type": "string",
                        "description": "Data center IP address"
                      },
                      "tunnel-id": {
                        "type": "string",
                        "description": "Tunnel identifier"
                      },
                      "sse-tunnel-name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 127,
                        "description": "Tunnel name on the SSE"
                      },
                      "tunnel-type": {
                        "type": "string",
                        "description": "Type of SSE tunnel"
                      },
                      "sse-provider": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 127,
                        "description": "SSE provider name"
                      },
                      "remote-ip-any": {
                        "type": "string",
                        "description": "Remote any IPV4/IPV6 address"
                      },
                      "remote-ip-addr": {
                        "type": "string",
                        "description": "Remote IPV4 address"
                      },
                      "remote-id-fqdn": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 127,
                        "description": "Remote identifier is FQDN"
                      },
                      "remote-id-user-fqdn": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 127,
                        "description": "Remote identifier is user FQDN"
                      },
                      "remote-key-id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 127,
                        "description": "Remote identifier is key identifier"
                      },
                      "local-key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 127,
                        "description": "Local key is pre shared key"
                      },
                      "remote-key": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 127,
                        "description": "Remote key is pre shared key"
                      },
                      "local-ip-any": {
                        "type": "string",
                        "description": "Local any IPV4/IPV6 address"
                      },
                      "local-ip-addr": {
                        "type": "string",
                        "description": "Local IPV4 address"
                      },
                      "local-id-fqdn": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 127,
                        "description": "FQDN is the local identifier"
                      },
                      "local-id-user-fqdn": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 127,
                        "description": "User FQDN is the local identifier"
                      },
                      "local-key-id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 127,
                        "description": "Local identifier is key string"
                      }
                    },
                    "required": [
                      "tunnel-name",
                      "dc-ip-addr",
                      "tunnel-id",
                      "sse-tunnel-name",
                      "tunnel-type",
                      "sse-provider",
                      "remote-ip-any",
                      "remote-ip-addr",
                      "remote-id-fqdn",
                      "remote-id-user-fqdn",
                      "remote-key-id",
                      "local-key",
                      "remote-key",
                      "local-ip-any",
                      "local-ip-addr",
                      "local-id-fqdn",
                      "local-id-user-fqdn",
                      "local-key-id"
                    ]
                  }
                }
              },
              "example": {
                "sse_actions_rpc:set-sse-ipsec-tunnel": {
                  "tunnel-name": "example-string",
                  "dc-ip-addr": "192.168.1.1",
                  "tunnel-id": "example-string",
                  "sse-tunnel-name": "example-string",
                  "tunnel-type": "example-string",
                  "sse-provider": "example-string",
                  "remote-ip-any": "2001:db8::1",
                  "remote-ip-addr": "example-string",
                  "remote-id-fqdn": "example-string",
                  "remote-id-user-fqdn": "admin",
                  "remote-key-id": "example-string",
                  "local-key": "example-string",
                  "remote-key": "example-string",
                  "local-ip-any": "2001:db8::1",
                  "local-ip-addr": "example-string",
                  "local-id-fqdn": "example-string",
                  "local-id-user-fqdn": "admin",
                  "local-key-id": "example-string"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object"
                },
                "example": {}
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
