    "description": "This module contains a collection of YANG definitions for\n     Voice RPC.\n     Copyright (c) 2022 by Cisco Systems, Inc.\n     All rights reserved.\n\n**Module:** `Cisco-IOS-XE-voice-rpc`\n**Version:** 2022-11-01\n**Operations:** 1",
    "version": "2022-11-01"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/voice_rpc:voice-register": {
      "post": {
        "summary": "Voice register RPC to indicate Webex-SGW data sync completion event",
        "description": "Voice register RPC to indicate Webex-SGW data sync completion event\n\n**Endpoint:** `POST /restconf/operations/voice_rpc:voice-register`",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-voice-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "voice_rpc:voice-register": {
                    "type": "object",
                    "properties": {
                      "webex-sgw": {
                        "type": "string",
                        "description": "Voice register webex survivability gateway mode",
                        "example": "configured-value"
                      }
                    },
                    "required": [
                      "webex-sgw"
                    ],
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "voice_rpc:voice-register": {
                  "webex-sgw": "configured-value"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "voice_rpc:voice-register": {
                      "type": "object",
                      "example": "configured-value"
                    }
                  },
                  "example": "configured-value"
                },
                "example": {
                  "voice_rpc:voice-register": {
                    "voice_rpc:voice-register": [
                      "configured-value"
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
