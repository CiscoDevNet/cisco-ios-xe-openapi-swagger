    "schemas": {
      "Cisco-IOS-XE-wireless-rfid-global-oper-rfid-global-oper-data": {
        "type": "object",
        "properties": {
          "total-rfid-count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295,
            "description": "This is the total number of unique RFID found in the RFID radio entry data"
          },
          "rfid-mac-addr": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$",
            "description": "RFID MAC address"
          },
          "ap-mac-addr": {
            "type": "string",
            "pattern": "^([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}$",
            "description": "AP MAC address"
          },
          "slot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Slot ID"
          },
          "ap-name": {
            "type": "string",
            "description": "AP Name"
          },
          "rssi-last-heard": {
            "type": "string",
            "description": "Time at which RFID was last heard by controller"
          },
          "rssi-value": {
            "type": "integer",
            "minimum": -128,
            "maximum": 127,
            "description": "RSSI value of the RFID tag when last heard by controller"
          },
          "snr-value": {
            "type": "integer",
            "minimum": -128,
            "maximum": 127,
            "description": "SNR signal to noise ratio value of RFID tag"
          },
          "radio-int-type": {
            "type": "string",
            "description": "Radio type of the detecting AP that detected RFID"
          },
