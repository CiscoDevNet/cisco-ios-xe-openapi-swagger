    "/operations/cisco_ia:sync-from": {
      "post": {
        "summary": "Synchronize the network element's\n       running-configuration to ConfD.",
        "description": "Synchronize the network element's\n       running-configuration to ConfD.\n\n**Endpoint:** `POST /restconf/operations/cisco_ia:sync-from`",
        "operationId": "post-root-8",
        "tags": [
          "cisco-ia"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cisco_ia:sync-from": {
                    "type": "object",
                    "properties": {
                      "sync-defaults": {
                        "type": "string",
                        "description": "Sends the output of\n           \\"
                      },
                      "ignore-presrv-paths": {
                        "type": "string",
                        "description": "Sync everything under /native.\n           Ignore any preserve paths."
                      }
                    }
                  }
                }
              },
              "example": {
                "cisco_ia:sync-from": {
                  "sync-defaults": "example-string",
                  "ignore-presrv-paths": "flash:/config.txt"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
