{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco-IOS-XE-utd-rpc - RPC Operations",
    "description": "NED UTD RPC YANG module for IOS\n     Copyright (c) 2016-2019 by Cisco Systems, Inc.\n     All rights reserved.\n\n**Module:** `Cisco-IOS-XE-utd-rpc`\n**Version:** 2019-11-01\n**Operations:** 1",
    "version": "2019-11-01"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/utd_rpc:utd": {
      "post": {
        "summary": "Unified Threat Defense commands",
        "description": "Unified Threat Defense commands\n\n**Endpoint:** `POST /restconf/operations/utd_rpc:utd`",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-utd-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "utd_rpc:utd": {
                    "type": "object",
                    "properties": {
                      "threat-inspection": {
                        "type": "object",
                        "properties": {
                          "signature": {
                            "type": "object",
                            "description": "Provide actions to be taken for signatures",
                            "example": "configured-value"
                          }
                        },
                        "description": "IPS/IDS related commands",
                        "example": "configured-value"
                      },
                      "web-filter": {
                        "type": "object",
                        "properties": {
                          "database": {
                            "type": "object",
                            "properties": {
                              "update": {
                                "type": "string",
                                "description": "Update the web-filter database",
                                "example": "2025-03-15"
                              }
                            },
                            "required": [
                              "update"
                            ],
                            "description": "Provide actions to be taken for the web-filter database",
                            "example": "configured-value"
                          }
                        },
                        "description": "Web-filter related commands",
                        "example": "configured-value"
                      },
                      "file-inspection": {
                        "type": "object",
                        "properties": {
                          "analysis": {
                            "type": "object",
                            "properties": {
                              "apikey": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128,
                                "description": "Provide UTD file analysis apikey",
                                "example": "configured-value"
                              }
                            },
                            "required": [
                              "apikey"
                            ],
                            "description": "UTD file analysis related commands",
                            "example": "configured-value"
                          }
                        },
                        "description": "UTD file inspection commands",
                        "example": "configured-value"
                      }
                    },
                    "x-yang-choices": [
                      {
                        "name": "feature",
                        "mandatory": false,
                        "cases": [
                          {
                            "name": "feature-threat",
                            "properties": [
                              "threat-inspection"
                            ]
                          },
                          {
                            "name": "feature-webfltr",
                            "properties": [
                              "web-filter"
                            ]
                          },
                          {
                            "name": "feature-file-inspection",
                            "properties": [
                              "file-inspection"
                            ]
                          }
                        ]
                      }
                    ],
                    "description": "YANG choice — mutually exclusive case groups: choice 'feature': feature-threat | feature-webfltr | feature-file-inspection.",
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "utd_rpc:utd": {
                  "threat-inspection": {
                    "signature": [
                      null
                    ]
                  },
                  "web-filter": {
                    "database": {
                      "update": "2025-03-15"
                    }
                  },
                  "file-inspection": {
                    "analysis": {
                      "apikey": "configured-value"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "utd_rpc:utd": {
                      "type": "object",
                      "example": "configured-value"
                    }
                  },
                  "example": "configured-value"
                },
                "example": {
                  "utd_rpc:utd": {
                    "utd_rpc:utd": [
                      null
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ]
}
