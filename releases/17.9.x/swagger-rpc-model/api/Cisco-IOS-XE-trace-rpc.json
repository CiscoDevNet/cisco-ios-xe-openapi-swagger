{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco-IOS-XE-trace-rpc - RPC Operations",
    "description": "Copyright (c) 2021 by Cisco Systems, Inc.\n     All rights reserved.\n\n**Module:** `Cisco-IOS-XE-trace-rpc`\n**Version:** 2021-07-01\n**Operations:** 2",
    "version": "2021-07-01"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/trace_rpc:trace-archive": {
      "post": {
        "summary": "RPC for generating trace archive",
        "description": "RPC for generating trace archive\n\n**Endpoint:** `POST /restconf/operations/trace_rpc:trace-archive`",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-trace-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "trace_rpc:trace-archive": {
                    "type": "object",
                    "properties": {
                      "all": {
                        "type": "object",
                        "properties": {
                          "location": {
                            "type": "string",
                            "description": "Location where archive gets generated",
                            "example": "San Jose, CA"
                          },
                          "file-name": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100,
                            "pattern": "[A-Za-z0-9_@!-/]*",
                            "description": "Name of the archive. When trace bundle is generated.\n         File name is limited to 100 characters",
                            "example": "example-1"
                          }
                        },
                        "required": [
                          "location",
                          "file-name"
                        ],
                        "description": "Generate trace archive",
                        "example": "configured-value"
                      }
                    },
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "trace_rpc:trace-archive": {
                  "all": {
                    "location": "San Jose, CA",
                    "file-name": "flash:/config.txt"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "trace_rpc:trace-archive": {
                      "type": "object",
                      "properties": {
                        "unique-id": {
                          "type": "string",
                          "description": "The unique identifier is a number which is generated for\n         a successful trace archive rpc action.",
                          "example": "1"
                        }
                      },
                      "example": "configured-value"
                    }
                  },
                  "example": "configured-value"
                },
                "example": {
                  "trace_rpc:trace-archive": {
                    "unique-id": "1"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/operations/trace_rpc:trace-message": {
      "post": {
        "summary": "RPC for trace logging operations",
        "description": "RPC for trace logging operations\n\n**Endpoint:** `POST /restconf/operations/trace_rpc:trace-message`",
        "operationId": "post-root-2",
        "tags": [
          "Cisco-IOS-XE-trace-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "trace_rpc:trace-message": {
                    "type": "object",
                    "properties": {
                      "trace-all-options": {
                        "type": "object",
                        "properties": {
                          "file-info": {
                            "type": "object",
                            "properties": {
                              "file-location": {
                                "type": "string",
                                "description": "Location where file will be generated",
                                "example": "configured-value"
                              },
                              "file-name": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 100,
                                "pattern": "[A-Za-z0-9_@!-/]*",
                                "description": "Name of the file that will be generated.\n         A UTC date string will be appended to the file name and will be\n         the name of trace bundle. For example, when RPC is fired with\n         file name as 'trace-file' at 2021:01:01 01:01:01,\n         the name of trace bundle will be  'trace-file-20210101-010101.tar.gz'.\n         File name is limited to 100 characters",
                                "example": "example-1"
                              }
                            },
                            "required": [
                              "file-location",
                              "file-name"
                            ],
                            "description": "Location and name of file",
                            "example": "configured-value"
                          },
                          "trace-filter-options": {
                            "type": "object",
                            "properties": {
                              "metadata": {
                                "type": "string",
                                "description": "Display meta data for every log message",
                                "default": "false",
                                "example": "configured-value"
                              },
                              "pcap-extract": {
                                "type": "string",
                                "description": "Packet capture file to extract",
                                "default": "false",
                                "example": "configured-value"
                              },
                              "debug-level-id": {
                                "type": "string",
                                "description": "Debug level for logging the logs",
                                "default": "debug-level-none",
                                "example": "1"
                              },
                              "consumer": {
                                "type": "string",
                                "description": "Consumer type for logs",
                                "default": "trace-tac",
                                "example": "configured-value"
                              },
                              "tof-flag": {
                                "type": "string",
                                "description": "Display trace on failure logs",
                                "default": "false",
                                "example": "True"
                              },
                              "module": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128,
                                "description": "Select logs for specific modules",
                                "default": "none",
                                "example": "configured-value"
                              },
                              "marker": {
                                "type": "object",
                                "properties": {
                                  "start-marker-type": {
                                    "type": "string",
                                    "description": "Marker type start or start last to select logs",
                                    "default": "trace-marker-start-none",
                                    "example": "default"
                                  },
                                  "end-marker-type": {
                                    "type": "string",
                                    "description": "Marker end start or end last to stop logging",
                                    "default": "trace-marker-end-none",
                                    "example": "default"
                                  },
                                  "start-marker": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128,
                                    "description": "Display logs when a specific marker is found in file set",
                                    "default": "none",
                                    "example": "configured-value"
                                  },
                                  "end-marker": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 128,
                                    "description": "Stop displaying logs when a specific marker\n         is found in file set",
                                    "default": "none",
                                    "example": "configured-value"
                                  }
                                },
                                "description": "Marker for displaying logs",
                                "example": "configured-value"
                              },
                              "interval": {
                                "type": "object",
                                "properties": {
                                  "start-type": {
                                    "type": "string",
                                    "description": "Type of start interval options",
                                    "default": "start-interval-none",
                                    "example": "default"
                                  },
                                  "start-interval": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 4294967295,
                                    "description": "Allows to fill value of start interval period",
                                    "default": "0",
                                    "example": 1
                                  },
                                  "end-type": {
                                    "type": "string",
                                    "description": "Type of end interval options",
                                    "default": "end-interval-none",
                                    "example": "default"
                                  },
                                  "end-interval": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 4294967295,
                                    "description": "Allows to fill value of end interval period",
                                    "default": "0",
                                    "example": 1
                                  }
                                },
                                "description": "Interval for displaying logs",
                                "example": 60
                              },
                              "timestamp": {
                                "type": "object",
                                "properties": {
                                  "start-timestamp": {
                                    "type": "string",
                                    "description": "Start time stamp for filtering log",
                                    "default": "1970-01-01T00:00:00.000000Z",
                                    "example": "2025-03-15T10:30:45Z"
                                  },
                                  "end-timestamp": {
                                    "type": "string",
                                    "description": "End time stamp for filtering log",
                                    "default": "1970-01-01T00:00:00.000000Z",
                                    "example": "2025-03-15T10:30:45Z"
                                  }
                                },
                                "description": "Use time stamp for filtering log",
                                "example": "2025-03-15T10:30:45Z"
                              },
                              "filter": {
                                "type": "object",
                                "properties": {
                                  "filter-none": {
                                    "type": "string",
                                    "description": "Default option - no action needed by user.\n             [Optional]: 'filter-none' can be set to true by user,\n             though it is a default option. If the user intends to use any of the\n             'filter-by-choice' options other than 'type-none', example -\n             type-mac-address, type-ipv4-address etc. 'filter-none' will be set\n             to default value and user need not modify this value.",
                                    "default": "true",
                                    "example": "configured-value"
                                  },
                                  "mac-address": {
                                    "type": "string",
                                    "description": "MAC address filter. Make sure it\n             is in 'aa:aa:aa:aa:aa:aa' format",
                                    "default": "00:00:00:00:00:00",
                                    "example": "00:1a:2b:3c:4d:5e"
                                  },
                                  "integer-value": {
                                    "type": "string",
                                    "description": "Integer-based filter",
                                    "default": "none",
                                    "example": "configured-value"
                                  },
                                  "ipv4-address": {
                                    "type": "string",
                                    "description": "IPv4-based filter",
                                    "default": "0.0.0.0",
                                    "example": "10.1.1.1"
                                  },
                                  "ipv6-address": {
                                    "type": "string",
                                    "description": "IPv6-based filter",
                                    "default": "::ff",
                                    "example": "2001:db8::1"
                                  },
                                  "uuid-string": {
                                    "type": "string",
                                    "description": "UUID based filter",
                                    "default": "none",
                                    "example": "1"
                                  },
                                  "string-value": {
                                    "type": "string",
                                    "description": "String based filter",
                                    "default": "none",
                                    "example": "configured-value"
                                  }
                                },
                                "description": "Select logs using filter",
                                "example": "configured-value"
                              },
                              "switch-info": {
                                "type": "object",
                                "properties": {
                                  "switch-id": {
                                    "type": "string",
                                    "description": "Switch",
                                    "default": "switch-none",
                                    "example": "1"
                                  },
                                  "switch-num": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 2,
                                    "description": "Set switch number 1 or 2 for logging",
                                    "default": "1",
                                    "example": 10
                                  }
                                },
                                "description": "Information about switch for logging",
                                "example": "configured-value"
                              }
                            },
                            "description": "Show logs of specific file",
                            "example": "configured-value"
                          },
                          "process": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128,
                            "description": "Process name to show logs for specific process",
                            "example": "configured-value"
                          },
                          "profile": {
                            "type": "object",
                            "properties": {
                              "profile-option": {
                                "type": "string",
                                "description": "Trace profile type",
                                "default": "trace-profile-predefined",
                                "example": "configured-value"
                              },
                              "profile-location": {
                                "type": "string",
                                "description": "Location of the profile file",
                                "default": "bootflash",
                                "example": "configured-value"
                              },
                              "profile-file": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 100,
                                "pattern": "[A-Za-z0-9_@!-/]*",
                                "description": "Name of the profile file.\n         File name is limited to 100 characters",
                                "default": "none",
                                "example": "configured-value"
                              },
                              "predefined-profile": {
                                "type": "string",
                                "description": " Allows to select pre-defined profile name",
                                "default": "all-profiles",
                                "example": "configured-value"
                              }
                            },
                            "description": "Profile name: show logs of specific profile number",
                            "example": "configured-value"
                          }
                        },
                        "description": "Options for generating logs",
                        "example": "configured-value"
                      }
                    },
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "trace_rpc:trace-message": {
                  "trace-all-options": {
                    "file-info": {
                      "file-location": "flash:/config.txt",
                      "file-name": "flash:/config.txt"
                    },
                    "trace-filter-options": {
                      "metadata": "configured-value",
                      "pcap-extract": "configured-value",
                      "debug-level-id": "1",
                      "consumer": "configured-value",
                      "tof-flag": "True",
                      "module": "configured-value",
                      "marker": {
                        "start-marker-type": "default",
                        "end-marker-type": "default",
                        "start-marker": "configured-value",
                        "end-marker": "configured-value"
                      },
                      "interval": {
                        "start-type": "default",
                        "start-interval": 10,
                        "end-type": "default",
                        "end-interval": 10
                      },
                      "timestamp": {
                        "start-timestamp": "2025-03-15T10:30:45Z",
                        "end-timestamp": "2025-03-15T10:30:45Z"
                      },
                      "filter": {
                        "filter-none": "configured-value",
                        "mac-address": "00:11:22:33:44:55",
                        "integer-value": "configured-value",
                        "ipv4-address": "192.168.1.1",
                        "ipv6-address": "2001:db8::1",
                        "uuid-string": "1",
                        "string-value": "configured-value"
                      },
                      "switch-info": {
                        "switch-id": "1",
                        "switch-num": 2
                      }
                    },
                    "process": "configured-value",
                    "profile": {
                      "profile-option": "flash:/config.txt",
                      "profile-location": "flash:/config.txt",
                      "profile-file": "flash:/config.txt",
                      "predefined-profile": "flash:/config.txt"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "trace_rpc:trace-message": {
                      "type": "object",
                      "properties": {
                        "unique-id": {
                          "type": "string",
                          "description": "The unique identifier is a number which is generated for\n         a successful trace message rpc action and can be used to\n         track the progress of action via trace events.",
                          "example": "1"
                        }
                      },
                      "example": "configured-value"
                    }
                  },
                  "example": "configured-value"
                },
                "example": {
                  "trace_rpc:trace-message": {
                    "unique-id": "1"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ]
}
