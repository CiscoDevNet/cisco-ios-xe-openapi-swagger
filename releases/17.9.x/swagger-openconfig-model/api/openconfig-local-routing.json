    "schemas": {
      "openconfig-local-routing-local-routes": {
        "type": "object",
        "properties": {
          "static-routes": {
            "type": "object",
            "properties": {
              "static": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "prefix": {
                      "type": "string",
                      "description": "Reference to the destination prefix list key.",
                      "example": "10.0.0.0/24"
                    },
                    "config": {
                      "type": "object",
                      "properties": {
                        "set-tag": {
                          "type": "string",
                          "description": "Set a generic tag value on the route. This tag can be\n        used for filtering routes that are distributed to other\n        routing protocols.",
                          "example": "configured-value"
                        },
                        "prefix": {
                          "type": "string",
                          "description": "Destination prefix for the static route, either IPv4 or\n        IPv6.",
                          "example": "10.0.0.0/24"
                        }
                      },
                      "description": "Configuration data for static routes",
                      "example": "configured-value"
                    },
                    "state": {
                      "type": "object",
                      "properties": {
                        "set-tag": {
                          "type": "string",
                          "description": "Set a generic tag value on the route. This tag can be\n        used for filtering routes that are distributed to other\n        routing protocols.",
                          "example": "configured-value"
                        },
                        "prefix": {
                          "type": "string",
                          "description": "Destination prefix for the static route, either IPv4 or\n        IPv6.",
                          "example": "10.0.0.0/24"
                        }
                      },
                      "description": "Operational state data for static routes",
                      "example": "active"
                    },
                    "next-hops": {
                      "type": "object",
                      "properties": {
                        "next-hop": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "interface-ref": {
                                "type": "object",
                                "properties": {
                                  "state": {
                                    "type": "object",
                                    "properties": {
                                      "interface": {
                                        "type": "string",
                                        "description": "Reference to a base interface.  If a reference to a\n        subinterface is required, this leaf must be specified\n        to indicate the base interface.",
                                        "example": "GigabitEthernet1/0/1"
                                      },
                                      "subinterface": {
                                        "type": "string",
                                        "description": "Reference to a subinterface -- this requires the base\n        interface to be specified using the interface leaf in\n        this container.  If only a reference to a base interface\n        is requuired, this leaf should not be set.",
                                        "example": "configured-value"
                                      }
                                    },
                                    "description": "Operational state for interface-ref",
                                    "example": "active"
                                  },
                                  "config": {
                                    "type": "object",
                                    "properties": {
                                      "interface": {
                                        "type": "string",
                                        "description": "Reference to a base interface.  If a reference to a\n        subinterface is required, this leaf must be specified\n        to indicate the base interface.",
                                        "example": "GigabitEthernet1/0/1"
                                      },
                                      "subinterface": {
                                        "type": "string",
                                        "description": "Reference to a subinterface -- this requires the base\n        interface to be specified using the interface leaf in\n        this container.  If only a reference to a base interface\n        is requuired, this leaf should not be set.",
                                        "example": "configured-value"
                                      }
                                    },
                                    "description": "Configured reference to interface / subinterface",
                                    "example": "configured-value"
                                  }
                                },
                                "description": "Reference to an interface or subinterface",
                                "example": "configured-value"
                              },
                              "index": {
                                "type": "string",
                                "description": "A reference to the index of the current next-hop.\n                The index is intended to be a user-specified value\n                which can be used to reference the next-hop in\n                question, without any other semantics being\n                assigned to it.",
                                "example": "0"
                              },
                              "config": {
                                "type": "object",
                                "properties": {
                                  "index": {
                                    "type": "string",
                                    "description": "An user-specified identifier utilised to uniquely reference\n        the next-hop entry in the next-hop list. The value of this\n        index has no semantic meaning other than for referencing\n        the entry.",
                                    "example": "0"
                                  },
                                  "next-hop": {
                                    "type": "string",
                                    "description": "The next-hop that is to be used for the static route\n        - this may be specified as an IP address, an interface\n        or a pre-defined next-hop type - for instance, DROP or\n        LOCAL_LINK. When this leaf is not set, and the interface-ref\n        value is specified for the next-hop, then the system should\n        treat the prefix as though it is directly connected to the\n        interface.",
                                    "example": "10.1.1.1"
                                  },
                                  "metric": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 4294967295,
                                    "description": "A metric which is utilised to specify the preference of\n        the next-hop entry when it is injected into the RIB. The\n        lower the metric, the more preferable the prefix is. When\n        this value is not specified the metric is inherited from\n        the default metric utilised for static routes within the\n        network instance that the static routes are being\n        instantiated. When multiple next-hops are specified for a\n        static route, the metric is utilised to determine which of\n        the next-hops is to be installed in the RIB. When multiple\n        next-hops have the same metric (be it specified, or simply\n        the default) then these next-hops should all be installed\n        in the RIB",
                                    "example": 10
                                  },
                                  "recurse": {
                                    "type": "boolean",
                                    "description": "Determines whether the next-hop should be allowed to\n        be looked up recursively - i.e., via a RIB entry which has\n        been installed by a routing protocol, or another static route\n        - rather than needing to be connected directly to an\n        interface of the local system within the current network\n        instance. When the interface reference specified within the\n        next-hop entry is set (i.e., is not null) then forwarding is\n        restricted to being via the interface specified - and\n        recursion is hence disabled.",
                                    "example": true
                                  }
                                },
                                "description": "Configuration parameters relating to the next-hop\n                entry",
                                "example": "configured-value"
                              },
                              "state": {
                                "type": "object",
                                "properties": {
                                  "index": {
                                    "type": "string",
                                    "description": "An user-specified identifier utilised to uniquely reference\n        the next-hop entry in the next-hop list. The value of this\n        index has no semantic meaning other than for referencing\n        the entry.",
                                    "example": "0"
                                  },
                                  "next-hop": {
                                    "type": "string",
                                    "description": "The next-hop that is to be used for the static route\n        - this may be specified as an IP address, an interface\n        or a pre-defined next-hop type - for instance, DROP or\n        LOCAL_LINK. When this leaf is not set, and the interface-ref\n        value is specified for the next-hop, then the system should\n        treat the prefix as though it is directly connected to the\n        interface.",
                                    "example": "10.1.1.1"
                                  },
                                  "metric": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 4294967295,
                                    "description": "A metric which is utilised to specify the preference of\n        the next-hop entry when it is injected into the RIB. The\n        lower the metric, the more preferable the prefix is. When\n        this value is not specified the metric is inherited from\n        the default metric utilised for static routes within the\n        network instance that the static routes are being\n        instantiated. When multiple next-hops are specified for a\n        static route, the metric is utilised to determine which of\n        the next-hops is to be installed in the RIB. When multiple\n        next-hops have the same metric (be it specified, or simply\n        the default) then these next-hops should all be installed\n        in the RIB",
                                    "example": 10
                                  },
                                  "recurse": {
                                    "type": "boolean",
                                    "description": "Determines whether the next-hop should be allowed to\n        be looked up recursively - i.e., via a RIB entry which has\n        been installed by a routing protocol, or another static route\n        - rather than needing to be connected directly to an\n        interface of the local system within the current network\n        instance. When the interface reference specified within the\n        next-hop entry is set (i.e., is not null) then forwarding is\n        restricted to being via the interface specified - and\n        recursion is hence disabled.",
                                    "example": true
                                  }
                                },
                                "description": "Operational state parameters relating to the\n                next-hop entry",
                                "example": "active"
                              }
                            },
                            "example": "configured-value"
                          },
                          "example": "10.1.1.1",
                          "description": "Next-hop IP address for this route"
                        }
                      },
                      "description": "Configuration and state parameters relating to the\n            next-hops that are to be utilised for the static\n            route being specified",
                      "example": "10.1.1.1"
                    }
                  },
                  "example": "configured-value"
                },
                "example": "configured-value"
              }
            },
            "description": "Enclosing container for the list of static routes",
            "example": "configured-value"
          },
          "local-aggregates": {
            "type": "object",
            "properties": {
              "aggregate": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "prefix": {
                      "type": "string",
                      "description": "Reference to the configured prefix for this aggregate",
                      "example": "10.0.0.0/24"
                    },
                    "config": {
                      "type": "object",
                      "properties": {
                        "set-tag": {
                          "type": "string",
                          "description": "Set a generic tag value on the route. This tag can be\n        used for filtering routes that are distributed to other\n        routing protocols.",
                          "example": "configured-value"
                        },
                        "prefix": {
                          "type": "string",
                          "description": "Aggregate prefix to be advertised",
                          "example": "10.0.0.0/24"
                        },
                        "discard": {
                          "type": "boolean",
                          "description": "When true, install the aggregate route with a discard\n        next-hop -- traffic destined to the aggregate will be\n        discarded with no ICMP message generated.  When false,\n        traffic destined to an aggregate address when no\n        constituent routes are present will generate an ICMP\n        unreachable message.",
                          "example": false
                        }
                      },
                      "description": "Configuration data for aggregate advertisements",
                      "example": "configured-value"
                    },
                    "state": {
                      "type": "object",
                      "properties": {
                        "set-tag": {
                          "type": "string",
                          "description": "Set a generic tag value on the route. This tag can be\n        used for filtering routes that are distributed to other\n        routing protocols.",
                          "example": "configured-value"
                        },
                        "prefix": {
                          "type": "string",
                          "description": "Aggregate prefix to be advertised",
                          "example": "10.0.0.0/24"
                        },
                        "discard": {
                          "type": "boolean",
                          "description": "When true, install the aggregate route with a discard\n        next-hop -- traffic destined to the aggregate will be\n        discarded with no ICMP message generated.  When false,\n        traffic destined to an aggregate address when no\n        constituent routes are present will generate an ICMP\n        unreachable message.",
                          "example": false
                        }
                      },
                      "description": "Operational state data for aggregate\n            advertisements",
                      "example": "active"
                    }
                  },
                  "example": "configured-value"
                },
                "example": "10.0.0.0/24"
              }
            },
            "description": "Enclosing container for locally-defined aggregate\n        routes",
            "example": "configured-value"
          },
          "config": {
            "type": "object",
            "description": "Configuration data for locally defined routes",
            "example": "configured-value"
          },
          "state": {
            "type": "object",
            "description": "Operational state data for locally defined routes",
            "example": "active"
          }
        },
        "example": "configured-value"
      },
      "openconfig-local-routing-config": {
        "type": "object",
        "example": "configured-value"
      },
      "openconfig-local-routing-state": {
        "type": "object",
        "example": "active"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
