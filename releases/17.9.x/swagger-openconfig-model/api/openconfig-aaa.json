{
  "openapi": "3.0.0",
  "info": {
    "title": "openconfig-aaa",
    "description": "This module defines configuration and operational state data\n    related to authorization, authentication, and accounting (AAA)\n    management.\n\n    Portions of this model reuse data definitions or structure from\n    RFC 7317 - A YANG Data Model for System Management\n\n**Module:** `openconfig-aaa`\n**Paths:** 3",
    "version": "17.18.1"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        }
      }
    }
  ],
  "paths": {
