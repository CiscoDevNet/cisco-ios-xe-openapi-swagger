  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "openconfig-aaa-aaa": {
        "type": "object",
        "properties": {
          "authentication": {
            "type": "object",
            "properties": {
              "admin-user": {
                "type": "object",
                "properties": {
                  "config": {
                    "type": "object",
                    "properties": {
                      "admin-password": {
                        "type": "string",
                        "description": "The admin/root password, supplied as a cleartext string.\n        The system should hash and only store the password as a\n        hashed value."
                      },
                      "admin-password-hashed": {
                        "type": "string",
                        "description": "The admin/root password, supplied as a hashed value\n        using the notation described in the definition of the\n        crypt-password-type."
                      }
                    },
                    "description": "Configuration data for the root user account"
                  },
                  "state": {
                    "type": "object",
                    "properties": {
                      "admin-password": {
                        "type": "string",
                        "description": "The admin/root password, supplied as a cleartext string.\n        The system should hash and only store the password as a\n        hashed value."
                      },
                      "admin-password-hashed": {
                        "type": "string",
                        "description": "The admin/root password, supplied as a hashed value\n        using the notation described in the definition of the\n        crypt-password-type."
                      },
                      "admin-username": {
                        "type": "string",
                        "description": "Name of the administrator user account, e.g., admin, root,\n        etc."
                      }
                    },
                    "description": "Operational state data for the root user account"
                  }
                },
                "description": "Top-level container for the system root or admin user\n        configuration and operational state"
              },
              "users": {
                "type": "object",
                "properties": {
                  "user": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "username": {
                          "type": "string",
                          "description": "References the configured username for the user"
                        },
                        "config": {
                          "type": "object",
                          "properties": {
                            "username": {
                              "type": "string",
                              "description": "Assigned username for this user"
                            },
                            "password": {
                              "type": "string",
                              "description": "The user password, supplied as cleartext.  The system\n        must hash the value and only store the hashed value."
                            },
                            "password-hashed": {
                              "type": "string",
                              "description": "The user password, supplied as a hashed value\n        using the notation described in the definition of the\n        crypt-password-type."
                            },
                            "ssh-key": {
                              "type": "string",
                              "description": "SSH public key for the user (RSA or DSA)"
                            },
                            "role": {
                              "type": "string",
                              "description": "Role assigned to the user.  The role may be supplied\n        as a string or a role defined by the SYSTEM_DEFINED_ROLES\n        identity."
                            }
                          },
                          "description": "Configuration data for local users"
                        },
                        "state": {
                          "type": "object",
                          "properties": {
                            "username": {
                              "type": "string",
                              "description": "Assigned username for this user"
                            },
                            "password": {
                              "type": "string",
                              "description": "The user password, supplied as cleartext.  The system\n        must hash the value and only store the hashed value."
                            },
                            "password-hashed": {
                              "type": "string",
                              "description": "The user password, supplied as a hashed value\n        using the notation described in the definition of the\n        crypt-password-type."
                            },
                            "ssh-key": {
                              "type": "string",
                              "description": "SSH public key for the user (RSA or DSA)"
                            },
                            "role": {
                              "type": "string",
                              "description": "Role assigned to the user.  The role may be supplied\n        as a string or a role defined by the SYSTEM_DEFINED_ROLES\n        identity."
                            }
                          },
                          "description": "Operational state data for local users"
                        }
                      }
                    }
                  }
                },
                "description": "Enclosing container list of local users"
              },
              "config": {
                "type": "object",
                "properties": {
                  "authentication-method": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "Ordered list of authentication methods for users.  This\n        can be either a reference to a server group, or a well-\n        defined designation in the AAA_METHOD_TYPE identity.  If\n        authentication fails with one method, the next defined\n        method is tried -- failure of all methods results in the\n        user being denied access."
                    }
                  }
                },
                "description": "Configuration data for global authentication services"
              },
              "state": {
                "type": "object",
                "properties": {
                  "authentication-method": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "Ordered list of authentication methods for users.  This\n        can be either a reference to a server group, or a well-\n        defined designation in the AAA_METHOD_TYPE identity.  If\n        authentication fails with one method, the next defined\n        method is tried -- failure of all methods results in the\n        user being denied access."
                    }
                  }
                },
                "description": "Operational state data for global authentication\n          services"
              }
            },
            "description": "Top-level container for global authentication data"
          },
          "authorization": {
            "type": "object",
            "properties": {
              "events": {
                "type": "object",
                "properties": {
                  "event": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "event-type": {
                          "type": "string",
                          "description": "Reference to the event-type list key"
                        },
                        "config": {
                          "type": "object",
                          "properties": {
                            "event-type": {
                              "type": "string",
                              "description": "The type of event to record at the AAA authorization\n        server"
                            }
                          },
                          "description": "Configuration data for each authorized event"
                        },
                        "state": {
                          "type": "object",
                          "properties": {
                            "event-type": {
                              "type": "string",
                              "description": "The type of event to record at the AAA authorization\n        server"
                            }
                          },
                          "description": "Operational state data for each authorized activity"
                        }
                      }
                    }
                  }
                },
                "description": "Enclosing container for the set of events subject\n        to authorization"
              },
              "config": {
                "type": "object",
                "properties": {
                  "authorization-method": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "Ordered list of methods for authorizing commands.  The first\n        method that provides a response (positive or negative) should\n        be used.  The list may contain a well-defined method such\n        as the set of all TACACS or RADIUS servers, or the name of\n        a defined AAA server group.  The system must validate\n        that the named server group exists."
                    }
                  }
                },
                "description": "Configuration data for authorization based on AAA\n          methods"
              },
              "state": {
                "type": "object",
                "properties": {
                  "authorization-method": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "Ordered list of methods for authorizing commands.  The first\n        method that provides a response (positive or negative) should\n        be used.  The list may contain a well-defined method such\n        as the set of all TACACS or RADIUS servers, or the name of\n        a defined AAA server group.  The system must validate\n        that the named server group exists."
                    }
                  }
                },
                "description": "Operational state data for authorization based on AAA"
              }
            },
            "description": "Top-level container for AAA authorization configuration\n        and operational state data"
          },
          "accounting": {
            "type": "object",
            "properties": {
              "events": {
                "type": "object",
                "properties": {
                  "event": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "event-type": {
                          "type": "string",
                          "description": "Reference to the event-type being logged at the\n            accounting server"
                        },
                        "config": {
                          "type": "object",
                          "properties": {
                            "event-type": {
                              "type": "string",
                              "description": "The type of activity to record at the AAA accounting\n        server"
                            },
                            "record": {
                              "type": "string",
                              "enum": [
                                "START_STOP",
                                "STOP"
                              ],
                              "description": "Send START record to the accounting server at the\n            beginning of the activity, and STOP record at the\n            end of the activity."
                            }
                          },
                          "description": "Configuration data for accounting events"
                        },
                        "state": {
                          "type": "object",
                          "properties": {
                            "event-type": {
                              "type": "string",
                              "description": "The type of activity to record at the AAA accounting\n        server"
                            },
                            "record": {
                              "type": "string",
                              "enum": [
                                "START_STOP",
                                "STOP"
                              ],
                              "description": "Send START record to the accounting server at the\n            beginning of the activity, and STOP record at the\n            end of the activity."
                            }
                          },
                          "description": "Operational state data for accounting events"
                        }
                      }
                    }
                  }
                },
                "description": "Enclosing container for defining handling of events\n        for accounting"
              },
              "config": {
                "type": "object",
                "properties": {
                  "accounting-method": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "An ordered list of methods used for AAA accounting for this\n         event type.  The method is defined by the destination for\n        accounting data, which may be specified as the group of\n        all TACACS+/RADIUS servers, a defined server group, or\n        the local system."
                    }
                  }
                },
                "description": "Configuration data for user activity accounting."
              },
              "state": {
                "type": "object",
                "properties": {
                  "accounting-method": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "An ordered list of methods used for AAA accounting for this\n         event type.  The method is defined by the destination for\n        accounting data, which may be specified as the group of\n        all TACACS+/RADIUS servers, a defined server group, or\n        the local system."
                    }
                  }
                },
                "description": "Operational state data for user accounting."
              }
            },
            "description": "Top-level container for AAA accounting"
          },
          "server-groups": {
            "type": "object",
            "properties": {
              "server-group": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "servers": {
                      "type": "object",
                      "properties": {
                        "server": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "tacacs": {
                                "type": "object",
                                "properties": {
                                  "config": {
                                    "type": "object",
                                    "properties": {
                                      "port": {
                                        "type": "string",
                                        "description": "The port number on which to contact the TACACS server"
                                      },
                                      "secret-key": {
                                        "type": "string",
                                        "description": "The unencrypted shared key used between the authentication\n        server and the device."
                                      },
                                      "secret-key-hashed": {
                                        "type": "string",
                                        "description": "The hashed shared key used between the authentication\n        server and the device."
                                      },
                                      "source-address": {
                                        "type": "string",
                                        "description": "Source IP address to use in messages to the TACACS server"
                                      }
                                    },
                                    "description": "Configuration data for TACACS+ server"
                                  },
                                  "state": {
                                    "type": "object",
                                    "properties": {
                                      "port": {
                                        "type": "string",
                                        "description": "The port number on which to contact the TACACS server"
                                      },
                                      "secret-key": {
                                        "type": "string",
                                        "description": "The unencrypted shared key used between the authentication\n        server and the device."
                                      },
                                      "secret-key-hashed": {
                                        "type": "string",
                                        "description": "The hashed shared key used between the authentication\n        server and the device."
                                      },
                                      "source-address": {
                                        "type": "string",
                                        "description": "Source IP address to use in messages to the TACACS server"
                                      }
                                    },
                                    "description": "Operational state data for TACACS+ server"
                                  }
                                },
                                "description": "Top-level container for TACACS+ server data"
                              },
                              "radius": {
                                "type": "object",
                                "properties": {
                                  "config": {
                                    "type": "object",
                                    "properties": {
                                      "auth-port": {
                                        "type": "string",
                                        "description": "Port number for authentication requests"
                                      },
                                      "acct-port": {
                                        "type": "string",
                                        "description": "Port number for accounting requests"
                                      },
                                      "secret-key": {
                                        "type": "string",
                                        "description": "The unencrypted shared key used between the authentication\n        server and the device."
                                      },
                                      "secret-key-hashed": {
                                        "type": "string",
                                        "description": "The hashed shared key used between the authentication\n        server and the device."
                                      },
                                      "source-address": {
                                        "type": "string",
                                        "description": "Source IP address to use in messages to the RADIUS server"
                                      },
                                      "retransmit-attempts": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 255,
                                        "description": "Number of times the system may resend a request to the\n        RADIUS server when it is unresponsive"
                                      }
                                    },
                                    "description": "Configuration data for RADIUS servers"
                                  },
                                  "state": {
                                    "type": "object",
                                    "properties": {
                                      "auth-port": {
                                        "type": "string",
                                        "description": "Port number for authentication requests"
                                      },
                                      "acct-port": {
                                        "type": "string",
                                        "description": "Port number for accounting requests"
                                      },
                                      "secret-key": {
                                        "type": "string",
                                        "description": "The unencrypted shared key used between the authentication\n        server and the device."
                                      },
                                      "secret-key-hashed": {
                                        "type": "string",
                                        "description": "The hashed shared key used between the authentication\n        server and the device."
                                      },
                                      "source-address": {
                                        "type": "string",
                                        "description": "Source IP address to use in messages to the RADIUS server"
                                      },
                                      "retransmit-attempts": {
                                        "type": "integer",
                                        "minimum": 0,
                                        "maximum": 255,
                                        "description": "Number of times the system may resend a request to the\n        RADIUS server when it is unresponsive"
                                      },
                                      "counters": {
                                        "type": "object",
                                        "properties": {
                                          "retried-access-requests": {
                                            "type": "string",
                                            "description": "Retransmitted Access-Request messages."
                                          },
                                          "access-accepts": {
                                            "type": "string",
                                            "description": "Received Access-Accept messages."
                                          },
                                          "access-rejects": {
                                            "type": "string",
                                            "description": "Received Access-Reject messages."
                                          },
                                          "timeout-access-requests": {
                                            "type": "string",
                                            "description": "Access-Request messages that have timed-out,\n          requiring retransmission."
                                          }
                                        },
                                        "description": "A collection of RADIUS related state objects."
                                      }
                                    },
                                    "description": "Operational state data for RADIUS servers"
                                  }
                                },
                                "description": "Top-level container for RADIUS server data"
                              },
                              "address": {
                                "type": "string",
                                "description": "Reference to the configured address of the AAA server"
                              },
                              "config": {
                                "type": "object",
                                "properties": {
                                  "name": {
                                    "type": "string",
                                    "description": "Name assigned to the server"
                                  },
                                  "address": {
                                    "type": "string",
                                    "description": "Address of the authentication server"
                                  },
                                  "timeout": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 65535,
                                    "description": "Set the timeout in seconds on responses from the AAA\n        server"
                                  }
                                },
                                "description": "Configuration data "
                              },
                              "state": {
                                "type": "object",
                                "properties": {
                                  "name": {
