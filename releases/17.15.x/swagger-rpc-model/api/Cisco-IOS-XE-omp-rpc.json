{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco-IOS-XE-omp-rpc - RPC Operations",
    "description": "Copyright (c) 2024 by Cisco Systems, Inc.\n     All rights reserved.\n\n**Module:** `Cisco-IOS-XE-omp-rpc`\n**Version:** 2024-07-01\n**Operations:** 1",
    "version": "2024-07-01"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/omp_rpc:sdwan-clear-omp": {
      "post": {
        "summary": "A SDWAN specific RPC action to clear the routing information base (RIB)\n       of overlay management protocol (OMP)",
        "description": "A SDWAN specific RPC action to clear the routing information base (RIB)\n       of overlay management protocol (OMP)\n\n**Endpoint:** `POST /restconf/operations/omp_rpc:sdwan-clear-omp`",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-omp-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "omp_rpc:sdwan-clear-omp": {
                    "type": "object",
                    "properties": {
                      "peer": {
                        "type": "object",
                        "properties": {
                          "tenant-id": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 65534,
                            "description": "Tenant ID",
                            "example": 1
                          },
                          "address": {
                            "type": "string",
                            "description": "IPv4 address of a peer",
                            "example": "10.1.1.1"
                          },
                          "soft": {
                            "type": "string",
                            "description": "Re-evaluate the peer's information with a soft reset.\n         If not specify this value, it will take a hard reset.",
                            "example": "configured-value"
                          }
                        },
                        "required": [
                          "address"
                        ],
                        "description": "Clear OMP's peer",
                        "example": "configured-value"
                      },
                      "routes": {
                        "type": "object",
                        "properties": {
                          "tenant-id": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 65534,
                            "description": "Tenant ID, default 0",
                            "default": "0",
                            "example": 1
                          }
                        },
                        "description": "Clear OMP's routes",
                        "example": "configured-value"
                      },
                      "multicast": {
                        "type": "object",
                        "properties": {
                          "vpn": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 65531,
                            "description": "VPN ID",
                            "example": 1
                          }
                        },
                        "required": [
                          "vpn"
                        ],
                        "description": "Clear OMP's multicast",
                        "example": "configured-value"
                      },
                      "tlocs": {
                        "type": "string",
                        "description": "Clear OMP's transport locators",
                        "example": "configured-value"
                      },
                      "identity": {
                        "type": "string",
                        "description": "Clear OMP's identity",
                        "example": "1"
                      },
                      "all": {
                        "type": "string",
                        "description": "Clear OMP's all RIB",
                        "example": "configured-value"
                      },
                      "l2-routes": {
                        "type": "object",
                        "properties": {
                          "clear-all-vpn": {
                            "type": "string",
                            "description": "Clear OMP's layer2 routes with all configured L2VPN",
                            "example": "configured-value"
                          },
                          "vpn": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 65531,
                            "description": "Layer2 VPN ID",
                            "example": 1
                          },
                          "vc-id": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 4294967295,
                            "description": "Virtual circuit ID",
                            "example": 1
                          }
                        },
                        "description": "Clear OMP's layer2 routes",
                        "example": "configured-value"
                      }
                    },
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "omp_rpc:sdwan-clear-omp": {
                  "peer": {
                    "tenant-id": 10,
                    "address": "10.1.1.1",
                    "soft": "configured-value"
                  },
                  "routes": {
                    "tenant-id": 10
                  },
                  "multicast": {
                    "vpn": 10
                  },
                  "tlocs": "configured-value",
                  "identity": "1",
                  "all": "configured-value",
                  "l2-routes": {
                    "clear-all-vpn": "configured-value",
                    "vpn": 10,
                    "vc-id": 10
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "omp_rpc:sdwan-clear-omp": {
                      "type": "object",
                      "example": "configured-value"
                    }
                  },
                  "example": "configured-value"
                },
                "example": {
                  "omp_rpc:sdwan-clear-omp": {
                    "omp_rpc:sdwan-clear-omp": [
                      null
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ]
}
