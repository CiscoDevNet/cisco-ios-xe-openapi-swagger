{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco-IOS-XE-ucse-rpc - RPC Operations",
    "description": "NED UCSE (Unified Computing System E-Series) RPC YANG module for IOS\n     Copyright (c) 2019 by Cisco Systems, Inc.\n     All rights reserved.\n\n**Module:** `Cisco-IOS-XE-ucse-rpc`\n**Version:** 2022-11-01\n**Operations:** 1",
    "version": "2022-11-01"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/ucse_rpc:ucse": {
      "post": {
        "summary": "UCSE (Unified Computing System E-Series) commands",
        "description": "UCSE (Unified Computing System E-Series) commands\n\n**Endpoint:** `POST /restconf/operations/ucse_rpc:ucse`",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-ucse-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ucse_rpc:ucse": {
                    "type": "object",
                    "properties": {
                      "subslot": {
                        "type": "string",
                        "pattern": "[0-2]/[0-3]",
                        "description": "UCSE (Unified Computing System E-Series) subslot"
                      },
                      "imc": {
                        "type": "object",
                        "properties": {
                          "password-reset": {
                            "type": "string",
                            "description": "Reset the password for IMC (Integrated Management Controller)"
                          }
                        },
                        "description": "IMC (Integrated Management Controller) command"
                      },
                      "server": {
                        "type": "object",
                        "properties": {
                          "cmos-reset": {
                            "type": "string",
                            "description": "Reset the CMOS password for the server"
                          },
                          "password-reset": {
                            "type": "object",
                            "properties": {
                              "BIOS": {
                                "type": "string",
                                "description": "Reset the BIOS password for the server"
                              }
                            },
                            "description": "Reset the password for the server"
                          },
                          "reload": {
                            "type": "string",
                            "description": "Reload the server"
                          },
                          "reset": {
                            "type": "string",
                            "description": "Reset the server"
                          },
                          "start": {
                            "type": "string",
                            "description": "Start the server"
                          },
                          "stop": {
                            "type": "string",
                            "description": "Stop the server"
                          }
                        },
                        "x-yang-choices": [
                          {
                            "name": "server-command-choice",
                            "mandatory": false,
                            "cases": [
                              {
                                "name": "server-cmos-password-reset",
                                "properties": [
                                  "cmos-reset"
                                ]
                              },
                              {
                                "name": "server-password-reset",
                                "properties": [
                                  "password-reset"
                                ]
                              },
                              {
                                "name": "server-reload",
                                "properties": [
                                  "reload"
                                ]
                              },
                              {
                                "name": "server-reset",
                                "properties": [
                                  "reset"
                                ]
                              },
                              {
                                "name": "server-start",
                                "properties": [
                                  "start"
                                ]
                              },
                              {
                                "name": "server-stop",
                                "properties": [
                                  "stop"
                                ]
                              }
                            ]
                          }
                        ],
                        "description": "Server commands"
                      },
                      "shutdown": {
                        "type": "string",
                        "description": "Shutdown the UCSE (Unified Computing System E-Series) module"
                      },
                      "statistics": {
                        "type": "object",
                        "properties": {
                          "clear": {
                            "type": "string",
                            "description": "Clear the statistics"
                          }
                        },
                        "description": "Statistics command"
                      }
                    },
                    "required": [
                      "subslot"
                    ],
                    "x-yang-choices": [
                      {
                        "name": "command-choice",
                        "mandatory": true,
                        "cases": [
                          {
                            "name": "imc-case",
                            "properties": [
                              "imc"
                            ]
                          },
                          {
                            "name": "server-case",
                            "properties": [
                              "server"
                            ]
                          },
                          {
                            "name": "shutdown-case",
                            "properties": [
                              "shutdown"
                            ]
                          },
                          {
                            "name": "statistics-case",
                            "properties": [
                              "statistics"
                            ]
                          }
                        ]
                      }
                    ],
                    "description": "YANG choice \u2014 mutually exclusive case groups: choice 'command-choice' (mandatory): imc-case | server-case | shutdown-case | statistics-case."
                  }
                }
              },
              "example": {
                "ucse_rpc:ucse": {
                  "subslot": "example-string",
                  "imc": {
                    "password-reset": "Cisco123!"
                  },
                  "server": {
                    "cmos-reset": "example-string",
                    "password-reset": {
                      "BIOS": "example-string"
                    },
                    "reload": "example-string",
                    "reset": "example-string",
                    "start": "example-string",
                    "stop": "example-string"
                  },
                  "shutdown": "example-string",
                  "statistics": {
                    "clear": "example-string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ucse_rpc:ucse": {
                      "type": "object"
                    }
                  }
                },
                "example": {
                  "ucse_rpc:ucse": {}
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ]
}
