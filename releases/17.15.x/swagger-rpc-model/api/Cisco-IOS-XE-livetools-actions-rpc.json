    "title": "Cisco-IOS-XE-livetools-actions-rpc - RPC Operations",
    "description": "This module contains a collection of YANG definitions\n     for live tools action RPC.\n     Copyright (c) 2024 by Cisco Systems, Inc.\n     All rights reserved.\n\n**Module:** `Cisco-IOS-XE-livetools-actions-rpc`\n**Version:** 2024-07-01\n**Operations:** 5",
    "version": "2024-07-01"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/livetools_actions_rpc:wol-action": {
      "post": {
        "summary": "This RPC is used to test the WAKE-ON-LAN feature execution and it returns\n       with an 'JOB ID' if the RPC execution was successful",
        "description": "This RPC is used to test the WAKE-ON-LAN feature execution and it returns\n       with an 'JOB ID' if the RPC execution was successful\n\n**Endpoint:** `POST /restconf/operations/livetools_actions_rpc:wol-action`",
        "operationId": "post-root-5",
        "tags": [
          "Cisco-IOS-XE-livetools-actions-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "livetools_actions_rpc:wol-action": {
                    "type": "object",
                    "properties": {
                      "mac-addr": {
                        "type": "string",
                        "description": "Destination MAC address"
                      },
                      "vlan": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4094,
                        "description": "Destination VLAN identifier",
                        "default": "1"
                      },
                      "interval": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3600,
                        "description": "Interval between retries",
                        "default": "120"
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 255,
                        "description": "Number of packets to be sent",
                        "default": "1"
                      }
                    },
                    "required": [
                      "mac-addr"
                    ]
                  }
                }
              },
              "example": {
                "livetools_actions_rpc:wol-action": {
                  "mac-addr": "00:11:22:33:44:55",
                  "vlan": 100,
                  "interval": 10,
                  "count": 10
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "livetools_actions_rpc:wol-action": {
                      "type": "object",
                      "properties": {
                        "job-id": {
                          "type": "string",
                          "description": "The ID is a unique identifier generated per RPC request.\n         It is used in conjunction with the WAKE-ON-LAN oper model,\n         allowing us to retrieve the operational data associated with a\n         specific ID. This is useful for matching an action RPC response ID\n         with the corresponding operational data"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "livetools_actions_rpc:wol-action": {
                    "job-id": "example-string"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/operations/livetools_actions_rpc:thrpt-action": {
      "post": {
        "summary": "Network throughput measurement",
        "description": "Network throughput measurement\n\n**Endpoint:** `POST /restconf/operations/livetools_actions_rpc:thrpt-action`",
        "operationId": "post-root-4",
        "tags": [
          "Cisco-IOS-XE-livetools-actions-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "livetools_actions_rpc:thrpt-action": {
                    "type": "object",
                    "properties": {
                      "proto": {
                        "type": "string",
                        "description": "Role of throughput tool: client/server",
                        "default": "thrpt-tcp-client"
                      },
                      "dest-addr": {
                        "type": "string",
                        "description": "Server IP address"
                      },
                      "ni-type": {
                        "type": "string",
                        "description": "Network instance type. Differentiates between the\n         default routing instance and VRFs",
                        "default": "net-inst-default"
                      },
                      "ni-name": {
                        "type": "string",
                        "description": "Network instance name. If the type is\n         net-inst-default, the name is not meaningful"
                      },
                      "timeout": {
                        "type": "string",
                        "description": "Measurement time",
                        "default": "5"
                      },
                      "wnd-span": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4294967295,
                        "description": "Duration of measurement window(s)",
                        "default": "1"
                      },
                      "num-wnds": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 4294967295,
                        "description": "Number of windows",
                        "default": "5"
                      },
                      "port": {
                        "type": "string",
                        "description": "Server transport port"
                      },
                      "dscp": {
                        "type": "string",
                        "description": "Numeric value of DSCP used during traffic generation",
                        "default": "0"
                      },
                      "client-rcv": {
                        "type": "string",
                        "description": "Flag to indicate that client should receive/read\n         data from the server instead of the default mode of writing data to\n         the server for throughput measurement",
                        "default": "false"
                      },
                      "mode": {
                        "type": "string",
                        "description": "Measurement mode",
                        "default": "thrpt-mode-full"
                      }
                    }
                  }
                }
              },
              "example": {
                "livetools_actions_rpc:thrpt-action": {
                  "proto": "example-string",
                  "dest-addr": "192.168.1.1",
                  "ni-type": "example-string",
                  "ni-name": "example-string",
                  "timeout": "example-string",
                  "wnd-span": 10,
                  "num-wnds": 10,
                  "port": "example-string",
                  "dscp": "example-string",
                  "client-rcv": "example-string",
                  "mode": "example-string"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "livetools_actions_rpc:thrpt-action": {
                      "type": "object",
                      "properties": {
                        "job-id": {
                          "type": "string",
                          "description": "The ID is a unique identifier generated per RPC request.\n         It is used in conjunction with the throughput oper model,\n         allowing us to retrieve the operational data associated with a\n         specific ID. This is useful for matching an action RPC response ID\n         with the corresponding operational data"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "livetools_actions_rpc:thrpt-action": {
                    "job-id": "example-string"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
