                        "type": "integer",
                        "minimum": 0,
                        "maximum": 30,
                        "description": "Minimum value of time to live(TTL) for an IP packet",
                        "default": "1"
                      },
                      "max-ttl": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 30,
                        "description": "Maximum value of time to live(TTL) for an IP packet",
                        "default": "30"
                      },
                      "dscp-num": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 63,
                        "description": "DSCP numeric value"
                      },
                      "dscp-ascii": {
                        "type": "string",
                        "description": "DSCP ascii value selected from a set of known DSCP options"
                      },
                      "src-if": {
                        "type": "string",
                        "description": "Source interface name"
                      },
                      "src-ip": {
                        "type": "string",
                        "description": "Source IP/IPv6 address"
                      },
                      "host-name": {
                        "type": "string",
                        "description": "Destination host name"
                      },
                      "host-ip": {
                        "type": "string",
                        "description": "Destination host IP address"
                      }
                    },
                    "required": [
                      "dscp-num",
                      "dscp-ascii",
                      "src-if",
                      "src-ip",
                      "host-name",
                      "host-ip"
                    ]
                  }
                }
              },
              "example": {
                "livetools_actions_rpc:ip-tracert-action": {
                  "ni-type": "example-string",
                  "ni-name": "example-string",
                  "num-probes": 5,
                  "port": 8080,
                  "timeout": 30,
                  "min-ttl": 10,
                  "max-ttl": 10,
                  "dscp-num": 10,
                  "dscp-ascii": "example-string",
                  "src-if": "GigabitEthernet1/0/1",
                  "src-ip": "2001:db8::1",
                  "host-name": "router1.example.com",
                  "host-ip": "192.168.1.1"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "livetools_actions_rpc:ip-tracert-action": {
                      "type": "object",
                      "properties": {
                        "job-id": {
                          "type": "string",
                          "description": "The ID is a unique identifier generated per RPC request.\n         It is used in conjunction with the IP trace route,\n         allowing us to retrieve the operational data associated with a\n         specific ID. This is useful for matching an action RPC response ID\n         with the corresponding operational data."
                        }
                      }
                    }
                  }
                },
                "example": {
                  "livetools_actions_rpc:ip-tracert-action": {
                    "job-id": "example-string"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
