  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "openconfig-procmon-processes": {
        "type": "object",
        "properties": {
          "process": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pid": {
                  "type": "string",
                  "description": "Reference to the process pid key",
                  "example": "C9300-48P"
                },
                "state": {
                  "type": "object",
                  "properties": {
                    "pid": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "The process pid",
                      "example": 1
                    },
                    "name": {
                      "type": "string",
                      "description": "The process name",
                      "example": "example-1"
                    },
                    "start-time": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "The time at which this process started,\n        reported as nanoseconds since the UNIX epoch.  The\n        system must be synchronized such that the start-time\n        can be reported accurately, otherwise it should not be\n        reported.",
                      "example": 1
                    },
                    "uptime": {
                      "type": "string",
                      "description": "Amount of time elapsed since this process started.",
                      "example": "651780"
                    },
                    "cpu-usage-user": {
                      "type": "string",
                      "description": "CPU time consumed by this process in user mode.",
                      "example": "5"
                    },
                    "cpu-usage-system": {
                      "type": "string",
                      "description": "CPU time consumed by this process in kernel mode.",
                      "example": "5"
                    },
                    "cpu-utilization": {
                      "type": "string",
                      "description": "The percentage of CPU that is being used by the process.",
                      "example": "5"
                    },
                    "memory-usage": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Bytes allocated and still in use by the process",
                      "example": 45
                    },
                    "memory-utilization": {
                      "type": "string",
                      "description": "The percentage of RAM that is being used by the process.",
                      "example": "15"
                    },
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "description": "Current process command line arguments.  Arguments with\n        a parameter (e.g., --option 10  or -option=10) should be\n        represented as a single element of the list with the\n        argument name and parameter together.  Flag arguments, i.e.,\n        those without a parameter should also be in their own list\n        element.",
                        "example": "configured-value"
                      },
                      "example": "configured-value"
                    }
                  },
                  "description": "State parameters related to monitored processes",
                  "example": "active"
                }
              },
              "example": "configured-value"
            },
            "example": "configured-value"
          }
        },
        "example": "configured-value"
      },
      "openconfig-procmon-state": {
        "type": "object",
        "properties": {
          "pid": {
            "type": "integer",
            "minimum": 0,
            "description": "The process pid",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "The process name",
            "example": "example-1"
          },
          "start-time": {
            "type": "integer",
            "minimum": 0,
            "description": "The time at which this process started,\n        reported as nanoseconds since the UNIX epoch.  The\n        system must be synchronized such that the start-time\n        can be reported accurately, otherwise it should not be\n        reported.",
            "example": 1
          },
          "uptime": {
            "type": "string",
            "description": "Amount of time elapsed since this process started.",
            "example": "651780"
          },
          "cpu-usage-user": {
            "type": "string",
            "description": "CPU time consumed by this process in user mode.",
            "example": "5"
          },
          "cpu-usage-system": {
            "type": "string",
            "description": "CPU time consumed by this process in kernel mode.",
            "example": "5"
          },
          "cpu-utilization": {
            "type": "string",
            "description": "The percentage of CPU that is being used by the process.",
            "example": "5"
          },
          "memory-usage": {
            "type": "integer",
            "minimum": 0,
            "description": "Bytes allocated and still in use by the process",
            "example": 45
          },
          "memory-utilization": {
