        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cisco_bridge_domain:create-parameterized-bridge-domains": {
                    "type": "object",
                    "properties": {
                      "parameter": {
                        "type": "string",
                        "description": "Create bridge-domains from vlan encapsulations of the\n               member interfaces.",
                        "example": "configured-value"
                      }
                    },
                    "example": 1
                  }
                },
                "example": 1
              },
              "example": {
                "cisco_bridge_domain:create-parameterized-bridge-domains": {
                  "parameter": "GigabitEthernet1/0/1"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cisco_bridge_domain:create-parameterized-bridge-domains": {
                      "type": "object",
                      "properties": {
                        "errstr": {
                          "type": "string",
                          "description": "Error message from the device if RPC failed.",
                          "example": "configured-value"
                        }
                      },
                      "example": 1
                    }
                  },
                  "example": 1
                },
                "example": {
                  "cisco_bridge_domain:create-parameterized-bridge-domains": {
                    "errstr": "configured-value"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
