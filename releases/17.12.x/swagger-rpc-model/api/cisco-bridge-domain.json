  "openapi": "3.0.0",
  "info": {
    "title": "cisco-bridge-domain - RPC Operations",
    "description": "This YANG module describes the configuration and operational\n     model for bridge domain.\n\n     Terms and Acronyms\n       AC : Attachment Circuits\n\n       BD : Bridge Domain\n\n       BCB : Backbone Core Bridge\n\n       BEB : Backbone Edge Bridge\n\n       B-MAC : Backbone MAC Address\n\n       CE : Customer Edge\n\n       C-MAC : Customer/Client MAC Address\n\n       DHCP : Dynamic Host Configuration Protocol\n\n       DAI : Dynamic ARP Inspection\n\n       EVC : Ethernet Virtual Circuit\n\n       IGMP : Internet Group Management Protocol\n\n       IPSG : IP Source Guard\n\n       L2VPN : Layer 2 Virtual Private Network\n\n       MLD : Multicast Listener Discovery\n\n       PBB : Provider Backbone Bridge\n\n       VLAN : Virtual Local Area Network\n    \n\n**Module:** `cisco-bridge-domain`\n**Version:** 2019-07-01\n**Operations:** 3",
    "version": "2019-07-01"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/cisco_bridge_domain:clear-bridge-domain": {
      "post": {
        "summary": "Clear mac-address table for bridge-domain and allows a bridge\n       to forward again after it was put in shutdown state as a\n       result of exceeding the configured MAC limit.",
        "description": "Clear mac-address table for bridge-domain and allows a bridge\n       to forward again after it was put in shutdown state as a\n       result of exceeding the configured MAC limit.\n\n**Endpoint:** `POST /restconf/operations/cisco_bridge_domain:clear-bridge-domain`",
        "operationId": "post-root",
        "tags": [
          "cisco-bridge-domain"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cisco_bridge_domain:clear-bridge-domain": {
                    "type": "object",
                    "example": 1
                  }
                },
                "example": 1
              },
              "example": {
                "cisco_bridge_domain:clear-bridge-domain": {
                  "cisco_bridge_domain:clear-bridge-domain": 1
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cisco_bridge_domain:clear-bridge-domain": {
                      "type": "object",
                      "properties": {
                        "errstr": {
                          "type": "string",
                          "description": "Error message from the device if RPC failed.",
                          "example": "configured-value"
                        }
                      },
                      "example": 1
                    }
                  },
                  "example": 1
                },
                "example": {
                  "cisco_bridge_domain:clear-bridge-domain": {
                    "errstr": "configured-value"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/operations/cisco_bridge_domain:clear-mac-address": {
      "post": {
        "summary": "This RPC allows to clear dynamically learnt mac-address\n       entries from the mac-address table.",
        "description": "This RPC allows to clear dynamically learnt mac-address\n       entries from the mac-address table.\n\n**Endpoint:** `POST /restconf/operations/cisco_bridge_domain:clear-mac-address`",
        "operationId": "post-root-2",
        "tags": [
          "cisco-bridge-domain"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cisco_bridge_domain:clear-mac-address": {
                    "type": "object",
                    "properties": {
                      "interface": {
                        "type": "string",
                        "description": "Reference to an interface. Clear mac-addesses learnt by\n           by this interface.",
                        "example": "GigabitEthernet1/0/1"
                      },
                      "mac-address": {
                        "type": "string",
                        "description": "Clear a specific mac-address entry from the mac-table.",
                        "example": "00:1a:2b:3c:4d:5e"
                      },
                      "bridge-domain": {
                        "type": "object",
                        "properties": {
                          "bd-id": {
                            "type": "string",
                            "description": "Bridge-domain identifier, clear all mac-address entries\n             dynamically learnt on this bridge-domain",
                            "example": "1"
                          },
                          "bg-id": {
                            "type": "string",
                            "description": "Bridge-group identifier, clear all mac-address entries\n             from all bridge-domains under this bridge-group.",
                            "example": "1"
                          }
                        },
                        "required": [
                          "bd-id",
                          "bg-id"
                        ],
                        "description": "Clear mac-address entries for given bridge-domain(s).",
                        "example": 1
                      }
                    },
                    "example": "00:1a:2b:3c:4d:5e"
                  }
                },
                "example": "00:1a:2b:3c:4d:5e"
              },
              "example": {
                "cisco_bridge_domain:clear-mac-address": {
                  "interface": "GigabitEthernet1/0/1",
                  "mac-address": "00:11:22:33:44:55",
                  "bridge-domain": {
                    "bd-id": "1",
                    "bg-id": "1"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cisco_bridge_domain:clear-mac-address": {
                      "type": "object",
                      "properties": {
                        "errstr": {
                          "type": "string",
                          "description": "Error message from the device if RPC failed.",
                          "example": "configured-value"
                        }
                      },
                      "example": "00:1a:2b:3c:4d:5e"
                    }
                  },
                  "example": "00:1a:2b:3c:4d:5e"
                },
                "example": {
                  "cisco_bridge_domain:clear-mac-address": {
                    "errstr": "configured-value"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
