  "paths": {
    "/operations/wireless_client_rpc:clear-sisf-binding-state": {
      "post": {
        "summary": "Delete client binding entry based on client MAC and entry state",
        "description": "Delete client binding entry based on client MAC and entry state\n\n**Endpoint:** `POST /restconf/operations/wireless_client_rpc:clear-sisf-binding-state`",
        "operationId": "post-root-2",
        "tags": [
          "Cisco-IOS-XE-wireless-client-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "wireless_client_rpc:clear-sisf-binding-state": {
                    "type": "object",
                    "properties": {
                      "entry-mac-address": {
                        "type": "string",
                        "description": "Wireless Client MAC address"
                      },
                      "binding-state": {
                        "type": "string",
                        "description": "Client binding state"
                      }
                    },
                    "required": [
                      "entry-mac-address",
                      "binding-state"
                    ]
                  }
                }
              },
              "example": {
                "wireless_client_rpc:clear-sisf-binding-state": {
                  "entry-mac-address": "00:11:22:33:44:55",
                  "binding-state": "example-string"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "wireless_client_rpc:clear-sisf-binding-state": {
                      "type": "object"
                    }
                  }
                },
                "example": {
                  "wireless_client_rpc:clear-sisf-binding-state": {}
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/operations/wireless_client_rpc:clear-sisf-binding-ip": {
      "post": {
        "summary": "Delete client binding entry based on client MAC and IP address",
        "description": "Delete client binding entry based on client MAC and IP address\n\n**Endpoint:** `POST /restconf/operations/wireless_client_rpc:clear-sisf-binding-ip`",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-wireless-client-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "wireless_client_rpc:clear-sisf-binding-ip": {
                    "type": "object",
                    "properties": {
                      "entry-mac-address": {
                        "type": "string",
                        "description": "Wireless Client MAC address"
                      },
                      "ip-addr": {
                        "type": "string",
                        "description": "Binding entry IP address"
                      },
                      "zone-id": {
                        "type": "string",
                        "description": "Binding entry zone-id",
                        "default": "0"
                      }
                    },
                    "required": [
                      "entry-mac-address",
                      "ip-addr"
                    ]
                  }
                }
              },
              "example": {
                "wireless_client_rpc:clear-sisf-binding-ip": {
                  "entry-mac-address": "00:11:22:33:44:55",
                  "ip-addr": "192.168.1.1",
                  "zone-id": "example-string"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "wireless_client_rpc:clear-sisf-binding-ip": {
                      "type": "object"
                    }
                  }
                },
                "example": {
                  "wireless_client_rpc:clear-sisf-binding-ip": {}
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
