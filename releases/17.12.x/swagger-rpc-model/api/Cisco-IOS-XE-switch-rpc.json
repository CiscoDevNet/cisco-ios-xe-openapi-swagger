{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco-IOS-XE-switch-rpc - RPC Operations",
    "description": "NED Switch RPC YANG module for IOS\n     Copyright (c) 2016-2019 by Cisco Systems, Inc.\n     All rights reserved.\n\n**Module:** `Cisco-IOS-XE-switch-rpc`\n**Version:** 2022-11-01\n**Operations:** 1",
    "version": "2022-11-01"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/switch_rpc:switch": {
      "post": {
        "summary": "<1-15>  Switch Priority",
        "description": "<1-15>  Switch Priority\n\n**Endpoint:** `POST /restconf/operations/switch_rpc:switch`",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-switch-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "switch_rpc:switch": {
                    "type": "object",
                    "properties": {
                      "switch-number-drop-node-name": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16
                      },
                      "priority": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 15,
                        "description": "<1-15>  Switch Priority"
                      },
                      "renumber": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16,
                        "description": "<1-16>  New number of the Switch"
                      },
                      "statck": {
                        "type": "object",
                        "properties": {
                          "port": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 2,
                            "description": "<1-2>  Stack port number to enable/disable"
                          }
                        },
                        "description": "<1-2>  Stack port number to enable/disable"
                      }
                    },
                    "required": [
                      "switch-number-drop-node-name"
                    ],
                    "x-yang-choices": [
                      {
                        "name": "pri-renum-stack",
                        "mandatory": true,
                        "cases": [
                          {
                            "name": "priority-case",
                            "properties": [
                              "priority"
                            ]
                          },
                          {
                            "name": "renumver-case",
                            "properties": [
                              "renumber"
                            ]
                          },
                          {
                            "name": "stack-case",
                            "properties": [
                              "statck"
                            ]
                          }
                        ]
                      }
                    ],
                    "description": "YANG choice \u2014 mutually exclusive case groups: choice 'pri-renum-stack' (mandatory): priority-case | renumver-case | stack-case."
                  }
                }
              },
              "example": {
                "switch_rpc:switch": {
                  "switch-number-drop-node-name": 10,
                  "priority": 10,
                  "renumber": 10,
                  "statck": {
                    "port": 8080
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "switch_rpc:switch": {
                      "type": "object"
                    }
                  }
                },
                "example": {
                  "switch_rpc:switch": {}
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ]
}
