{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco-IOS-XE-cli-rpc - RPC Operations",
    "description": "This module contains a collection of YANG definitions\n     for RPCs related to the Command Line Interface (CLI).\n     Copyright (c) 2022 by Cisco Systems, Inc.\n     All rights reserved.\n\n**Module:** `Cisco-IOS-XE-cli-rpc`\n**Version:** 2022-11-01\n**Operations:** 2",
    "version": "2022-11-01"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/cli_rpc:config-ios-cli-rpc": {
      "post": {
        "summary": "Configure CLIs directly to the IOS, bypassing NETCONF transaction",
        "description": "Configure CLIs directly to the IOS, bypassing NETCONF transaction\n\n**Endpoint:** `POST /restconf/operations/cli_rpc:config-ios-cli-rpc`",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-cli-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cli_rpc:config-ios-cli-rpc": {
                    "type": "object",
                    "properties": {
                      "config-clis": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60000,
                        "description": "Configuration CLI commands",
                        "example": "configured-value"
                      },
                      "timeout": {
                        "type": "integer",
                        "minimum": 10,
                        "maximum": 1800,
                        "description": "Configurable timeout for the RPC",
                        "default": "300",
                        "example": 1
                      }
                    },
                    "required": [
                      "config-clis"
                    ],
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "cli_rpc:config-ios-cli-rpc": {
                  "config-clis": "configured-value",
                  "timeout": 30
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cli_rpc:config-ios-cli-rpc": {
                      "type": "object",
                      "properties": {
                        "result": {
                          "type": "string",
                          "description": "Output returned by the network element",
                          "example": "success"
                        },
                        "lineno": {
                          "type": "string",
                          "description": "line number of the failed CLI",
                          "example": "configured-value"
                        },
                        "error-code": {
                          "type": "string",
                          "description": "Error code returned by the parser",
                          "example": "0"
                        },
                        "error-string": {
                          "type": "string",
                          "description": "Error string",
                          "example": "0"
                        },
                        "error-tag": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64,
                          "description": "supplied error tag that matched the error-pattern",
                          "example": "0"
                        }
                      },
                      "example": "configured-value"
                    }
                  },
                  "example": "configured-value"
                },
                "example": {
                  "cli_rpc:config-ios-cli-rpc": {
                    "result": "success",
                    "lineno": "configured-value",
                    "error-code": "0",
                    "error-string": "0",
                    "error-tag": "0"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/operations/cli_rpc:config-ios-cli-trans": {
      "post": {
        "summary": "Configure IOS CLI using NETCONF transaction",
        "description": "Configure IOS CLI using NETCONF transaction\n\n**Endpoint:** `POST /restconf/operations/cli_rpc:config-ios-cli-trans`",
        "operationId": "post-root-2",
        "tags": [
          "Cisco-IOS-XE-cli-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cli_rpc:config-ios-cli-trans": {
                    "type": "object",
                    "properties": {
                      "clis": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60000,
                        "description": "Configuration CLI commands",
                        "example": "configured-value"
                      },
                      "do-commit": {
                        "type": "string",
                        "description": "Copy the CLI commands from candidate datastore\n           to running datastore in candidate mode. ",
                        "default": "true",
                        "example": "configured-value"
                      }
                    },
                    "required": [
                      "clis"
                    ],
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "cli_rpc:config-ios-cli-trans": {
                  "clis": "configured-value",
                  "do-commit": "configured-value"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cli_rpc:config-ios-cli-trans": {
                      "type": "object",
                      "properties": {
                        "result": {
                          "type": "string",
                          "description": "Output returned by the network element",
                          "example": "success"
                        }
                      },
                      "example": "configured-value"
                    }
                  },
                  "example": "configured-value"
                },
                "example": {
                  "cli_rpc:config-ios-cli-trans": {
                    "result": "success"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ]
}
