{
  "openapi": "3.0.0",
  "info": {
    "title": "openconfig-macsec",
    "description": "This module defines configuration and state data for\n     MACsec IEEE Std 802.1AE-2018.\n\n**Module:** `openconfig-macsec`\n**Paths:** 1",
    "version": "17.18.1"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        }
      }
    }
  ],
  "paths": {
    "/data/openconfig-macsec:macsec": {
      "get": {
        "summary": "Get macsec",
        "description": "The MACsec",
        "operationId": "get-root",
        "tags": [
          "openconfig-macsec"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "openconfig-macsec:macsec": {
                      "$ref": "#/components/schemas/openconfig-macsec-macsec"
                    }
                  },
                  "example": "00:1a:2b:3c:4d:5e"
                }
              }
            }
          },
          "404": {
            "description": "Resource not found"
          }
        }
      },
      "put": {
        "summary": "Create or replace macsec",
        "description": "Create or replace The MACsec",
        "operationId": "put-root",
        "tags": [
          "openconfig-macsec"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "openconfig-macsec:macsec": {
                    "$ref": "#/components/schemas/openconfig-macsec-macsec"
                  }
                },
                "example": "00:1a:2b:3c:4d:5e"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "204": {
            "description": "Updated"
          },
          "400": {
            "description": "Bad request"
          }
        }
      },
      "patch": {
        "summary": "Modify macsec",
        "description": "Partially modify The MACsec",
        "operationId": "patch-root",
        "tags": [
          "openconfig-macsec"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "openconfig-macsec:macsec": {
                    "$ref": "#/components/schemas/openconfig-macsec-macsec"
                  }
                },
                "example": "00:1a:2b:3c:4d:5e"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Updated"
          },
          "400": {
            "description": "Bad request"
          }
        }
      },
      "delete": {
        "summary": "Delete macsec",
        "description": "Delete The MACsec",
        "operationId": "delete-root",
        "tags": [
          "openconfig-macsec"
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "openconfig-macsec-macsec": {
        "type": "object",
        "properties": {
          "mka": {
            "type": "object",
            "properties": {
              "policies": {
                "type": "object",
                "properties": {
                  "policy": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "description": "Reference to MKA policy name",
                          "example": "example-1"
                        },
                        "config": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "description": "Name of the MKA policy.",
                              "example": "example-1"
                            },
                            "key-server-priority": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 255,
                              "description": "Specifies the key server priority used by the MACsec Key Agreement\n        (MKA) protocol to select the key server when MACsec is enabled using\n        static connectivity association key (CAK) security mode. The switch with\n        the lower priority-number is selected as the key server. If the\n        priority-number is identical on both sides of a point-to-point link, the\n        MKA protocol selects the device with the lower MAC address as the key\n        server",
                              "example": 1
                            },
                            "confidentiality-offset": {
                              "type": "string",
                              "description": "The confidentiality offset specifies a number of octets in an Ethernet\n         frame that are sent in unencrypted plain-text",
                              "example": "1"
                            },
                            "delay-protection": {
                              "type": "boolean",
                              "description": "Traffic delayed longer than 2 seconds is rejected by the interfaces\n         enabled with delay protection.",
                              "example": true
                            },
                            "include-icv-indicator": {
                              "type": "boolean",
                              "description": "Generate and include an Integrity Check Value (ICV) field in the MKPDU.\n         For compatibility with previous MACsec implementation that do not\n         require an ICV",
                              "example": true
                            },
                            "sak-rekey-interval": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 4294967295,
                              "description": "SAK Rekey interval in seconds. The default value is 0 where no rekey is\n         performed.",
                              "example": 1
                            },
                            "sak-rekey-on-live-peer-loss": {
                              "type": "boolean",
                              "description": "Rekey on peer loss",
                              "example": true
                            },
                            "use-updated-eth-header": {
                              "type": "boolean",
                              "description": "Use updated ethernet header for ICV calculation. In case the Ethernet\n         frame headers change, use the updated headers to calculate the ICV.",
                              "example": true
                            },
                            "macsec-cipher-suite": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "description": "Set Cipher suite(s) for SAK derivation",
                                "example": "configured-value"
                              },
                              "example": "00:1a:2b:3c:4d:5e"
                            }
                          },
                          "description": "Configuration of the MKA policy",
                          "example": "configured-value"
                        },
                        "state": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "description": "Name of the MKA policy.",
                              "example": "example-1"
                            },
                            "key-server-priority": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 255,
                              "description": "Specifies the key server priority used by the MACsec Key Agreement\n        (MKA) protocol to select the key server when MACsec is enabled using\n        static connectivity association key (CAK) security mode. The switch with\n        the lower priority-number is selected as the key server. If the\n        priority-number is identical on both sides of a point-to-point link, the\n        MKA protocol selects the device with the lower MAC address as the key\n        server",
                              "example": 1
                            },
                            "confidentiality-offset": {
                              "type": "string",
                              "description": "The confidentiality offset specifies a number of octets in an Ethernet\n         frame that are sent in unencrypted plain-text",
                              "example": "1"
                            },
                            "delay-protection": {
                              "type": "boolean",
                              "description": "Traffic delayed longer than 2 seconds is rejected by the interfaces\n         enabled with delay protection.",
                              "example": true
                            },
                            "include-icv-indicator": {
                              "type": "boolean",
                              "description": "Generate and include an Integrity Check Value (ICV) field in the MKPDU.\n         For compatibility with previous MACsec implementation that do not\n         require an ICV",
                              "example": true
                            },
                            "sak-rekey-interval": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 4294967295,
                              "description": "SAK Rekey interval in seconds. The default value is 0 where no rekey is\n         performed.",
                              "example": 1
                            },
                            "sak-rekey-on-live-peer-loss": {
                              "type": "boolean",
                              "description": "Rekey on peer loss",
                              "example": true
                            },
                            "use-updated-eth-header": {
                              "type": "boolean",
                              "description": "Use updated ethernet header for ICV calculation. In case the Ethernet\n         frame headers change, use the updated headers to calculate the ICV.",
                              "example": true
                            },
                            "macsec-cipher-suite": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "description": "Set Cipher suite(s) for SAK derivation",
                                "example": "configured-value"
                              },
                              "example": "00:1a:2b:3c:4d:5e"
                            }
                          },
                          "description": "Operational state data for MKA policy",
                          "example": "active"
                        }
                      },
                      "example": "configured-value"
                    },
                    "example": "configured-value"
                  }
                },
                "description": "Enclosing container for the list of MKA policies",
                "example": "configured-value"
              },
