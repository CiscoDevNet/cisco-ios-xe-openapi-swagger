                      "type": "object",
                      "properties": {
                        "scsa-rx": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "sci-rx": {
                                "type": "string",
                                "description": "RX Secure Channel and Secure Association Statistics",
                                "example": "configured-value"
                              },
                              "state": {
                                "type": "object",
                                "properties": {
                                  "counters": {
                                    "type": "object",
                                    "properties": {
                                      "sci-rx": {
                                        "type": "string",
                                        "pattern": "^[0-9A-Fa-f]+$",
                                        "description": "Secure Channel Identifier.\n         Every Receive Channel is uniquely identified using this field.",
                                        "example": "configured-value"
                                      },
                                      "sc-invalid": {
                                        "type": "string",
                                        "description": "Invalid Secure Channel RX Packets counter.\n         This counter reflects the number of invalid received packets in a\n         secure channel.",
                                        "example": "1"
                                      },
                                      "sc-valid": {
                                        "type": "string",
                                        "description": "Valid Secure Channel RX Packets counter.\n         This counter reflects the number of valid received packets in a\n         secure channel.",
                                        "example": "1"
                                      },
                                      "sa-invalid": {
                                        "type": "string",
                                        "description": "Invalid Secure Association RX Packets counter.\n         This counter reflects the number of integrity check fails for received\n         packets in a secure association.",
                                        "example": "1"
                                      },
                                      "sa-valid": {
                                        "type": "string",
                                        "description": "Secure Association Valid RX Packets counter.\n         This counter reflects the number of packets in a secure association\n         that passed integrity check.",
                                        "example": "1"
                                      }
                                    },
                                    "description": "Counters container for macsec-scsa-rx-interface-stats",
                                    "example": 10
                                  }
                                },
                                "description": "State container for macsec-scsa-rx-interface-stats",
                                "example": "active"
                              }
                            },
                            "example": "configured-value"
                          },
                          "example": "configured-value"
                        }
                      },
                      "description": "Enclosing container for received packets for Secure Channel and\n         Secure Association",
                      "example": "configured-value"
                    },
