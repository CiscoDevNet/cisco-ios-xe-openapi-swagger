          "interfaces": {
            "type": "object",
            "properties": {
              "interface": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "scsa-tx": {
                      "type": "object",
                      "properties": {
                        "scsa-tx": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "sci-tx": {
                                "type": "string",
                                "description": "TX Secure Channel and Secure Association Statistics",
                                "example": "configured-value"
                              },
                              "state": {
                                "type": "object",
                                "properties": {
                                  "counters": {
                                    "type": "object",
                                    "properties": {
                                      "sci-tx": {
                                        "type": "string",
                                        "pattern": "^[0-9A-Fa-f]+$",
                                        "description": "Secure Channel Identifier.\n         Every Transmit Channel is uniquely identified using this field.",
                                        "example": "configured-value"
                                      },
                                      "sc-auth-only": {
                                        "type": "string",
                                        "description": "Secure Channel Authenticated only TX Packets counter.\n         This counter reflects the number of authenticated only transmitted\n         packets in a secure channel.",
                                        "example": "configured-value"
                                      },
                                      "sc-encrypted": {
                                        "type": "string",
                                        "description": "Secure Channel Encrypted TX Packets counter.\n         This counter reflects the number of encrypted and authenticated\n         transmitted packets in a secure channel.",
                                        "example": "configured-value"
                                      },
                                      "sa-auth-only": {
                                        "type": "string",
                                        "description": "Secure Association Authenticated only TX Packets counter.\n         This counter reflects the number of authenticated only, transmitted\n         packets in a secure association.",
                                        "example": "configured-value"
                                      },
                                      "sa-encrypted": {
                                        "type": "string",
                                        "description": "Secure Association Encrypted TX Packets counter.\n         This counter reflects the number of encrypted and authenticated\n         transmitted packets in a secure association.",
                                        "example": "configured-value"
                                      }
                                    },
                                    "description": "Counters container for macsec-scsa-tx-interface-stats",
                                    "example": 10
                                  }
                                },
                                "description": "State container for macsec-scsa-tx-interface-stats",
                                "example": "active"
                              }
                            },
                            "example": "configured-value"
                          },
                          "example": "configured-value"
                        }
                      },
                      "description": "Enclosing container for transmitted packets for Secure Channel and\n         Secure Association",
                      "example": "configured-value"
                    },
