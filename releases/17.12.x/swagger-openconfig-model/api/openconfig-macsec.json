                                "type": "object",
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "description": "Reference to the MKA key id",
                                    "example": "1"
                                  },
                                  "config": {
                                    "type": "object",
                                    "properties": {
                                      "id": {
                                        "type": "string",
                                        "pattern": "^[0-9A-Fa-f]+$",
                                        "description": "Key identifier is used as the\n         Connectivity Association Key name (CKN)",
                                        "example": "1"
                                      },
                                      "key-clear-text": {
                                        "type": "string",
                                        "description": "The key, used for signing and encrypting. Supplied as a clear text\n         string. When read, also returned as clear text string.",
                                        "example": "configured-value"
                                      },
                                      "cryptographic-algorithm": {
                                        "type": "string",
                                        "enum": [
                                          "AES_128_CMAC",
                                          "AES_256_CMAC"
                                        ],
                                        "description": "MKA Cryptographic authentication algorithm to use",
                                        "example": "configured-value"
                                      },
                                      "valid-date-time": {
                                        "type": "string",
                                        "enum": [
                                          "VALID_IMMEDIATELY"
                                        ],
                                        "description": "Key is valid immediately",
                                        "example": "1"
                                      },
                                      "expiration-date-time": {
                                        "type": "string",
                                        "enum": [
                                          "NO_EXPIRATION"
                                        ],
                                        "description": "Key does not expire",
                                        "example": "50"
                                      }
                                    },
                                    "description": "Configuration of MKA key",
                                    "example": "configured-value"
                                  },
                                  "state": {
                                    "type": "object",
                                    "properties": {
                                      "id": {
                                        "type": "string",
                                        "pattern": "^[0-9A-Fa-f]+$",
                                        "description": "Key identifier is used as the\n         Connectivity Association Key name (CKN)",
                                        "example": "1"
                                      },
                                      "key-clear-text": {
                                        "type": "string",
                                        "description": "The key, used for signing and encrypting. Supplied as a clear text\n         string. When read, also returned as clear text string.",
                                        "example": "configured-value"
                                      },
                                      "cryptographic-algorithm": {
                                        "type": "string",
                                        "enum": [
                                          "AES_128_CMAC",
                                          "AES_256_CMAC"
                                        ],
                                        "description": "MKA Cryptographic authentication algorithm to use",
                                        "example": "configured-value"
                                      },
                                      "valid-date-time": {
                                        "type": "string",
                                        "enum": [
                                          "VALID_IMMEDIATELY"
                                        ],
                                        "description": "Key is valid immediately",
                                        "example": "1"
                                      },
                                      "expiration-date-time": {
                                        "type": "string",
                                        "enum": [
                                          "NO_EXPIRATION"
                                        ],
                                        "description": "Key does not expire",
                                        "example": "50"
                                      }
                                    },
                                    "description": "Operational state data for MKA key",
                                    "example": "active"
                                  }
                                },
                                "example": "configured-value"
                              },
                              "example": "configured-value"
                            }
                          },
                          "description": "Enclosing container for the list of MKA keys",
                          "example": "configured-value"
                        },
                        "name": {
                          "type": "string",
                          "description": "Reference to the MKA Key chain name",
                          "example": "example-1"
                        },
                        "config": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "description": "MKA Key-chain name",
                              "example": "example-1"
                            }
                          },
                          "description": "Configuration of the MKA key chain",
                          "example": "configured-value"
                        },
                        "state": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string",
                              "description": "MKA Key-chain name",
                              "example": "example-1"
                            }
                          },
                          "description": "Operational state data for MKA key chain",
                          "example": "active"
                        }
                      },
                      "example": "configured-value"
                    },
                    "example": "MY-KEY-CHAIN"
                  }
                },
                "description": "Enclosing container for the MKA key chains",
                "example": "configured-value"
              },
              "state": {
                "type": "object",
                "properties": {
                  "counters": {
                    "type": "object",
                    "properties": {
                      "out-mkpdu-errors": {
                        "type": "string",
                        "description": "MKPDU TX error count",
                        "example": "0"
