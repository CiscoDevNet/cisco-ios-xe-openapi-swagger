{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco-IOS-XE-ethernet-rpc - RPC Operations",
    "description": "Copyright (c) 2021-2022 by Cisco Systems, Inc.\n     All rights reserved.\n\n**Module:** `Cisco-IOS-XE-ethernet-rpc`\n**Version:** 2022-11-01\n**Operations:** 2",
    "version": "2022-11-01"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/ethernet_rpc:ethernet-oam": {
      "post": {
        "summary": "Start/Stop ethernet OAM remote-loopback on interface",
        "description": "Start/Stop ethernet OAM remote-loopback on interface\n\n**Endpoint:** `POST /restconf/operations/ethernet_rpc:ethernet-oam`",
        "operationId": "post-root-2",
        "tags": [
          "Cisco-IOS-XE-ethernet-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ethernet_rpc:ethernet-oam": {
                    "type": "object",
                    "properties": {
                      "action": {
                        "type": "string",
                        "description": "Start or stop action for remote-loopback",
                        "example": "configured-value"
                      },
                      "interface": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 99,
                        "pattern": "[0-9a-zA-Z/\\-_]*",
                        "description": "Interface name to start/stop ethernet OAM remote-loopback",
                        "example": "GigabitEthernet1/0/1"
                      }
                    },
                    "required": [
                      "action",
                      "interface"
                    ],
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "ethernet_rpc:ethernet-oam": {
                  "action": "configured-value",
                  "interface": "GigabitEthernet1/0/1"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ethernet_rpc:ethernet-oam": {
                      "type": "object",
                      "example": "configured-value"
                    }
                  },
                  "example": "configured-value"
                },
                "example": {
                  "ethernet_rpc:ethernet-oam": {
                    "ethernet_rpc:ethernet-oam": [
                      null
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/operations/ethernet_rpc:eth-lat-loopback": {
      "post": {
        "summary": "Ethernet latching-loopback activate/deactivate",
        "description": "Ethernet latching-loopback activate/deactivate\n\n**Endpoint:** `POST /restconf/operations/ethernet_rpc:eth-lat-loopback`",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-ethernet-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ethernet_rpc:eth-lat-loopback": {
                    "type": "object",
                    "properties": {
                      "action": {
                        "type": "string",
                        "description": "Activate/deactivate action for ethernet latching-loopback",
                        "example": "configured-value"
                      },
                      "domain": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "[0-9a-zA-Z\\-_]*",
                        "description": "Ethernet CFM (Connectivity fault management) domain name",
                        "example": "configured-value"
                      },
                      "id": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 8191,
                        "description": "Local MEP(Maintenance End Point) id",
                        "example": 1
                      },
                      "service": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "[0-9a-zA-Z\\-_\\^]*",
                        "description": "Ethernet CFM(Connectivity fault management) maintenance\n         association name",
                        "example": "configured-value"
                      },
                      "destination-mac": {
                        "type": "string",
                        "description": "MAC address of remote device",
                        "example": "00:1a:2b:3c:4d:5e"
                      },
                      "timeout": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 90000,
                        "description": "Timeout value of latching loopback in seconds.\n         0 for permanent latching loopback session",
                        "default": "300",
                        "example": 1
                      },
                      "svc-name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 64,
                        "pattern": "[0-9a-zA-Z\\-_\\^]*",
                        "description": "Ethernet CFM(Connectivity fault management) maintenance\n             association name",
                        "example": "example-1"
                      },
                      "svc-number": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 65535,
                        "description": "Ethernet CFM(Connectivity fault management) maintenance\n             association number",
                        "example": 10
                      },
                      "svc-none": {
                        "type": "string",
                        "description": "No Ethernet CFM(Connectivity fault management) maintenance\n             association option selected if set to true",
                        "default": "true",
                        "example": "configured-value"
                      }
                    },
                    "required": [
                      "action",
                      "domain",
                      "id",
                      "destination-mac"
                    ],
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "ethernet_rpc:eth-lat-loopback": {
                  "action": "configured-value",
                  "domain": "configured-value",
                  "id": 10,
                  "service": "configured-value",
                  "destination-mac": "00:11:22:33:44:55",
                  "timeout": 30,
                  "svc-name": "example-1",
                  "svc-number": 10,
                  "svc-none": "configured-value"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ethernet_rpc:eth-lat-loopback": {
                      "type": "object",
                      "example": "configured-value"
                    }
                  },
                  "example": "configured-value"
                },
                "example": {
                  "ethernet_rpc:eth-lat-loopback": {
                    "ethernet_rpc:eth-lat-loopback": [
                      null
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ]
}
