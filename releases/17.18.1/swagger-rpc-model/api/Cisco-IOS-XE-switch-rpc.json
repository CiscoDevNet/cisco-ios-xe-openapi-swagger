{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco-IOS-XE-switch-rpc - RPC Operations",
    "description": "NED Switch RPC YANG module for IOS\n     Copyright (c) 2016-2024 by Cisco Systems, Inc.\n     All rights reserved.\n\n**Module:** `Cisco-IOS-XE-switch-rpc`\n**Version:** 2024-07-01\n**Operations:** 1",
    "version": "2024-07-01"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/switch_rpc:switch": {
      "post": {
        "summary": "<1-15>  Switch Priority",
        "description": "<1-15>  Switch Priority\n\n**Endpoint:** `POST /restconf/operations/switch_rpc:switch`",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-switch-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "switch_rpc:switch": {
                    "type": "object",
                    "properties": {
                      "clear": {
                        "type": "object",
                        "properties": {
                          "stack-mode": {
                            "type": "string",
                            "description": "Reset the switch mode to N+1",
                            "example": "configured-value"
                          }
                        },
                        "description": "Reset the switch mode to N+1",
                        "example": "configured-value"
                      },
                      "switch-number-drop-node-name": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16,
                        "example": 0
                      },
                      "priority": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 15,
                        "description": "<1-15>  Switch Priority",
                        "example": 100
                      },
                      "renumber": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 16,
                        "description": "<1-16>  New number of the Switch",
                        "example": 10
                      },
                      "statck": {
                        "type": "object",
                        "properties": {
                          "port": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 2,
                            "description": "<1-2>  Stack port number to enable/disable",
                            "example": 443
                          }
                        },
                        "description": "<1-2>  Stack port number to enable/disable",
                        "example": "configured-value"
                      },
                      "stack": {
                        "type": "object",
                        "properties": {
                          "port": {
                            "type": "object",
                            "properties": {
                              "port-number-drop-node-name": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 2,
                                "description": "<1-2>  Stack port number to enable/disable",
                                "example": 0
                              },
                              "enable": {
                                "type": "string",
                                "description": "Enable stack port",
                                "example": "True"
                              },
                              "disable": {
                                "type": "string",
                                "description": "Disable stack port",
                                "example": "False"
                              }
                            },
                            "description": "Stack port enable or disable",
                            "example": 443
                          }
                        },
                        "description": "Stack port enable or disable",
                        "example": "configured-value"
                      },
                      "role": {
                        "type": "object",
                        "properties": {
                          "active": {
                            "type": "string",
                            "description": "Set the new switch to 1+1 active mode",
                            "example": "True"
                          },
                          "standby": {
                            "type": "string",
                            "description": "Set the new switch to 1+1 standby mode",
                            "example": "configured-value"
                          }
                        },
                        "description": "Set the new switch to 1+1 active mode",
                        "example": 15
                      }
                    },
                    "x-yang-choices": [
                      {
                        "name": "pri-renum-stack",
                        "mandatory": false,
                        "cases": [
                          {
                            "name": "priority-case",
                            "properties": [
                              "priority"
                            ]
                          },
                          {
                            "name": "renumver-case",
                            "properties": [
                              "renumber"
                            ]
                          },
                          {
                            "name": "stack-case",
                            "properties": [
                              "statck"
                            ]
                          },
                          {
                            "name": "stack-port-case",
                            "properties": [
                              "stack"
                            ]
                          },
                          {
                            "name": "role-case",
                            "properties": [
                              "role"
                            ]
                          }
                        ]
                      }
                    ],
                    "description": "YANG choice — mutually exclusive case groups: choice 'pri-renum-stack': priority-case | renumver-case | stack-case | stack-port-case | role-case.",
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "switch_rpc:switch": {
                  "clear": {
                    "stack-mode": "configured-value"
                  },
                  "switch-number-drop-node-name": 10,
                  "priority": 10,
                  "renumber": 10,
                  "statck": {
                    "port": 8080
                  },
                  "stack": {
                    "port": {
                      "port-number-drop-node-name": 8080,
                      "enable": "True",
                      "disable": "False"
                    }
                  },
                  "role": {
                    "active": "True",
                    "standby": "configured-value"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "switch_rpc:switch": {
                      "type": "object",
                      "example": "configured-value"
                    }
                  },
                  "example": "configured-value"
                },
                "example": {
                  "switch_rpc:switch": {
                    "switch_rpc:switch": [
                      null
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ]
}
