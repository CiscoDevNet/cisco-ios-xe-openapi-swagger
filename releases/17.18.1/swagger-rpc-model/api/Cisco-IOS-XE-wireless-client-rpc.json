    "/operations/wireless_client_rpc:apf-ms-delete-all": {
      "post": {
        "summary": "Delete wireless client based on client MAC or IP address or username",
        "description": "Delete wireless client based on client MAC or IP address or username\n\n**Endpoint:** `POST /restconf/operations/wireless_client_rpc:apf-ms-delete-all`",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-wireless-client-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "wireless_client_rpc:apf-ms-delete-all": {
                    "type": "object",
                    "properties": {
                      "zone-id": {
                        "type": "string",
                        "description": "Binding entry zone-id",
                        "default": "0",
                        "example": "1"
                      },
                      "mac-addr": {
                        "type": "string",
                        "description": "MAC address",
                        "example": "00:1a:2b:3c:4d:5e"
                      },
                      "ip-addr": {
                        "type": "string",
                        "description": "IP address",
                        "example": "10.1.1.1"
                      },
                      "user-name": {
                        "type": "string",
                        "description": "Username",
                        "example": "admin"
                      }
                    },
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "wireless_client_rpc:apf-ms-delete-all": {
                  "zone-id": "1",
                  "mac-addr": "00:11:22:33:44:55",
                  "ip-addr": "192.168.1.1",
                  "user-name": "admin"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "wireless_client_rpc:apf-ms-delete-all": {
                      "type": "object",
                      "example": "configured-value"
                    }
                  },
                  "example": "configured-value"
                },
                "example": {
                  "wireless_client_rpc:apf-ms-delete-all": {
                    "wireless_client_rpc:apf-ms-delete-all": [
                      null
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Unauthorized"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
