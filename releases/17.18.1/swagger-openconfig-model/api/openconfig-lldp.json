                                "type": "object",
                                "properties": {
                                  "capability": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "properties": {
                                        "name": {
                                          "type": "string",
                                          "description": "Reference to capabilities list key",
                                          "example": "example-1"
                                        },
                                        "config": {
                                          "type": "object",
                                          "description": "Configuration data for LLDP capabilities",
                                          "example": "configured-value"
                                        },
                                        "state": {
                                          "type": "object",
                                          "properties": {
                                            "name": {
                                              "type": "string",
                                              "description": "Name of the system capability advertised by the neighbor.\n        Capabilities are represented in a bitmap that defines the\n        primary functions of the system. The capabilities are\n        defined in IEEE 802.1AB.",
                                              "example": "example-1"
                                            },
                                            "enabled": {
                                              "type": "boolean",
                                              "description": "Indicates whether the corresponding system capability is\n        enabled on the neighbor.",
                                              "example": true
                                            }
                                          },
                                          "description": "Operational state data for LLDP capabilities",
                                          "example": "active"
                                        }
                                      },
                                      "example": "configured-value"
                                    },
                                    "example": "configured-value"
                                  }
                                },
                                "description": "Enclosing container for list of LLDP capabilities",
                                "example": "configured-value"
                              },
                              "id": {
                                "type": "string",
                                "description": "",
                                "example": "1"
                              },
                              "config": {
                                "type": "object",
                                "description": "Configuration data ",
                                "example": "configured-value"
                              },
                              "state": {
                                "type": "object",
                                "properties": {
                                  "system-name": {
                                    "type": "string",
                                    "description": "The system name field shall contain an alpha-numeric string\n        that indicates the system's administratively assigned name.\n        The system name should be the system's fully qualified domain\n        name. If implementations support IETF RFC 3418, the sysName\n        object should be used for this field.",
                                    "example": "example-1"
                                  },
                                  "system-description": {
                                    "type": "string",
                                    "description": "The system description field shall contain an alpha-numeric\n        string that is the textual description of the network entity.\n        The system description should include the full name and\n        version identification of the system's hardware type,\n        software operating system, and networking software. If\n        implementations support IETF RFC 3418, the sysDescr object\n        should be used for this field.",
                                    "example": "Cisco IOS XE Software, Catalyst 9300"
                                  },
                                  "chassis-id": {
                                    "type": "string",
                                    "description": "The Chassis ID is a mandatory TLV which identifies the\n        chassis component of the endpoint identifier associated with\n        the transmitting LLDP agent",
                                    "example": "1"
                                  },
                                  "chassis-id-type": {
                                    "type": "string",
                                    "description": "This field identifies the format and source of the chassis\n        identifier string. It is an enumerator defined by the\n        LldpChassisIdSubtype object from IEEE 802.1AB MIB.",
                                    "example": "default"
                                  },
                                  "id": {
                                    "type": "string",
                                    "description": "System generated identifier for the neighbor on the\n        interface.",
                                    "example": "1"
                                  },
                                  "age": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "description": "Age since discovery",
                                    "example": 3600
                                  },
                                  "last-update": {
                                    "type": "integer",
                                    "description": "Seconds since last update received.",
                                    "example": 1
                                  },
                                  "ttl": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 65535,
                                    "description": "The time-to-live (TTL) is a mandatory TLV which indicates\n        how long information from the neighbor should be considered\n        valid.",
                                    "example": 1
                                  },
                                  "port-id": {
                                    "type": "string",
                                    "description": "The Port ID is a mandatory TLV which identifies the port\n        component of the endpoint identifier associated with the\n        transmitting LLDP agent. If the specified port is an IEEE\n        802.3 Repeater port, then this TLV is optional.",
                                    "example": "1"
                                  },
                                  "port-id-type": {
                                    "type": "string",
                                    "description": "This field identifies the format and source of the port\n        identifier string. It is an enumerator defined by the\n        PtopoPortIdType object from RFC2922.",
                                    "example": "default"
                                  },
                                  "port-description": {
                                    "type": "string",
                                    "description": "The binary string containing the actual port identifier for\n        the port which this LLDP PDU was transmitted. The source and\n        format of this field is defined by PtopoPortId from\n        RFC2922.",
                                    "example": "configured-value"
                                  },
                                  "management-address": {
                                    "type": "string",
                                    "description": "The Management Address is a mandatory TLV which identifies a\n        network address associated with the local LLDP agent, which\n        can be used to reach the agent on the port identified in the\n        Port ID TLV.",
                                    "example": "10.1.1.1"
                                  },
                                  "management-address-type": {
                                    "type": "string",
                                    "description": "The enumerated value for the network address type\n        identified in this TLV. This enumeration is defined in the\n        'Assigned Numbers' RFC [RFC3232] and the\n        ianaAddressFamilyNumbers object.",
                                    "example": "default"
                                  }
                                },
                                "description": "Operational state data ",
                                "example": "active"
                              }
