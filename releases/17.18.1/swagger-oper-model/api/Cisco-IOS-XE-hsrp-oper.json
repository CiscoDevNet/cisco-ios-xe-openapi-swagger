            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "hsrp-group-info": {
                      "type": "object",
                      "properties": {
                        "priority": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 4294967295
                        },
                        "preempt": {
                          "type": "boolean"
                        },
                        "state": {
                          "type": "string"
                        },
                        "active-ip": {
                          "type": "string"
                        },
                        "standby-ip": {
                          "type": "string"
                        },
                        "virtual-ip": {
                          "type": "string"
                        },
                        "group-id": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 65535
                        },
                        "if-name": {
                          "type": "string"
                        }
                      }
                    },
                    "hsrp-neighbor": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "if-name": {
                            "type": "string"
                          },
                          "neighbor": {
                            "type": "object",
                            "properties": {
                              "address": {
                                "type": "string"
                              },
                              "active-list": {
                                "type": "array",
                                "items": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 255
                                }
                              },
                              "standby-list": {
                                "type": "array",
                                "items": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 255
                                }
                              },
                              "passive": {
                                "type": "boolean"
                              },
                              "passive-timer-remaining": {
                                "type": "integer",
                                "minimum": 0,
                                "maximum": 65535
                              },
                              "bfd-enabled": {
                                "type": "boolean"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "Cisco-IOS-XE-hsrp-oper:hsrp-oper-data": {
                    "hsrp-group-info": {
                      "priority": 1,
                      "preempt": true,
                      "state": "up",
                      "active-ip": "example",
                      "standby-ip": "example",
                      "virtual-ip": "example",
                      "group-id": "C9300-48T",
                      "if-name": "GigabitEthernet1/0/1"
                    },
                    "hsrp-neighbor": [
                      {
                        "if-name": "GigabitEthernet1/0/1",
                        "neighbor": {
                          "address": "10.10.10.1",
                          "active-list": [
                            1
                          ],
                          "standby-list": [
                            1
                          ],
                          "passive": true,
                          "passive-timer-remaining": 1,
                          "bfd-enabled": true
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource not found"
          }
