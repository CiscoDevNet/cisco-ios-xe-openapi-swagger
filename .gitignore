# C9K RESTCONF capture harness (Track B) — device-real data stays LOCAL only
scripts/harness/captures/
scripts/harness/inventory.json
scripts/harness/secrets*
scripts/harness/.env
.env
.venv-harness/
scripts/harness/capture-index.*
