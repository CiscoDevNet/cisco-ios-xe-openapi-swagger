# MDT telemetry pyATS harness — live device output / real testbed stay LOCAL only
scripts/mdt-telemetry/harness/pyats/results/
scripts/mdt-telemetry/harness/pyats/testbed.yaml
!scripts/mdt-telemetry/harness/pyats/testbed.example.yaml

# Large reference files not needed for GitHub Pages
references/

# Old monolithic Postman collection (replaced by split v1/v2 files)
tools/IOS-XE-RESTCONF-Complete.postman_collection.json

# Swagger UI build artifacts (legacy: kept out of repo root)
/swagger-ui-*/
# Vendored copy for air-gapped self-hosting MUST be tracked
!assets/vendor/swagger-ui-*/

# Archive directory (not needed for live site)
archive/

# Generated export bundles and local build scratch
releases/*/exports/bruno/
# Postman exports are zipped at deploy time (raw JSON for all releases > Pages size limit)
releases/*/exports/postman/
tmp/
tmp_*.json

# MDT local collector output (captured live payloads stay LOCAL)
scripts/mdt-telemetry/collector/output/
