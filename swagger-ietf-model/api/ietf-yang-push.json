          },
          {
            "$ref": "#/components/parameters/depth"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ietf-yang-push:(update-trigger)": {
                      "type": "object",
                      "properties": {
                        "period": {
                          "type": "string"
                        },
                        "anchor-time": {
                          "type": "string"
                        },
                        "no-synch-on-start": {
                          "type": "boolean",
                          "description": "Presence flag"
                        },
                        "dampening-period": {
                          "type": "string"
                        },
                        "excluded-change": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "ietf-yang-push:(update-trigger)": {
                    "period": 1,
                    "anchor-time": "example",
                    "no-synch-on-start": "behavior), in order to facilitate\n             a receiver's synchronization, a full update is sent\n             when the subscription starts using a push-update\n             notification, just like in the case of a periodic\n             subscription.  After that, push-change-update\n             notifications only are sent unless the Publisher chooses\n             to resynch the subscription again.",
                    "dampening-period": 0,
                    "excluded-change": [
                      "example"
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Resource not found"
          }
        }
      }
    },
