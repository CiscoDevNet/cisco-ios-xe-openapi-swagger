    "title": "Cisco IOS-XE IETF - ietf-yang-push",
    "description": "IETF standard data from `ietf-yang-push` module.\n\n**Root containers:** 24 ((update-trigger), dscp, subscription-priority, subscription-dependency, (update-trigger)...)\n**Paths:** 14 | **Operations:** 29\n\nSupports CRUD for read-write nodes, GET for read-only nodes.",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/iosxe/"
    },
    "x-yang-module": "ietf-yang-push",
    "x-model-type": "ietf"
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        },
        "port": {
          "default": "443"
        }
      }
    }
  ],
