{
  "openapi": "3.0.0",
  "info": {
    "title": "DRAFT-MSDP-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from DRAFT-MSDP-MIB for MSDP peer state events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/DRAFT-MSDP-MIB:msdpEstablished": {
      "get": {
        "description": "Notification for msdpEstablished event",
        "tags": [
          "Multicast"
        ],
        "summary": "SNMP Trap: msdpEstablished",
        "operationId": "get_msdpEstablished",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "msdpEstablished notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/msdpEstablished"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "DRAFT-MSDP-MIB:msdpEstablished": {
                      "msdpPeerRemoteAddress": "10.1.1.1",
                      "msdpPeerFsmEstablishedTransitions": 5
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/DRAFT-MSDP-MIB:msdpBackwardTransition": {
      "get": {
        "description": "Notification for msdpBackwardTransition event",
        "tags": [
          "Multicast"
        ],
        "summary": "SNMP Trap: msdpBackwardTransition",
        "operationId": "get_msdpBackwardTransition",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "msdpBackwardTransition notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/msdpBackwardTransition"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "DRAFT-MSDP-MIB:msdpBackwardTransition": {
                      "msdpPeerRemoteAddress": "10.1.1.1",
                      "msdpPeerState": "active"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "msdpEstablished": {
        "type": "object",
        "description": "SNMP trap notification payload for msdpEstablished",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "DRAFT-MSDP-MIB:msdpEstablished": {
                "type": "object",
                "description": "Varbind objects for msdpEstablished trap",
                "properties": {
                  "msdpPeerRemoteAddress": {
                    "type": "string"
                  },
                  "msdpPeerFsmEstablishedTransitions": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "DRAFT-MSDP-MIB:msdpEstablished": {
              "msdpPeerRemoteAddress": "10.1.1.1",
              "msdpPeerFsmEstablishedTransitions": 5
            }
          }
        }
      },
      "msdpBackwardTransition": {
        "type": "object",
        "description": "SNMP trap notification payload for msdpBackwardTransition",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "DRAFT-MSDP-MIB:msdpBackwardTransition": {
                "type": "object",
                "description": "Varbind objects for msdpBackwardTransition trap",
                "properties": {
                  "msdpPeerRemoteAddress": {
                    "type": "string"
                  },
                  "msdpPeerState": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "DRAFT-MSDP-MIB:msdpBackwardTransition": {
              "msdpPeerRemoteAddress": "10.1.1.1",
              "msdpPeerState": "active"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Multicast",
      "description": "SNMP notification and event subscriptions for Multicast"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/iosxe/"
  }
}
