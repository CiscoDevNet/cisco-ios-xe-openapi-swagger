{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-PROCESS-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-PROCESS-MIB for Process CPU threshold events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-PROCESS-MIB:cpmCPURisingThreshold": {
      "get": {
        "description": "Notification for cpmCPURisingThreshold event",
        "tags": [
          "System Management"
        ],
        "summary": "SNMP Trap: cpmCPURisingThreshold",
        "operationId": "get_cpmCPURisingThreshold",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cpmCPURisingThreshold notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cpmCPURisingThreshold"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-PROCESS-MIB:cpmCPURisingThreshold": {
                      "cpmCPUTotalIndex": 1,
                      "cpmCPUThresholdClass": "example-string",
                      "cpmCPURisingThresholdValue": "example-string",
                      "cpmCPUTotalMonIntervalValue": "example-string",
                      "cpmCPUInterruptMonIntervalValue": "example-string",
                      "cpmProcessPID": 12345,
                      "cpmProcExtUtil5SecRev": "example-string",
                      "cpmProcessTimeCreated": "example-string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-PROCESS-MIB:cpmCPUFallingThreshold": {
      "get": {
        "description": "Notification for cpmCPUFallingThreshold event",
        "tags": [
          "System Management"
        ],
        "summary": "SNMP Trap: cpmCPUFallingThreshold",
        "operationId": "get_cpmCPUFallingThreshold",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cpmCPUFallingThreshold notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cpmCPUFallingThreshold"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-PROCESS-MIB:cpmCPUFallingThreshold": {
                      "cpmCPUTotalIndex": 1,
                      "cpmCPUThresholdClass": "example-string",
                      "cpmCPUFallingThresholdValue": "example-string",
                      "cpmCPUTotalMonIntervalValue": "example-string",
                      "cpmCPUInterruptMonIntervalValue": "example-string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "cpmCPURisingThreshold": {
        "type": "object",
        "description": "SNMP trap notification payload for cpmCPURisingThreshold",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-PROCESS-MIB:cpmCPURisingThreshold": {
                "type": "object",
                "description": "Varbind objects for cpmCPURisingThreshold trap",
                "properties": {
                  "cpmCPUTotalIndex": {
                    "type": "string"
                  },
                  "cpmCPUThresholdClass": {
                    "type": "string"
                  },
                  "cpmCPURisingThresholdValue": {
                    "type": "string"
                  },
                  "cpmCPUTotalMonIntervalValue": {
                    "type": "string"
                  },
                  "cpmCPUInterruptMonIntervalValue": {
                    "type": "string"
                  },
                  "cpmProcessPID": {
                    "type": "string"
                  },
                  "cpmProcExtUtil5SecRev": {
                    "type": "string"
                  },
                  "cpmProcessTimeCreated": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-PROCESS-MIB:cpmCPURisingThreshold": {
              "cpmCPUTotalIndex": 1,
              "cpmCPUThresholdClass": "example-string",
              "cpmCPURisingThresholdValue": "example-string",
              "cpmCPUTotalMonIntervalValue": "example-string",
              "cpmCPUInterruptMonIntervalValue": "example-string",
              "cpmProcessPID": 12345,
              "cpmProcExtUtil5SecRev": "example-string",
              "cpmProcessTimeCreated": "example-string"
            }
          }
        }
      },
      "cpmCPUFallingThreshold": {
        "type": "object",
        "description": "SNMP trap notification payload for cpmCPUFallingThreshold",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-PROCESS-MIB:cpmCPUFallingThreshold": {
                "type": "object",
                "description": "Varbind objects for cpmCPUFallingThreshold trap",
                "properties": {
                  "cpmCPUTotalIndex": {
                    "type": "string"
                  },
                  "cpmCPUThresholdClass": {
                    "type": "string"
                  },
                  "cpmCPUFallingThresholdValue": {
                    "type": "string"
                  },
                  "cpmCPUTotalMonIntervalValue": {
                    "type": "string"
                  },
                  "cpmCPUInterruptMonIntervalValue": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-PROCESS-MIB:cpmCPUFallingThreshold": {
              "cpmCPUTotalIndex": 1,
              "cpmCPUThresholdClass": "example-string",
              "cpmCPUFallingThresholdValue": "example-string",
              "cpmCPUTotalMonIntervalValue": "example-string",
              "cpmCPUInterruptMonIntervalValue": "example-string"
            }
          }
        }
      }
    }
  }
}
