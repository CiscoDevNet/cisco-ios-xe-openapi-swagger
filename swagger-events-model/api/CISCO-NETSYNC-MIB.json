  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-NETSYNC-MIB:ciscoNetsyncSelectedT0Clock": {
      "get": {
        "description": "Notification for ciscoNetsyncSelectedT0Clock event",
        "tags": [
          "System Management"
        ],
        "summary": "SNMP Trap: ciscoNetsyncSelectedT0Clock",
        "operationId": "get_ciscoNetsyncSelectedT0Clock",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ciscoNetsyncSelectedT0Clock notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ciscoNetsyncSelectedT0Clock"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-NETSYNC-MIB:ciscoNetsyncSelectedT0Clock": {
                      "cnsSelInpSrcNetsyncIndex": 1,
                      "cnsSelInpSrcName": "router-01",
                      "cnsSelInpSrcIntfType": "netsyncIfTypeEthernet",
                      "cnsSelInpSrcQualityLevel": "normal",
                      "cnsSelInpSrcPriority": "cnsselinpsrcpriority"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
