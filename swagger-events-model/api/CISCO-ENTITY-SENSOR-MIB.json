{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-ENTITY-SENSOR-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-ENTITY-SENSOR-MIB for Entity sensor threshold events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-ENTITY-SENSOR-MIB:entSensorThresholdNotification": {
      "get": {
        "description": "Notification for entSensorThresholdNotification event",
        "tags": [
          "Hardware"
        ],
        "summary": "SNMP Trap: entSensorThresholdNotification",
        "operationId": "get_entSensorThresholdNotification",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "entSensorThresholdNotification notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/entSensorThresholdNotification"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-ENTITY-SENSOR-MIB:entSensorThresholdNotification": {
                      "entPhysicalIndex": 1,
                      "entSensorThresholdIndex": 1,
                      "entSensorThresholdValue": 1000,
                      "entSensorValue": 45,
                      "entSensorThresholdSeverity": "major"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-ENTITY-SENSOR-MIB:entSensorThresholdRecoveryNotification": {
      "get": {
        "description": "Notification for entSensorThresholdRecoveryNotification event",
        "tags": [
          "Hardware"
        ],
        "summary": "SNMP Trap: entSensorThresholdRecoveryNotification",
        "operationId": "get_entSensorThresholdRecoveryNotification",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "entSensorThresholdRecoveryNotification notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/entSensorThresholdRecoveryNotification"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-ENTITY-SENSOR-MIB:entSensorThresholdRecoveryNotification": {
                      "entPhysicalIndex": 1,
                      "entSensorValue": 45,
                      "entSensorThresholdIndex": 1,
                      "entSensorThresholdSeverity": "major",
                      "entSensorThresholdValue": 1000
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "entSensorThresholdNotification": {
        "type": "object",
        "description": "SNMP trap notification payload for entSensorThresholdNotification",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-ENTITY-SENSOR-MIB:entSensorThresholdNotification": {
                "type": "object",
                "description": "Varbind objects for entSensorThresholdNotification trap",
                "properties": {
                  "entPhysicalIndex": {
                    "type": "string"
                  },
                  "entSensorThresholdIndex": {
                    "type": "string"
                  },
                  "entSensorThresholdValue": {
                    "type": "string"
                  },
                  "entSensorValue": {
                    "type": "string"
                  },
                  "entSensorThresholdSeverity": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-ENTITY-SENSOR-MIB:entSensorThresholdNotification": {
              "entPhysicalIndex": 1,
              "entSensorThresholdIndex": 1,
              "entSensorThresholdValue": 1000,
              "entSensorValue": 45,
              "entSensorThresholdSeverity": "major"
            }
          }
        }
      },
      "entSensorThresholdRecoveryNotification": {
        "type": "object",
        "description": "SNMP trap notification payload for entSensorThresholdRecoveryNotification",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-ENTITY-SENSOR-MIB:entSensorThresholdRecoveryNotification": {
                "type": "object",
                "description": "Varbind objects for entSensorThresholdRecoveryNotification trap",
                "properties": {
                  "entPhysicalIndex": {
                    "type": "string"
                  },
                  "entSensorValue": {
                    "type": "string"
                  },
                  "entSensorThresholdIndex": {
                    "type": "string"
                  },
                  "entSensorThresholdSeverity": {
                    "type": "string"
                  },
                  "entSensorThresholdValue": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-ENTITY-SENSOR-MIB:entSensorThresholdRecoveryNotification": {
              "entPhysicalIndex": 1,
              "entSensorValue": 45,
              "entSensorThresholdIndex": 1,
              "entSensorThresholdSeverity": "major",
              "entSensorThresholdValue": 1000
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Hardware",
      "description": "SNMP notification and event subscriptions for Hardware"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/iosxe/"
  }
}
