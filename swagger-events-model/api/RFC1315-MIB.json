{
  "openapi": "3.0.0",
  "info": {
    "title": "RFC1315-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from RFC1315-MIB for Frame Relay DTE events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/RFC1315-MIB:frDLCIStatusChange": {
      "get": {
        "description": "Notification for frDLCIStatusChange event",
        "tags": [
          "Interface"
        ],
        "summary": "SNMP Trap: frDLCIStatusChange",
        "operationId": "get_frDLCIStatusChange",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "frDLCIStatusChange notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/frDLCIStatusChange"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "RFC1315-MIB:frDLCIStatusChange": {
                      "frCircuitDlci": 100,
                      "frCircuitIfIndex": 1,
                      "frCircuitState": "active"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "frDLCIStatusChange": {
        "type": "object",
        "description": "SNMP trap notification payload for frDLCIStatusChange",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "RFC1315-MIB:frDLCIStatusChange": {
                "type": "object",
                "description": "Varbind objects for frDLCIStatusChange trap",
                "properties": {
                  "frCircuitDlci": {
                    "type": "string"
                  },
                  "frCircuitIfIndex": {
                    "type": "string"
                  },
                  "frCircuitState": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "RFC1315-MIB:frDLCIStatusChange": {
              "frCircuitDlci": 100,
              "frCircuitIfIndex": 1,
              "frCircuitState": "active"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Interface",
      "description": "SNMP notification and event subscriptions for Interface"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/iosxe/"
  }
}
