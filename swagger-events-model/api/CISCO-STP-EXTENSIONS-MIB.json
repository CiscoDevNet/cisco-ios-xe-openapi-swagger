{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-STP-EXTENSIONS-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-STP-EXTENSIONS-MIB for Spanning tree protocol events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-STP-EXTENSIONS-MIB:stpxInconsistencyUpdate": {
      "get": {
        "description": "Notification for stpxInconsistencyUpdate event",
        "tags": [
          "Switching"
        ],
        "summary": "SNMP Trap: stpxInconsistencyUpdate",
        "operationId": "get_stpxInconsistencyUpdate",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "stpxInconsistencyUpdate notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/stpxInconsistencyUpdate"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-STP-EXTENSIONS-MIB:stpxInconsistencyUpdate": {
                      "stpxVlanIndex": 1,
                      "stpxPortIndex": 1,
                      "stpxInconsistentState": "active"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-STP-EXTENSIONS-MIB:stpxRootInconsistencyUpdate": {
      "get": {
        "description": "Notification for stpxRootInconsistencyUpdate event",
        "tags": [
          "Switching"
        ],
        "summary": "SNMP Trap: stpxRootInconsistencyUpdate",
        "operationId": "get_stpxRootInconsistencyUpdate",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "stpxRootInconsistencyUpdate notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/stpxRootInconsistencyUpdate"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-STP-EXTENSIONS-MIB:stpxRootInconsistencyUpdate": {
                      "stpxRootInconsistencyIndex": 1,
                      "stpxRootInconsistencyPortIndex": 1,
                      "stpxRootInconsistencyState": "active",
                      "stpxSpanningTreeType": "rapidPvstPlus"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-STP-EXTENSIONS-MIB:stpxLoopInconsistencyUpdate": {
      "get": {
        "description": "Notification for stpxLoopInconsistencyUpdate event",
        "tags": [
          "Switching"
        ],
        "summary": "SNMP Trap: stpxLoopInconsistencyUpdate",
        "operationId": "get_stpxLoopInconsistencyUpdate",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "stpxLoopInconsistencyUpdate notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/stpxLoopInconsistencyUpdate"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-STP-EXTENSIONS-MIB:stpxLoopInconsistencyUpdate": {
                      "stpxLoopInconsistencyIndex": 1,
                      "stpxLoopInconsistencyPortIndex": 1,
                      "stpxLoopInconsistencyState": "active",
                      "stpxSpanningTreeType": "rapidPvstPlus"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "stpxInconsistencyUpdate": {
        "type": "object",
        "description": "SNMP trap notification payload for stpxInconsistencyUpdate",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-STP-EXTENSIONS-MIB:stpxInconsistencyUpdate": {
                "type": "object",
                "description": "Varbind objects for stpxInconsistencyUpdate trap",
                "properties": {
                  "stpxVlanIndex": {
                    "type": "string"
                  },
                  "stpxPortIndex": {
                    "type": "string"
                  },
                  "stpxInconsistentState": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-STP-EXTENSIONS-MIB:stpxInconsistencyUpdate": {
              "stpxVlanIndex": 1,
              "stpxPortIndex": 1,
              "stpxInconsistentState": "active"
            }
          }
        }
      },
      "stpxRootInconsistencyUpdate": {
        "type": "object",
        "description": "SNMP trap notification payload for stpxRootInconsistencyUpdate",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-STP-EXTENSIONS-MIB:stpxRootInconsistencyUpdate": {
                "type": "object",
                "description": "Varbind objects for stpxRootInconsistencyUpdate trap",
                "properties": {
                  "stpxRootInconsistencyIndex": {
                    "type": "string"
                  },
                  "stpxRootInconsistencyPortIndex": {
                    "type": "string"
                  },
                  "stpxRootInconsistencyState": {
                    "type": "string"
                  },
                  "stpxSpanningTreeType": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-STP-EXTENSIONS-MIB:stpxRootInconsistencyUpdate": {
              "stpxRootInconsistencyIndex": 1,
              "stpxRootInconsistencyPortIndex": 1,
              "stpxRootInconsistencyState": "active",
              "stpxSpanningTreeType": "rapidPvstPlus"
            }
          }
        }
      },
      "stpxLoopInconsistencyUpdate": {
        "type": "object",
        "description": "SNMP trap notification payload for stpxLoopInconsistencyUpdate",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-STP-EXTENSIONS-MIB:stpxLoopInconsistencyUpdate": {
                "type": "object",
                "description": "Varbind objects for stpxLoopInconsistencyUpdate trap",
                "properties": {
                  "stpxLoopInconsistencyIndex": {
                    "type": "string"
                  },
                  "stpxLoopInconsistencyPortIndex": {
                    "type": "string"
                  },
                  "stpxLoopInconsistencyState": {
                    "type": "string"
                  },
                  "stpxSpanningTreeType": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-STP-EXTENSIONS-MIB:stpxLoopInconsistencyUpdate": {
              "stpxLoopInconsistencyIndex": 1,
              "stpxLoopInconsistencyPortIndex": 1,
              "stpxLoopInconsistencyState": "active",
              "stpxSpanningTreeType": "rapidPvstPlus"
            }
          }
