{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - sm-oper",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG definitions\n     for session operations events generated from the Cisco Wired\n     devices. These models may produce high volume of data.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - sm-oper.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - sm-oper.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-sm-events-oper structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-sm-events-oper.html)",
    "x-yang-module": "Cisco-IOS-XE-sm-events-oper",
    "x-model-type": "events"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
