      "get": {
        "summary": "Get Cisco-IOS-XE-sm-events-oper event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-sm-events-oper",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-sm-events-oper:sessionevent": {
                      "client-mac": "00:1a:2b:3c:4d:5e",
                      "audit-session-id": "AC1001640000002B",
                      "method-id": 12345,
                      "username": "admin",
                      "client-join-time": "2026-02-10T10:30:00Z",
                      "server-address": "10.1.1.1",
                      "interface-name": "GigabitEthernet1",
                      "(session-event-choice)?": {
                        "authc-success-params": "success-params",
                        "eap-method": "session-eap",
                        "authc-failure-params": "none",
                        "failure-reason": "configuration-applied",
                        "failed-attribute": "none",
                        "authz-success-params": "success-params",
                        "res-vlan-id": 100,
                        "res-vlan-name": "router-01",
                        "sgt": 1000,
                        "authz-failure-params": "none",
