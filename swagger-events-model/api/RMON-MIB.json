{
  "openapi": "3.0.0",
  "info": {
    "title": "RMON-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from RMON-MIB for Remote monitoring events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/RMON-MIB:risingAlarm": {
      "get": {
        "description": "Notification for risingAlarm event",
        "tags": [
          "Management"
        ],
        "summary": "SNMP Trap: risingAlarm",
        "operationId": "get_risingAlarm",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "risingAlarm notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/risingAlarm"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "RMON-MIB:risingAlarm": {
                      "alarmIndex": 1,
                      "alarmVariable": "alarmvariable",
                      "alarmSampleType": "absoluteValue",
                      "alarmValue": 1000,
                      "alarmRisingThreshold": "alarmrisingthreshold"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/RMON-MIB:fallingAlarm": {
      "get": {
        "description": "Notification for fallingAlarm event",
        "tags": [
          "Management"
        ],
        "summary": "SNMP Trap: fallingAlarm",
        "operationId": "get_fallingAlarm",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "fallingAlarm notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/fallingAlarm"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "RMON-MIB:fallingAlarm": {
                      "alarmIndex": 1,
                      "alarmVariable": "alarmvariable",
                      "alarmSampleType": "absoluteValue",
                      "alarmValue": 1000,
                      "alarmFallingThreshold": "alarmfallingthreshold"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "risingAlarm": {
        "type": "object",
        "description": "SNMP trap notification payload for risingAlarm",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "RMON-MIB:risingAlarm": {
                "type": "object",
                "description": "Varbind objects for risingAlarm trap",
                "properties": {
                  "alarmIndex": {
                    "type": "string"
                  },
                  "alarmVariable": {
                    "type": "string"
                  },
                  "alarmSampleType": {
                    "type": "string"
                  },
                  "alarmValue": {
                    "type": "string"
                  },
                  "alarmRisingThreshold": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "RMON-MIB:risingAlarm": {
              "alarmIndex": 1,
              "alarmVariable": "alarmvariable",
              "alarmSampleType": "absoluteValue",
              "alarmValue": 1000,
              "alarmRisingThreshold": "alarmrisingthreshold"
            }
          }
        }
      },
      "fallingAlarm": {
        "type": "object",
        "description": "SNMP trap notification payload for fallingAlarm",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "RMON-MIB:fallingAlarm": {
                "type": "object",
                "description": "Varbind objects for fallingAlarm trap",
                "properties": {
                  "alarmIndex": {
                    "type": "string"
                  },
                  "alarmVariable": {
                    "type": "string"
                  },
                  "alarmSampleType": {
                    "type": "string"
                  },
                  "alarmValue": {
                    "type": "string"
                  },
                  "alarmFallingThreshold": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "RMON-MIB:fallingAlarm": {
              "alarmIndex": 1,
              "alarmVariable": "alarmvariable",
              "alarmSampleType": "absoluteValue",
              "alarmValue": 1000,
              "alarmFallingThreshold": "alarmfallingthreshold"
            }
          }
        }
      }
    }
  }
}
