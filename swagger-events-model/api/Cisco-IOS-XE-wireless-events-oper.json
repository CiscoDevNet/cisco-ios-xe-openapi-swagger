        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-wireless-events-oper:wsa-client-event": {
                      "client-mac": "00:1a:2b:3c:4d:5e",
                      "wtp-mac": "aa:bb:cc:dd:ee:ff",
                      "state-transition-timestamp": "active",
                      "audit-session-id": "AC1001640000002B",
                      "ssid": "Corporate-WiFi",
                      "client-event": "wsa-client",
                      "client-event-result": "wsa-client",
                      "vlan-id": 100,
                      "client-vnid": 12345,
                      "client-sgt": 100,
                      "rssi": -65,
                      "snr": 30,
                      "ms-ap-slot-id": 12345,
                      "mm-client-role": "mm-client",
