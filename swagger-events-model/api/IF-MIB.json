{
  "openapi": "3.0.0",
  "info": {
    "title": "IF-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from IF-MIB for Interface link state events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/IF-MIB:linkDown": {
      "get": {
        "description": "Notification for linkDown event",
        "tags": [
          "Interface"
        ],
        "summary": "SNMP Trap: linkDown",
        "operationId": "get_linkDown",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "linkDown notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/linkDown"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "IF-MIB:linkDown": {
                      "ifIndex": 1,
                      "ifAdminStatus": "up",
                      "ifOperStatus": "down"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/IF-MIB:linkUp": {
      "get": {
        "description": "Notification for linkUp event",
        "tags": [
          "Interface"
        ],
        "summary": "SNMP Trap: linkUp",
        "operationId": "get_linkUp",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "linkUp notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/linkUp"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "IF-MIB:linkUp": {
                      "ifIndex": 1,
                      "ifAdminStatus": "up",
                      "ifOperStatus": "up"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "linkDown": {
        "type": "object",
        "description": "SNMP trap notification payload for linkDown",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "IF-MIB:linkDown": {
                "type": "object",
                "description": "Varbind objects for linkDown trap",
                "properties": {
                  "ifIndex": {
                    "type": "string"
                  },
                  "ifAdminStatus": {
                    "type": "string"
                  },
                  "ifOperStatus": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "IF-MIB:linkDown": {
              "ifIndex": 1,
              "ifAdminStatus": "up",
              "ifOperStatus": "down"
            }
          }
        }
      },
      "linkUp": {
        "type": "object",
        "description": "SNMP trap notification payload for linkUp",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "IF-MIB:linkUp": {
                "type": "object",
                "description": "Varbind objects for linkUp trap",
                "properties": {
                  "ifIndex": {
                    "type": "string"
                  },
                  "ifAdminStatus": {
                    "type": "string"
                  },
                  "ifOperStatus": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "IF-MIB:linkUp": {
              "ifIndex": 1,
              "ifAdminStatus": "up",
              "ifOperStatus": "up"
            }
          }
        }
      }
    }
  }
}
