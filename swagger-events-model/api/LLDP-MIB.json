{
  "openapi": "3.0.0",
  "info": {
    "title": "LLDP-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from LLDP-MIB for LLDP remote table change events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/LLDP-MIB:lldpRemTablesChange": {
      "get": {
        "description": "Notification for lldpRemTablesChange event",
        "tags": [
          "Management"
        ],
        "summary": "SNMP Trap: lldpRemTablesChange",
        "operationId": "get_lldpRemTablesChange",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "lldpRemTablesChange notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/lldpRemTablesChange"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "LLDP-MIB:lldpRemTablesChange": {
                      "lldpStatsRemTablesInserts": "lldpstatsremtablesinserts",
                      "lldpStatsRemTablesDeletes": "lldpstatsremtablesdeletes",
                      "lldpStatsRemTablesDrops": "lldpstatsremtablesdrops",
                      "lldpStatsRemTablesAgeouts": "lldpstatsremtablesageouts"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "lldpRemTablesChange": {
        "type": "object",
        "description": "SNMP trap notification payload for lldpRemTablesChange",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "LLDP-MIB:lldpRemTablesChange": {
                "type": "object",
                "description": "Varbind objects for lldpRemTablesChange trap",
                "properties": {
                  "lldpStatsRemTablesInserts": {
                    "type": "string"
                  },
                  "lldpStatsRemTablesDeletes": {
                    "type": "string"
                  },
                  "lldpStatsRemTablesDrops": {
                    "type": "string"
                  },
                  "lldpStatsRemTablesAgeouts": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "LLDP-MIB:lldpRemTablesChange": {
              "lldpStatsRemTablesInserts": "lldpstatsremtablesinserts",
              "lldpStatsRemTablesDeletes": "lldpstatsremtablesdeletes",
              "lldpStatsRemTablesDrops": "lldpstatsremtablesdrops",
              "lldpStatsRemTablesAgeouts": "lldpstatsremtablesageouts"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Management",
      "description": "SNMP notification and event subscriptions for Management"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/docs/ios-xe/"
  }
}
