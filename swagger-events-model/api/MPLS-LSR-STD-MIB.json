{
  "openapi": "3.0.0",
  "info": {
    "title": "MPLS-LSR-STD-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from MPLS-LSR-STD-MIB for MPLS LSR interface events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/MPLS-LSR-STD-MIB:mplsXCUp": {
      "get": {
        "description": "Notification for mplsXCUp event",
        "tags": [
          "MPLS"
        ],
        "summary": "SNMP Trap: mplsXCUp",
        "operationId": "get_mplsXCUp",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "mplsXCUp notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/mplsXCUp"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "MPLS-LSR-STD-MIB:mplsXCUp": {
                      "mplsXCIndex": 1,
                      "mplsXCInSegmentIndex": 1,
                      "mplsXCOutSegmentIndex": 1,
                      "mplsXCOperStatus": "up"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/MPLS-LSR-STD-MIB:mplsXCDown": {
      "get": {
        "description": "Notification for mplsXCDown event",
        "tags": [
          "MPLS"
        ],
        "summary": "SNMP Trap: mplsXCDown",
        "operationId": "get_mplsXCDown",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "mplsXCDown notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/mplsXCDown"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "MPLS-LSR-STD-MIB:mplsXCDown": {
                      "mplsXCIndex": 1,
                      "mplsXCInSegmentIndex": 1,
                      "mplsXCOutSegmentIndex": 1,
                      "mplsXCOperStatus": "down"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "mplsXCUp": {
        "type": "object",
        "description": "SNMP trap notification payload for mplsXCUp",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "MPLS-LSR-STD-MIB:mplsXCUp": {
                "type": "object",
                "description": "Varbind objects for mplsXCUp trap",
                "properties": {
                  "mplsXCIndex": {
                    "type": "string"
                  },
                  "mplsXCInSegmentIndex": {
                    "type": "string"
                  },
                  "mplsXCOutSegmentIndex": {
                    "type": "string"
                  },
                  "mplsXCOperStatus": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "MPLS-LSR-STD-MIB:mplsXCUp": {
              "mplsXCIndex": 1,
              "mplsXCInSegmentIndex": 1,
              "mplsXCOutSegmentIndex": 1,
              "mplsXCOperStatus": "up"
            }
          }
        }
      },
      "mplsXCDown": {
        "type": "object",
        "description": "SNMP trap notification payload for mplsXCDown",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "MPLS-LSR-STD-MIB:mplsXCDown": {
                "type": "object",
                "description": "Varbind objects for mplsXCDown trap",
                "properties": {
                  "mplsXCIndex": {
                    "type": "string"
                  },
                  "mplsXCInSegmentIndex": {
                    "type": "string"
                  },
                  "mplsXCOutSegmentIndex": {
                    "type": "string"
                  },
                  "mplsXCOperStatus": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "MPLS-LSR-STD-MIB:mplsXCDown": {
              "mplsXCIndex": 1,
              "mplsXCInSegmentIndex": 1,
              "mplsXCOutSegmentIndex": 1,
              "mplsXCOperStatus": "down"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "MPLS",
      "description": "SNMP notification and event subscriptions for MPLS"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/docs/ios-xe/"
  }
}
