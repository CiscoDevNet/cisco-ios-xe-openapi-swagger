{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - fib",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG definitions\n     for FIB status change notification.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - fib.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - fib.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-fib-events structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-fib-events.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-fib-events:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-fib-events event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-fib-events",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-fib-events:fib-updates": {
                      "severity-level": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "vrf-name": "default",
                      "address-family-type": "10.1.1.1",
                      "fib-last-update-time": "2026-02-10T10:30:00Z"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/fib-updates"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "operationId": "get-events"
      }
    },
    "/operations/ietf-subscribed-notifications:establish-subscription": {
      "post": {
        "summary": "Create event subscription",
        "description": "Establish a subscription to Cisco-IOS-XE-fib-events events",
        "tags": [
          "events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "example": {
                "input": {
                  "stream": "Cisco-IOS-XE-fib-events:events",
                  "encoding": "encode-json",
                  "update-trigger": "periodic",
                  "period": 6000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-fib-events:fib-updates": {
                      "severity-level": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "vrf-name": "default",
                      "address-family-type": "10.1.1.1",
                      "fib-last-update-time": "2026-02-10T10:30:00Z"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/fib-updates"
                }
              }
            }
          }
        },
        "operationId": "post-establish-subscription"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "fib-updates": {
        "type": "object",
        "description": "Notification payload for fib-updates",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the event occurred"
              },
              "Cisco-IOS-XE-fib-events:fib-updates": {
                "type": "object",
                "properties": {
                  "severity-level": {
                    "type": "string"
                  },
                  "host-name": {
                    "type": "string"
                  },
                  "system-ip": {
                    "type": "string",
                    "format": "ipv4"
                  },
                  "vrf-name": {
                    "type": "string"
                  },
                  "address-family-type": {
                    "type": "string"
                  },
                  "fib-last-update-time": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "Cisco-IOS-XE-fib-events:fib-updates": {
              "severity-level": "major",
              "host-name": "Router1",
              "system-ip": "10.1.1.1",
              "vrf-name": "default",
              "address-family-type": "10.1.1.1",
              "fib-last-update-time": "2026-02-10T10:30:00Z"
            }
          }
        }
      },
      "fib-default-route-state-change": {
        "type": "object",
        "description": "Notification payload for fib-default-route-state-change",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the event occurred"
              },
              "Cisco-IOS-XE-fib-events:fib-default-route-state-change": {
                "type": "object",
                "properties": {
                  "table-name": {
                    "type": "string"
                  },
                  "vrf-name": {
                    "type": "string"
                  },
                  "af": {
                    "type": "string"
                  },
                  "drh-override": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "Cisco-IOS-XE-fib-events:fib-default-route-state-change": {
              "table-name": "router-01",
              "vrf-name": "default",
              "af": "fib-af",
              "drh-override": 12345
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "events",
      "description": "Model-driven telemetry event subscriptions"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/iosxe/"
  }
}
