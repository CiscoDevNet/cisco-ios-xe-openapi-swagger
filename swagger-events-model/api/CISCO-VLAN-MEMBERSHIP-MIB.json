{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-VLAN-MEMBERSHIP-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-VLAN-MEMBERSHIP-MIB for VLAN membership events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-VLAN-MEMBERSHIP-MIB:vmVmpsChange": {
      "get": {
        "description": "Notification for vmVmpsChange event",
        "tags": [
          "VLAN Management"
        ],
        "summary": "SNMP Trap: vmVmpsChange",
        "operationId": "get_vmVmpsChange",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "vmVmpsChange notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/vmVmpsChange"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-VLAN-MEMBERSHIP-MIB:vmVmpsChange": {
                      "vmVmpsIpAddress": "10.1.1.1"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "vmVmpsChange": {
        "type": "object",
        "description": "SNMP trap notification payload for vmVmpsChange",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-VLAN-MEMBERSHIP-MIB:vmVmpsChange": {
                "type": "object",
                "description": "Varbind objects for vmVmpsChange trap",
                "properties": {
                  "vmVmpsIpAddress": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-VLAN-MEMBERSHIP-MIB:vmVmpsChange": {
              "vmVmpsIpAddress": "10.1.1.1"
            }
          }
        }
      }
    }
  }
}
