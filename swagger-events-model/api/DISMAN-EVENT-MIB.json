{
  "openapi": "3.0.0",
  "info": {
    "title": "DISMAN-EVENT-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from DISMAN-EVENT-MIB for Distributed management event triggers",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/DISMAN-EVENT-MIB:mteTriggerFired": {
      "get": {
        "description": "Notification for mteTriggerFired event",
        "tags": [
          "Management"
        ],
        "summary": "SNMP Trap: mteTriggerFired",
        "operationId": "get_mteTriggerFired",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "mteTriggerFired notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/mteTriggerFired"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "DISMAN-EVENT-MIB:mteTriggerFired": {
                      "mteHotTrigger": "SnmpAdminString",
                      "mteHotTargetName": "cpmCPUTotalMonIntervalValue",
                      "mteHotContextName": "default",
                      "mteHotOID": 12345,
                      "mteHotValue": 1000
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
