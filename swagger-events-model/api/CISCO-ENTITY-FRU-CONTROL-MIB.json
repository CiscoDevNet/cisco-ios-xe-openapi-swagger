          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cefcModuleStatusChange notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cefcModuleStatusChange"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-ENTITY-FRU-CONTROL-MIB:cefcModuleStatusChange": {
                      "entPhysicalIndex": 1,
                      "cefcModuleOperStatus": "up",
                      "cefcModuleStatusLastChangeTime": "up"
                    }
