{
  "openapi": "3.0.0",
  "info": {
    "title": "SNMPv2-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from SNMPv2-MIB for SNMP protocol operational events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/SNMPv2-MIB:coldStart": {
      "get": {
        "description": "Notification for coldStart event",
        "tags": [
          "Management"
        ],
        "summary": "SNMP Trap: coldStart",
        "operationId": "get_coldStart",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "coldStart notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/coldStart"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "SNMPv2-MIB:coldStart": {
                      "event-time": "2026-02-10T10:30:00Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/SNMPv2-MIB:warmStart": {
      "get": {
        "description": "Notification for warmStart event",
        "tags": [
          "Management"
        ],
        "summary": "SNMP Trap: warmStart",
        "operationId": "get_warmStart",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "warmStart notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/warmStart"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "SNMPv2-MIB:warmStart": {
                      "event-time": "2026-02-10T10:30:00Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/SNMPv2-MIB:authenticationFailure": {
      "get": {
        "description": "Notification for authenticationFailure event",
        "tags": [
          "Management"
        ],
        "summary": "SNMP Trap: authenticationFailure",
        "operationId": "get_authenticationFailure",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "authenticationFailure notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/authenticationFailure"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "SNMPv2-MIB:authenticationFailure": {
                      "event-time": "2026-02-10T10:30:00Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "coldStart": {
        "type": "object",
        "description": "SNMP trap notification payload for coldStart",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "SNMPv2-MIB:coldStart": {
                "type": "object",
                "description": "Varbind objects for coldStart trap",
                "properties": {
                  "event-time": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "SNMPv2-MIB:coldStart": {
              "event-time": "2026-02-10T10:30:00Z"
            }
          }
        }
      },
      "warmStart": {
        "type": "object",
        "description": "SNMP trap notification payload for warmStart",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "SNMPv2-MIB:warmStart": {
                "type": "object",
                "description": "Varbind objects for warmStart trap",
                "properties": {
                  "event-time": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "SNMPv2-MIB:warmStart": {
              "event-time": "2026-02-10T10:30:00Z"
            }
          }
        }
      },
      "authenticationFailure": {
        "type": "object",
        "description": "SNMP trap notification payload for authenticationFailure",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "SNMPv2-MIB:authenticationFailure": {
                "type": "object",
                "description": "Varbind objects for authenticationFailure trap",
                "properties": {
                  "event-time": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "SNMPv2-MIB:authenticationFailure": {
              "event-time": "2026-02-10T10:30:00Z"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Management",
      "description": "SNMP notification and event subscriptions for Management"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/iosxe/"
  }
}
