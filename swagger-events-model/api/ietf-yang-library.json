{
  "openapi": "3.0.1",
  "info": {
    "title": "ietf-yang-library Event Notifications",
    "version": "17.18.1",
    "description": "This module contains IETF YANG definitions for YANG library event notifications.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [ietf-yang-library.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/ietf-yang-library.yang)\n\n**🌳 YANG Tree:** [View ietf-yang-library structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/ietf-yang-library.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/ws/event-streams/ietf-yang-library/yang-library-update": {
      "get": {
        "summary": "Subscribe to yang-library-update events",
        "description": "Notification when YANG library content is updated",
        "tags": [
          "yang-library-events"
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols - WebSocket connection established",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/yang-library-update"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "ietf-yang-library:yang-library-update": {
                      "content-id": 12345
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "operationId": "get-yang-library-update",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "Limit the depth of returned sub-tree data (RFC 8040 Section 4.8.2). Use 'unbounded' for full depth.",
            "schema": {
              "type": "string",
              "default": "unbounded"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Select specific fields to return (RFC 8040 Section 4.8.3). Example: fields=name;status",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "description": "Filter by config state: 'config' (config true only), 'nonconfig' (config false only), or 'all'.",
            "schema": {
              "type": "string",
              "enum": [
                "config",
                "nonconfig",
                "all"
              ],
              "default": "all"
            }
          }
        ]
      }
    },
    "/ws/event-streams/ietf-yang-library/yang-library-change": {
      "get": {
        "summary": "Subscribe to yang-library-change events (deprecated)",
        "description": "Deprecated notification when YANG library module set changes",
        "tags": [
          "yang-library-events"
        ],
        "deprecated": true,
        "responses": {
          "101": {
            "description": "Switching Protocols - WebSocket connection established",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/yang-library-change"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "ietf-yang-library:yang-library-change": {}
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "operationId": "get-yang-library-change",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "Limit the depth of returned sub-tree data (RFC 8040 Section 4.8.2). Use 'unbounded' for full depth.",
            "schema": {
              "type": "string",
              "default": "unbounded"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Select specific fields to return (RFC 8040 Section 4.8.3). Example: fields=name;status",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "description": "Filter by config state: 'config' (config true only), 'nonconfig' (config false only), or 'all'.",
            "schema": {
              "type": "string",
              "enum": [
                "config",
                "nonconfig",
                "all"
              ],
              "default": "all"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "yang-library-update": {
        "type": "object",
        "description": "Notification payload for yang-library-update",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the event occurred"
              },
              "ietf-yang-library:yang-library-update": {
                "type": "object",
                "properties": {
                  "content-id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "ietf-yang-library:yang-library-update": {
              "content-id": 12345
            }
          }
        }
      },
      "yang-library-change": {
        "type": "object",
        "description": "Notification payload for yang-library-change",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the event occurred"
              },
              "ietf-yang-library:yang-library-change": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "ietf-yang-library:yang-library-change": {}
          }
        }
      },
      "restconf-error": {
        "type": "object",
        "description": "Standard RESTCONF error response (RFC 8040 Section 7.1)",
        "properties": {
          "ietf-restconf:errors": {
            "type": "object",
            "properties": {
              "error": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "error-type": {
                      "type": "string",
                      "enum": [
                        "transport",
                        "rpc",
                        "protocol",
                        "application"
                      ],
                      "description": "Layer where the error occurred"
                    },
                    "error-tag": {
                      "type": "string",
                      "description": "Enumerated error tag (e.g. invalid-value, data-missing, access-denied)"
                    },
                    "error-severity": {
                      "type": "string",
                      "enum": [
                        "error",
                        "warning"
                      ],
                      "description": "Error severity"
                    },
                    "error-app-tag": {
                      "type": "string",
                      "description": "Application-specific error tag"
                    },
                    "error-path": {
                      "type": "string",
                      "description": "YANG instance-identifier of the error node"
                    },
                    "error-message": {
                      "type": "string",
                      "description": "Human-readable error description"
                    }
                  },
                  "required": [
                    "error-type",
                    "error-tag"
                  ]
                }
              }
            }
          }
        },
        "example": {
          "ietf-restconf:errors": {
            "error": [
              {
                "error-type": "protocol",
                "error-tag": "invalid-value",
                "error-severity": "error",
                "error-message": "Invalid input parameter"
              }
            ]
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "yang-library-events",
      "description": "SNMP notification and event subscriptions for yang-library-events"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/iosxe/"
  }
}
