{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-POWER-ETHERNET-EXT-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-POWER-ETHERNET-EXT-MIB for Power over Ethernet extension events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-POWER-ETHERNET-EXT-MIB:cpeExtPolicingNotif": {
      "get": {
        "description": "Notification for cpeExtPolicingNotif event",
        "tags": [
          "Power Management"
        ],
        "summary": "SNMP Trap: cpeExtPolicingNotif",
        "operationId": "get_cpeExtPolicingNotif",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cpeExtPolicingNotif notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cpeExtPolicingNotif"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-POWER-ETHERNET-EXT-MIB:cpeExtPolicingNotif": {
                      "pethPsePortGroupIndex": 1,
                      "pethPsePortIndex": 1,
                      "CISCO-POWER-ETHERNET-EXT-MIB:cpeExtPsePortPolicingAction": "ext-mib:cpeextpseportpolicingaction",
                      "CISCO-POWER-ETHERNET-EXT-MIB:cpeExtPsePortAdditionalStatus": "up",
                      "CISCO-POWER-ETHERNET-EXT-MIB:cpeExtPsePortPwrAllocated": "ext-mib:cpeextpseportpwrallocated",
                      "CISCO-POWER-ETHERNET-EXT-MIB:cpeExtPsePortMaxPwrDrawn": "ext-mib:cpeextpseportmaxpwrdrawn"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "cpeExtPolicingNotif": {
        "type": "object",
        "description": "SNMP trap notification payload for cpeExtPolicingNotif",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-POWER-ETHERNET-EXT-MIB:cpeExtPolicingNotif": {
                "type": "object",
                "description": "Varbind objects for cpeExtPolicingNotif trap",
                "properties": {
                  "pethPsePortGroupIndex": {
                    "type": "string"
                  },
                  "pethPsePortIndex": {
                    "type": "string"
                  },
                  "CISCO-POWER-ETHERNET-EXT-MIB:cpeExtPsePortPolicingAction": {
                    "type": "string"
                  },
                  "CISCO-POWER-ETHERNET-EXT-MIB:cpeExtPsePortAdditionalStatus": {
                    "type": "string"
                  },
                  "CISCO-POWER-ETHERNET-EXT-MIB:cpeExtPsePortPwrAllocated": {
                    "type": "string"
                  },
                  "CISCO-POWER-ETHERNET-EXT-MIB:cpeExtPsePortMaxPwrDrawn": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-POWER-ETHERNET-EXT-MIB:cpeExtPolicingNotif": {
              "pethPsePortGroupIndex": 1,
              "pethPsePortIndex": 1,
              "CISCO-POWER-ETHERNET-EXT-MIB:cpeExtPsePortPolicingAction": "ext-mib:cpeextpseportpolicingaction",
              "CISCO-POWER-ETHERNET-EXT-MIB:cpeExtPsePortAdditionalStatus": "up",
              "CISCO-POWER-ETHERNET-EXT-MIB:cpeExtPsePortPwrAllocated": "ext-mib:cpeextpseportpwrallocated",
              "CISCO-POWER-ETHERNET-EXT-MIB:cpeExtPsePortMaxPwrDrawn": "ext-mib:cpeextpseportmaxpwrdrawn"
            }
          }
        }
      }
    }
  }
}
