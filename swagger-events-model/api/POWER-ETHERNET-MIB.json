{
  "openapi": "3.0.0",
  "info": {
    "title": "POWER-ETHERNET-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from POWER-ETHERNET-MIB for Power over Ethernet events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/POWER-ETHERNET-MIB:pethPsePortOnOffNotification": {
      "get": {
        "description": "Notification for pethPsePortOnOffNotification event",
        "tags": [
          "Power Management"
        ],
        "summary": "SNMP Trap: pethPsePortOnOffNotification",
        "operationId": "get_pethPsePortOnOffNotification",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "pethPsePortOnOffNotification notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/pethPsePortOnOffNotification"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "POWER-ETHERNET-MIB:pethPsePortOnOffNotification": {
                      "pethPsePortGroupIndex": 1,
                      "pethPsePortIndex": 1,
                      "pethPsePortDetectionStatus": "up"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/POWER-ETHERNET-MIB:pethMainPowerUsageOnNotification": {
      "get": {
        "description": "Notification for pethMainPowerUsageOnNotification event",
        "tags": [
          "Power Management"
        ],
        "summary": "SNMP Trap: pethMainPowerUsageOnNotification",
        "operationId": "get_pethMainPowerUsageOnNotification",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "pethMainPowerUsageOnNotification notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/pethMainPowerUsageOnNotification"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "POWER-ETHERNET-MIB:pethMainPowerUsageOnNotification": {
                      "pethMainPseGroupIndex": 1,
                      "pethMainPseConsumptionPower": "pethmainpseconsumptionpower"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/POWER-ETHERNET-MIB:pethMainPowerUsageOffNotification": {
      "get": {
        "description": "Notification for pethMainPowerUsageOffNotification event",
        "tags": [
          "Power Management"
        ],
        "summary": "SNMP Trap: pethMainPowerUsageOffNotification",
        "operationId": "get_pethMainPowerUsageOffNotification",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "pethMainPowerUsageOffNotification notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/pethMainPowerUsageOffNotification"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "POWER-ETHERNET-MIB:pethMainPowerUsageOffNotification": {
                      "pethMainPseGroupIndex": 1,
                      "pethMainPseConsumptionPower": "pethmainpseconsumptionpower"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "pethPsePortOnOffNotification": {
        "type": "object",
        "description": "SNMP trap notification payload for pethPsePortOnOffNotification",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "POWER-ETHERNET-MIB:pethPsePortOnOffNotification": {
                "type": "object",
                "description": "Varbind objects for pethPsePortOnOffNotification trap",
                "properties": {
                  "pethPsePortGroupIndex": {
                    "type": "string"
                  },
                  "pethPsePortIndex": {
                    "type": "string"
                  },
                  "pethPsePortDetectionStatus": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "POWER-ETHERNET-MIB:pethPsePortOnOffNotification": {
              "pethPsePortGroupIndex": 1,
              "pethPsePortIndex": 1,
              "pethPsePortDetectionStatus": "up"
            }
          }
        }
      },
      "pethMainPowerUsageOnNotification": {
        "type": "object",
        "description": "SNMP trap notification payload for pethMainPowerUsageOnNotification",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "POWER-ETHERNET-MIB:pethMainPowerUsageOnNotification": {
                "type": "object",
                "description": "Varbind objects for pethMainPowerUsageOnNotification trap",
                "properties": {
                  "pethMainPseGroupIndex": {
                    "type": "string"
                  },
                  "pethMainPseConsumptionPower": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "POWER-ETHERNET-MIB:pethMainPowerUsageOnNotification": {
              "pethMainPseGroupIndex": 1,
              "pethMainPseConsumptionPower": "pethmainpseconsumptionpower"
            }
          }
        }
      },
      "pethMainPowerUsageOffNotification": {
        "type": "object",
        "description": "SNMP trap notification payload for pethMainPowerUsageOffNotification",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "POWER-ETHERNET-MIB:pethMainPowerUsageOffNotification": {
                "type": "object",
                "description": "Varbind objects for pethMainPowerUsageOffNotification trap",
                "properties": {
                  "pethMainPseGroupIndex": {
                    "type": "string"
                  },
                  "pethMainPseConsumptionPower": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "POWER-ETHERNET-MIB:pethMainPowerUsageOffNotification": {
              "pethMainPseGroupIndex": 1,
              "pethMainPseConsumptionPower": "pethmainpseconsumptionpower"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Power Management",
      "description": "SNMP notification and event subscriptions for Power Management"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
