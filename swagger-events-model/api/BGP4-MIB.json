{
  "openapi": "3.0.0",
  "info": {
    "title": "BGP4-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from BGP4-MIB for BGP routing protocol events",
    "version": "1.0.0",
    "x-yang-module": "ietf-subscribed-notifications",
    "x-model-type": "events"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/BGP4-MIB:bgpEstablished": {
      "get": {
        "summary": "SNMP Trap: BGP peer established",
        "description": "Notification when BGP peer session transitions to Established state",
        "operationId": "get_bgpEstablished",
        "tags": [
          "BGP Peer Events"
        ],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "Limit the depth of returned sub-tree data (RFC 8040 Section 4.8.2). Use 'unbounded' for full depth.",
            "schema": {
              "type": "string",
              "default": "unbounded"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Select specific fields to return (RFC 8040 Section 4.8.3). Example: fields=name;status",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "description": "Filter by config state: 'config' (config true only), 'nonconfig' (config false only), or 'all'.",
            "schema": {
              "type": "string",
              "enum": [
                "config",
                "nonconfig",
                "all"
              ],
              "default": "all"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "name key"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "id key"
          }
        ],
        "responses": {
          "200": {
            "description": "bgpEstablished notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/bgpEstablished"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "BGP4-MIB:bgpEstablished": {
                      "bgpPeerRemoteAddr": "10.0.0.2",
                      "bgpPeerLastError": "0x00 0x00",
                      "bgpPeerState": "active"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        }
      },
      "x-yang-path": "/subscriptions/subscription={id}/receivers/receiver={name}/BGP4-MIB:bgpEstablished",
      "x-restconf-kind": "notification",
      "x-list-keys": [
        "id",
        "name"
      ]
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/BGP4-MIB:bgpBackwardTransition": {
      "get": {
        "summary": "SNMP Trap: BGP backward transition",
        "description": "Notification when BGP peer session transitions out of Established state",
        "operationId": "get_bgpBackwardTransition",
        "tags": [
          "BGP Peer Events"
        ],
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "Limit the depth of returned sub-tree data (RFC 8040 Section 4.8.2). Use 'unbounded' for full depth.",
            "schema": {
              "type": "string",
              "default": "unbounded"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Select specific fields to return (RFC 8040 Section 4.8.3). Example: fields=name;status",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "description": "Filter by config state: 'config' (config true only), 'nonconfig' (config false only), or 'all'.",
            "schema": {
              "type": "string",
              "enum": [
                "config",
                "nonconfig",
                "all"
              ],
              "default": "all"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "name key"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "id key"
          }
        ],
        "responses": {
          "200": {
            "description": "bgpBackwardTransition notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/bgpBackwardTransition"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "BGP4-MIB:bgpBackwardTransition": {
                      "bgpPeerRemoteAddr": "10.0.0.2",
                      "bgpPeerLastError": "0x00 0x00",
                      "bgpPeerState": "active"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        }
      },
      "x-yang-path": "/subscriptions/subscription={id}/receivers/receiver={name}/BGP4-MIB:bgpBackwardTransition",
      "x-restconf-kind": "notification",
      "x-list-keys": [
        "id",
        "name"
      ]
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Subscription identifier"
      },
      "ReceiverName": {
        "name": "name",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Receiver name"
      }
    },
    "responses": {
      "NotificationResponse": {
        "description": "SNMP Trap notification data",
        "content": {
          "application/yang-data+json": {
            "schema": {
              "type": "object",
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "bgpEstablished": {
        "type": "object",
        "description": "SNMP trap notification payload for bgpEstablished",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "BGP4-MIB:bgpEstablished": {
                "type": "object",
                "description": "Varbind objects for bgpEstablished trap",
                "properties": {
                  "bgpPeerRemoteAddr": {
                    "type": "string"
                  },
                  "bgpPeerLastError": {
                    "type": "string"
                  },
                  "bgpPeerState": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "BGP4-MIB:bgpEstablished": {
              "bgpPeerRemoteAddr": "10.0.0.2",
              "bgpPeerLastError": "0x00 0x00",
              "bgpPeerState": "active"
            }
          }
        }
      },
      "bgpBackwardTransition": {
        "type": "object",
        "description": "SNMP trap notification payload for bgpBackwardTransition",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "BGP4-MIB:bgpBackwardTransition": {
                "type": "object",
                "description": "Varbind objects for bgpBackwardTransition trap",
                "properties": {
                  "bgpPeerRemoteAddr": {
                    "type": "string"
                  },
                  "bgpPeerLastError": {
                    "type": "string"
                  },
                  "bgpPeerState": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "BGP4-MIB:bgpBackwardTransition": {
              "bgpPeerRemoteAddr": "10.0.0.2",
              "bgpPeerLastError": "0x00 0x00",
              "bgpPeerState": "active"
            }
          }
        }
      },
      "restconf-error": {
        "type": "object",
        "description": "Standard RESTCONF error response (RFC 8040 Section 7.1)",
        "properties": {
          "ietf-restconf:errors": {
            "type": "object",
            "properties": {
              "error": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "error-type": {
                      "type": "string",
                      "enum": [
                        "transport",
                        "rpc",
                        "protocol",
                        "application"
                      ],
                      "description": "Layer where the error occurred"
                    },
                    "error-tag": {
                      "type": "string",
                      "description": "Enumerated error tag (e.g. invalid-value, data-missing, access-denied)"
                    },
                    "error-severity": {
                      "type": "string",
                      "enum": [
                        "error",
                        "warning"
                      ],
                      "description": "Error severity"
                    },
                    "error-app-tag": {
                      "type": "string",
                      "description": "Application-specific error tag"
                    },
                    "error-path": {
                      "type": "string",
                      "description": "YANG instance-identifier of the error node"
                    },
                    "error-message": {
                      "type": "string",
                      "description": "Human-readable error description"
                    }
                  },
                  "required": [
                    "error-type",
                    "error-tag"
                  ]
                }
              }
            }
          }
        },
        "example": {
          "ietf-restconf:errors": {
            "error": [
              {
                "error-type": "protocol",
                "error-tag": "invalid-value",
                "error-severity": "error",
                "error-message": "Invalid input parameter"
              }
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "BGP Peer Events",
      "description": "SNMP notification and event subscriptions for BGP Peer Events"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/iosxe/"
  }
}
