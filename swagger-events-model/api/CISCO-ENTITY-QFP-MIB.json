                "type": "object",
                "description": "Varbind objects for ceqfpMemoryResFallingThreshNotif trap",
                "properties": {
                  "entPhysicalIndex": {
                    "type": "string"
                  },
                  "ceqfpMemoryResType": {
                    "type": "string"
                  },
                  "ceqfpMemoryResInUse": {
                    "type": "string"
                  },
                  "ceqfpMemoryResCurrentFallingThresh": {
                    "type": "integer",
                    "format": "int32"
                  }
                }
              }
            }
          }
