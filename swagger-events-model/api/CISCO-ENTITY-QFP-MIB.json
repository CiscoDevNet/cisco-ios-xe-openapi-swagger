{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-ENTITY-QFP-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-ENTITY-QFP-MIB for Quantum Flow Processor utilization events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-ENTITY-QFP-MIB:ceqfpMemoryResRisingThreshNotif": {
      "get": {
        "description": "Notification for ceqfpMemoryResRisingThreshNotif event",
        "tags": [
          "Hardware"
        ],
        "summary": "SNMP Trap: ceqfpMemoryResRisingThreshNotif",
        "operationId": "get_ceqfpMemoryResRisingThreshNotif",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ceqfpMemoryResRisingThreshNotif notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ceqfpMemoryResRisingThreshNotif"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-ENTITY-QFP-MIB:ceqfpMemoryResRisingThreshNotif": {
                      "entPhysicalIndex": 1,
                      "ceqfpMemoryResType": "dram",
                      "ceqfpMemoryResInUse": "ceqfpmemoryresinuse",
                      "ceqfpMemoryResCurrentRisingThresh": 1000
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-ENTITY-QFP-MIB:ceqfpMemoryResFallingThreshNotif": {
      "get": {
        "description": "Notification for ceqfpMemoryResFallingThreshNotif event",
        "tags": [
          "Hardware"
        ],
        "summary": "SNMP Trap: ceqfpMemoryResFallingThreshNotif",
        "operationId": "get_ceqfpMemoryResFallingThreshNotif",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ceqfpMemoryResFallingThreshNotif notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ceqfpMemoryResFallingThreshNotif"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-ENTITY-QFP-MIB:ceqfpMemoryResFallingThreshNotif": {
                      "entPhysicalIndex": 1,
                      "ceqfpMemoryResType": "dram",
                      "ceqfpMemoryResInUse": "ceqfpmemoryresinuse",
                      "ceqfpMemoryResCurrentFallingThresh": 1000
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-ENTITY-QFP-MIB:ceqfpThroughputNotif": {
      "get": {
        "description": "Notification for ceqfpThroughputNotif event",
        "tags": [
          "Hardware"
        ],
        "summary": "SNMP Trap: ceqfpThroughputNotif",
        "operationId": "get_ceqfpThroughputNotif",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ceqfpThroughputNotif notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ceqfpThroughputNotif"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-ENTITY-QFP-MIB:ceqfpThroughputNotif": {
                      "entPhysicalIndex": 1,
                      "ceqfpThroughputLicensedBW": "ceqfpthroughputlicensedbw",
                      "ceqfpThroughputLevel": "normal",
                      "ceqfpThroughputAvgRate": 100
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "ceqfpMemoryResRisingThreshNotif": {
        "type": "object",
        "description": "SNMP trap notification payload for ceqfpMemoryResRisingThreshNotif",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-ENTITY-QFP-MIB:ceqfpMemoryResRisingThreshNotif": {
                "type": "object",
                "description": "Varbind objects for ceqfpMemoryResRisingThreshNotif trap",
                "properties": {
                  "entPhysicalIndex": {
                    "type": "string"
                  },
                  "ceqfpMemoryResType": {
                    "type": "string"
                  },
                  "ceqfpMemoryResInUse": {
                    "type": "string"
                  },
                  "ceqfpMemoryResCurrentRisingThresh": {
                    "type": "integer",
                    "format": "int32"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-ENTITY-QFP-MIB:ceqfpMemoryResRisingThreshNotif": {
              "entPhysicalIndex": 1,
              "ceqfpMemoryResType": "dram",
              "ceqfpMemoryResInUse": "ceqfpmemoryresinuse",
              "ceqfpMemoryResCurrentRisingThresh": 1000
            }
          }
        }
      },
