{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-RTTMON-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-RTTMON-MIB for Round-trip time monitoring and IP SLA events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-RTTMON-MIB:rttMonNotification": {
      "get": {
        "description": "Notification for rttMonNotification event",
        "tags": [
          "Performance"
        ],
        "summary": "SNMP Trap: rttMonNotification",
        "operationId": "get_rttMonNotification",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "rttMonNotification notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/rttMonNotification"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-RTTMON-MIB:rttMonNotification": {
                      "rttMonCtrlAdminIndex": 1,
                      "rttMonCtrlAdminTag": "example-string",
                      "rttMonHistoryCollectionLifeIndex": 1,
                      "rttMonHistoryCollectionBucketIndex": 1,
                      "rttMonHistoryCollectionSampleIndex": 1,
                      "rttMonHistoryCollectionAddress": "10.1.1.1",
                      "rttMonReactConfigIndex": 1,
                      "rttMonReactVar": "example-string",
                      "rttMonReactOccurred": "example-string",
                      "rttMonReactValue": "example-string",
                      "rttMonReactThresholdRising": "example-string",
                      "rttMonReactThresholdFalling": "example-string",
                      "rttMonEchoAdminLSPSelector": "example-string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
