{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - crypto-pki",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG definitions\n     for crypto PKI events data.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - crypto-pki.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - crypto-pki.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-crypto-pki-events structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-crypto-pki-events.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-crypto-pki-events:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-crypto-pki-events event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-crypto-pki-events",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-crypto-pki-events:pki-certificate-expiry": {
                      "trust-point": "example-string",
                      "expires-at": "2026-02-10T10:30:00Z",
                      "is-ca-cert": true,
                      "subject-name": "example-name",
                      "issuer-name": "example-name",
                      "serial-number": "example-string",
                      "severity": "major",
                      "host-name": "Router1"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/pki-certificate-expiry"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/operations/ietf-subscribed-notifications:establish-subscription": {
      "post": {
        "summary": "Create event subscription",
        "description": "Establish a subscription to Cisco-IOS-XE-crypto-pki-events events",
        "tags": [
          "events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "example": {
                "input": {
                  "stream": "Cisco-IOS-XE-crypto-pki-events:events",
                  "encoding": "encode-json",
                  "update-trigger": "periodic",
                  "period": 6000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-crypto-pki-events:pki-certificate-expiry": {
                      "trust-point": "example-string",
                      "expires-at": "2026-02-10T10:30:00Z",
                      "is-ca-cert": true,
                      "subject-name": "example-name",
                      "issuer-name": "example-name",
                      "serial-number": "example-string",
                      "severity": "major",
                      "host-name": "Router1"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/pki-certificate-expiry"
                }
              }
            }
          }
        }
      }
    }
  },
