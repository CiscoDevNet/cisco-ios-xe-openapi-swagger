{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - utd",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG Definitions\n     for UTD event notification.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - utd.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - utd.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-utd-events structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-utd-events.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-utd-events:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-utd-events event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-utd-events",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-utd-events:utd-con": {
                      "severity": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "type": "security",
                      "timestamp": "2026-02-10T10:30:00Z",
                      "status": "up",
                      "reason": "link-flap-detected"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/utd-con"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "operationId": "get-events"
      }
    },
    "/operations/ietf-subscribed-notifications:establish-subscription": {
      "post": {
        "summary": "Create event subscription",
        "description": "Establish a subscription to Cisco-IOS-XE-utd-events events",
        "tags": [
          "events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "example": {
                "input": {
                  "stream": "Cisco-IOS-XE-utd-events:events",
                  "encoding": "encode-json",
                  "update-trigger": "periodic",
                  "period": 6000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-utd-events:utd-con": {
                      "severity": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "type": "security",
                      "timestamp": "2026-02-10T10:30:00Z",
                      "status": "up",
                      "reason": "link-flap-detected"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/utd-con"
                }
              }
            }
          }
        },
        "operationId": "post-establish-subscription"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "utd-con": {
        "type": "object",
        "description": "Notification payload for utd-con",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the event occurred"
              },
              "Cisco-IOS-XE-utd-events:utd-con": {
                "type": "object",
                "properties": {
                  "severity": {
                    "type": "string"
                  },
                  "host-name": {
                    "type": "string"
                  },
                  "system-ip": {
                    "type": "string",
                    "format": "ipv4"
                  },
                  "type": {
                    "type": "string"
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "status": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "Cisco-IOS-XE-utd-events:utd-con": {
              "severity": "major",
              "host-name": "Router1",
              "system-ip": "10.1.1.1",
              "type": "security",
              "timestamp": "2026-02-10T10:30:00Z",
              "status": "up",
              "reason": "link-flap-detected"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "events",
      "description": "Model-driven telemetry event subscriptions"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/docs/ios-xe/"
  }
}
