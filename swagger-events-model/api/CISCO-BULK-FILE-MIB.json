{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-BULK-FILE-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-BULK-FILE-MIB for Bulk file transfer events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-BULK-FILE-MIB:cbfDefineFileCompletion": {
      "get": {
        "description": "Notification for cbfDefineFileCompletion event",
        "tags": [
          "Management"
        ],
        "summary": "SNMP Trap: cbfDefineFileCompletion",
        "operationId": "get_cbfDefineFileCompletion",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cbfDefineFileCompletion notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cbfDefineFileCompletion"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-BULK-FILE-MIB:cbfDefineFileCompletion": {
                      "cbfDefineFileIndex": 1,
                      "cbfStatusFileIndex": "up",
                      "cbfStatusFileState": "active",
                      "cbfStatusFileCompletionTime": "up"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "cbfDefineFileCompletion": {
        "type": "object",
        "description": "SNMP trap notification payload for cbfDefineFileCompletion",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-BULK-FILE-MIB:cbfDefineFileCompletion": {
                "type": "object",
                "description": "Varbind objects for cbfDefineFileCompletion trap",
                "properties": {
                  "cbfDefineFileIndex": {
                    "type": "string"
                  },
                  "cbfStatusFileIndex": {
                    "type": "string"
                  },
                  "cbfStatusFileState": {
                    "type": "string"
                  },
                  "cbfStatusFileCompletionTime": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-BULK-FILE-MIB:cbfDefineFileCompletion": {
              "cbfDefineFileIndex": 1,
              "cbfStatusFileIndex": "up",
              "cbfStatusFileState": "active",
              "cbfStatusFileCompletionTime": "up"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Management",
      "description": "SNMP notification and event subscriptions for Management"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/iosxe/"
  }
}
