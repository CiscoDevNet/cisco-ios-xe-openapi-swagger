{
  "openapi": "3.0.0",
  "info": {
    "title": "DIAL-CONTROL-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from DIAL-CONTROL-MIB for Dial control peer and call events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/DIAL-CONTROL-MIB:dialCtlPeerCallInformation": {
      "get": {
        "description": "Notification for dialCtlPeerCallInformation event",
        "tags": [
          "Interface"
        ],
        "summary": "SNMP Trap: dialCtlPeerCallInformation",
        "operationId": "get_dialCtlPeerCallInformation",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          },
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "Limit the depth of returned sub-tree data (RFC 8040 Section 4.8.2). Use 'unbounded' for full depth.",
            "schema": {
              "type": "string",
              "default": "unbounded"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Select specific fields to return (RFC 8040 Section 4.8.3). Example: fields=name;status",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "description": "Filter by config state: 'config' (config true only), 'nonconfig' (config false only), or 'all'.",
            "schema": {
              "type": "string",
              "enum": [
                "config",
                "nonconfig",
                "all"
              ],
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "dialCtlPeerCallInformation notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/dialCtlPeerCallInformation"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "DIAL-CONTROL-MIB:dialCtlPeerCallInformation": {
                      "callActiveSetupTime": 3600,
                      "callActiveIndex": 1,
                      "callHistoryPeerId": 12345,
                      "callHistoryPeerIfIndex": 1,
                      "callHistoryLogicalIfIndex": 1,
                      "ifIndex": 1,
                      "ifOperStatus": "up",
                      "callHistoryPeerAddress": "10.1.1.1",
                      "callHistoryPeerSubAddress": "10.1.1.1",
                      "callHistoryDisconnectCause": "none",
                      "callHistoryConnectTime": 3600,
                      "callHistoryDisconnectTime": 3600,
                      "callHistoryInfoType": "speech",
                      "callHistoryCallOrigin": "callhistorycallorigin"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        }
      }
    },
