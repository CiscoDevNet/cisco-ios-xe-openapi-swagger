{
  "openapi": "3.0.0",
  "info": {
    "title": "DIAL-CONTROL-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from DIAL-CONTROL-MIB for Dial control peer and call events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/DIAL-CONTROL-MIB:dialCtlPeerCallInformation": {
      "get": {
        "description": "Notification for dialCtlPeerCallInformation event",
        "tags": [
          "Interface"
        ],
        "summary": "SNMP Trap: dialCtlPeerCallInformation",
        "operationId": "get_dialCtlPeerCallInformation",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "dialCtlPeerCallInformation notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/dialCtlPeerCallInformation"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "DIAL-CONTROL-MIB:dialCtlPeerCallInformation": {
                      "callActiveSetupTime": "example-string",
                      "callActiveIndex": 1,
                      "callHistoryPeerId": 12345,
                      "callHistoryPeerIfIndex": 1,
                      "callHistoryLogicalIfIndex": 1,
                      "ifIndex": 1,
                      "ifOperStatus": "up",
                      "callHistoryPeerAddress": "10.1.1.1",
                      "callHistoryPeerSubAddress": "10.1.1.1",
                      "callHistoryDisconnectCause": "example-string",
                      "callHistoryConnectTime": "example-string",
                      "callHistoryDisconnectTime": "example-string",
                      "callHistoryInfoType": "event-type",
                      "callHistoryCallOrigin": "example-string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/DIAL-CONTROL-MIB:dialCtlPeerCallSetup": {
      "get": {
        "description": "Notification for dialCtlPeerCallSetup event",
        "tags": [
          "Interface"
        ],
        "summary": "SNMP Trap: dialCtlPeerCallSetup",
        "operationId": "get_dialCtlPeerCallSetup",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "dialCtlPeerCallSetup notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/dialCtlPeerCallSetup"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "DIAL-CONTROL-MIB:dialCtlPeerCallSetup": {
                      "callActiveSetupTime": "example-string",
                      "callActiveIndex": 1,
                      "callActivePeerId": 12345,
                      "callActivePeerIfIndex": 1,
                      "callActiveLogicalIfIndex": 1,
                      "ifIndex": 1,
                      "ifOperStatus": "up",
                      "callActivePeerAddress": "10.1.1.1",
                      "callActivePeerSubAddress": "10.1.1.1",
                      "callActiveInfoType": "event-type",
                      "callActiveCallOrigin": "example-string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
