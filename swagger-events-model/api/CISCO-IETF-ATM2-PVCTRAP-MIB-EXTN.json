      "get": {
        "summary": "Subscribe to atmIntfPvcUpTrap events",
        "description": "Establishes WebSocket connection for ATM interface PVC up trap notifications",
        "tags": [
          "atm-events"
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols - WebSocket connection established",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/atmIntfPvcUpTrap"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-IETF-ATM2-PVCTRAP-MIB-EXTN:atmIntfPvcUpTrap": {
                      "ifIndex": 1,
                      "CISCO-IETF-ATM2-PVCTRAP-MIB-EXTN:atmIntfCurrentlyDownToUpPVcls": "mib-extn:atmintfcurrentlydowntouppvcls"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — authentication required (HTTP Basic)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "operationId": "get-atmIntfPvcUpTrap",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "Limit the depth of returned sub-tree data (RFC 8040 Section 4.8.2). Use 'unbounded' for full depth.",
            "schema": {
              "type": "string",
              "default": "unbounded"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Select specific fields to return (RFC 8040 Section 4.8.3). Example: fields=name;status",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "description": "Filter by config state: 'config' (config true only), 'nonconfig' (config false only), or 'all'.",
            "schema": {
              "type": "string",
              "enum": [
                "config",
                "nonconfig",
                "all"
              ],
              "default": "all"
            }
          }
        ]
      },
      "x-yang-path": "/ws/event-streams/CISCO-IETF-ATM2-PVCTRAP-MIB-EXTN/atmIntfPvcUpTrap",
      "x-restconf-kind": "notification"
    },
