              "eventTime": {
                "type": "string",
                "format": "date-time"
              },
              "CISCO-IETF-ATM2-PVCTRAP-MIB-EXTN:atmIntfPvcUpTrap": {
                "type": "object",
                "properties": {
                  "object-1": {
