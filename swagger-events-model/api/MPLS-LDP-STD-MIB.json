    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/MPLS-LDP-STD-MIB:mplsLdpInitSessionThresholdExceeded": {
      "get": {
        "description": "Notification for mplsLdpInitSessionThresholdExceeded event",
        "tags": [
          "MPLS"
        ],
        "summary": "SNMP Trap: mplsLdpInitSessionThresholdExceeded",
        "operationId": "get_mplsLdpInitSessionThresholdExceeded",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "mplsLdpInitSessionThresholdExceeded notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/mplsLdpInitSessionThresholdExceeded"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "MPLS-LDP-STD-MIB:mplsLdpInitSessionThresholdExceeded": {
                      "mplsLdpEntityLdpId": 12345,
                      "mplsLdpEntityIndex": 1,
                      "mplsLdpEntityInitSessionThreshold": "mplsldpentityinitsessionthreshold"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
