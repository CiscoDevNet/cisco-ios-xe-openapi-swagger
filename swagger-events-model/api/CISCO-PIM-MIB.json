{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-PIM-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-PIM-MIB for PIM protocol state change events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-PIM-MIB:ciscoPimInterfaceUp": {
      "get": {
        "description": "Notification for ciscoPimInterfaceUp event",
        "tags": [
          "Multicast"
        ],
        "summary": "SNMP Trap: ciscoPimInterfaceUp",
        "operationId": "get_ciscoPimInterfaceUp",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ciscoPimInterfaceUp notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ciscoPimInterfaceUp"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-PIM-MIB:ciscoPimInterfaceUp": {
                      "pimInterfaceIfIndex": "GigabitEthernet1",
                      "pimInterfaceStatus": "GigabitEthernet1"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
