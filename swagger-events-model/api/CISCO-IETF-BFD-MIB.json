{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-IETF-BFD-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-IETF-BFD-MIB for BFD session state events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-IETF-BFD-MIB:ciscoBfdSessUp": {
      "get": {
        "description": "Notification for ciscoBfdSessUp event",
        "tags": [
          "Routing"
        ],
        "summary": "SNMP Trap: ciscoBfdSessUp",
        "operationId": "get_ciscoBfdSessUp",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ciscoBfdSessUp notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ciscoBfdSessUp"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-IETF-BFD-MIB:ciscoBfdSessUp": {
                      "ciscoBfdSessIndex": 1,
                      "ciscoBfdSessDiag": "example-string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-IETF-BFD-MIB:ciscoBfdSessDown": {
      "get": {
        "description": "Notification for ciscoBfdSessDown event",
        "tags": [
          "Routing"
        ],
        "summary": "SNMP Trap: ciscoBfdSessDown",
        "operationId": "get_ciscoBfdSessDown",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ciscoBfdSessDown notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ciscoBfdSessDown"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-IETF-BFD-MIB:ciscoBfdSessDown": {
                      "ciscoBfdSessIndex": 1,
                      "ciscoBfdSessDiag": "example-string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "ciscoBfdSessUp": {
        "type": "object",
        "description": "SNMP trap notification payload for ciscoBfdSessUp",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-IETF-BFD-MIB:ciscoBfdSessUp": {
                "type": "object",
                "description": "Varbind objects for ciscoBfdSessUp trap",
                "properties": {
                  "ciscoBfdSessIndex": {
                    "type": "string"
                  },
                  "ciscoBfdSessDiag": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-IETF-BFD-MIB:ciscoBfdSessUp": {
              "ciscoBfdSessIndex": 1,
              "ciscoBfdSessDiag": "example-string"
            }
          }
        }
      },
      "ciscoBfdSessDown": {
        "type": "object",
        "description": "SNMP trap notification payload for ciscoBfdSessDown",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-IETF-BFD-MIB:ciscoBfdSessDown": {
                "type": "object",
                "description": "Varbind objects for ciscoBfdSessDown trap",
                "properties": {
                  "ciscoBfdSessIndex": {
                    "type": "string"
                  },
                  "ciscoBfdSessDiag": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-IETF-BFD-MIB:ciscoBfdSessDown": {
              "ciscoBfdSessIndex": 1,
              "ciscoBfdSessDiag": "example-string"
            }
          }
        }
      }
    }
  }
}
