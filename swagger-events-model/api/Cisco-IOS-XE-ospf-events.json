{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - ospf",
    "version": "17.18.1",
    "description": "OSPF Notification events YANG definitions\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - ospf.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - ospf.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-ospf-events structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-ospf-events.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-ospf-events:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-ospf-events event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-ospf-events",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-ospf-events:ospfv3-nbr-state-change": {
                      "severity": "major",
                      "vrf-name": "default",
                      "process-id": 1,
                      "af": "address-family-ipv4",
                      "router-id": "1.1.1.1",
                      "nbr-addr": "2001:db8::1",
                      "nbr-id": 12345,
                      "if-name": "GigabitEthernet1",
                      "if-addr": "2001:db8::1",
                      "nbr-state": "active"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ospfv3-nbr-state-change"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/operations/ietf-subscribed-notifications:establish-subscription": {
      "post": {
        "summary": "Create event subscription",
        "description": "Establish a subscription to Cisco-IOS-XE-ospf-events events",
        "tags": [
          "events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "example": {
                "input": {
                  "stream": "Cisco-IOS-XE-ospf-events:events",
                  "encoding": "encode-json",
                  "update-trigger": "periodic",
                  "period": 6000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-ospf-events:ospfv3-nbr-state-change": {
                      "severity": "major",
                      "vrf-name": "default",
                      "process-id": 1,
                      "af": "address-family-ipv4",
                      "router-id": "1.1.1.1",
                      "nbr-addr": "2001:db8::1",
                      "nbr-id": 12345,
                      "if-name": "GigabitEthernet1",
                      "if-addr": "2001:db8::1",
                      "nbr-state": "active"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ospfv3-nbr-state-change"
                }
              }
            }
          }
        }
      }
    }
  },
