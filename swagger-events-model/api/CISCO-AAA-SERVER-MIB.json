{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-AAA-SERVER-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-AAA-SERVER-MIB for AAA server state events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-AAA-SERVER-MIB:casServerStateChange": {
      "get": {
        "description": "Notification for casServerStateChange event",
        "tags": [
          "Security"
        ],
        "summary": "SNMP Trap: casServerStateChange",
        "operationId": "get_casServerStateChange",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "casServerStateChange notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/casServerStateChange"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-AAA-SERVER-MIB:casServerStateChange": {
                      "casProtocol": "example-string",
                      "casIndex": 1,
                      "casState": "active",
                      "casPreviousStateDuration": "active",
                      "casTotalDeadTime": "example-string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "casServerStateChange": {
        "type": "object",
        "description": "SNMP trap notification payload for casServerStateChange",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-AAA-SERVER-MIB:casServerStateChange": {
                "type": "object",
                "description": "Varbind objects for casServerStateChange trap",
                "properties": {
                  "casProtocol": {
                    "type": "string"
                  },
                  "casIndex": {
                    "type": "string"
                  },
                  "casState": {
                    "type": "string"
                  },
                  "casPreviousStateDuration": {
                    "type": "string"
                  },
                  "casTotalDeadTime": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-AAA-SERVER-MIB:casServerStateChange": {
              "casProtocol": "example-string",
              "casIndex": 1,
              "casState": "active",
              "casPreviousStateDuration": "active",
              "casTotalDeadTime": "example-string"
            }
          }
        }
      }
    }
  }
}
