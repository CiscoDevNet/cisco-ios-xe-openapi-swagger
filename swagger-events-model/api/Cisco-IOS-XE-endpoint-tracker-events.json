{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - endpoint-tracker",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG definitions\n     for endpoint tracker events.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - endpoint-tracker.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - endpoint-tracker.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-endpoint-tracker-events structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-endpoint-tracker-events.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-endpoint-tracker-events:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-endpoint-tracker-events event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-endpoint-tracker-events",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-endpoint-tracker-events:tracker-state-change": {
                      "severity-level": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "vrf-name": "default",
                      "attach-point-name": "router-01",
                      "tracker-name": "router-01",
                      "new-state": "active",
                      "address-family": "10.1.1.1"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/tracker-state-change"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/operations/ietf-subscribed-notifications:establish-subscription": {
      "post": {
        "summary": "Create event subscription",
        "description": "Establish a subscription to Cisco-IOS-XE-endpoint-tracker-events events",
        "tags": [
          "events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "example": {
                "input": {
                  "stream": "Cisco-IOS-XE-endpoint-tracker-events:events",
                  "encoding": "encode-json",
                  "update-trigger": "periodic",
                  "period": 6000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-endpoint-tracker-events:tracker-state-change": {
                      "severity-level": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "vrf-name": "default",
                      "attach-point-name": "router-01",
                      "tracker-name": "router-01",
                      "new-state": "active",
                      "address-family": "10.1.1.1"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/tracker-state-change"
                }
              }
            }
          }
        }
      }
    }
  },
