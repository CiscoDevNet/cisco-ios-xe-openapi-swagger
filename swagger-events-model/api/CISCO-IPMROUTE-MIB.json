{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-IPMROUTE-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-IPMROUTE-MIB for IP multicast routing events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-IPMROUTE-MIB:ciscoIpMRouteMissingHeartBeats": {
      "get": {
        "description": "Notification for ciscoIpMRouteMissingHeartBeats event",
        "tags": [
          "Multicast"
        ],
        "summary": "SNMP Trap: ciscoIpMRouteMissingHeartBeats",
        "operationId": "get_ciscoIpMRouteMissingHeartBeats",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ciscoIpMRouteMissingHeartBeats notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ciscoIpMRouteMissingHeartBeats"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-IPMROUTE-MIB:ciscoIpMRouteMissingHeartBeats": {
                      "ciscoIpMRouteHeartBeatGroupAddr": "example-string",
                      "ciscoIpMRouteHeartBeatSourceAddr": "example-string",
                      "ciscoIpMRouteHeartBeatInterval": "example-string",
                      "ciscoIpMRouteHeartBeatWindowSize": "example-string",
                      "ciscoIpMRouteHeartBeatCount": 5
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "ciscoIpMRouteMissingHeartBeats": {
        "type": "object",
        "description": "SNMP trap notification payload for ciscoIpMRouteMissingHeartBeats",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-IPMROUTE-MIB:ciscoIpMRouteMissingHeartBeats": {
                "type": "object",
                "description": "Varbind objects for ciscoIpMRouteMissingHeartBeats trap",
                "properties": {
                  "ciscoIpMRouteHeartBeatGroupAddr": {
                    "type": "string"
                  },
                  "ciscoIpMRouteHeartBeatSourceAddr": {
                    "type": "string"
                  },
                  "ciscoIpMRouteHeartBeatInterval": {
                    "type": "string"
                  },
                  "ciscoIpMRouteHeartBeatWindowSize": {
                    "type": "string"
                  },
                  "ciscoIpMRouteHeartBeatCount": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-IPMROUTE-MIB:ciscoIpMRouteMissingHeartBeats": {
              "ciscoIpMRouteHeartBeatGroupAddr": "example-string",
              "ciscoIpMRouteHeartBeatSourceAddr": "example-string",
              "ciscoIpMRouteHeartBeatInterval": "example-string",
              "ciscoIpMRouteHeartBeatWindowSize": "example-string",
              "ciscoIpMRouteHeartBeatCount": 5
            }
          }
        }
      }
    }
  }
}
