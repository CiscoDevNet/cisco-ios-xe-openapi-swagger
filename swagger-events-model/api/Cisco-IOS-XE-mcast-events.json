{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - mcast",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG definitions\n     for multicast events data.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - mcast.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - mcast.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-mcast-events structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-mcast-events.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-mcast-events:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-mcast-events event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-mcast-events",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-mcast-events:pim-nbr-state-event": {
                      "severity": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "if-name": "GigabitEthernet1",
                      "nbr-addr": "10.1.1.1",
                      "ni-type": "event-type",
                      "ni-name": "example-name",
                      "state": "active"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/pim-nbr-state-event"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/operations/ietf-subscribed-notifications:establish-subscription": {
      "post": {
        "summary": "Create event subscription",
        "description": "Establish a subscription to Cisco-IOS-XE-mcast-events events",
        "tags": [
          "events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "example": {
                "input": {
                  "stream": "Cisco-IOS-XE-mcast-events:events",
                  "encoding": "encode-json",
                  "update-trigger": "periodic",
                  "period": 6000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-mcast-events:pim-nbr-state-event": {
                      "severity": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "if-name": "GigabitEthernet1",
                      "nbr-addr": "10.1.1.1",
                      "ni-type": "event-type",
                      "ni-name": "example-name",
                      "state": "active"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/pim-nbr-state-event"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "pim-nbr-state-event": {
        "type": "object",
        "description": "Notification payload for pim-nbr-state-event",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the event occurred"
              },
              "Cisco-IOS-XE-mcast-events:pim-nbr-state-event": {
                "type": "object",
                "properties": {
                  "severity": {
                    "type": "string"
                  },
                  "host-name": {
                    "type": "string"
                  },
                  "system-ip": {
                    "type": "string",
                    "format": "ipv4"
                  },
                  "if-name": {
                    "type": "string"
                  },
                  "nbr-addr": {
                    "type": "string",
                    "format": "ipv4"
                  },
                  "ni-type": {
                    "type": "string"
                  },
                  "ni-name": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "Cisco-IOS-XE-mcast-events:pim-nbr-state-event": {
              "severity": "major",
              "host-name": "Router1",
              "system-ip": "10.1.1.1",
              "if-name": "GigabitEthernet1",
              "nbr-addr": "10.1.1.1",
              "ni-type": "event-type",
              "ni-name": "example-name",
              "state": "active"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "events",
      "description": "Model-driven telemetry event subscriptions"
    }
  ]
}
