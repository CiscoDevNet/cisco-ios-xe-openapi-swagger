{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - red-app",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG\n     definitions for redundancy application notification data.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - red-app.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - red-app.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-red-app-events structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-red-app-events.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-red-app-events:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-red-app-events event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-red-app-events",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-red-app-events:red-event": {
                      "rg-id": 12345,
                      "sys-time": "2026-02-10T10:30:00Z",
                      "site-id": 12345,
                      "sys-ip-addr": "10.1.1.1",
                      "role": "rg-app"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/red-event"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "operationId": "get-events"
      }
    },
    "/operations/ietf-subscribed-notifications:establish-subscription": {
      "post": {
        "summary": "Create event subscription",
        "description": "Establish a subscription to Cisco-IOS-XE-red-app-events events",
        "tags": [
          "events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "example": {
                "input": {
                  "stream": "Cisco-IOS-XE-red-app-events:events",
                  "encoding": "encode-json",
                  "update-trigger": "periodic",
                  "period": 6000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-red-app-events:red-event": {
                      "rg-id": 12345,
                      "sys-time": "2026-02-10T10:30:00Z",
                      "site-id": 12345,
                      "sys-ip-addr": "10.1.1.1",
                      "role": "rg-app"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/red-event"
                }
              }
            }
          }
        },
        "operationId": "post-establish-subscription"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "red-event": {
        "type": "object",
        "description": "Notification payload for red-event",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the event occurred"
              },
              "Cisco-IOS-XE-red-app-events:red-event": {
                "type": "object",
                "properties": {
                  "rg-id": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "sys-time": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "site-id": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "sys-ip-addr": {
                    "type": "string",
                    "format": "ipv4"
                  },
                  "role": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "Cisco-IOS-XE-red-app-events:red-event": {
              "rg-id": 12345,
              "sys-time": "2026-02-10T10:30:00Z",
              "site-id": 12345,
              "sys-ip-addr": "10.1.1.1",
              "role": "rg-app"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "events",
      "description": "Model-driven telemetry event subscriptions"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/iosxe/"
  }
}
