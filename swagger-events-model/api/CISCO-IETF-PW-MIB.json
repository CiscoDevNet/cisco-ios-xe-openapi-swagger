{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-IETF-PW-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-IETF-PW-MIB for Pseudowire state events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-IETF-PW-MIB:cpwVcDown": {
      "get": {
        "description": "Notification for cpwVcDown event",
        "tags": [
          "MPLS"
        ],
        "summary": "SNMP Trap: cpwVcDown",
        "operationId": "get_cpwVcDown",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cpwVcDown notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cpwVcDown"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-IETF-PW-MIB:cpwVcDown": {
                      "cpwVcIndex": 1,
                      "cpwVcOperStatus": "down"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-IETF-PW-MIB:cpwVcUp": {
      "get": {
        "description": "Notification for cpwVcUp event",
        "tags": [
          "MPLS"
        ],
        "summary": "SNMP Trap: cpwVcUp",
        "operationId": "get_cpwVcUp",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cpwVcUp notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cpwVcUp"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-IETF-PW-MIB:cpwVcUp": {
                      "cpwVcIndex": 1,
                      "cpwVcOperStatus": "up"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "cpwVcDown": {
        "type": "object",
        "description": "SNMP trap notification payload for cpwVcDown",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-IETF-PW-MIB:cpwVcDown": {
                "type": "object",
                "description": "Varbind objects for cpwVcDown trap",
                "properties": {
                  "cpwVcIndex": {
                    "type": "string"
                  },
                  "cpwVcOperStatus": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-IETF-PW-MIB:cpwVcDown": {
              "cpwVcIndex": 1,
              "cpwVcOperStatus": "down"
            }
          }
        }
      },
      "cpwVcUp": {
        "type": "object",
        "description": "SNMP trap notification payload for cpwVcUp",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-IETF-PW-MIB:cpwVcUp": {
                "type": "object",
                "description": "Varbind objects for cpwVcUp trap",
                "properties": {
                  "cpwVcIndex": {
                    "type": "string"
                  },
                  "cpwVcOperStatus": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-IETF-PW-MIB:cpwVcUp": {
              "cpwVcIndex": 1,
              "cpwVcOperStatus": "up"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "MPLS",
      "description": "SNMP notification and event subscriptions for MPLS"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/docs/ios-xe/"
  }
}
