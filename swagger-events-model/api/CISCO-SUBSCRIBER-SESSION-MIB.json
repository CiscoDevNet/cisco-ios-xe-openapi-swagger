  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-SUBSCRIBER-SESSION-MIB:csubJobFinishedNotify": {
      "get": {
        "description": "Notification for csubJobFinishedNotify event",
        "tags": [
          "Management"
        ],
        "summary": "SNMP Trap: csubJobFinishedNotify",
        "operationId": "get_csubJobFinishedNotify",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "csubJobFinishedNotify notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/csubJobFinishedNotify"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-SUBSCRIBER-SESSION-MIB:csubJobFinishedNotify": {
                      "csubJobId": 12345,
                      "csubJobStartedTime": 3600,
                      "csubJobFinishedTime": 3600,
                      "csubJobFinishedReason": "configuration-applied"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
