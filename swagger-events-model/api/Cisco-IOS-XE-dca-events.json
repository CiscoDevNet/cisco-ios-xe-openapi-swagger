{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - dca",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG definitions\n     for platform dynamic core allocation change events.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - dca.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - dca.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-dca-events structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-dca-events.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-dca-events:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-dca-events event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-dca-events",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-dca-events:dca-change-event": {
                      "severity-level": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "dca-change-type": "event-type",
                      "result": "dca-change"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/dca-change-event"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/operations/ietf-subscribed-notifications:establish-subscription": {
      "post": {
        "summary": "Create event subscription",
        "description": "Establish a subscription to Cisco-IOS-XE-dca-events events",
        "tags": [
          "events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "example": {
                "input": {
                  "stream": "Cisco-IOS-XE-dca-events:events",
                  "encoding": "encode-json",
                  "update-trigger": "periodic",
                  "period": 6000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-dca-events:dca-change-event": {
                      "severity-level": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "dca-change-type": "event-type",
                      "result": "dca-change"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/dca-change-event"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "dca-change-event": {
        "type": "object",
        "description": "Notification payload for dca-change-event",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the event occurred"
              },
              "Cisco-IOS-XE-dca-events:dca-change-event": {
                "type": "object",
                "properties": {
                  "severity-level": {
                    "type": "string"
                  },
                  "host-name": {
                    "type": "string"
                  },
                  "system-ip": {
                    "type": "string",
                    "format": "ipv4"
                  },
                  "dca-change-type": {
                    "type": "string"
                  },
                  "result": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "Cisco-IOS-XE-dca-events:dca-change-event": {
              "severity-level": "major",
              "host-name": "Router1",
              "system-ip": "10.1.1.1",
              "dca-change-type": "event-type",
              "result": "dca-change"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "events",
      "description": "Model-driven telemetry event subscriptions"
    }
  ]
}
