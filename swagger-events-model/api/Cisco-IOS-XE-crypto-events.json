{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - crypto",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG definitions\n     for crypto events data.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - crypto.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - crypto.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-crypto-events structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-crypto-events.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-crypto-events:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-crypto-events event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-crypto-events",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-crypto-events:ike-ipsec-event": {
                      "severity-level": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "event-id": 12345,
                      "cause": "crypto-ike",
                      "action": "crypto-ike",
                      "local-ip": "10.1.1.1",
                      "remote-ip": "10.1.1.1",
                      "resp-port": 100,
                      "init-port": 100,
                      "detail": "example-string"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ike-ipsec-event"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/operations/ietf-subscribed-notifications:establish-subscription": {
      "post": {
        "summary": "Create event subscription",
        "description": "Establish a subscription to Cisco-IOS-XE-crypto-events events",
        "tags": [
          "events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "example": {
                "input": {
                  "stream": "Cisco-IOS-XE-crypto-events:events",
                  "encoding": "encode-json",
                  "update-trigger": "periodic",
                  "period": 6000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-crypto-events:ike-ipsec-event": {
                      "severity-level": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "event-id": 12345,
                      "cause": "crypto-ike",
                      "action": "crypto-ike",
                      "local-ip": "10.1.1.1",
                      "remote-ip": "10.1.1.1",
                      "resp-port": 100,
                      "init-port": 100,
                      "detail": "example-string"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ike-ipsec-event"
                }
              }
            }
          }
        }
      }
    }
  },
