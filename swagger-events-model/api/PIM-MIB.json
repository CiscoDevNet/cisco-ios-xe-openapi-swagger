{
  "openapi": "3.0.0",
  "info": {
    "title": "PIM-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from PIM-MIB for PIM neighbor loss events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/PIM-MIB:pimNeighborLoss": {
      "get": {
        "description": "Notification for pimNeighborLoss event",
        "tags": [
          "Multicast"
        ],
        "summary": "SNMP Trap: pimNeighborLoss",
        "operationId": "get_pimNeighborLoss",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "pimNeighborLoss notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/pimNeighborLoss"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "PIM-MIB:pimNeighborLoss": {
                      "pimNeighborAddress": "10.1.1.1",
                      "pimNeighborIfIndex": 1
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "pimNeighborLoss": {
        "type": "object",
        "description": "SNMP trap notification payload for pimNeighborLoss",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "PIM-MIB:pimNeighborLoss": {
                "type": "object",
                "description": "Varbind objects for pimNeighborLoss trap",
                "properties": {
                  "pimNeighborAddress": {
                    "type": "string"
                  },
                  "pimNeighborIfIndex": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "PIM-MIB:pimNeighborLoss": {
              "pimNeighborAddress": "10.1.1.1",
              "pimNeighborIfIndex": 1
            }
          }
        }
      }
    }
  }
}
