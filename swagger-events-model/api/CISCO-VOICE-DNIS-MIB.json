{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-VOICE-DNIS-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-VOICE-DNIS-MIB for Voice DNIS mapping events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-VOICE-DNIS-MIB:cvDnisMappingUrlInaccessible": {
      "get": {
        "description": "Notification for cvDnisMappingUrlInaccessible event",
        "tags": [
          "Voice"
        ],
        "summary": "SNMP Trap: cvDnisMappingUrlInaccessible",
        "operationId": "get_cvDnisMappingUrlInaccessible",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cvDnisMappingUrlInaccessible notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cvDnisMappingUrlInaccessible"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-VOICE-DNIS-MIB:cvDnisMappingUrlInaccessible": {
                      "cvDnisMappingName": "router-01",
                      "cvDnisMappingUrl": "cvdnismappingurl",
                      "cvDnisMappingUrlAccessError": "0x00 0x00"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "cvDnisMappingUrlInaccessible": {
        "type": "object",
        "description": "SNMP trap notification payload for cvDnisMappingUrlInaccessible",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-VOICE-DNIS-MIB:cvDnisMappingUrlInaccessible": {
                "type": "object",
                "description": "Varbind objects for cvDnisMappingUrlInaccessible trap",
                "properties": {
                  "cvDnisMappingName": {
                    "type": "string"
                  },
                  "cvDnisMappingUrl": {
                    "type": "string"
                  },
                  "cvDnisMappingUrlAccessError": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-VOICE-DNIS-MIB:cvDnisMappingUrlInaccessible": {
              "cvDnisMappingName": "router-01",
              "cvDnisMappingUrl": "cvdnismappingurl",
              "cvDnisMappingUrlAccessError": "0x00 0x00"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Voice",
      "description": "SNMP notification and event subscriptions for Voice"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/docs/ios-xe/"
  }
}
