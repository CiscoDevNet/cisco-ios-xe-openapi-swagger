            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cnpdThresholdRisingEvent notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cnpdThresholdRisingEvent"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-NBAR-PROTOCOL-DISCOVERY-MIB:cnpdThresholdRisingEvent": {
                      "cnpdThresholdConfigIndex": 1,
                      "cnpdThresholdConfigIfIndex": 1,
                      "cnpdThresholdConfigStatsSelect": "example-string",
                      "cnpdThresholdHistoryIndex": 1,
                      "cnpdThresholdHistoryValue": "example-string",
                      "cnpdThresholdConfigRising": "example-string",
                      "cnpdThresholdConfigProtocol": "example-string",
                      "cnpdThresholdHistoryTime": "example-string"
                    }
                  }
                }
              }
            }
