{
  "openapi": "3.0.1",
  "info": {
    "title": "cisco-smart-license Event Notifications",
    "version": "17.18.1",
    "description": "This module contains YANG definitions for Cisco Smart Licensing event notifications.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions with 24 notification types.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [cisco-smart-license.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/cisco-smart-license.yang)\n\n**🌳 YANG Tree:** [View cisco-smart-license structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/cisco-smart-license.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
