{
  "openapi": "3.0.0",
  "info": {
    "title": "ENTITY-STATE-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from ENTITY-STATE-MIB for Entity operational state events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/ENTITY-STATE-MIB:entStateOperEnabled": {
      "get": {
        "description": "Notification for entStateOperEnabled event",
        "tags": [
          "Hardware"
        ],
        "summary": "SNMP Trap: entStateOperEnabled",
        "operationId": "get_entStateOperEnabled",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "entStateOperEnabled notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/entStateOperEnabled"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "ENTITY-STATE-MIB:entStateOperEnabled": {
                      "entPhysicalIndex": 1,
                      "entStateAdmin": "active",
                      "entStateAlarm": "active"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/ENTITY-STATE-MIB:entStateOperDisabled": {
      "get": {
        "description": "Notification for entStateOperDisabled event",
        "tags": [
          "Hardware"
        ],
        "summary": "SNMP Trap: entStateOperDisabled",
        "operationId": "get_entStateOperDisabled",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "entStateOperDisabled notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/entStateOperDisabled"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "ENTITY-STATE-MIB:entStateOperDisabled": {
                      "entPhysicalIndex": 1,
                      "entStateAdmin": "active",
                      "entStateAlarm": "active"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "entStateOperEnabled": {
        "type": "object",
        "description": "SNMP trap notification payload for entStateOperEnabled",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "ENTITY-STATE-MIB:entStateOperEnabled": {
                "type": "object",
                "description": "Varbind objects for entStateOperEnabled trap",
                "properties": {
                  "entPhysicalIndex": {
                    "type": "string"
                  },
                  "entStateAdmin": {
                    "type": "string"
                  },
                  "entStateAlarm": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "ENTITY-STATE-MIB:entStateOperEnabled": {
              "entPhysicalIndex": 1,
              "entStateAdmin": "active",
              "entStateAlarm": "active"
            }
          }
        }
      },
      "entStateOperDisabled": {
        "type": "object",
        "description": "SNMP trap notification payload for entStateOperDisabled",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "ENTITY-STATE-MIB:entStateOperDisabled": {
                "type": "object",
                "description": "Varbind objects for entStateOperDisabled trap",
                "properties": {
                  "entPhysicalIndex": {
                    "type": "string"
                  },
                  "entStateAdmin": {
                    "type": "string"
                  },
                  "entStateAlarm": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "ENTITY-STATE-MIB:entStateOperDisabled": {
              "entPhysicalIndex": 1,
              "entStateAdmin": "active",
              "entStateAlarm": "active"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Hardware",
      "description": "SNMP notification and event subscriptions for Hardware"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/iosxe/"
  }
}
