{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - nat",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG definitions\n     for NAT event notification.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - nat.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - nat.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-nat-events structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-nat-events.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-nat-events:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-nat-events event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-nat-events",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-nat-events:nat-route-change": {
                      "severity-level": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "vrf-name": "default",
                      "object-tracker": 100,
                      "address": "10.1.1.1",
                      "mask": "255.255.255.0",
                      "route-type": "connected",
                      "update": "ip-nat"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/nat-route-change"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "operationId": "get-events"
      }
    },
    "/operations/ietf-subscribed-notifications:establish-subscription": {
      "post": {
        "summary": "Create event subscription",
        "description": "Establish a subscription to Cisco-IOS-XE-nat-events events",
        "tags": [
          "events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "example": {
                "input": {
                  "stream": "Cisco-IOS-XE-nat-events:events",
                  "encoding": "encode-json",
                  "update-trigger": "periodic",
                  "period": 6000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-nat-events:nat-route-change": {
                      "severity-level": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "vrf-name": "default",
                      "object-tracker": 100,
                      "address": "10.1.1.1",
                      "mask": "255.255.255.0",
                      "route-type": "connected",
                      "update": "ip-nat"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/nat-route-change"
                }
              }
            }
          }
        },
        "operationId": "post-establish-subscription"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "nat-route-change": {
        "type": "object",
        "description": "Notification payload for nat-route-change",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the event occurred"
              },
              "Cisco-IOS-XE-nat-events:nat-route-change": {
                "type": "object",
                "properties": {
                  "severity-level": {
                    "type": "string"
                  },
                  "host-name": {
                    "type": "string"
                  },
                  "system-ip": {
                    "type": "string",
                    "format": "ipv4"
                  },
                  "vrf-name": {
                    "type": "string"
                  },
                  "object-tracker": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "address": {
                    "type": "string",
                    "format": "ipv4"
                  },
                  "mask": {
                    "type": "string",
                    "format": "ipv4"
                  },
                  "route-type": {
                    "type": "string"
                  },
                  "update": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "Cisco-IOS-XE-nat-events:nat-route-change": {
              "severity-level": "major",
              "host-name": "Router1",
              "system-ip": "10.1.1.1",
              "vrf-name": "default",
              "object-tracker": 100,
              "address": "10.1.1.1",
              "mask": "255.255.255.0",
              "route-type": "connected",
              "update": "ip-nat"
            }
          }
        }
      },
      "nat-update": {
        "type": "object",
        "description": "Notification payload for nat-update",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the event occurred"
              },
              "Cisco-IOS-XE-nat-events:nat-update": {
                "type": "object",
                "properties": {
                  "severity-level": {
                    "type": "string"
                  },
                  "host-name": {
                    "type": "string"
                  },
                  "system-ip": {
                    "type": "string",
                    "format": "ipv4"
                  },
                  "nat-type": {
                    "type": "string"
                  },
                  "nat-event": {
                    "type": "string"
                  },
                  "nat-event-type": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "Cisco-IOS-XE-nat-events:nat-update": {
              "severity-level": "major",
              "host-name": "Router1",
              "system-ip": "10.1.1.1",
              "nat-type": "static",
              "nat-event": "ip-nat",
              "nat-event-type": "create"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "events",
      "description": "Model-driven telemetry event subscriptions"
    }
  ],
