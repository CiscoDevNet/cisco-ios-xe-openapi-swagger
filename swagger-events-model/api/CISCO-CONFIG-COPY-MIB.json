{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-CONFIG-COPY-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-CONFIG-COPY-MIB for Configuration copy completion events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-CONFIG-COPY-MIB:ccCopyCompletion": {
      "get": {
        "description": "Notification for ccCopyCompletion event",
        "tags": [
          "Configuration"
        ],
        "summary": "SNMP Trap: ccCopyCompletion",
        "operationId": "get_ccCopyCompletion",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ccCopyCompletion notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ccCopyCompletion"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-CONFIG-COPY-MIB:ccCopyCompletion": {
                      "ccCopyIndex": 1,
                      "ccCopyFileName": "router-01",
                      "ccCopyState": "active",
                      "ccCopyTimeStarted": "cccopytimestarted",
                      "ccCopyTimeCompleted": "cccopytimecompleted",
                      "ccCopyFailCause": "none"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "ccCopyCompletion": {
        "type": "object",
        "description": "SNMP trap notification payload for ccCopyCompletion",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-CONFIG-COPY-MIB:ccCopyCompletion": {
                "type": "object",
                "description": "Varbind objects for ccCopyCompletion trap",
                "properties": {
                  "ccCopyIndex": {
                    "type": "string"
                  },
                  "ccCopyFileName": {
                    "type": "string"
                  },
                  "ccCopyState": {
                    "type": "string"
                  },
                  "ccCopyTimeStarted": {
                    "type": "string"
                  },
                  "ccCopyTimeCompleted": {
                    "type": "string"
                  },
                  "ccCopyFailCause": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-CONFIG-COPY-MIB:ccCopyCompletion": {
              "ccCopyIndex": 1,
              "ccCopyFileName": "router-01",
              "ccCopyState": "active",
              "ccCopyTimeStarted": "cccopytimestarted",
              "ccCopyTimeCompleted": "cccopytimecompleted",
              "ccCopyFailCause": "none"
            }
          }
        }
      }
    }
  }
}
