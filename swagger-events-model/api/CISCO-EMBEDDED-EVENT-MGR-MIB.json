{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-EMBEDDED-EVENT-MGR-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-EMBEDDED-EVENT-MGR-MIB for Embedded Event Manager policy events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-EMBEDDED-EVENT-MGR-MIB:cEventMgrServerEvent": {
      "get": {
        "description": "Notification for cEventMgrServerEvent event",
        "tags": [
          "Management"
        ],
        "summary": "SNMP Trap: cEventMgrServerEvent",
        "operationId": "get_cEventMgrServerEvent",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cEventMgrServerEvent notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cEventMgrServerEvent"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-EMBEDDED-EVENT-MGR-MIB:cEventMgrServerEvent": {
                      "ceemHistoryEventIndex": 1,
                      "ceemHistoryEventType1": 1,
                      "ceemHistoryEventType2": 2,
                      "ceemHistoryEventType3": 3,
                      "ceemHistoryEventType4": 4,
                      "ceemHistoryPolicyPath": "ceemhistorypolicypath",
                      "ceemHistoryPolicyName": "router-01",
                      "ceemHistoryPolicyExitStatus": "up"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-EMBEDDED-EVENT-MGR-MIB:cEventMgrPolicyEvent": {
      "get": {
        "description": "Notification for cEventMgrPolicyEvent event",
        "tags": [
          "Management"
        ],
        "summary": "SNMP Trap: cEventMgrPolicyEvent",
        "operationId": "get_cEventMgrPolicyEvent",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cEventMgrPolicyEvent notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cEventMgrPolicyEvent"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-EMBEDDED-EVENT-MGR-MIB:cEventMgrPolicyEvent": {
                      "ceemHistoryEventIndex": 1,
                      "ceemHistoryEventType1": 1,
                      "ceemHistoryEventType2": 2,
                      "ceemHistoryEventType3": 3,
                      "ceemHistoryEventType4": 4,
                      "ceemHistoryPolicyPath": "ceemhistorypolicypath",
                      "ceemHistoryPolicyName": "router-01",
                      "ceemHistoryPolicyIntData1": "ceemhistorypolicyintdata1",
                      "ceemHistoryPolicyIntData2": "ceemhistorypolicyintdata2",
                      "ceemHistoryPolicyStrData": "ceemhistorypolicystrdata"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
