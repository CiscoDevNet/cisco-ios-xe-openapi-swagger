{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-DATA-COLLECTION-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-DATA-COLLECTION-MIB for Data collection events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-DATA-COLLECTION-MIB:cdcVFileCollectionError": {
      "get": {
        "description": "Notification for cdcVFileCollectionError event",
        "tags": [
          "Management"
        ],
        "summary": "SNMP Trap: cdcVFileCollectionError",
        "operationId": "get_cdcVFileCollectionError",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cdcVFileCollectionError notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cdcVFileCollectionError"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-DATA-COLLECTION-MIB:cdcVFileCollectionError": {
                      "cdcVFileIndex": 1,
                      "cdcVFileName": "show_tech_output.gz",
                      "cdcVFileErrorCode": "cdcvfileerrorcode"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-DATA-COLLECTION-MIB:cdcFileXferComplete": {
      "get": {
        "description": "Notification for cdcFileXferComplete event",
        "tags": [
          "Management"
        ],
        "summary": "SNMP Trap: cdcFileXferComplete",
        "operationId": "get_cdcFileXferComplete",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cdcFileXferComplete notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cdcFileXferComplete"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-DATA-COLLECTION-MIB:cdcFileXferComplete": {
                      "cdcVFileIndex": 1,
                      "cdcVFileMgmtIndex": 1,
                      "cdcVFileMgmtLastXferStatus": "up",
                      "cdcVFileMgmtLastXferURL": "cdcvfilemgmtlastxferurl"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "cdcVFileCollectionError": {
        "type": "object",
        "description": "SNMP trap notification payload for cdcVFileCollectionError",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-DATA-COLLECTION-MIB:cdcVFileCollectionError": {
                "type": "object",
                "description": "Varbind objects for cdcVFileCollectionError trap",
                "properties": {
                  "cdcVFileIndex": {
                    "type": "string"
                  },
                  "cdcVFileName": {
                    "type": "string"
                  },
                  "cdcVFileErrorCode": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-DATA-COLLECTION-MIB:cdcVFileCollectionError": {
              "cdcVFileIndex": 1,
              "cdcVFileName": "show_tech_output.gz",
              "cdcVFileErrorCode": "cdcvfileerrorcode"
            }
          }
        }
      },
      "cdcFileXferComplete": {
        "type": "object",
        "description": "SNMP trap notification payload for cdcFileXferComplete",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-DATA-COLLECTION-MIB:cdcFileXferComplete": {
                "type": "object",
                "description": "Varbind objects for cdcFileXferComplete trap",
                "properties": {
                  "cdcVFileIndex": {
                    "type": "string"
                  },
                  "cdcVFileMgmtIndex": {
                    "type": "string"
                  },
                  "cdcVFileMgmtLastXferStatus": {
                    "type": "string"
                  },
                  "cdcVFileMgmtLastXferURL": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-DATA-COLLECTION-MIB:cdcFileXferComplete": {
              "cdcVFileIndex": 1,
              "cdcVFileMgmtIndex": 1,
              "cdcVFileMgmtLastXferStatus": "up",
              "cdcVFileMgmtLastXferURL": "cdcvfilemgmtlastxferurl"
            }
          }
        }
      }
    }
  }
}
