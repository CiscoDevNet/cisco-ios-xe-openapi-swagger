{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-CONFIG-MAN-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-CONFIG-MAN-MIB for Configuration management events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-CONFIG-MAN-MIB:ciscoConfigManEvent": {
      "get": {
        "description": "Notification for ciscoConfigManEvent event",
        "tags": [
          "Configuration"
        ],
        "summary": "SNMP Trap: ciscoConfigManEvent",
        "operationId": "get_ciscoConfigManEvent",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ciscoConfigManEvent notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ciscoConfigManEvent"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-CONFIG-MAN-MIB:ciscoConfigManEvent": {
                      "ccmHistoryEventIndex": 1,
                      "ccmHistoryEventCommandSource": "commandLine",
                      "ccmHistoryEventConfigSource": "running",
                      "ccmHistoryEventConfigDestination": "startup"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-CONFIG-MAN-MIB:ccmCLIRunningConfigChanged": {
      "get": {
        "description": "Notification for ccmCLIRunningConfigChanged event",
        "tags": [
          "Configuration"
        ],
        "summary": "SNMP Trap: ccmCLIRunningConfigChanged",
        "operationId": "get_ccmCLIRunningConfigChanged",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ccmCLIRunningConfigChanged notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ccmCLIRunningConfigChanged"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-CONFIG-MAN-MIB:ccmCLIRunningConfigChanged": {
                      "ccmHistoryRunningLastChanged": 123456,
                      "ccmHistoryEventIndex": 1,
                      "ccmHistoryEventTerminalType": "virtual"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-CONFIG-MAN-MIB:ccmCTIDRolledOver": {
      "get": {
        "description": "Notification for ccmCTIDRolledOver event",
        "tags": [
          "Configuration"
        ],
        "summary": "SNMP Trap: ccmCTIDRolledOver",
        "operationId": "get_ccmCTIDRolledOver",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ccmCTIDRolledOver notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ccmCTIDRolledOver"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-CONFIG-MAN-MIB:ccmCTIDRolledOver": {
                      "event-time": "2026-02-10T10:30:00Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "ciscoConfigManEvent": {
        "type": "object",
        "description": "SNMP trap notification payload for ciscoConfigManEvent",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-CONFIG-MAN-MIB:ciscoConfigManEvent": {
                "type": "object",
                "description": "Varbind objects for ciscoConfigManEvent trap",
                "properties": {
                  "ccmHistoryEventIndex": {
                    "type": "string"
                  },
                  "ccmHistoryEventCommandSource": {
                    "type": "string"
                  },
                  "ccmHistoryEventConfigSource": {
                    "type": "string"
                  },
                  "ccmHistoryEventConfigDestination": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-CONFIG-MAN-MIB:ciscoConfigManEvent": {
              "ccmHistoryEventIndex": 1,
              "ccmHistoryEventCommandSource": "commandLine",
              "ccmHistoryEventConfigSource": "running",
              "ccmHistoryEventConfigDestination": "startup"
            }
          }
        }
      },
      "ccmCLIRunningConfigChanged": {
        "type": "object",
        "description": "SNMP trap notification payload for ccmCLIRunningConfigChanged",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-CONFIG-MAN-MIB:ccmCLIRunningConfigChanged": {
                "type": "object",
                "description": "Varbind objects for ccmCLIRunningConfigChanged trap",
                "properties": {
                  "ccmHistoryRunningLastChanged": {
                    "type": "string"
                  },
                  "ccmHistoryEventIndex": {
                    "type": "string"
                  },
                  "ccmHistoryEventTerminalType": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-CONFIG-MAN-MIB:ccmCLIRunningConfigChanged": {
              "ccmHistoryRunningLastChanged": 123456,
              "ccmHistoryEventIndex": 1,
              "ccmHistoryEventTerminalType": "virtual"
            }
          }
        }
      },
      "ccmCTIDRolledOver": {
        "type": "object",
        "description": "SNMP trap notification payload for ccmCTIDRolledOver",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-CONFIG-MAN-MIB:ccmCTIDRolledOver": {
                "type": "object",
                "description": "Varbind objects for ccmCTIDRolledOver trap",
                "properties": {
                  "event-time": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-CONFIG-MAN-MIB:ccmCTIDRolledOver": {
              "event-time": "2026-02-10T10:30:00Z"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Configuration",
      "description": "SNMP notification and event subscriptions for Configuration"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/iosxe/"
  }
}
