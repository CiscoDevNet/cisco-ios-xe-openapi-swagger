{
  "openapi": "3.0.1",
  "info": {
    "title": "ietf-yang-push Event Notifications",
    "version": "17.18.1",
    "description": "This module contains IETF YANG definitions for YANG push event notifications.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [ietf-yang-push.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/ietf-yang-push.yang)\n\n**🌳 YANG Tree:** [View ietf-yang-push structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/ietf-yang-push.html)",
    "x-yang-module": "ietf-yang-push",
    "x-model-type": "events"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/ws/event-streams/ietf-yang-push/push-update": {
      "get": {
        "summary": "Subscribe to push-update events",
        "description": "Periodic push update notification with datastore contents",
        "tags": [
          "yang-push-events"
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols - WebSocket connection established",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/push-update"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "ietf-yang-push:push-update": {
                      "subscription-id": 2147483650,
                      "time-of-update": "2026-02-10T10:30:00Z",
                      "updates-not-sent": true,
                      "datastore-contents-xml": "contents-xml"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "operationId": "get-push-update",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "Limit the depth of returned sub-tree data (RFC 8040 Section 4.8.2). Use 'unbounded' for full depth.",
            "schema": {
              "type": "string",
              "default": "unbounded"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Select specific fields to return (RFC 8040 Section 4.8.3). Example: fields=name;status",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "description": "Filter by config state: 'config' (config true only), 'nonconfig' (config false only), or 'all'.",
            "schema": {
              "type": "string",
              "enum": [
                "config",
                "nonconfig",
                "all"
              ],
              "default": "all"
            }
          }
        ]
      },
      "x-yang-path": "/ws/event-streams/ietf-yang-push/push-update",
      "x-restconf-kind": "notification"
    },
    "/ws/event-streams/ietf-yang-push/push-change-update": {
      "get": {
        "summary": "Subscribe to push-change-update events",
        "description": "On-change push update notification with datastore changes",
        "tags": [
          "yang-push-events"
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols - WebSocket connection established",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/push-change-update"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "ietf-yang-push:push-change-update": {
                      "subscription-id": 2147483650,
                      "time-of-update": "2026-02-10T10:30:00Z",
                      "updates-not-sent": true,
                      "datastore-changes-xml": "changes-xml"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "operationId": "get-push-change-update",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "Limit the depth of returned sub-tree data (RFC 8040 Section 4.8.2). Use 'unbounded' for full depth.",
            "schema": {
              "type": "string",
              "default": "unbounded"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Select specific fields to return (RFC 8040 Section 4.8.3). Example: fields=name;status",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "description": "Filter by config state: 'config' (config true only), 'nonconfig' (config false only), or 'all'.",
            "schema": {
              "type": "string",
              "enum": [
                "config",
                "nonconfig",
                "all"
              ],
              "default": "all"
            }
          }
        ]
      },
      "x-yang-path": "/ws/event-streams/ietf-yang-push/push-change-update",
      "x-restconf-kind": "notification"
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "push-update": {
        "type": "object",
        "description": "Notification payload for push-update",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the event occurred"
              },
              "ietf-yang-push:push-update": {
                "type": "object",
                "properties": {
                  "subscription-id": {
                    "type": "string"
                  },
                  "time-of-update": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "updates-not-sent": {
                    "type": "boolean"
                  },
                  "datastore-contents-xml": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "ietf-yang-push:push-update": {
              "subscription-id": 2147483650,
              "time-of-update": "2026-02-10T10:30:00Z",
              "updates-not-sent": true,
              "datastore-contents-xml": "contents-xml"
            }
          }
        }
      },
      "push-change-update": {
        "type": "object",
        "description": "Notification payload for push-change-update",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the event occurred"
              },
              "ietf-yang-push:push-change-update": {
                "type": "object",
                "properties": {
                  "subscription-id": {
                    "type": "string"
                  },
                  "time-of-update": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "updates-not-sent": {
                    "type": "boolean"
                  },
                  "datastore-changes-xml": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "ietf-yang-push:push-change-update": {
              "subscription-id": 2147483650,
              "time-of-update": "2026-02-10T10:30:00Z",
              "updates-not-sent": true,
              "datastore-changes-xml": "changes-xml"
            }
          }
        }
      },
      "restconf-error": {
        "type": "object",
        "description": "Standard RESTCONF error response (RFC 8040 Section 7.1)",
        "properties": {
          "ietf-restconf:errors": {
            "type": "object",
            "properties": {
              "error": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "error-type": {
                      "type": "string",
                      "enum": [
                        "transport",
                        "rpc",
                        "protocol",
                        "application"
                      ],
                      "description": "Layer where the error occurred"
                    },
                    "error-tag": {
                      "type": "string",
                      "description": "Enumerated error tag (e.g. invalid-value, data-missing, access-denied)"
                    },
                    "error-severity": {
                      "type": "string",
                      "enum": [
                        "error",
                        "warning"
                      ],
                      "description": "Error severity"
                    },
                    "error-app-tag": {
                      "type": "string",
                      "description": "Application-specific error tag"
                    },
                    "error-path": {
                      "type": "string",
                      "description": "YANG instance-identifier of the error node"
                    },
                    "error-message": {
                      "type": "string",
                      "description": "Human-readable error description"
                    }
                  },
                  "required": [
                    "error-type",
                    "error-tag"
                  ]
                }
              }
            }
          }
        },
        "example": {
          "ietf-restconf:errors": {
            "error": [
              {
                "error-type": "protocol",
                "error-tag": "invalid-value",
                "error-severity": "error",
                "error-message": "Invalid input parameter"
              }
            ]
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
