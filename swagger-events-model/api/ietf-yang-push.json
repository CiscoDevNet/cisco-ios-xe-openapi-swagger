{
  "openapi": "3.0.1",
  "info": {
    "title": "ietf-yang-push Event Notifications",
    "version": "17.18.1",
    "description": "This module contains IETF YANG definitions for YANG push event notifications.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [ietf-yang-push.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/ietf-yang-push.yang)\n\n**🌳 YANG Tree:** [View ietf-yang-push structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/ietf-yang-push.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/ws/event-streams/ietf-yang-push/push-update": {
      "get": {
        "summary": "Subscribe to push-update events",
        "description": "Periodic push update notification with datastore contents",
        "tags": [
          "yang-push-events"
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols - WebSocket connection established",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/push-update"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "ietf-yang-push:push-update": {
                      "subscription-id": 2147483650,
                      "time-of-update": "2026-02-10T10:30:00Z",
                      "updates-not-sent": true,
                      "datastore-contents-xml": "contents-xml"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "get-push-update"
      }
    },
    "/ws/event-streams/ietf-yang-push/push-change-update": {
      "get": {
        "summary": "Subscribe to push-change-update events",
        "description": "On-change push update notification with datastore changes",
        "tags": [
          "yang-push-events"
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols - WebSocket connection established",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/push-change-update"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "ietf-yang-push:push-change-update": {
                      "subscription-id": 2147483650,
                      "time-of-update": "2026-02-10T10:30:00Z",
                      "updates-not-sent": true,
                      "datastore-changes-xml": "changes-xml"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "get-push-change-update"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "push-update": {
        "type": "object",
        "description": "Notification payload for push-update",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the event occurred"
              },
              "ietf-yang-push:push-update": {
                "type": "object",
                "properties": {
                  "subscription-id": {
                    "type": "string"
                  },
                  "time-of-update": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "updates-not-sent": {
                    "type": "boolean"
                  },
                  "datastore-contents-xml": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "ietf-yang-push:push-update": {
              "subscription-id": 2147483650,
              "time-of-update": "2026-02-10T10:30:00Z",
              "updates-not-sent": true,
              "datastore-contents-xml": "contents-xml"
            }
          }
        }
      },
      "push-change-update": {
        "type": "object",
        "description": "Notification payload for push-change-update",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the event occurred"
              },
              "ietf-yang-push:push-change-update": {
                "type": "object",
                "properties": {
                  "subscription-id": {
                    "type": "string"
                  },
                  "time-of-update": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "updates-not-sent": {
                    "type": "boolean"
                  },
                  "datastore-changes-xml": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "ietf-yang-push:push-change-update": {
              "subscription-id": 2147483650,
              "time-of-update": "2026-02-10T10:30:00Z",
              "updates-not-sent": true,
              "datastore-changes-xml": "changes-xml"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "yang-push-events",
      "description": "SNMP notification and event subscriptions for yang-push-events"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/docs/ios-xe/"
  }
}
