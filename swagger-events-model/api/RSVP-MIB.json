{
  "openapi": "3.0.0",
  "info": {
    "title": "RSVP-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from RSVP-MIB for RSVP session events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/RSVP-MIB:newFlow": {
      "get": {
        "description": "Notification for newFlow event",
        "tags": [
          "QoS"
        ],
        "summary": "SNMP Trap: newFlow",
        "operationId": "get_newFlow",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          },
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "Limit the depth of returned sub-tree data (RFC 8040 Section 4.8.2). Use 'unbounded' for full depth.",
            "schema": {
              "type": "string",
              "default": "unbounded"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Select specific fields to return (RFC 8040 Section 4.8.3). Example: fields=name;status",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "description": "Filter by config state: 'config' (config true only), 'nonconfig' (config false only), or 'all'.",
            "schema": {
              "type": "string",
              "enum": [
                "config",
                "nonconfig",
                "all"
              ],
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "newFlow notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/newFlow"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "RSVP-MIB:newFlow": {
                      "intSrvFlowNumber": 5,
                      "intSrvFlowStatus": "up",
                      "rsvpSessionNumber": 5,
                      "rsvpSessionDestAddr": "10.0.0.1",
                      "rsvpResvFwdNumber": 5,
                      "rsvpResvFwdStatus": "up",
                      "rsvpResvNumber": 5,
                      "rsvpResvStatus": "up",
                      "rsvpSenderNumber": 5,
                      "rsvpSenderStatus": "up"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/RSVP-MIB:lostFlow": {
      "get": {
        "description": "Notification for lostFlow event",
        "tags": [
          "QoS"
        ],
        "summary": "SNMP Trap: lostFlow",
        "operationId": "get_lostFlow",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          },
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "Limit the depth of returned sub-tree data (RFC 8040 Section 4.8.2). Use 'unbounded' for full depth.",
            "schema": {
              "type": "string",
              "default": "unbounded"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Select specific fields to return (RFC 8040 Section 4.8.3). Example: fields=name;status",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "description": "Filter by config state: 'config' (config true only), 'nonconfig' (config false only), or 'all'.",
            "schema": {
              "type": "string",
              "enum": [
                "config",
                "nonconfig",
                "all"
              ],
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "lostFlow notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/lostFlow"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "RSVP-MIB:lostFlow": {
                      "intSrvFlowNumber": 5,
                      "intSrvFlowStatus": "up",
                      "rsvpSessionNumber": 5,
                      "rsvpSessionDestAddr": "10.0.0.1",
                      "rsvpResvFwdNumber": 5,
                      "rsvpResvFwdStatus": "up",
                      "rsvpResvNumber": 5,
                      "rsvpResvStatus": "up",
                      "rsvpSenderNumber": 5,
                      "rsvpSenderStatus": "up"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "newFlow": {
        "type": "object",
        "description": "SNMP trap notification payload for newFlow",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "RSVP-MIB:newFlow": {
                "type": "object",
                "description": "Varbind objects for newFlow trap",
                "properties": {
                  "intSrvFlowNumber": {
                    "type": "string"
                  },
                  "intSrvFlowStatus": {
                    "type": "string"
                  },
                  "rsvpSessionNumber": {
                    "type": "string"
                  },
                  "rsvpSessionDestAddr": {
                    "type": "string"
                  },
                  "rsvpResvFwdNumber": {
                    "type": "string"
                  },
                  "rsvpResvFwdStatus": {
                    "type": "string"
                  },
                  "rsvpResvNumber": {
                    "type": "string"
                  },
                  "rsvpResvStatus": {
                    "type": "string"
                  },
                  "rsvpSenderNumber": {
                    "type": "string"
                  },
                  "rsvpSenderStatus": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "RSVP-MIB:newFlow": {
              "intSrvFlowNumber": 5,
              "intSrvFlowStatus": "up",
              "rsvpSessionNumber": 5,
              "rsvpSessionDestAddr": "10.0.0.1",
              "rsvpResvFwdNumber": 5,
              "rsvpResvFwdStatus": "up",
              "rsvpResvNumber": 5,
              "rsvpResvStatus": "up",
              "rsvpSenderNumber": 5,
              "rsvpSenderStatus": "up"
            }
          }
        }
      },
      "lostFlow": {
        "type": "object",
        "description": "SNMP trap notification payload for lostFlow",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "RSVP-MIB:lostFlow": {
                "type": "object",
                "description": "Varbind objects for lostFlow trap",
                "properties": {
                  "intSrvFlowNumber": {
                    "type": "string"
                  },
                  "intSrvFlowStatus": {
                    "type": "string"
                  },
                  "rsvpSessionNumber": {
                    "type": "string"
                  },
                  "rsvpSessionDestAddr": {
                    "type": "string"
                  },
                  "rsvpResvFwdNumber": {
                    "type": "string"
                  },
                  "rsvpResvFwdStatus": {
                    "type": "string"
                  },
                  "rsvpResvNumber": {
                    "type": "string"
                  },
                  "rsvpResvStatus": {
                    "type": "string"
                  },
                  "rsvpSenderNumber": {
                    "type": "string"
                  },
                  "rsvpSenderStatus": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "RSVP-MIB:lostFlow": {
              "intSrvFlowNumber": 5,
              "intSrvFlowStatus": "up",
              "rsvpSessionNumber": 5,
              "rsvpSessionDestAddr": "10.0.0.1",
              "rsvpResvFwdNumber": 5,
              "rsvpResvFwdStatus": "up",
              "rsvpResvNumber": 5,
              "rsvpResvStatus": "up",
              "rsvpSenderNumber": 5,
              "rsvpSenderStatus": "up"
            }
          }
        }
      },
      "restconf-error": {
        "type": "object",
        "description": "Standard RESTCONF error response (RFC 8040 Section 7.1)",
        "properties": {
          "ietf-restconf:errors": {
            "type": "object",
            "properties": {
              "error": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "error-type": {
                      "type": "string",
                      "enum": [
                        "transport",
                        "rpc",
                        "protocol",
                        "application"
                      ],
                      "description": "Layer where the error occurred"
                    },
                    "error-tag": {
                      "type": "string",
                      "description": "Enumerated error tag (e.g. invalid-value, data-missing, access-denied)"
                    },
                    "error-severity": {
                      "type": "string",
                      "enum": [
                        "error",
                        "warning"
                      ],
                      "description": "Error severity"
                    },
                    "error-app-tag": {
                      "type": "string",
                      "description": "Application-specific error tag"
                    },
                    "error-path": {
                      "type": "string",
                      "description": "YANG instance-identifier of the error node"
                    },
                    "error-message": {
                      "type": "string",
                      "description": "Human-readable error description"
                    }
                  },
                  "required": [
                    "error-type",
                    "error-tag"
                  ]
                }
              }
            }
          }
        },
        "example": {
          "ietf-restconf:errors": {
            "error": [
              {
                "error-type": "protocol",
                "error-tag": "invalid-value",
                "error-severity": "error",
                "error-message": "Invalid input parameter"
              }
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "QoS",
      "description": "SNMP notification and event subscriptions for QoS"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/iosxe/"
  }
}
