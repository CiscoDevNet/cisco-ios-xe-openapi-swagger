{
  "openapi": "3.0.0",
  "info": {
    "title": "RSVP-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from RSVP-MIB for RSVP session events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/RSVP-MIB:newFlow": {
      "get": {
        "description": "Notification for newFlow event",
        "tags": [
          "QoS"
        ],
        "summary": "SNMP Trap: newFlow",
        "operationId": "get_newFlow",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "newFlow notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/newFlow"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "RSVP-MIB:newFlow": {
                      "intSrvFlowNumber": 5,
                      "intSrvFlowStatus": "up",
                      "rsvpSessionNumber": 5,
                      "rsvpSessionDestAddr": "10.0.0.1",
                      "rsvpResvFwdNumber": 5,
                      "rsvpResvFwdStatus": "up",
                      "rsvpResvNumber": 5,
                      "rsvpResvStatus": "up",
                      "rsvpSenderNumber": 5,
                      "rsvpSenderStatus": "up"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/RSVP-MIB:lostFlow": {
      "get": {
        "description": "Notification for lostFlow event",
        "tags": [
          "QoS"
        ],
        "summary": "SNMP Trap: lostFlow",
        "operationId": "get_lostFlow",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "lostFlow notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/lostFlow"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "RSVP-MIB:lostFlow": {
                      "intSrvFlowNumber": 5,
                      "intSrvFlowStatus": "up",
                      "rsvpSessionNumber": 5,
                      "rsvpSessionDestAddr": "10.0.0.1",
                      "rsvpResvFwdNumber": 5,
                      "rsvpResvFwdStatus": "up",
                      "rsvpResvNumber": 5,
                      "rsvpResvStatus": "up",
                      "rsvpSenderNumber": 5,
                      "rsvpSenderStatus": "up"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "newFlow": {
        "type": "object",
        "description": "SNMP trap notification payload for newFlow",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "RSVP-MIB:newFlow": {
                "type": "object",
                "description": "Varbind objects for newFlow trap",
                "properties": {
                  "intSrvFlowNumber": {
                    "type": "string"
                  },
                  "intSrvFlowStatus": {
                    "type": "string"
                  },
                  "rsvpSessionNumber": {
                    "type": "string"
                  },
                  "rsvpSessionDestAddr": {
                    "type": "string"
                  },
                  "rsvpResvFwdNumber": {
                    "type": "string"
                  },
                  "rsvpResvFwdStatus": {
                    "type": "string"
                  },
                  "rsvpResvNumber": {
                    "type": "string"
                  },
                  "rsvpResvStatus": {
                    "type": "string"
                  },
                  "rsvpSenderNumber": {
                    "type": "string"
                  },
                  "rsvpSenderStatus": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "RSVP-MIB:newFlow": {
              "intSrvFlowNumber": 5,
              "intSrvFlowStatus": "up",
              "rsvpSessionNumber": 5,
              "rsvpSessionDestAddr": "10.0.0.1",
              "rsvpResvFwdNumber": 5,
              "rsvpResvFwdStatus": "up",
              "rsvpResvNumber": 5,
              "rsvpResvStatus": "up",
              "rsvpSenderNumber": 5,
              "rsvpSenderStatus": "up"
            }
          }
        }
      },
      "lostFlow": {
        "type": "object",
        "description": "SNMP trap notification payload for lostFlow",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "RSVP-MIB:lostFlow": {
                "type": "object",
                "description": "Varbind objects for lostFlow trap",
                "properties": {
                  "intSrvFlowNumber": {
                    "type": "string"
                  },
                  "intSrvFlowStatus": {
                    "type": "string"
                  },
                  "rsvpSessionNumber": {
                    "type": "string"
                  },
                  "rsvpSessionDestAddr": {
                    "type": "string"
                  },
                  "rsvpResvFwdNumber": {
                    "type": "string"
                  },
                  "rsvpResvFwdStatus": {
                    "type": "string"
                  },
                  "rsvpResvNumber": {
                    "type": "string"
                  },
                  "rsvpResvStatus": {
                    "type": "string"
                  },
                  "rsvpSenderNumber": {
                    "type": "string"
                  },
                  "rsvpSenderStatus": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "RSVP-MIB:lostFlow": {
              "intSrvFlowNumber": 5,
              "intSrvFlowStatus": "up",
              "rsvpSessionNumber": 5,
              "rsvpSessionDestAddr": "10.0.0.1",
              "rsvpResvFwdNumber": 5,
              "rsvpResvFwdStatus": "up",
              "rsvpResvNumber": 5,
              "rsvpResvStatus": "up",
              "rsvpSenderNumber": 5,
              "rsvpSenderStatus": "up"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "QoS",
      "description": "SNMP notification and event subscriptions for QoS"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/docs/ios-xe/"
  }
}
