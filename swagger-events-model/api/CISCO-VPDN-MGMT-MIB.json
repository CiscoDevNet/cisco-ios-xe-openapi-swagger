{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-VPDN-MGMT-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-VPDN-MGMT-MIB for VPDN tunnel events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-VPDN-MGMT-MIB:cvpdnNotifSession": {
      "get": {
        "description": "Notification for cvpdnNotifSession event",
        "tags": [
          "VPN"
        ],
        "summary": "SNMP Trap: cvpdnNotifSession",
        "operationId": "get_cvpdnNotifSession",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cvpdnNotifSession notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cvpdnNotifSession"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-VPDN-MGMT-MIB:cvpdnNotifSession": {
                      "cvpdnNotifSessionID": 12345,
                      "cvpdnNotifSessionEvent": "example-string",
                      "cvpdnSystemTunnelType": "event-type",
                      "cvpdnTunnelAttrTunnelId": 12345,
                      "cvpdnSessionAttrSessionId": 12345,
                      "cvpdnSessionAttrDevicePhyId": 12345,
                      "cvpdnSessionAttrVirtualCircuitID": 12345
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "cvpdnNotifSession": {
        "type": "object",
        "description": "SNMP trap notification payload for cvpdnNotifSession",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-VPDN-MGMT-MIB:cvpdnNotifSession": {
                "type": "object",
                "description": "Varbind objects for cvpdnNotifSession trap",
                "properties": {
                  "cvpdnNotifSessionID": {
                    "type": "string"
                  },
                  "cvpdnNotifSessionEvent": {
                    "type": "string"
                  },
                  "cvpdnSystemTunnelType": {
                    "type": "string"
                  },
                  "cvpdnTunnelAttrTunnelId": {
                    "type": "string"
                  },
                  "cvpdnSessionAttrSessionId": {
                    "type": "string"
                  },
                  "cvpdnSessionAttrDevicePhyId": {
                    "type": "string"
                  },
                  "cvpdnSessionAttrVirtualCircuitID": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-VPDN-MGMT-MIB:cvpdnNotifSession": {
              "cvpdnNotifSessionID": 12345,
              "cvpdnNotifSessionEvent": "example-string",
              "cvpdnSystemTunnelType": "event-type",
              "cvpdnTunnelAttrTunnelId": 12345,
              "cvpdnSessionAttrSessionId": 12345,
              "cvpdnSessionAttrDevicePhyId": 12345,
              "cvpdnSessionAttrVirtualCircuitID": 12345
            }
          }
        }
      }
    }
  }
}
