{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - platform-software",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG definitions\n     for various platform software events.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - platform-software.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - platform-software.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-platform-software-events structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-platform-software-events.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-platform-software-events:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-platform-software-events event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-platform-software-events",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-platform-software-events:process-state-event": {
                      "name": "example-name",
                      "location": "example-value",
                      "fru": "fru-type",
                      "slot": 100,
                      "bay": 100,
                      "chassis": 100,
                      "node": 100,
                      "new-state": "active",
                      "instance": 1,
                      "pid": 12345
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/process-state-event"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/operations/ietf-subscribed-notifications:establish-subscription": {
      "post": {
        "summary": "Create event subscription",
        "description": "Establish a subscription to Cisco-IOS-XE-platform-software-events events",
        "tags": [
          "events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "example": {
                "input": {
                  "stream": "Cisco-IOS-XE-platform-software-events:events",
                  "encoding": "encode-json",
                  "update-trigger": "periodic",
                  "period": 6000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-platform-software-events:process-state-event": {
                      "name": "example-name",
                      "location": "example-value",
                      "fru": "fru-type",
                      "slot": 100,
                      "bay": 100,
                      "chassis": 100,
                      "node": 100,
                      "new-state": "active",
                      "instance": 1,
                      "pid": 12345
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/process-state-event"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "process-state-event": {
        "type": "object",
        "description": "Notification payload for process-state-event",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the event occurred"
              },
              "Cisco-IOS-XE-platform-software-events:process-state-event": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "location": {
                    "type": "string"
                  },
                  "fru": {
                    "type": "string"
                  },
                  "slot": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "bay": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "chassis": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "node": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "new-state": {
                    "type": "string"
                  },
                  "instance": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "pid": {
                    "type": "integer",
                    "format": "int32"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "Cisco-IOS-XE-platform-software-events:process-state-event": {
              "name": "example-name",
              "location": "example-value",
              "fru": "fru-type",
              "slot": 100,
              "bay": 100,
              "chassis": 100,
              "node": 100,
              "new-state": "active",
              "instance": 1,
              "pid": 12345
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "events",
      "description": "Model-driven telemetry event subscriptions"
    }
