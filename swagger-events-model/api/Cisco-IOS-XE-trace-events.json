{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - trace",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG definitions\n     for trace action notification for trace decoder events.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - trace.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - trace.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-trace-events structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-trace-events.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-trace-events:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-trace-events event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-trace-events",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-trace-events:trace-status": {
                      "unique-id": 12345,
                      "percentage": 85
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/trace-status"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/operations/ietf-subscribed-notifications:establish-subscription": {
      "post": {
        "summary": "Create event subscription",
        "description": "Establish a subscription to Cisco-IOS-XE-trace-events events",
        "tags": [
          "events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "example": {
                "input": {
                  "stream": "Cisco-IOS-XE-trace-events:events",
                  "encoding": "encode-json",
                  "update-trigger": "periodic",
                  "period": 6000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-trace-events:trace-status": {
                      "unique-id": 12345,
                      "percentage": 85
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/trace-status"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "trace-status": {
        "type": "object",
        "description": "Notification payload for trace-status",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the event occurred"
              },
              "Cisco-IOS-XE-trace-events:trace-status": {
                "type": "object",
                "properties": {
                  "unique-id": {
                    "type": "integer",
                    "format": "int32"
                  },
                  "percentage": {
                    "type": "integer",
                    "format": "int32"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "Cisco-IOS-XE-trace-events:trace-status": {
              "unique-id": 12345,
              "percentage": 85
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "events",
      "description": "Model-driven telemetry event subscriptions"
    }
  ]
}
