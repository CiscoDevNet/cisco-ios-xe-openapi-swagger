        "description": "SNMP trap notification payload for ciscoTap2MIBActive",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-TAP2-MIB:ciscoTap2MIBActive": {
                "type": "object",
                "description": "Varbind objects for ciscoTap2MIBActive trap",
                "properties": {
                  "event-time": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-TAP2-MIB:ciscoTap2MIBActive": {
              "event-time": "2026-02-10T10:30:00Z"
            }
