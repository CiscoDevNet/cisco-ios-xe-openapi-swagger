{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-HSRP-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-HSRP-MIB for HSRP state change events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-HSRP-MIB:cHsrpStateChange": {
      "get": {
        "description": "Notification for cHsrpStateChange event",
        "tags": [
          "High Availability"
        ],
        "summary": "SNMP Trap: cHsrpStateChange",
        "operationId": "get_cHsrpStateChange",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cHsrpStateChange notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cHsrpStateChange"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-HSRP-MIB:cHsrpStateChange": {
                      "ifIndex": 1,
                      "cHsrpGrpNumber": 5,
                      "cHsrpGrpStandbyState": "active"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "cHsrpStateChange": {
        "type": "object",
        "description": "SNMP trap notification payload for cHsrpStateChange",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-HSRP-MIB:cHsrpStateChange": {
                "type": "object",
                "description": "Varbind objects for cHsrpStateChange trap",
                "properties": {
                  "ifIndex": {
                    "type": "string"
                  },
                  "cHsrpGrpNumber": {
                    "type": "string"
                  },
                  "cHsrpGrpStandbyState": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-HSRP-MIB:cHsrpStateChange": {
              "ifIndex": 1,
              "cHsrpGrpNumber": 5,
              "cHsrpGrpStandbyState": "active"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "High Availability",
      "description": "SNMP notification and event subscriptions for High Availability"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/docs/ios-xe/"
  }
}
