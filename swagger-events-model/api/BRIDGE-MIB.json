{
  "openapi": "3.0.0",
  "info": {
    "title": "BRIDGE-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from BRIDGE-MIB for bridging and spanning tree events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/BRIDGE-MIB:newRoot": {
      "get": {
        "summary": "SNMP Trap: New spanning tree root bridge",
        "description": "Notification when this bridge becomes the new root of the spanning tree",
        "operationId": "get_newRoot",
        "tags": [
          "Spanning Tree Events"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "newRoot notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/newRoot"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "BRIDGE-MIB:newRoot": {
                      "event-time": "2026-02-10T10:30:00Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/BRIDGE-MIB:topologyChange": {
      "get": {
        "summary": "SNMP Trap: Spanning tree topology change",
        "description": "Notification when spanning tree topology change is detected",
        "operationId": "get_topologyChange",
        "tags": [
          "Spanning Tree Events"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "topologyChange notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/topologyChange"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "BRIDGE-MIB:topologyChange": {
                      "event-time": "2026-02-10T10:30:00Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/BRIDGE-MIB:newRootPort": {
      "get": {
        "summary": "SNMP Trap: New spanning tree root port",
        "description": "Notification when a new root port is selected",
        "operationId": "get_newRootPort",
        "tags": [
          "Spanning Tree Events"
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "newRoot notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/newRoot"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "BRIDGE-MIB:newRoot": {
                      "event-time": "2026-02-10T10:30:00Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Subscription identifier"
      },
      "ReceiverName": {
        "name": "name",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Receiver name"
      }
    },
    "responses": {
      "NotificationResponse": {
        "description": "SNMP Trap notification data",
        "content": {
          "application/yang-data+json": {
            "schema": {
              "type": "object",
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "newRoot": {
        "type": "object",
        "description": "SNMP trap notification payload for newRoot",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "BRIDGE-MIB:newRoot": {
                "type": "object",
                "description": "Varbind objects for newRoot trap",
                "properties": {
                  "event-time": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "BRIDGE-MIB:newRoot": {
              "event-time": "2026-02-10T10:30:00Z"
            }
          }
        }
      },
      "topologyChange": {
        "type": "object",
        "description": "SNMP trap notification payload for topologyChange",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "BRIDGE-MIB:topologyChange": {
                "type": "object",
                "description": "Varbind objects for topologyChange trap",
                "properties": {
                  "event-time": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "BRIDGE-MIB:topologyChange": {
              "event-time": "2026-02-10T10:30:00Z"
            }
          }
        }
      }
    }
  }
}
