{
  "openapi": "3.0.0",
  "info": {
    "title": "DS3-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from DS3-MIB for DS3/E3 interface events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/DS3-MIB:dsx3LineStatusChange": {
      "get": {
        "description": "Notification for dsx3LineStatusChange event",
        "tags": [
          "Interface"
        ],
        "summary": "SNMP Trap: dsx3LineStatusChange",
        "operationId": "get_dsx3LineStatusChange",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "dsx3LineStatusChange notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/dsx3LineStatusChange"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "DS3-MIB:dsx3LineStatusChange": {
                      "dsx3LineIndex": 1,
                      "dsx3LineStatus": "up",
                      "dsx3LineStatusLastChange": "up"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "dsx3LineStatusChange": {
        "type": "object",
        "description": "SNMP trap notification payload for dsx3LineStatusChange",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "DS3-MIB:dsx3LineStatusChange": {
                "type": "object",
                "description": "Varbind objects for dsx3LineStatusChange trap",
                "properties": {
                  "dsx3LineIndex": {
                    "type": "string"
                  },
                  "dsx3LineStatus": {
                    "type": "string"
                  },
                  "dsx3LineStatusLastChange": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "DS3-MIB:dsx3LineStatusChange": {
              "dsx3LineIndex": 1,
              "dsx3LineStatus": "up",
              "dsx3LineStatusLastChange": "up"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Interface",
      "description": "SNMP notification and event subscriptions for Interface"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/iosxe/"
  }
}
