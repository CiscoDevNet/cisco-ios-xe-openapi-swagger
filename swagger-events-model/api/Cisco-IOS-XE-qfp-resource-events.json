{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - qfp-resource",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG Definitions\n     for qfp resource event notification.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - qfp-resource.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - qfp-resource.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-qfp-resource-events structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-qfp-resource-events.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-qfp-resource-events:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-qfp-resource-events event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-qfp-resource-events",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-qfp-resource-events:qfp-resource-usage": {
                      "severity": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "warning-string": "QFP memory utilization exceeded 90% threshold",
                      "five-sec": 1000,
                      "one-min": 1000,
                      "five-min": 1000,
                      "sixty-min": 1000,
                      "qfp-resource-status": "up"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/qfp-resource-usage"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "operationId": "get-events"
      }
    },
    "/operations/ietf-subscribed-notifications:establish-subscription": {
      "post": {
        "summary": "Create event subscription",
        "description": "Establish a subscription to Cisco-IOS-XE-qfp-resource-events events",
        "tags": [
          "events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "example": {
                "input": {
                  "stream": "Cisco-IOS-XE-qfp-resource-events:events",
                  "encoding": "encode-json",
                  "update-trigger": "periodic",
                  "period": 6000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-qfp-resource-events:qfp-resource-usage": {
                      "severity": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "warning-string": "QFP memory utilization exceeded 90% threshold",
                      "five-sec": 1000,
                      "one-min": 1000,
                      "five-min": 1000,
                      "sixty-min": 1000,
                      "qfp-resource-status": "up"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/qfp-resource-usage"
                }
              }
            }
          }
        },
        "operationId": "post-establish-subscription"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
