            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Subscription ID"
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Receiver name"
          }
        ],
        "responses": {
          "200": {
            "description": "Voltage status notification",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ciscoEnvMonVoltStatusChangeNotif"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-ENVMON-MIB:ciscoEnvMonVoltStatusChangeNotif": {
                      "ciscoEnvMonVoltageStatusIndex": "up",
                      "ciscoEnvMonVoltageStatusDescr": "up",
                      "ciscoEnvMonVoltageStatusValue": "up",
                      "ciscoEnvMonVoltageState": "active"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
