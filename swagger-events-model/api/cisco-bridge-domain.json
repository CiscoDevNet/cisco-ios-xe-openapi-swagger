{
  "openapi": "3.0.1",
  "info": {
    "title": "cisco-bridge-domain Event Notifications",
    "version": "17.18.1",
    "description": "This module contains YANG definitions for Cisco bridge domain event notifications.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [cisco-bridge-domain.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/cisco-bridge-domain.yang)\n\n**🌳 YANG Tree:** [View cisco-bridge-domain structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/cisco-bridge-domain.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/ws/event-streams/cisco-bridge-domain/bd-state-notification": {
      "get": {
        "summary": "Subscribe to bd-state-notification events",
        "description": "Establishes WebSocket connection for bridge domain state change notifications",
        "tags": [
          "bridge-domain-events"
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols - WebSocket connection established",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/bd-state-notification"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "cisco-bridge-domain:bd-state-notification": {
                      "id": 12345,
                      "bd-state": "active",
                      "time": 1707500000
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — authentication required (HTTP Basic)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "operationId": "get-bd-state-notification",
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "depth",
            "in": "query",
            "required": false,
            "description": "Limit the depth of returned sub-tree data (RFC 8040 Section 4.8.2). Use 'unbounded' for full depth.",
            "schema": {
              "type": "string",
              "default": "unbounded"
            }
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "description": "Select specific fields to return (RFC 8040 Section 4.8.3). Example: fields=name;status",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "description": "Filter by config state: 'config' (config true only), 'nonconfig' (config false only), or 'all'.",
            "schema": {
              "type": "string",
              "enum": [
                "config",
                "nonconfig",
                "all"
              ],
              "default": "all"
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "bd-state-notification": {
        "type": "object",
        "description": "Bridge domain state change notification",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Time when the notification was generated"
              },
              "cisco-bridge-domain:bd-state-notification": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "Bridge domain identifier"
                  },
                  "bd-state": {
                    "type": "string",
                    "description": "Current state of the bridge domain"
                  },
                  "time": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Timestamp of state change"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "cisco-bridge-domain:bd-state-notification": {
              "id": 12345,
              "bd-state": "active",
              "time": 1707500000
            }
          }
        }
      },
      "restconf-error": {
        "type": "object",
        "description": "Standard RESTCONF error response (RFC 8040 Section 7.1)",
        "properties": {
          "ietf-restconf:errors": {
            "type": "object",
            "properties": {
              "error": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "error-type": {
                      "type": "string",
                      "enum": [
                        "transport",
                        "rpc",
                        "protocol",
                        "application"
                      ],
                      "description": "Layer where the error occurred"
                    },
                    "error-tag": {
                      "type": "string",
                      "description": "Enumerated error tag (e.g. invalid-value, data-missing, access-denied)"
                    },
                    "error-severity": {
                      "type": "string",
                      "enum": [
                        "error",
                        "warning"
                      ],
                      "description": "Error severity"
                    },
                    "error-app-tag": {
                      "type": "string",
                      "description": "Application-specific error tag"
                    },
                    "error-path": {
                      "type": "string",
                      "description": "YANG instance-identifier of the error node"
                    },
                    "error-message": {
                      "type": "string",
                      "description": "Human-readable error description"
                    }
                  },
                  "required": [
                    "error-type",
                    "error-tag"
                  ]
                }
              }
            }
          }
        },
        "example": {
          "ietf-restconf:errors": {
            "error": [
              {
                "error-type": "protocol",
                "error-tag": "invalid-value",
                "error-severity": "error",
                "error-message": "Invalid input parameter"
              }
            ]
          }
        }
      }
    },
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "bridge-domain-events",
      "description": "SNMP notification and event subscriptions for bridge-domain-events"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/iosxe/"
  }
}
