{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-ENHANCED-MEMPOOL-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-ENHANCED-MEMPOOL-MIB for Memory pool buffer events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-ENHANCED-MEMPOOL-MIB:cempMemBufferNotify": {
      "get": {
        "description": "Notification for cempMemBufferNotify event",
        "tags": [
          "System Management"
        ],
        "summary": "SNMP Trap: cempMemBufferNotify",
        "operationId": "get_cempMemBufferNotify",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cempMemBufferNotify notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cempMemBufferNotify"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-ENHANCED-MEMPOOL-MIB:cempMemBufferNotify": {
                      "entPhysicalIndex": 1,
                      "cempMemBufferPoolIndex": 1,
                      "cempMemBufferName": "router-01",
                      "cempMemBufferPeak": "cempmembufferpeak",
                      "cempMemBufferPeakTime": 3600
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "cempMemBufferNotify": {
        "type": "object",
        "description": "SNMP trap notification payload for cempMemBufferNotify",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-ENHANCED-MEMPOOL-MIB:cempMemBufferNotify": {
                "type": "object",
                "description": "Varbind objects for cempMemBufferNotify trap",
                "properties": {
                  "entPhysicalIndex": {
                    "type": "string"
                  },
                  "cempMemBufferPoolIndex": {
                    "type": "string"
                  },
                  "cempMemBufferName": {
                    "type": "string"
                  },
                  "cempMemBufferPeak": {
                    "type": "string"
                  },
                  "cempMemBufferPeakTime": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-ENHANCED-MEMPOOL-MIB:cempMemBufferNotify": {
              "entPhysicalIndex": 1,
              "cempMemBufferPoolIndex": 1,
              "cempMemBufferName": "router-01",
              "cempMemBufferPeak": "cempmembufferpeak",
              "cempMemBufferPeakTime": 3600
            }
          }
        }
      }
    }
  }
}
