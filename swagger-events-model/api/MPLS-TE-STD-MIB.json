                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "MPLS-TE-STD-MIB:mplsTunnelUp": {
                "type": "object",
                "description": "Varbind objects for mplsTunnelUp trap",
                "properties": {
                  "mplsTunnelIndex": {
                    "type": "string"
                  },
                  "mplsTunnelInstance": {
