{
  "openapi": "3.0.0",
  "info": {
    "title": "MPLS-TE-STD-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from MPLS-TE-STD-MIB for MPLS Traffic Engineering tunnel events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/MPLS-TE-STD-MIB:mplsTunnelUp": {
      "get": {
        "description": "Notification for mplsTunnelUp event",
        "tags": [
          "MPLS"
        ],
        "summary": "SNMP Trap: mplsTunnelUp",
        "operationId": "get_mplsTunnelUp",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "mplsTunnelUp notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/mplsTunnelUp"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "MPLS-TE-STD-MIB:mplsTunnelUp": {
                      "mplsTunnelIndex": 1,
                      "mplsTunnelInstance": "mplstunnelinstance",
                      "mplsTunnelIngressLSRId": 12345,
                      "mplsTunnelEgressLSRId": 12345,
                      "mplsTunnelAdminStatus": "up",
                      "mplsTunnelOperStatus": "up"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
