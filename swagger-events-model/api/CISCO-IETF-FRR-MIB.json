{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-IETF-FRR-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-IETF-FRR-MIB for MPLS fast reroute events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-IETF-FRR-MIB:cmplsFrrProtected": {
      "get": {
        "description": "Notification for cmplsFrrProtected event",
        "tags": [
          "MPLS"
        ],
        "summary": "SNMP Trap: cmplsFrrProtected",
        "operationId": "get_cmplsFrrProtected",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cmplsFrrProtected notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cmplsFrrProtected"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-IETF-FRR-MIB:cmplsFrrProtected": {
                      "cmplsFrrConstIfIndex": 1,
                      "cmplsFrrConstTunnelIndex": 1,
                      "cmplsFrrConstTunnelInstance": "cmplsfrrconsttunnelinstance",
                      "cmplsFrrConstNumProtectingTunOnIf": 5,
                      "cmplsFrrConstNumProtectedTunOnIf": 5,
                      "cmplsFrrConstBandwidth": 12345
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-IETF-FRR-MIB:cmplsFrrUnProtected": {
      "get": {
        "description": "Notification for cmplsFrrUnProtected event",
        "tags": [
          "MPLS"
        ],
        "summary": "SNMP Trap: cmplsFrrUnProtected",
        "operationId": "get_cmplsFrrUnProtected",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cmplsFrrUnProtected notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cmplsFrrUnProtected"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-IETF-FRR-MIB:cmplsFrrUnProtected": {
                      "cmplsFrrConstIfIndex": 1,
                      "cmplsFrrConstTunnelIndex": 1,
                      "cmplsFrrConstTunnelInstance": "cmplsfrrconsttunnelinstance",
                      "cmplsFrrConstNumProtectingTunOnIf": 5,
                      "cmplsFrrConstNumProtectedTunOnIf": 5,
                      "cmplsFrrConstBandwidth": 12345
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "cmplsFrrProtected": {
        "type": "object",
        "description": "SNMP trap notification payload for cmplsFrrProtected",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-IETF-FRR-MIB:cmplsFrrProtected": {
                "type": "object",
                "description": "Varbind objects for cmplsFrrProtected trap",
                "properties": {
                  "cmplsFrrConstIfIndex": {
                    "type": "string"
                  },
                  "cmplsFrrConstTunnelIndex": {
                    "type": "string"
                  },
                  "cmplsFrrConstTunnelInstance": {
                    "type": "string"
                  },
                  "cmplsFrrConstNumProtectingTunOnIf": {
                    "type": "string"
                  },
                  "cmplsFrrConstNumProtectedTunOnIf": {
                    "type": "string"
                  },
                  "cmplsFrrConstBandwidth": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-IETF-FRR-MIB:cmplsFrrProtected": {
              "cmplsFrrConstIfIndex": 1,
              "cmplsFrrConstTunnelIndex": 1,
              "cmplsFrrConstTunnelInstance": "cmplsfrrconsttunnelinstance",
              "cmplsFrrConstNumProtectingTunOnIf": 5,
              "cmplsFrrConstNumProtectedTunOnIf": 5,
              "cmplsFrrConstBandwidth": 12345
            }
          }
        }
      },
      "cmplsFrrUnProtected": {
        "type": "object",
        "description": "SNMP trap notification payload for cmplsFrrUnProtected",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-IETF-FRR-MIB:cmplsFrrUnProtected": {
                "type": "object",
                "description": "Varbind objects for cmplsFrrUnProtected trap",
                "properties": {
                  "cmplsFrrConstIfIndex": {
                    "type": "string"
                  },
                  "cmplsFrrConstTunnelIndex": {
                    "type": "string"
                  },
                  "cmplsFrrConstTunnelInstance": {
                    "type": "string"
                  },
                  "cmplsFrrConstNumProtectingTunOnIf": {
                    "type": "string"
                  },
                  "cmplsFrrConstNumProtectedTunOnIf": {
                    "type": "string"
                  },
                  "cmplsFrrConstBandwidth": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-IETF-FRR-MIB:cmplsFrrUnProtected": {
              "cmplsFrrConstIfIndex": 1,
              "cmplsFrrConstTunnelIndex": 1,
              "cmplsFrrConstTunnelInstance": "cmplsfrrconsttunnelinstance",
              "cmplsFrrConstNumProtectingTunOnIf": 5,
              "cmplsFrrConstNumProtectedTunOnIf": 5,
              "cmplsFrrConstBandwidth": 12345
            }
          }
        }
      }
    }
  }
}
