{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-DOT3-OAM-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-DOT3-OAM-MIB for Ethernet OAM threshold events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-DOT3-OAM-MIB:cdot3OamThresholdEvent": {
      "get": {
        "description": "Notification for cdot3OamThresholdEvent event",
        "tags": [
          "Ethernet OAM"
        ],
        "summary": "SNMP Trap: cdot3OamThresholdEvent",
        "operationId": "get_cdot3OamThresholdEvent",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cdot3OamThresholdEvent notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cdot3OamThresholdEvent"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-DOT3-OAM-MIB:cdot3OamThresholdEvent": {
                      "ifIndex": 1,
                      "cdot3OamEventLogIndex": 1,
                      "cdot3OamEventLogTimestamp": "2026-02-10T10:30:00Z",
                      "cdot3OamEventLogOui": "cdot3oameventlogoui",
                      "cdot3OamEventLogType": "errSymPeriodEvent",
                      "cdot3OamEventLogLocation": "cdot3oameventloglocation",
                      "cdot3OamEventLogWindowHi": "cdot3oameventlogwindowhi",
                      "cdot3OamEventLogWindowLo": "cdot3oameventlogwindowlo",
                      "cdot3OamEventLogThresholdHi": "cdot3oameventlogthresholdhi",
                      "cdot3OamEventLogThresholdLo": "cdot3oameventlogthresholdlo",
                      "cdot3OamEventLogValue": 1000,
                      "cdot3OamEventLogRunningTotal": 5,
                      "cdot3OamEventLogEventTotal": 5
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-DOT3-OAM-MIB:cdot3OamNonThresholdEvent": {
      "get": {
        "description": "Notification for cdot3OamNonThresholdEvent event",
        "tags": [
          "Ethernet OAM"
        ],
        "summary": "SNMP Trap: cdot3OamNonThresholdEvent",
        "operationId": "get_cdot3OamNonThresholdEvent",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cdot3OamNonThresholdEvent notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cdot3OamNonThresholdEvent"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-DOT3-OAM-MIB:cdot3OamNonThresholdEvent": {
                      "ifIndex": 1,
                      "cdot3OamEventLogIndex": 1,
                      "cdot3OamEventLogTimestamp": "2026-02-10T10:30:00Z",
                      "cdot3OamEventLogOui": "cdot3oameventlogoui",
                      "cdot3OamEventLogType": "errSymPeriodEvent",
                      "cdot3OamEventLogLocation": "cdot3oameventloglocation",
                      "cdot3OamEventLogEventTotal": 5
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "cdot3OamThresholdEvent": {
        "type": "object",
        "description": "SNMP trap notification payload for cdot3OamThresholdEvent",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-DOT3-OAM-MIB:cdot3OamThresholdEvent": {
                "type": "object",
                "description": "Varbind objects for cdot3OamThresholdEvent trap",
                "properties": {
                  "ifIndex": {
                    "type": "string"
                  },
                  "cdot3OamEventLogIndex": {
                    "type": "string"
                  },
                  "cdot3OamEventLogTimestamp": {
                    "type": "string"
                  },
                  "cdot3OamEventLogOui": {
                    "type": "string"
                  },
                  "cdot3OamEventLogType": {
                    "type": "string"
                  },
                  "cdot3OamEventLogLocation": {
                    "type": "string"
                  },
                  "cdot3OamEventLogWindowHi": {
                    "type": "string"
                  },
                  "cdot3OamEventLogWindowLo": {
                    "type": "string"
                  },
                  "cdot3OamEventLogThresholdHi": {
                    "type": "string"
                  },
                  "cdot3OamEventLogThresholdLo": {
                    "type": "string"
                  },
                  "cdot3OamEventLogValue": {
                    "type": "string"
                  },
                  "cdot3OamEventLogRunningTotal": {
                    "type": "string"
                  },
                  "cdot3OamEventLogEventTotal": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-DOT3-OAM-MIB:cdot3OamThresholdEvent": {
              "ifIndex": 1,
              "cdot3OamEventLogIndex": 1,
              "cdot3OamEventLogTimestamp": "2026-02-10T10:30:00Z",
              "cdot3OamEventLogOui": "cdot3oameventlogoui",
              "cdot3OamEventLogType": "errSymPeriodEvent",
              "cdot3OamEventLogLocation": "cdot3oameventloglocation",
              "cdot3OamEventLogWindowHi": "cdot3oameventlogwindowhi",
              "cdot3OamEventLogWindowLo": "cdot3oameventlogwindowlo",
              "cdot3OamEventLogThresholdHi": "cdot3oameventlogthresholdhi",
              "cdot3OamEventLogThresholdLo": "cdot3oameventlogthresholdlo",
              "cdot3OamEventLogValue": 1000,
              "cdot3OamEventLogRunningTotal": 5,
              "cdot3OamEventLogEventTotal": 5
            }
          }
        }
      },
      "cdot3OamNonThresholdEvent": {
        "type": "object",
        "description": "SNMP trap notification payload for cdot3OamNonThresholdEvent",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-DOT3-OAM-MIB:cdot3OamNonThresholdEvent": {
                "type": "object",
                "description": "Varbind objects for cdot3OamNonThresholdEvent trap",
                "properties": {
                  "ifIndex": {
                    "type": "string"
                  },
                  "cdot3OamEventLogIndex": {
                    "type": "string"
                  },
                  "cdot3OamEventLogTimestamp": {
                    "type": "string"
                  },
                  "cdot3OamEventLogOui": {
                    "type": "string"
                  },
                  "cdot3OamEventLogType": {
                    "type": "string"
                  },
                  "cdot3OamEventLogLocation": {
                    "type": "string"
                  },
                  "cdot3OamEventLogEventTotal": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-DOT3-OAM-MIB:cdot3OamNonThresholdEvent": {
              "ifIndex": 1,
              "cdot3OamEventLogIndex": 1,
              "cdot3OamEventLogTimestamp": "2026-02-10T10:30:00Z",
              "cdot3OamEventLogOui": "cdot3oameventlogoui",
              "cdot3OamEventLogType": "errSymPeriodEvent",
              "cdot3OamEventLogLocation": "cdot3oameventloglocation",
              "cdot3OamEventLogEventTotal": 5
            }
          }
        }
      }
    }
  }
}
