              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-RF-MIB:ciscoRFIssuStateNotif": {
                "type": "object",
                "description": "Varbind objects for ciscoRFIssuStateNotif trap",
                "properties": {
                  "cRFStatusUnitId": {
                    "type": "string"
                  },
