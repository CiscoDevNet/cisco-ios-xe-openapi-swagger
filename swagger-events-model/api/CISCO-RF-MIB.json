{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-RF-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-RF-MIB for Redundancy framework events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-RF-MIB:ciscoRFSwactNotif": {
      "get": {
        "description": "Notification for ciscoRFSwactNotif event",
        "tags": [
          "High Availability"
        ],
        "summary": "SNMP Trap: ciscoRFSwactNotif",
        "operationId": "get_ciscoRFSwactNotif",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ciscoRFSwactNotif notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ciscoRFSwactNotif"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-RF-MIB:ciscoRFSwactNotif": {
                      "cRFStatusUnitId": "up",
                      "sysUpTime": 3600,
                      "cRFStatusLastSwactReasonCode": "up"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-RF-MIB:ciscoRFProgressionNotif": {
      "get": {
        "description": "Notification for ciscoRFProgressionNotif event",
        "tags": [
          "High Availability"
        ],
        "summary": "SNMP Trap: ciscoRFProgressionNotif",
        "operationId": "get_ciscoRFProgressionNotif",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ciscoRFProgressionNotif notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ciscoRFProgressionNotif"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-RF-MIB:ciscoRFProgressionNotif": {
                      "cRFStatusUnitId": "up",
                      "cRFStatusUnitState": "active",
                      "cRFStatusPeerUnitId": "up",
                      "cRFStatusPeerUnitState": "active"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-RF-MIB:ciscoRFIssuStateNotifRev1": {
      "get": {
        "description": "Notification for ciscoRFIssuStateNotifRev1 event",
        "tags": [
          "High Availability"
        ],
        "summary": "SNMP Trap: ciscoRFIssuStateNotifRev1",
        "operationId": "get_ciscoRFIssuStateNotifRev1",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ciscoRFIssuStateNotif notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ciscoRFIssuStateNotif"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-RF-MIB:ciscoRFIssuStateNotif": {
                      "cRFStatusUnitId": "up",
                      "cRFStatusUnitState": "active"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "ciscoRFSwactNotif": {
        "type": "object",
        "description": "SNMP trap notification payload for ciscoRFSwactNotif",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-RF-MIB:ciscoRFSwactNotif": {
                "type": "object",
                "description": "Varbind objects for ciscoRFSwactNotif trap",
                "properties": {
                  "cRFStatusUnitId": {
                    "type": "string"
                  },
                  "sysUpTime": {
                    "type": "string"
                  },
                  "cRFStatusLastSwactReasonCode": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-RF-MIB:ciscoRFSwactNotif": {
              "cRFStatusUnitId": "up",
              "sysUpTime": 3600,
              "cRFStatusLastSwactReasonCode": "up"
            }
          }
        }
      },
      "ciscoRFProgressionNotif": {
