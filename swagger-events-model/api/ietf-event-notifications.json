                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "ietf-event-notifications:subscription-terminated": {
                      "subscription-id": 2147483650,
                      "reason": "link-flap-detected"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "get-subscription-terminated"
      }
    }
  },
