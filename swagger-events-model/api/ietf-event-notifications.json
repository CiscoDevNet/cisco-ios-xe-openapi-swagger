                  "$ref": "#/components/schemas/subscription-suspended"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "ietf-event-notifications:subscription-suspended": {
                      "subscription-id": 2147483650,
                      "reason": "link-flap-detected"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "get-subscription-suspended"
      }
    },
    "/ws/event-streams/ietf-event-notifications/subscription-resumed": {
      "get": {
        "summary": "Subscribe to subscription-resumed events",
