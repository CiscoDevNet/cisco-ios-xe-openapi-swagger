                  "encoding": {
                    "type": "string"
                  },
                  "(filter-type)?": {
                    "type": "string"
                  },
                  "filter": {
                    "type": "string"
                  },
                  "filter-ref": {
                    "type": "string"
                  },
                  "startTime": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "stopTime": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
