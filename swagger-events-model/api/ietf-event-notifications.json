{
  "openapi": "3.0.1",
  "info": {
    "title": "ietf-event-notifications Event Notifications",
    "version": "17.18.1",
    "description": "This module contains IETF YANG definitions for event notification subscription management.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [ietf-event-notifications.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/ietf-event-notifications.yang)\n\n**🌳 YANG Tree:** [View ietf-event-notifications structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/ietf-event-notifications.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/ws/event-streams/ietf-event-notifications/replay-complete": {
      "get": {
        "summary": "Subscribe to replay-complete events",
        "description": "Notification that replay of buffered notifications has completed",
        "tags": [
          "event-notification-lifecycle"
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols - WebSocket connection established",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/replay-complete"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "ietf-event-notifications:replay-complete": {
                      "subscription-id": 2147483650
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "get-replay-complete"
      }
    },
    "/ws/event-streams/ietf-event-notifications/notification-complete": {
      "get": {
        "summary": "Subscribe to notification-complete events",
        "description": "Notification that all requested notifications have been sent",
        "tags": [
          "event-notification-lifecycle"
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols - WebSocket connection established",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/notification-complete"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "ietf-event-notifications:notification-complete": {
                      "subscription-id": 2147483650
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "get-notification-complete"
      }
    },
    "/ws/event-streams/ietf-event-notifications/subscription-started": {
      "get": {
        "summary": "Subscribe to subscription-started events",
        "description": "Notification that a subscription has successfully started",
        "tags": [
          "event-notification-lifecycle"
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols - WebSocket connection established",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/subscription-started"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "ietf-event-notifications:subscription-started": {
                      "subscription-id": 2147483650,
                      "stream": "NETCONF",
                      "encoding": "encode-xml",
                      "(filter-type)?": "by-reference",
                      "filter": "/ietf-interfaces:interfaces",
                      "filter-ref": "1",
                      "startTime": "2026-02-10T10:30:00Z",
                      "stopTime": "2026-02-10T10:30:00Z"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "get-subscription-started"
      }
    },
    "/ws/event-streams/ietf-event-notifications/subscription-suspended": {
      "get": {
        "summary": "Subscribe to subscription-suspended events",
        "description": "Notification that a subscription has been suspended",
        "tags": [
          "event-notification-lifecycle"
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols - WebSocket connection established",
