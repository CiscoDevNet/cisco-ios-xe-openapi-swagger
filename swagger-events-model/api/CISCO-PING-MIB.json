{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-PING-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-PING-MIB for Ping operation completion events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-PING-MIB:ciscoPingCompletion": {
      "get": {
        "description": "Notification for ciscoPingCompletion event",
        "tags": [
          "Management"
        ],
        "summary": "SNMP Trap: ciscoPingCompletion",
        "operationId": "get_ciscoPingCompletion",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ciscoPingCompletion notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ciscoPingCompletion"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-PING-MIB:ciscoPingCompletion": {
                      "ciscoPingSerialNumber": 5,
                      "ciscoPingCompleted": "ciscopingcompleted",
                      "ciscoPingSentPackets": "ciscopingsentpackets",
                      "ciscoPingReceivedPackets": "ciscopingreceivedpackets"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "ciscoPingCompletion": {
        "type": "object",
        "description": "SNMP trap notification payload for ciscoPingCompletion",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-PING-MIB:ciscoPingCompletion": {
                "type": "object",
                "description": "Varbind objects for ciscoPingCompletion trap",
                "properties": {
                  "ciscoPingSerialNumber": {
                    "type": "string"
                  },
                  "ciscoPingCompleted": {
                    "type": "string"
                  },
                  "ciscoPingSentPackets": {
                    "type": "string"
                  },
                  "ciscoPingReceivedPackets": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-PING-MIB:ciscoPingCompletion": {
              "ciscoPingSerialNumber": 5,
              "ciscoPingCompleted": "ciscopingcompleted",
              "ciscoPingSentPackets": "ciscopingsentpackets",
              "ciscoPingReceivedPackets": "ciscopingreceivedpackets"
            }
          }
        }
      }
    }
  }
}
