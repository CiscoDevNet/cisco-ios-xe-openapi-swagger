{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-SYSLOG-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-SYSLOG-MIB for Syslog message events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-SYSLOG-MIB:clogMessageGenerated": {
      "get": {
        "description": "Notification for clogMessageGenerated event",
        "tags": [
          "Management"
        ],
        "summary": "SNMP Trap: clogMessageGenerated",
        "operationId": "get_clogMessageGenerated",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "clogMessageGenerated notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/clogMessageGenerated"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-SYSLOG-MIB:clogMessageGenerated": {
                      "clogHistIndex": 1,
                      "clogHistFacility": "SYS",
                      "clogHistSeverity": "major",
                      "clogHistMsgName": "CONFIG_I",
                      "clogHistMsgText": "Configured from console by admin on vty0",
                      "clogHistTimestamp": "2026-02-10T10:30:00Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "clogMessageGenerated": {
        "type": "object",
        "description": "SNMP trap notification payload for clogMessageGenerated",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-SYSLOG-MIB:clogMessageGenerated": {
                "type": "object",
                "description": "Varbind objects for clogMessageGenerated trap",
                "properties": {
                  "clogHistIndex": {
                    "type": "string"
                  },
                  "clogHistFacility": {
                    "type": "string"
                  },
                  "clogHistSeverity": {
                    "type": "string"
                  },
                  "clogHistMsgName": {
                    "type": "string"
                  },
                  "clogHistMsgText": {
                    "type": "string"
                  },
                  "clogHistTimestamp": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-SYSLOG-MIB:clogMessageGenerated": {
              "clogHistIndex": 1,
              "clogHistFacility": "SYS",
              "clogHistSeverity": "major",
              "clogHistMsgName": "CONFIG_I",
              "clogHistMsgText": "Configured from console by admin on vty0",
              "clogHistTimestamp": "2026-02-10T10:30:00Z"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Management",
      "description": "SNMP notification and event subscriptions for Management"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/docs/ios-xe/"
  }
}
