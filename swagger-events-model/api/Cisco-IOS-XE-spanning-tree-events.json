{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - spanning-tree",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG definitions\n     for Spanning-Tree event notification.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - spanning-tree.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - spanning-tree.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-spanning-tree-events structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-spanning-tree-events.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-spanning-tree-events:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-spanning-tree-events event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-spanning-tree-events",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-spanning-tree-events:stp-intf-guard-event": {
                      "if-name": "GigabitEthernet1",
                      "port-num": 100,
                      "guard-type": "root-guard",
                      "guard-state": "active",
                      "action": "stp-port",
                      "(mac-type-choice)?": "00:1a:2b:3c:4d:5e",
                      "client-mac": "00:1a:2b:3c:4d:5e",
                      "(vlan-type-choice)?": 100,
                      "vlan-id": 100,
                      "(instance-type-choice)?": 1,
                      "mst-instance": 100
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/stp-intf-guard-event"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/operations/ietf-subscribed-notifications:establish-subscription": {
      "post": {
        "summary": "Create event subscription",
        "description": "Establish a subscription to Cisco-IOS-XE-spanning-tree-events events",
        "tags": [
          "events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "example": {
                "input": {
                  "stream": "Cisco-IOS-XE-spanning-tree-events:events",
                  "encoding": "encode-json",
                  "update-trigger": "periodic",
                  "period": 6000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-spanning-tree-events:stp-intf-guard-event": {
                      "if-name": "GigabitEthernet1",
                      "port-num": 100,
                      "guard-type": "root-guard",
                      "guard-state": "active",
                      "action": "stp-port",
                      "(mac-type-choice)?": "00:1a:2b:3c:4d:5e",
                      "client-mac": "00:1a:2b:3c:4d:5e",
                      "(vlan-type-choice)?": 100,
                      "vlan-id": 100,
                      "(instance-type-choice)?": 1,
                      "mst-instance": 100
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/stp-intf-guard-event"
                }
              }
            }
          }
        }
      }
    }
  },
