{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-EIGRP-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-EIGRP-MIB for EIGRP neighbor state events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-EIGRP-MIB:cEigrpAuthFailureEvent": {
      "get": {
        "description": "Notification for cEigrpAuthFailureEvent event",
        "tags": [
          "Routing"
        ],
        "summary": "SNMP Trap: cEigrpAuthFailureEvent",
        "operationId": "get_cEigrpAuthFailureEvent",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cEigrpAuthFailureEvent notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cEigrpAuthFailureEvent"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-EIGRP-MIB:cEigrpAuthFailureEvent": {
                      "cEigrpVpnId": 12345,
                      "cEigrpAsNumber": 5,
                      "cEigrpHandle": "ceigrphandle",
                      "cEigrpPeerAddrType": "ipv4",
                      "cEigrpPeerAddr": "10.0.0.1"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-EIGRP-MIB:cEigrpRouteStuckInActive": {
      "get": {
        "description": "Notification for cEigrpRouteStuckInActive event",
        "tags": [
          "Routing"
        ],
        "summary": "SNMP Trap: cEigrpRouteStuckInActive",
        "operationId": "get_cEigrpRouteStuckInActive",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cEigrpRouteStuckInActive notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cEigrpRouteStuckInActive"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-EIGRP-MIB:cEigrpRouteStuckInActive": {
                      "cEigrpVpnId": 12345,
                      "cEigrpAsNumber": 5,
                      "cEigrpHandle": "ceigrphandle",
                      "cEigrpPeerAddrType": "ipv4",
                      "cEigrpPeerAddr": "10.0.0.1",
                      "cEigrpDestNetType": "ipv4",
                      "cEigrpDestNet": "startup",
                      "cEigrpDestNetPrefixLen": "startup",
                      "cEigrpStuckInActive": "ceigrpstuckinactive"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "cEigrpAuthFailureEvent": {
        "type": "object",
        "description": "SNMP trap notification payload for cEigrpAuthFailureEvent",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-EIGRP-MIB:cEigrpAuthFailureEvent": {
                "type": "object",
                "description": "Varbind objects for cEigrpAuthFailureEvent trap",
                "properties": {
                  "cEigrpVpnId": {
                    "type": "string"
                  },
                  "cEigrpAsNumber": {
                    "type": "string"
                  },
                  "cEigrpHandle": {
                    "type": "string"
                  },
                  "cEigrpPeerAddrType": {
                    "type": "string"
                  },
                  "cEigrpPeerAddr": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-EIGRP-MIB:cEigrpAuthFailureEvent": {
              "cEigrpVpnId": 12345,
              "cEigrpAsNumber": 5,
              "cEigrpHandle": "ceigrphandle",
              "cEigrpPeerAddrType": "ipv4",
              "cEigrpPeerAddr": "10.0.0.1"
            }
          }
        }
      },
      "cEigrpRouteStuckInActive": {
        "type": "object",
        "description": "SNMP trap notification payload for cEigrpRouteStuckInActive",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-EIGRP-MIB:cEigrpRouteStuckInActive": {
                "type": "object",
                "description": "Varbind objects for cEigrpRouteStuckInActive trap",
                "properties": {
                  "cEigrpVpnId": {
                    "type": "string"
                  },
                  "cEigrpAsNumber": {
                    "type": "string"
                  },
                  "cEigrpHandle": {
                    "type": "string"
                  },
                  "cEigrpPeerAddrType": {
                    "type": "string"
                  },
                  "cEigrpPeerAddr": {
                    "type": "string"
                  },
                  "cEigrpDestNetType": {
                    "type": "string"
                  },
                  "cEigrpDestNet": {
                    "type": "string"
                  },
                  "cEigrpDestNetPrefixLen": {
                    "type": "string"
                  },
                  "cEigrpStuckInActive": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-EIGRP-MIB:cEigrpRouteStuckInActive": {
              "cEigrpVpnId": 12345,
              "cEigrpAsNumber": 5,
              "cEigrpHandle": "ceigrphandle",
              "cEigrpPeerAddrType": "ipv4",
              "cEigrpPeerAddr": "10.0.0.1",
              "cEigrpDestNetType": "ipv4",
              "cEigrpDestNet": "startup",
              "cEigrpDestNetPrefixLen": "startup",
              "cEigrpStuckInActive": "ceigrpstuckinactive"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Routing",
      "description": "SNMP notification and event subscriptions for Routing"
    }
