{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - appqoe",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG definitions\n     for AppQoE events operational data.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - appqoe.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - appqoe.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-appqoe-events structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-appqoe-events.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-appqoe-events:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-appqoe-events event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-appqoe-events",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-appqoe-events:appqoe-event": {
                      "severity-level": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "event-id": 12345,
                      "device-mode": "active",
                      "module": "example-string",
                      "headline": "example-string",
                      "cause": "appqoe-cause",
                      "action": "appqoe-action",
                      "detail": "example-string",
                      "sn-system-ip": "10.1.1.1",
                      "sng-name": "example-name"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/appqoe-event"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/operations/ietf-subscribed-notifications:establish-subscription": {
      "post": {
        "summary": "Create event subscription",
        "description": "Establish a subscription to Cisco-IOS-XE-appqoe-events events",
        "tags": [
          "events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "example": {
                "input": {
                  "stream": "Cisco-IOS-XE-appqoe-events:events",
                  "encoding": "encode-json",
                  "update-trigger": "periodic",
                  "period": 6000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-appqoe-events:appqoe-alarm": {
                      "severity-level": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "alarm-id": 12345,
                      "device-mode": "active",
                      "module": "example-string",
                      "headline": "example-string",
                      "cause": "appqoe-cause",
                      "action": "appqoe-action",
                      "detail": "example-string",
                      "sn-system-ip": "10.1.1.1",
                      "clear": true,
                      "sng-name": "example-name"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/appqoe-alarm"
                }
              }
            }
          }
        }
      }
    }
  },
