  "openapi": "3.0.0",
  "info": {
    "title": "Events - ip-sla",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG definitions\n     for IPSLA Reaction Notification.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - ip-sla.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - ip-sla.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-ip-sla-events structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-ip-sla-events.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-ip-sla-events:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-ip-sla-events event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-ip-sla-events",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-ip-sla-events:ipsla-reaction-update": {
                      "severity": "major",
                      "oper-id": 12345,
                      "probe-type": "icmp-echo",
                      "oper-type": "add",
                      "react-type": "rtt",
                      "react-status": "up",
                      "react-value": 1000,
                      "precision": "ipsla-precision",
                      "react-data": "5ms",
                      "threshold-type": "percent",
                      "threshold-rising": 100000,
                      "threshold-falling": 100000,
                      "(threshold-value-choice)?": "value-choice)?",
                      "xofy": "1-of-5",
                      "x-value": 1000,
                      "y-value": 1000,
                      "consecutive": 1000,
                      "average": 1000,
                      "immediate": true,
                      "oper-data": {
                        "(oper-data-type-choice)?": {
                          "dhcp-oper-data": "up",
                          "destination-address": "10.1.1.1",
                          "source-address": "10.1.1.1",
                          "dns-oper-data": "up",
                          "target-name": "router-01",
                          "name-server": "8.8.8.8",
                          "source-port": 100,
                          "vrf-name": "default",
                          "ftp-oper-data": "up",
                          "url": "https://10.1.1.1/firmware.bin",
                          "mode": "active",
                          "http-oper-data": "up",
                          "dest-port": 100,
                          "icmp-echo-oper-data": "up",
                          "icmp-jitter-oper-data": "up",
                          "lsp-ping-oper-data": "up",
                          "target-address": "10.1.1.1",
                          "lsp-selector": "10.1.1.1",
                          "lsp-trace-oper-data": "up",
                          "lsp-pseudowire-oper-data": "up",
                          "vccv-id": 12345,
                          "path-echo-oper-data": "up",
                          "path-jitter-oper-data": "up",
                          "tcp-connect-oper-data": "up",
                          "udp-echo-oper-data": "up",
