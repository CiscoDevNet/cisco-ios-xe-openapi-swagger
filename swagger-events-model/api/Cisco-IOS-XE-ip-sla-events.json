                            "name-server": "8.8.8.8",
                            "dest-port": 100,
                            "vrf-name": "default"
                          }
                        }
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ipsla-reaction-update"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
