{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - im-oper",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG definitions\n     for ioxman eventq data.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - im-oper.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - im-oper.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-im-events-oper structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-im-events-oper.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-im-events-oper:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-im-events-oper event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-im-events-oper",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-im-events-oper:im-event": {
                      "severity-level": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "vrf-name": "default",
                      "app-id": 12345,
                      "ev-type": "link-up",
                      "status": "up",
                      "message": "Operation completed successfully",
                      "app-state": "active"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/im-event"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "operationId": "get-events"
      }
    },
    "/operations/ietf-subscribed-notifications:establish-subscription": {
      "post": {
        "summary": "Create event subscription",
        "description": "Establish a subscription to Cisco-IOS-XE-im-events-oper events",
        "tags": [
          "events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "example": {
                "input": {
                  "stream": "Cisco-IOS-XE-im-events-oper:events",
                  "encoding": "encode-json",
                  "update-trigger": "periodic",
                  "period": 6000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-im-events-oper:im-event": {
                      "severity-level": "major",
                      "host-name": "Router1",
                      "system-ip": "10.1.1.1",
                      "vrf-name": "default",
                      "app-id": 12345,
                      "ev-type": "link-up",
                      "status": "up",
                      "message": "Operation completed successfully",
                      "app-state": "active"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/im-event"
                }
              }
            }
          }
        },
        "operationId": "post-establish-subscription"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "im-event": {
        "type": "object",
        "description": "Notification payload for im-event",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the event occurred"
              },
              "Cisco-IOS-XE-im-events-oper:im-event": {
                "type": "object",
                "properties": {
                  "severity-level": {
                    "type": "string"
                  },
                  "host-name": {
                    "type": "string"
                  },
                  "system-ip": {
                    "type": "string",
                    "format": "ipv4"
                  },
                  "vrf-name": {
                    "type": "string"
                  },
                  "app-id": {
                    "type": "string"
                  },
                  "ev-type": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string"
                  },
                  "message": {
                    "type": "string"
                  },
                  "app-state": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "Cisco-IOS-XE-im-events-oper:im-event": {
              "severity-level": "major",
              "host-name": "Router1",
              "system-ip": "10.1.1.1",
              "vrf-name": "default",
              "app-id": 12345,
              "ev-type": "link-up",
              "status": "up",
              "message": "Operation completed successfully",
              "app-state": "active"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "events",
      "description": "Model-driven telemetry event subscriptions"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/docs/ios-xe/"
  }
}
