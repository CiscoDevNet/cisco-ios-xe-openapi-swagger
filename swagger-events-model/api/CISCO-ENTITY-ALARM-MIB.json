{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-ENTITY-ALARM-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-ENTITY-ALARM-MIB for Entity alarm events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-ENTITY-ALARM-MIB:ceAlarmAsserted": {
      "get": {
        "description": "Notification for ceAlarmAsserted event",
        "tags": [
          "Management"
        ],
        "summary": "SNMP Trap: ceAlarmAsserted",
        "operationId": "get_ceAlarmAsserted",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ceAlarmAsserted notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ceAlarmAsserted"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-ENTITY-ALARM-MIB:ceAlarmAsserted": {
                      "ceAlarmHistIndex": 1,
                      "ceAlarmHistEntPhysicalIndex": 1,
                      "ceAlarmHistAlarmType": "environmentalAlarm",
                      "ceAlarmHistSeverity": "major",
                      "ceAlarmHistTimeStamp": "2026-02-10T10:30:00Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-ENTITY-ALARM-MIB:ceAlarmCleared": {
      "get": {
        "description": "Notification for ceAlarmCleared event",
        "tags": [
          "Management"
        ],
        "summary": "SNMP Trap: ceAlarmCleared",
        "operationId": "get_ceAlarmCleared",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ceAlarmCleared notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ceAlarmCleared"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-ENTITY-ALARM-MIB:ceAlarmCleared": {
                      "ceAlarmHistIndex": 1,
                      "ceAlarmHistEntPhysicalIndex": 1,
                      "ceAlarmHistAlarmType": "environmentalAlarm",
                      "ceAlarmHistSeverity": "major",
                      "ceAlarmHistTimeStamp": "2026-02-10T10:30:00Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "ceAlarmAsserted": {
        "type": "object",
        "description": "SNMP trap notification payload for ceAlarmAsserted",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-ENTITY-ALARM-MIB:ceAlarmAsserted": {
                "type": "object",
                "description": "Varbind objects for ceAlarmAsserted trap",
                "properties": {
                  "ceAlarmHistIndex": {
                    "type": "string"
                  },
                  "ceAlarmHistEntPhysicalIndex": {
                    "type": "string"
                  },
                  "ceAlarmHistAlarmType": {
                    "type": "string"
                  },
                  "ceAlarmHistSeverity": {
                    "type": "string"
                  },
                  "ceAlarmHistTimeStamp": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-ENTITY-ALARM-MIB:ceAlarmAsserted": {
              "ceAlarmHistIndex": 1,
              "ceAlarmHistEntPhysicalIndex": 1,
              "ceAlarmHistAlarmType": "environmentalAlarm",
              "ceAlarmHistSeverity": "major",
              "ceAlarmHistTimeStamp": "2026-02-10T10:30:00Z"
            }
          }
        }
      },
      "ceAlarmCleared": {
        "type": "object",
        "description": "SNMP trap notification payload for ceAlarmCleared",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-ENTITY-ALARM-MIB:ceAlarmCleared": {
                "type": "object",
                "description": "Varbind objects for ceAlarmCleared trap",
                "properties": {
                  "ceAlarmHistIndex": {
                    "type": "string"
                  },
                  "ceAlarmHistEntPhysicalIndex": {
                    "type": "string"
                  },
                  "ceAlarmHistAlarmType": {
                    "type": "string"
                  },
                  "ceAlarmHistSeverity": {
                    "type": "string"
                  },
                  "ceAlarmHistTimeStamp": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-ENTITY-ALARM-MIB:ceAlarmCleared": {
              "ceAlarmHistIndex": 1,
              "ceAlarmHistEntPhysicalIndex": 1,
              "ceAlarmHistAlarmType": "environmentalAlarm",
              "ceAlarmHistSeverity": "major",
              "ceAlarmHistTimeStamp": "2026-02-10T10:30:00Z"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Management",
      "description": "SNMP notification and event subscriptions for Management"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE NETCONF/YANG Event Notifications - Cisco DevNet",
    "url": "https://developer.cisco.com/docs/ios-xe/"
  }
}
