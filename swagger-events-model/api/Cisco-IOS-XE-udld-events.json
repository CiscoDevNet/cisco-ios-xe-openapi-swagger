{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - udld",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG definitions\n     for Unidirectional link detection event notification.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - udld.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - udld.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-udld-events structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-udld-events.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-udld-events:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-udld-events event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-udld-events",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-udld-events:udld-intf-event": {
                      "if-name": "GigabitEthernet1",
                      "neighbor-id": 12345,
                      "port-blocked": true,
                      "neighbor-port": "GigabitEthernet1/0/2",
                      "state": "active",
                      "event-type": "state-change"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/udld-intf-event"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/operations/ietf-subscribed-notifications:establish-subscription": {
      "post": {
        "summary": "Create event subscription",
        "description": "Establish a subscription to Cisco-IOS-XE-udld-events events",
        "tags": [
          "events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "example": {
                "input": {
                  "stream": "Cisco-IOS-XE-udld-events:events",
                  "encoding": "encode-json",
                  "update-trigger": "periodic",
                  "period": 6000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-udld-events:udld-intf-event": {
                      "if-name": "GigabitEthernet1",
                      "neighbor-id": 12345,
                      "port-blocked": true,
                      "neighbor-port": "GigabitEthernet1/0/2",
                      "state": "active",
                      "event-type": "state-change"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/udld-intf-event"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "udld-intf-event": {
        "type": "object",
        "description": "Notification payload for udld-intf-event",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the event occurred"
              },
              "Cisco-IOS-XE-udld-events:udld-intf-event": {
                "type": "object",
                "properties": {
                  "if-name": {
                    "type": "string"
                  },
                  "neighbor-id": {
                    "type": "string"
                  },
                  "port-blocked": {
                    "type": "boolean"
                  },
                  "neighbor-port": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "event-type": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "Cisco-IOS-XE-udld-events:udld-intf-event": {
              "if-name": "GigabitEthernet1",
              "neighbor-id": 12345,
              "port-blocked": true,
              "neighbor-port": "GigabitEthernet1/0/2",
              "state": "active",
              "event-type": "state-change"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "events",
      "description": "Model-driven telemetry event subscriptions"
    }
  ]
}
