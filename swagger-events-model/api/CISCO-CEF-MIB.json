{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-CEF-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-CEF-MIB for CEF forwarding inconsistency events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      },
      "description": "RESTCONF server"
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-CEF-MIB:cefResourceFailure": {
      "get": {
        "description": "Notification for cefResourceFailure event",
        "tags": [
          "Routing"
        ],
        "summary": "SNMP Trap: cefResourceFailure",
        "operationId": "get_cefResourceFailure",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cefResourceFailure notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cefResourceFailure"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-CEF-MIB:cefResourceFailure": {
                      "entPhysicalIndex": 1,
                      "cefResourceFailureReason": "configuration-applied"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-CEF-MIB:cefPeerStateChange": {
      "get": {
        "description": "Notification for cefPeerStateChange event",
        "tags": [
          "Routing"
        ],
        "summary": "SNMP Trap: cefPeerStateChange",
        "operationId": "get_cefPeerStateChange",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cefPeerStateChange notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cefPeerStateChange"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-CEF-MIB:cefPeerStateChange": {
                      "entPhysicalIndex": 1,
                      "entPeerPhysicalIndex": 1,
                      "cefPeerOperState": "active"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-CEF-MIB:cefPeerFIBStateChange": {
      "get": {
        "description": "Notification for cefPeerFIBStateChange event",
        "tags": [
          "Routing"
        ],
        "summary": "SNMP Trap: cefPeerFIBStateChange",
        "operationId": "get_cefPeerFIBStateChange",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cefPeerFIBStateChange notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cefPeerFIBStateChange"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-CEF-MIB:cefPeerFIBStateChange": {
                      "entPhysicalIndex": 1,
                      "entPeerPhysicalIndex": 1,
                      "cefFIBIpVersion": "17.18.1",
                      "cefPeerFIBOperState": "active"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-CEF-MIB:cefInconsistencyDetection": {
      "get": {
        "description": "Notification for cefInconsistencyDetection event",
        "tags": [
          "Routing"
        ],
        "summary": "SNMP Trap: cefInconsistencyDetection",
        "operationId": "get_cefInconsistencyDetection",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cefInconsistencyDetection notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cefInconsistencyDetection"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-CEF-MIB:cefInconsistencyDetection": {
                      "entLastInconsistencyDetectTime": 3600
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
      "SubscriptionId": {
        "description": "Subscription identifier",
        "name": "id",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      },
      "ReceiverName": {
        "description": "Receiver name",
        "name": "name",
        "in": "path",
        "schema": {
          "type": "string"
        },
        "required": true
      }
    },
    "responses": {
      "NotificationResponse": {
        "content": {
          "application/yang-data+json": {
            "schema": {
              "properties": {
                "notification": {
                  "type": "object",
                  "description": "Notification event data with timestamp and trap parameters"
                }
              },
              "type": "object"
            }
          }
        },
        "description": "SNMP Trap notification data"
      }
    },
    "schemas": {
      "cefResourceFailure": {
        "type": "object",
        "description": "SNMP trap notification payload for cefResourceFailure",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-CEF-MIB:cefResourceFailure": {
                "type": "object",
                "description": "Varbind objects for cefResourceFailure trap",
                "properties": {
                  "entPhysicalIndex": {
                    "type": "string"
                  },
                  "cefResourceFailureReason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-CEF-MIB:cefResourceFailure": {
              "entPhysicalIndex": 1,
              "cefResourceFailureReason": "configuration-applied"
            }
          }
        }
      },
      "cefPeerStateChange": {
        "type": "object",
        "description": "SNMP trap notification payload for cefPeerStateChange",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-CEF-MIB:cefPeerStateChange": {
                "type": "object",
                "description": "Varbind objects for cefPeerStateChange trap",
                "properties": {
                  "entPhysicalIndex": {
                    "type": "string"
                  },
                  "entPeerPhysicalIndex": {
                    "type": "string"
                  },
                  "cefPeerOperState": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-CEF-MIB:cefPeerStateChange": {
              "entPhysicalIndex": 1,
              "entPeerPhysicalIndex": 1,
              "cefPeerOperState": "active"
            }
          }
        }
      },
      "cefPeerFIBStateChange": {
        "type": "object",
        "description": "SNMP trap notification payload for cefPeerFIBStateChange",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-CEF-MIB:cefPeerFIBStateChange": {
                "type": "object",
                "description": "Varbind objects for cefPeerFIBStateChange trap",
                "properties": {
                  "entPhysicalIndex": {
                    "type": "string"
                  },
                  "entPeerPhysicalIndex": {
                    "type": "string"
                  },
                  "cefFIBIpVersion": {
                    "type": "string"
                  },
                  "cefPeerFIBOperState": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-CEF-MIB:cefPeerFIBStateChange": {
              "entPhysicalIndex": 1,
              "entPeerPhysicalIndex": 1,
              "cefFIBIpVersion": "17.18.1",
              "cefPeerFIBOperState": "active"
            }
          }
        }
      },
      "cefInconsistencyDetection": {
        "type": "object",
        "description": "SNMP trap notification payload for cefInconsistencyDetection",
        "properties": {
          "notification": {
            "type": "object",
            "properties": {
              "eventTime": {
                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-CEF-MIB:cefInconsistencyDetection": {
                "type": "object",
                "description": "Varbind objects for cefInconsistencyDetection trap",
                "properties": {
                  "entLastInconsistencyDetectTime": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
          "notification": {
            "eventTime": "2026-02-10T10:30:00Z",
            "CISCO-CEF-MIB:cefInconsistencyDetection": {
              "entLastInconsistencyDetectTime": 3600
            }
          }
        }
      }
    }
  }
}
