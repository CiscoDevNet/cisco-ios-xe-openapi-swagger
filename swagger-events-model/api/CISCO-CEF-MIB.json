                "properties": {
                  "entPhysicalIndex": {
                    "type": "string"
                  },
                  "entPeerPhysicalIndex": {
                    "type": "string"
                  },
                  "cefPeerOperState": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "example": {
