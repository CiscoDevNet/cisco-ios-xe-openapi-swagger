    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-SONET-MIB:ciscoSonetSectionStatusChange": {
      "get": {
        "description": "Notification for ciscoSonetSectionStatusChange event",
        "tags": [
          "Interface"
        ],
        "summary": "SNMP Trap: ciscoSonetSectionStatusChange",
        "operationId": "get_ciscoSonetSectionStatusChange",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "ciscoSonetSectionStatusChange notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/ciscoSonetSectionStatusChange"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-SONET-MIB:ciscoSonetSectionStatusChange": {
                      "ifIndex": 1,
                      "sonetSectionCurrentStatus": "up",
                      "ifDescr": "System component"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
