{
  "openapi": "3.0.1",
  "info": {
    "title": "ietf-ospf Event Notifications",
    "version": "17.18.1",
    "description": "This module contains IETF YANG definitions for OSPF event notifications.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [ietf-ospf.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/ietf-ospf.yang)\n\n**🌳 YANG Tree:** [View ietf-ospf structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/ietf-ospf.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/ws/event-streams/ietf-ospf/if-state-change": {
      "get": {
        "summary": "Subscribe to if-state-change events",
        "description": "OSPF interface state change notification",
        "tags": [
          "ospf-events"
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols - WebSocket connection established",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/if-state-change"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "ietf-ospf:if-state-change": {
                      "routing-instance": "default",
                      "routing-protocol-name": "ospf",
                      "instance-af": "ipv4-unicast",
                      "af": "ipv4-unicast",
                      "link-type": "point-to-point-link",
                      "interface": "GigabitEthernet1",
                      "virtual-link": "0.0.0.0-1.1.1.1",
                      "area-id": 12345,
                      "neighbor-router-id": "1.1.1.1",
                      "sham-link": "10.1.1.1",
                      "local-ip-addr": "10.1.1.1",
                      "remote-ip-addr": "10.1.1.1",
                      "state": "active"
                    }
                  }
                }
              }
            }
          }
        },
        "operationId": "get-if-state-change"
      }
    },
