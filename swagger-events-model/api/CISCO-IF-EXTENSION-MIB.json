                      "ifName": "router-01",
                      "ifType": "ethernetCsmacd",
                      "cieIfOperStatusCause": "down"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "scheme": "basic",
        "type": "http"
      }
    },
    "parameters": {
