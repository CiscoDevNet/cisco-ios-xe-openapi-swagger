                "type": "string",
                "format": "date-time",
                "description": "Timestamp when the trap was generated"
              },
              "CISCO-IF-EXTENSION-MIB:cieLinkDown": {
                "type": "object",
                "description": "Varbind objects for cieLinkDown trap",
                "properties": {
                  "ifIndex": {
                    "type": "string"
                  },
                  "ifAdminStatus": {
                    "type": "string"
                  },
