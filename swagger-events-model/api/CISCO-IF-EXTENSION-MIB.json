{
  "openapi": "3.0.0",
  "info": {
    "title": "CISCO-IF-EXTENSION-MIB SNMP Notifications",
    "description": "SNMP Trap notifications from CISCO-IF-EXTENSION-MIB for Interface extension events",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://{device}",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "security": [
    {
      "basicAuth": []
    }
  ],
  "paths": {
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-IF-EXTENSION-MIB:cieLinkDown": {
      "get": {
        "description": "Notification for cieLinkDown event",
        "tags": [
          "Interface"
        ],
        "summary": "SNMP Trap: cieLinkDown",
        "operationId": "get_cieLinkDown",
        "parameters": [
          {
            "$ref": "#/components/parameters/SubscriptionId"
          },
          {
            "$ref": "#/components/parameters/ReceiverName"
          }
        ],
        "responses": {
          "200": {
            "description": "cieLinkDown notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cieLinkDown"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-IF-EXTENSION-MIB:cieLinkDown": {
                      "ifIndex": 1,
                      "ifAdminStatus": "up",
                      "ifOperStatus": "down",
                      "ifName": "router-01",
                      "ifType": "ethernetCsmacd"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/data/ietf-subscribed-notifications:subscriptions/subscription={id}/receivers/receiver={name}/CISCO-IF-EXTENSION-MIB:cieLinkUp": {
      "get": {
