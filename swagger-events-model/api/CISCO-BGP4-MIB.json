          "200": {
            "description": "cbgpFsmStateChange notification data",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/cbgpFsmStateChange"
                },
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "CISCO-BGP4-MIB:cbgpFsmStateChange": {
                      "bgpPeerRemoteAddr": "10.0.0.2",
                      "bgpPeerLastError": "0x00 0x00",
                      "bgpPeerState": "active",
                      "CISCO-BGP4-MIB:cbgpPeerLastErrorTxt": "bgp4-mib:cbgppeerlasterrortxt",
