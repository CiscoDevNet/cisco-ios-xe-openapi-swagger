{
  "openapi": "3.0.0",
  "info": {
    "title": "Events - platform-oper",
    "version": "17.18.1",
    "description": "This module contains a collection of YANG definitions\n     for monitoring of platform components events.\n\n**Event Notifications Module** - Used for model-driven telemetry and streaming subscriptions.\n\n**Usage**: Subscribe to events via NETCONF/RESTCONF subscriptions\n\n**Protocol**: RFC 8639 (Subscription to YANG Notifications)\n\n**Authentication**: HTTP Basic Authentication\n\n**YANG Model:** [Events - platform-oper.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Events - platform-oper.yang)\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-platform-events-oper structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-platform-events-oper.html)"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/data/Cisco-IOS-XE-platform-events-oper:events": {
      "get": {
        "summary": "Get Cisco-IOS-XE-platform-events-oper event subscriptions",
        "description": "Retrieve active event subscriptions for Cisco-IOS-XE-platform-events-oper",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-platform-events-oper:platform-sensor-state-update": {
                      "severity": "major",
                      "comp-type": "chassis",
                      "sensor-type": "temperature",
                      "description": "Event notification description",
                      "location": "R0",
                      "id": 12345,
                      "sensor-val": "42.5",
                      "value-instant": 3.14,
                      "value-avg": 3.14,
                      "value-max": 3.14,
                      "value-min": 3.14,
                      "sampling-period-sec": 1000,
                      "alarm-data": "temperature-critical",
                      "alarm-status": "up",
                      "alarm-threshold-high": 1000,
                      "alarm-threshold-low": 1000,
                      "new-state": "active",
                      "time-stamp": "2026-02-10T10:30:00Z"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/platform-sensor-state-update"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "operationId": "get-events"
      }
    },
    "/operations/ietf-subscribed-notifications:establish-subscription": {
      "post": {
        "summary": "Create event subscription",
        "description": "Establish a subscription to Cisco-IOS-XE-platform-events-oper events",
        "tags": [
          "events"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "example": {
                "input": {
                  "stream": "Cisco-IOS-XE-platform-events-oper:events",
                  "encoding": "encode-json",
                  "update-trigger": "periodic",
                  "period": 6000
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription created",
            "content": {
              "application/yang-data+json": {
                "example": {
                  "notification": {
                    "eventTime": "2026-02-10T10:30:00Z",
                    "Cisco-IOS-XE-platform-events-oper:platform-sensor-state-update": {
                      "severity": "major",
                      "comp-type": "chassis",
                      "sensor-type": "temperature",
                      "description": "Event notification description",
                      "location": "R0",
                      "id": 12345,
                      "sensor-val": "42.5",
                      "value-instant": 3.14,
                      "value-avg": 3.14,
                      "value-max": 3.14,
                      "value-min": 3.14,
                      "sampling-period-sec": 1000,
                      "alarm-data": "temperature-critical",
                      "alarm-status": "up",
                      "alarm-threshold-high": 1000,
                      "alarm-threshold-low": 1000,
                      "new-state": "active",
                      "time-stamp": "2026-02-10T10:30:00Z"
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/platform-sensor-state-update"
                }
              }
            }
          }
        },
        "operationId": "post-establish-subscription"
      }
    }
  },
