          "default": "devnetsandboxiosxec9k.cisco.com"
        },
        "port": {
          "default": "443"
        }
      }
    }
  ],
  "paths": {
    "/operations/Cisco-IOS-XE-wireless-client-rpc:apf-ms-delete-all": {
      "post": {
        "summary": "Execute apf-ms-delete-all",
        "operationId": "post-Cisco-IOS-XE-wireless-client-rpc-apf-ms-delete-all",
        "tags": [
          "Cisco-IOS-XE-wireless-client-rpc"
        ],
        "responses": {
          "204": {
            "description": "Success (no output)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "zone-id": {
                    "type": "integer",
                    "example": 1
                  },
                  "(alternative-choice)": {
                    "type": "object",
                    "properties": {
                      "mac-addr": {
                        "type": "string",
                        "example": "configured-value"
                      },
                      "ip-addr": {
                        "type": "string",
                        "example": "configured-value"
                      },
                      "user-name": {
                        "type": "string",
                        "example": "admin"
                      }
                    },
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "Cisco-IOS-XE-wireless-client-rpc:input": {
                  "zone-id": 1,
                  "(alternative-choice)": {
                    "mac-addr": "configured-value",
                    "ip-addr": "configured-value",
                    "user-name": "admin"
                  }
                }
              }
            }
          }
        },
        "description": "Execute the **apf-ms-delete-all** RPC operation.\n\nSends a POST request to invoke this action on the device. The request body contains input parameters; the response contains any output values."
      }
    },
