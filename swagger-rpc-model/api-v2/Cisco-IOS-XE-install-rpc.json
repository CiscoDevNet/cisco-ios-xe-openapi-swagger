    "/operations/Cisco-IOS-XE-install-rpc:install": {
      "post": {
        "summary": "Execute install",
        "operationId": "post-Cisco-IOS-XE-install-rpc-install",
        "tags": [
          "Cisco-IOS-XE-install-rpc"
        ],
        "responses": {
          "204": {
            "description": "Success (no output)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "uuid": {
                    "type": "string",
                    "example": "1"
                  },
                  "one-shot": {
                    "type": "boolean",
                    "example": true
                  },
                  "reloadfast": {
                    "type": "boolean",
                    "example": true
                  },
                  "issu": {
                    "type": "boolean",
                    "example": true
                  },
                  "controller-mode-options": {
                    "type": "object",
                    "properties": {
                      "vpn": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295,
                        "example": 1
                      }
                    },
                    "example": "configured-value"
                  },
                  "download-timeout": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295,
                    "example": 1
                  },
                  "xfsu": {
                    "type": "boolean",
                    "example": true
                  },
                  "scheduled-start": {
                    "type": "string",
                    "example": "configured-value"
                  },
                  "scheduled-end": {
                    "type": "string",
                    "example": "configured-value"
                  },
                  "(install-type-by-choice)": {
                    "type": "object",
                    "properties": {
                      "path": {
                        "type": "string",
                        "example": "/data/example"
                      },
                      "name": {
                        "type": "string",
                        "example": "example-1",
                        "description": "Unique identifier name"
                      }
                    },
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "Cisco-IOS-XE-install-rpc:input": {
                  "uuid": "1",
                  "one-shot": true,
                  "reloadfast": true,
                  "issu": true,
                  "controller-mode-options": {
                    "vpn": 1
                  },
                  "download-timeout": 1,
                  "xfsu": true,
                  "scheduled-start": "configured-value",
                  "scheduled-end": "configured-value",
                  "(install-type-by-choice)": {
                    "path": "/data/example",
                    "name": "example-1"
                  }
                }
              }
            }
          }
        },
        "description": "Execute the **install** RPC operation.\n\nSends a POST request to invoke this action on the device. The request body contains input parameters; the response contains any output values."
      }
    },
