{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE RPC - Cisco-IOS-XE-geo-rpc",
    "description": "RPC operations from `Cisco-IOS-XE-geo-rpc` module.\n\n**RPCs:** 1 (geo-database)\n\nAll endpoints use POST on `/operations/`.",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/iosxe/"
    },
    "x-yang-module": "Cisco-IOS-XE-geo-rpc",
    "x-model-type": "rpc"
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        },
        "port": {
          "default": "443"
        }
      }
    }
  ],
  "paths": {
    "/operations/Cisco-IOS-XE-geo-rpc:geo-database": {
      "post": {
        "summary": "Execute geo-database",
        "operationId": "post-Cisco-IOS-XE-geo-rpc-geo-database",
        "tags": [
          "Cisco-IOS-XE-geo-rpc"
        ],
        "responses": {
          "204": {
            "description": "Success (no output)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "(geo-database-type-by-choice)": {
                    "type": "object",
                    "properties": {
                      "update-file": {
                        "type": "string",
                        "example": "2025-03-15"
                      },
                      "revert-default": {
                        "type": "boolean",
                        "example": true
                      }
                    },
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "Cisco-IOS-XE-geo-rpc:input": {
                  "(geo-database-type-by-choice)": {
                    "update-file": "2025-03-15",
                    "revert-default": true
                  }
                }
              }
            }
          }
        },
        "description": "Execute the **geo-database** RPC operation.\n\nSends a POST request to invoke this action on the device. The request body contains input parameters; the response contains any output values."
      }
    }
  },
  "components": {
