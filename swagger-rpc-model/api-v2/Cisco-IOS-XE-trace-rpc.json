          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "all": {
                    "type": "object",
                    "properties": {
                      "location": {
                        "type": "string",
                        "example": "San Jose, CA"
                      },
                      "file-name": {
                        "type": "string",
                        "example": "example-1"
                      }
                    },
                    "example": "configured-value"
