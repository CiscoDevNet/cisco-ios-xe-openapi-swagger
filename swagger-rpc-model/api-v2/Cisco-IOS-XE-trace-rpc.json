            "description": "Not found"
          },
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "unique-id": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4294967295,
                      "example": 1
                    }
                  },
                  "example": "configured-value"
                },
                "example": {
                  "Cisco-IOS-XE-trace-rpc:output": {
                    "unique-id": 1
                  }
                }
              }
            }
          }
