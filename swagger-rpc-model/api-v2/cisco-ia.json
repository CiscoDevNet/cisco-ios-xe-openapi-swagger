                    "type": "string",
                    "example": "https://10.1.1.1/restconf"
                  },
                  "verbose": {
                    "type": "boolean",
                    "example": true
                  },
                  "nolock": {
                    "type": "boolean",
                    "example": true
                  },
                  "revert-on-error": {
                    "type": "boolean",
                    "description": "Presence flag",
