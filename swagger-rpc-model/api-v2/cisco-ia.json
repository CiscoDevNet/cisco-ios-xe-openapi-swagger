{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE RPC - cisco-ia",
    "description": "RPC operations from `cisco-ia` module.\n\n**RPCs:** 8 (sync-from, save-config, netconf-session-id, current-time, is-syncing...)\n\nAll endpoints use POST on `/operations/`.",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/iosxe/"
    },
    "x-yang-module": "cisco-ia",
    "x-model-type": "rpc"
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        },
        "port": {
          "default": "443"
        }
      }
    }
  ],
  "paths": {
    "/operations/cisco-ia:sync-from": {
      "post": {
        "summary": "Execute sync-from",
        "operationId": "post-cisco-ia-sync-from",
        "tags": [
          "cisco-ia"
        ],
        "responses": {
          "204": {
            "description": "Success (no output)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          },
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string",
                      "example": "success"
                    }
                  },
                  "example": "configured-value"
                },
                "example": {
                  "cisco-ia:output": {
                    "result": "success"
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sync-defaults": {
                    "type": "boolean",
                    "description": "Presence flag",
                    "example": true
                  },
                  "ignore-presrv-paths": {
                    "type": "boolean",
                    "description": "Presence flag",
                    "example": true
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "cisco-ia:input": {
                  "sync-defaults": null,
                  "ignore-presrv-paths": null
                }
              }
            }
          }
        },
        "description": "Execute the **sync-from** RPC operation.\n\nSends a POST request to invoke this action on the device. The request body contains input parameters; the response contains any output values."
      }
    },
