    "/operations/cisco-ia:revert": {
      "post": {
        "summary": "Execute revert",
        "operationId": "post-cisco-ia-revert",
        "tags": [
          "cisco-ia"
        ],
        "responses": {
          "204": {
            "description": "Success (no output)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          },
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string",
                      "example": "success"
                    }
                  },
                  "example": "configured-value"
                },
                "example": {
                  "cisco-ia:output": {
                    "result": "success"
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "now": {
                    "type": "boolean",
                    "description": "Presence flag",
                    "example": true
                  },
                  "timer": {
                    "type": "integer",
                    "minimum": -32768,
                    "maximum": 32767,
                    "example": 1
                  },
                  "idle": {
                    "type": "integer",
                    "minimum": -32768,
                    "maximum": 32767,
                    "example": 1
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "cisco-ia:input": {
                  "now": null,
                  "timer": 1,
                  "idle": 1
                }
              }
            }
          }
        },
        "description": "Execute the **revert** RPC operation.\n\nSends a POST request to invoke this action on the device. The request body contains input parameters; the response contains any output values."
