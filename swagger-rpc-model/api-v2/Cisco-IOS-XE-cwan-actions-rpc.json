          "Cisco-IOS-XE-cwan-actions-rpc"
        ],
        "responses": {
          "204": {
            "description": "Success (no output)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          },
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "dm-tid": {
                      "type": "string",
                      "example": "1"
                    },
                    "status": {
                      "type": "string",
                      "example": "active",
                      "description": "Current status"
                    },
                    "file-path": {
                      "type": "string",
                      "example": "/data/example"
                    }
                  },
                  "example": "configured-value"
                },
                "example": {
                  "Cisco-IOS-XE-cwan-actions-rpc:output": {
                    "dm-tid": "1",
                    "status": "active",
                    "file-path": "/data/example"
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "dm-tid": {
                    "type": "string",
                    "example": "1"
                  },
                  "if-name": {
                    "type": "string",
                    "example": "GigabitEthernet1/0/1"
                  },
                  "radio-reset-enable": {
                    "type": "boolean",
                    "description": "Presence flag",
                    "example": true
                  },
                  "rotation": {
                    "type": "boolean",
                    "description": "Presence flag",
                    "example": true
                  },
                  "autostop-enable": {
                    "type": "boolean",
                    "example": true
                  },
                  "autostop-timer": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255,
                    "example": 1
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "Cisco-IOS-XE-cwan-actions-rpc:input": {
                  "dm-tid": "1",
                  "if-name": "GigabitEthernet1/0/1",
                  "radio-reset-enable": null,
                  "rotation": null,
                  "autostop-enable": true,
                  "autostop-timer": 1
                }
              }
            }
          }
        },
        "description": "Execute the **cwan-start-dmlog** RPC operation.\n\nSends a POST request to invoke this action on the device. The request body contains input parameters; the response contains any output values."
      }
