{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE RPC - ietf-routing",
    "description": "RPC operations from `ietf-routing` module.\n\n**RPCs:** 1 (fib-route)\n\nAll endpoints use POST on `/operations/`.",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/iosxe/"
    },
    "x-yang-module": "ietf-routing",
    "x-model-type": "rpc"
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        },
        "port": {
          "default": "443"
        }
      }
    }
  ],
  "paths": {
    "/operations/ietf-routing:fib-route": {
      "post": {
        "summary": "Execute fib-route",
        "operationId": "post-root",
        "tags": [
          "ietf-routing"
        ],
        "responses": {
          "204": {
            "description": "Success (no output)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          },
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "route": {
                      "type": "object",
                      "properties": {
                        "address-family": {
                          "type": "string",
                          "example": "ipv4-unicast"
                        },
                        "next-hop": {
                          "type": "object",
                          "properties": {
                            "(next-hop-options)": {
                              "type": "object",
                              "properties": {
                                "outgoing-interface": {
                                  "type": "string",
                                  "example": "configured-value"
                                },
                                "next-hop-address": {
                                  "type": "string",
                                  "example": "10.1.1.1"
                                },
                                "special-next-hop": {
                                  "type": "string",
                                  "example": "configured-value"
                                }
                              },
                              "example": "configured-value"
                            }
                          },
                          "example": "10.1.1.1",
                          "description": "Next-hop IP address for this route"
                        },
                        "source-protocol": {
                          "type": "string",
                          "example": "configured-value"
                        },
                        "active": {
                          "type": "boolean",
                          "description": "Presence flag",
                          "example": true
                        },
                        "last-updated": {
                          "type": "string",
                          "example": "2025-03-15T10:30:45Z"
                        }
                      },
                      "example": "configured-value"
                    }
                  },
                  "example": "configured-value"
                },
                "example": {
                  "ietf-routing:output": {
                    "route": {
                      "address-family": "ipv4-unicast",
                      "next-hop": {
                        "(next-hop-options)": {
                          "outgoing-interface": "configured-value",
                          "next-hop-address": "10.1.1.1",
                          "special-next-hop": "default"
                        }
                      },
                      "source-protocol": "configured-value",
                      "active": true,
                      "last-updated": "2025-03-15T10:30:45Z"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "routing-instance-name": {
                    "type": "string",
                    "example": "example-1"
                  },
                  "destination-address": {
                    "type": "object",
                    "properties": {
                      "address-family": {
                        "type": "string",
                        "example": "ipv4-unicast"
                      }
                    },
                    "example": "10.1.1.1"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "ietf-routing:input": {
                  "routing-instance-name": "example-1",
                  "destination-address": {
                    "address-family": "ipv4-unicast"
                  }
                }
              }
            }
          }
        },
        "description": "Execute the **fib-route** RPC operation.\n\nSends a POST request to invoke this action on the device. The request body contains input parameters; the response contains any output values."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "RESTCONF basic authentication (RFC 8040)"
      }
    },
    "parameters": {
      "content-type": {
        "name": "Content-Type",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "default": "application/yang-data+json"
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ]
}
