{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE RPC - ietf-routing",
    "description": "RPC operations from `ietf-routing` module.\n\n**RPCs:** 1 (fib-route)\n\nAll endpoints use POST on `/operations/`.",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/iosxe/"
    },
    "x-yang-module": "ietf-routing",
    "x-model-type": "rpc"
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        },
        "port": {
          "default": "443"
        }
      }
    }
  ],
  "paths": {
    "/operations/ietf-routing:fib-route": {
      "post": {
        "summary": "Execute fib-route",
        "operationId": "post-root",
        "tags": [
          "ietf-routing"
        ],
        "responses": {
          "204": {
            "description": "Success (no output)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          },
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ietf-routing:output": {
                      "type": "object",
                      "properties": {
                        "route": {
                          "type": "object",
                          "properties": {
                            "address-family": {
                              "type": "string"
                            },
                            "next-hop": {
                              "type": "object",
                              "properties": {
                                "(next-hop-options)": {
                                  "type": "object",
                                  "properties": {
                                    "outgoing-interface": {
                                      "type": "string"
                                    },
                                    "next-hop-address": {
                                      "type": "string"
                                    },
                                    "special-next-hop": {
                                      "type": "string"
                                    }
                                  }
                                }
                              }
                            },
                            "source-protocol": {
                              "type": "string"
                            },
                            "active": {
                              "type": "boolean",
                              "description": "Presence flag"
                            },
                            "last-updated": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "example": {
                  "ietf-routing:output": {
                    "route": {
                      "address-family": "example",
                      "next-hop": {
                        "(next-hop-options)": {
                          "outgoing-interface": "example",
                          "next-hop-address": "example",
                          "special-next-hop": "blackhole"
                        }
                      },
                      "source-protocol": "example",
                      "active": null,
                      "last-updated": "example"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ietf-routing:input": {
                    "type": "object",
                    "properties": {
                      "routing-instance-name": {
                        "type": "string"
                      },
                      "destination-address": {
                        "type": "object",
                        "properties": {
                          "address-family": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "ietf-routing:input": {
                  "routing-instance-name": "example",
                  "destination-address": {
                    "address-family": "example"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "RESTCONF basic authentication (RFC 8040)"
      }
    },
    "parameters": {
      "content-type": {
        "name": "Content-Type",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "default": "application/yang-data+json"
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ]
}
