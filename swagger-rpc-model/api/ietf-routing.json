{
  "openapi": "3.0.0",
  "info": {
    "title": "ietf-routing RPCs",
    "description": "Routing Management (RFC 8349) - FIB route lookup operations",
    "version": "2018-03-13",
    "x-yang-module": "ietf-routing",
    "x-model-type": "rpc"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        }
      }
    }
  ],
  "paths": {
    "/operations/ietf-routing:fib-route": {
      "post": {
        "tags": [
          "Routing FIB"
        ],
        "summary": "Perform FIB route lookup",
        "description": "Lookup a route in the Forwarding Information Base (FIB) for a given destination address",
        "operationId": "fibRoute",
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "object",
                    "properties": {
                      "routing-instance-name": {
                        "type": "string",
                        "description": "Name of the routing instance"
                      },
                      "destination-address": {
                        "type": "object",
                        "properties": {
                          "address-family": {
                            "type": "string",
                            "description": "Address family identifier (ipv4, ipv6, etc.)"
                          }
                        },
                        "required": [
                          "address-family"
                        ]
                      }
                    },
                    "required": [
                      "routing-instance-name",
                      "destination-address"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "FIB route lookup successful",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "output": {
                      "type": "object",
                      "properties": {
                        "route": {
                          "type": "object",
                          "properties": {
                            "address-family": {
                              "type": "string",
                              "description": "Address family"
                            },
                            "next-hop": {
                              "type": "object",
                              "properties": {
                                "outgoing-interface": {
                                  "type": "string",
                                  "description": "Outgoing interface"
                                },
                                "next-hop-address": {
                                  "type": "string",
                                  "description": "Next-hop IP address"
                                },
                                "special-next-hop": {
                                  "type": "string",
                                  "enum": [
                                    "blackhole",
                                    "unreachable",
                                    "prohibit",
                                    "receive"
                                  ],
                                  "description": "Special next-hop type"
                                }
                              }
                            },
                            "source-protocol": {
                              "type": "string",
                              "description": "Source protocol that installed the route"
                            },
                            "active": {
                              "type": "boolean",
                              "description": "Whether the route is active"
                            },
                            "last-updated": {
                              "type": "string",
                              "format": "date-time",
                              "description": "When the route was last updated"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": false,
            "description": "RESTCONF request body media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          }
        ]
      },
      "x-yang-path": "/fib-route",
      "x-restconf-kind": "rpc"
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "restconf-error": {
        "type": "object",
        "description": "Standard RESTCONF error response (RFC 8040 Section 7.1)",
        "properties": {
          "ietf-restconf:errors": {
            "type": "object",
            "properties": {
              "error": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "error-type": {
                      "type": "string",
                      "enum": [
                        "transport",
                        "rpc",
                        "protocol",
                        "application"
                      ],
                      "description": "Layer where the error occurred"
                    },
                    "error-tag": {
                      "type": "string",
                      "description": "Enumerated error tag (e.g. invalid-value, data-missing, access-denied)"
                    },
                    "error-severity": {
                      "type": "string",
                      "enum": [
                        "error",
                        "warning"
                      ],
                      "description": "Error severity"
                    },
                    "error-app-tag": {
                      "type": "string",
                      "description": "Application-specific error tag"
                    },
                    "error-path": {
                      "type": "string",
                      "description": "YANG instance-identifier of the error node"
                    },
                    "error-message": {
                      "type": "string",
                      "description": "Human-readable error description"
                    }
                  },
                  "required": [
                    "error-type",
                    "error-tag"
                  ]
                }
              }
            }
          }
        },
        "example": {
          "ietf-restconf:errors": {
            "error": [
              {
                "error-type": "protocol",
                "error-tag": "invalid-value",
                "error-severity": "error",
                "error-message": "Invalid input parameter"
              }
            ]
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "Routing FIB",
      "description": "RPC operations for Routing FIB"
    }
  ],
  "externalDocs": {
    "description": "Cisco IOS-XE YANG RPC Operations - Cisco DevNet",
    "url": "https://developer.cisco.com/iosxe/"
  }
}
