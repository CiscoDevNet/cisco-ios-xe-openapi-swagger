  "paths": {
    "/operations/ietf-netconf:get-config": {
      "post": {
        "tags": [
          "NETCONF Core"
        ],
        "summary": "Retrieve all or part of a specified configuration datastore",
        "description": "Retrieve configuration from candidate, running, or startup datastore with optional filtering",
        "operationId": "getConfig",
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "object",
                        "properties": {
                          "candidate": {
                            "type": "string",
                            "description": "Candidate configuration datastore",
                            "nullable": true
                          },
                          "running": {
                            "type": "string",
                            "description": "Running configuration datastore",
                            "nullable": true
                          },
                          "startup": {
                            "type": "string",
                            "description": "Startup configuration datastore",
                            "nullable": true
                          }
                        }
                      },
                      "filter": {
                        "type": "object",
                        "description": "Subtree or XPath filter"
                      }
                    },
                    "required": [
                      "source"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Configuration data retrieved successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "output": {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "object",
                          "description": "Configuration data"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": false,
            "description": "RESTCONF request body media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          }
        ]
      },
      "x-yang-path": "/get-config",
      "x-restconf-kind": "rpc"
    },
    "/operations/ietf-netconf:edit-config": {
      "post": {
        "tags": [
          "NETCONF Core"
        ],
        "summary": "Edit a configuration datastore",
        "description": "Load all or part of a specified configuration to the specified target datastore",
        "operationId": "editConfig",
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "object",
                    "properties": {
                      "target": {
                        "type": "object",
                        "properties": {
                          "candidate": {
                            "type": "string",
                            "nullable": true,
                            "description": "YANG empty leaf (presence-only)"
                          },
                          "running": {
                            "type": "string",
                            "nullable": true,
                            "description": "YANG empty leaf (presence-only)"
                          }
                        }
                      },
                      "default-operation": {
                        "type": "string",
                        "enum": [
                          "merge",
                          "replace",
                          "none"
                        ]
                      },
                      "test-option": {
                        "type": "string",
                        "enum": [
                          "test-then-set",
                          "set",
                          "test-only"
                        ]
                      },
                      "error-option": {
                        "type": "string",
                        "enum": [
                          "stop-on-error",
                          "continue-on-error",
                          "rollback-on-error"
                        ]
                      },
                      "config": {
                        "type": "object",
                        "description": "Configuration data"
                      }
                    },
                    "required": [
                      "target"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Configuration edited successfully"
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
