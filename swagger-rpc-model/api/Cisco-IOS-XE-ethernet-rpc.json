            "description": "Success (no output)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "Cisco-IOS-XE-ethernet-rpc:input": {
                    "type": "object",
                    "properties": {
                      "action": {
                        "type": "string",
                        "example": "configured-value"
                      },
                      "interface": {
                        "type": "string",
                        "example": "GigabitEthernet1/0/1",
                        "description": "Interface name (e.g., GigabitEthernet1/0/1)"
                      }
                    },
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "Cisco-IOS-XE-ethernet-rpc:input": {
                  "action": "configured-value",
