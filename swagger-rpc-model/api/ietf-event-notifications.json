{
  "openapi": "3.0.0",
  "info": {
    "title": "ietf-event-notifications RPCs",
    "description": "YANG Push Event Subscription Management (RFC 8639) - Dynamic subscription lifecycle management for YANG-based event streams\n\n**YANG Model:** [ietf-event-notifications RPCs.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/ietf-event-notifications RPCs.yang)",
    "version": "2019-09-09",
    "x-yang-module": "ietf-event-notifications",
    "x-model-type": "rpc"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com",
          "description": "Device IP or hostname"
        }
      }
    }
  ],
  "paths": {
    "/operations/ietf-event-notifications:establish-subscription": {
      "post": {
        "tags": [
          "YANG Push Subscriptions"
        ],
        "summary": "Establish a dynamic event subscription",
        "description": "Create a dynamic subscription to YANG data events with filtering and update policies",
        "operationId": "establishSubscription",
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "object",
                    "properties": {
                      "stream": {
                        "type": "string",
                        "description": "Event stream name (e.g., NETCONF, yang-push)"
                      },
                      "encoding": {
                        "type": "string",
                        "enum": [
                          "encode-xml",
                          "encode-json"
                        ],
                        "description": "Encoding format for notifications"
                      },
                      "filter": {
                        "type": "object",
                        "description": "Subtree or XPath filter"
                      },
                      "stop-time": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Optional end time for subscription"
                      }
                    },
                    "required": [
                      "stream"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Subscription established",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "output": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "integer",
                          "description": "Subscription identifier"
                        },
                        "replay-start-time": {
                          "type": "string",
                          "format": "date-time",
                          "description": "Start time for event replay"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Forbidden \u2014 insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": false,
            "description": "RESTCONF request body media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          }
        ]
      },
      "x-yang-path": "/establish-subscription",
      "x-restconf-kind": "rpc"
    },
    "/operations/ietf-event-notifications:create-subscription": {
      "post": {
        "tags": [
          "YANG Push Subscriptions"
        ],
        "summary": "Create a subscription (legacy NETCONF)",
        "description": "Legacy NETCONF notification subscription (RFC 5277 compatibility)",
        "operationId": "createSubscription",
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "input": {
                    "type": "object",
                    "properties": {
                      "stream": {
                        "type": "string",
                        "description": "Event stream name"
                      },
                      "filter": {
                        "type": "object",
                        "description": "Event filter"
                      },
                      "startTime": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Replay start time"
                      },
                      "stopTime": {
                        "type": "string",
                        "format": "date-time",
                        "description": "Subscription end time"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Subscription created successfully"
          },
