{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE RPC - Cisco-IOS-XE-switch-rpc",
    "description": "RPC operations from `Cisco-IOS-XE-switch-rpc` module.\n\n**RPCs:** 1 (switch)\n\nAll endpoints use POST on `/operations/`.",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/iosxe/"
    },
    "x-yang-module": "Cisco-IOS-XE-switch-rpc",
    "x-model-type": "rpc"
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        },
        "port": {
          "default": "443"
        }
      }
    }
  ],
  "paths": {
    "/operations/Cisco-IOS-XE-switch-rpc:switch": {
      "post": {
        "summary": "Execute switch",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-switch-rpc"
        ],
        "responses": {
          "204": {
            "description": "Success (no output)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          },
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Cisco-IOS-XE-switch-rpc:output": {
                      "type": "object",
                      "properties": {
                        "result": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "example": {
                  "Cisco-IOS-XE-switch-rpc:output": {
                    "result": "example"
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "Cisco-IOS-XE-switch-rpc:input": {
                    "type": "object",
                    "properties": {
                      "switch-number-drop-node-name": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      "(pri-renum-stack)": {
                        "type": "object",
                        "properties": {
                          "priority": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                          },
                          "renumber": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255
                          },
                          "statck": {
                            "type": "object"
                          },
                          "stack": {
                            "type": "object",
                            "properties": {
                              "port": {
                                "type": "object",
                                "properties": {
                                  "port-number-drop-node-name": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 255
                                  },
                                  "enable": {
                                    "type": "boolean",
                                    "description": "Presence flag"
                                  },
                                  "disable": {
                                    "type": "boolean",
                                    "description": "Presence flag"
                                  }
                                }
                              }
                            }
                          },
                          "role": {
                            "type": "object",
                            "properties": {
                              "active": {
                                "type": "boolean",
                                "description": "Presence flag"
                              },
                              "standby": {
                                "type": "boolean",
                                "description": "Presence flag"
                              }
                            }
                          }
                        }
                      },
                      "clear": {
                        "type": "object",
                        "properties": {
                          "stack-mode": {
                            "type": "boolean",
                            "description": "Presence flag"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "Cisco-IOS-XE-switch-rpc:input": {
                  "switch-number-drop-node-name": 1,
                  "(pri-renum-stack)": {
                    "priority": 1,
                    "renumber": 1,
                    "statck": {},
                    "stack": {
                      "port": {
                        "port-number-drop-node-name": 1,
                        "enable": null,
                        "disable": null
                      }
                    },
                    "role": {
                      "active": null,
                      "standby": null
                    }
                  },
                  "clear": {
                    "stack-mode": null
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "RESTCONF basic authentication (RFC 8040)"
      }
    },
    "parameters": {
      "content-type": {
        "name": "Content-Type",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string",
          "default": "application/yang-data+json"
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ]
}
