{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE RPC - Cisco-IOS-XE-switch-rpc",
    "description": "RPC operations from `Cisco-IOS-XE-switch-rpc` module.\n\n**RPCs:** 1 (switch)\n\nAll endpoints use POST on `/operations/`.\n\n**YANG Model:** [Cisco IOS-XE RPC - Cisco-IOS-XE-switch-rpc.yang](https://github.com/YangModels/yang/blob/main/vendor/cisco/xe/17181/Cisco IOS-XE RPC - Cisco-IOS-XE-switch-rpc.yang)",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/iosxe/"
    },
    "x-yang-module": "Cisco-IOS-XE-switch-rpc",
    "x-model-type": "rpc"
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        },
        "port": {
          "default": "443"
        }
      }
    }
  ],
  "paths": {
    "/operations/Cisco-IOS-XE-switch-rpc:switch": {
      "post": {
        "summary": "Execute switch",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-switch-rpc"
        ],
        "responses": {
          "204": {
            "description": "Success (no output)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          },
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Cisco-IOS-XE-switch-rpc:output": {
                      "type": "object",
                      "properties": {
                        "result": {
                          "type": "string",
                          "example": "success"
                        }
                      },
                      "example": "configured-value"
                    }
                  },
                  "example": "configured-value"
                },
                "example": {
                  "Cisco-IOS-XE-switch-rpc:output": {
                    "result": "success"
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "Cisco-IOS-XE-switch-rpc:input": {
                    "type": "object",
                    "properties": {
                      "switch-number-drop-node-name": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255,
                        "example": 0
                      },
                      "(pri-renum-stack)": {
                        "type": "object",
                        "properties": {
                          "priority": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255,
                            "example": 100,
                            "description": "Priority value (higher = preferred)"
                          },
                          "renumber": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255,
                            "example": 10
                          },
                          "statck": {
                            "type": "object",
                            "example": "configured-value"
                          },
                          "stack": {
                            "type": "object",
                            "properties": {
                              "port": {
                                "type": "object",
                                "properties": {
                                  "port-number-drop-node-name": {
                                    "type": "integer",
                                    "minimum": 0,
                                    "maximum": 255,
                                    "example": 0
                                  },
                                  "enable": {
                                    "type": "boolean",
                                    "description": "Presence flag",
                                    "example": true
                                  },
                                  "disable": {
                                    "type": "boolean",
                                    "description": "Presence flag",
                                    "example": false
                                  }
                                },
                                "example": 443
                              }
                            },
                            "example": "configured-value"
                          },
                          "role": {
                            "type": "object",
                            "properties": {
                              "active": {
                                "type": "boolean",
                                "description": "Presence flag",
                                "example": true
                              },
                              "standby": {
                                "type": "boolean",
                                "description": "Presence flag",
                                "example": true
                              }
                            },
                            "example": 15
                          }
                        },
                        "example": 10
                      },
                      "clear": {
                        "type": "object",
                        "properties": {
                          "stack-mode": {
                            "type": "boolean",
                            "description": "Presence flag",
                            "example": true
                          }
                        },
                        "example": "configured-value"
                      }
                    },
                    "example": "configured-value"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "Cisco-IOS-XE-switch-rpc:input": {
                  "switch-number-drop-node-name": 0,
                  "(pri-renum-stack)": {
                    "priority": 100,
                    "renumber": 10,
                    "statck": [
                      null
                    ],
                    "stack": {
                      "port": {
                        "port-number-drop-node-name": 0,
                        "enable": true,
                        "disable": false
                      }
                    },
                    "role": {
                      "active": true,
                      "standby": {
                        "standby-list": [
                          {
                            "group-number": 10,
                            "ip": {
                              "address": "10.1.1.254"
                            }
                          }
                        ]
                      }
                    }
                  },
                  "clear": {
                    "stack-mode": [
                      null
                    ]
                  }
                }
              }
            }
          }
        },
        "description": "Execute the **switch** RPC operation.\n\nSends a POST request to invoke this action on the device. The request body contains input parameters; the response contains any output values."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
