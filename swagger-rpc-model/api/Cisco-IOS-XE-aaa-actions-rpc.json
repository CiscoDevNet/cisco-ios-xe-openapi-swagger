  "info": {
    "title": "Cisco-IOS-XE-aaa-actions-rpc - RPC Operations",
    "description": "This module contains a collection of YANG definitions\n     for AAA RPC action data.\n     Copyright (c) 2021-2022 by Cisco Systems, Inc.\n     All rights reserved.\n\n**Module:** `Cisco-IOS-XE-aaa-actions-rpc`\n**Version:** 2022-11-01\n**Operations:** 1\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-aaa-actions-rpc structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-aaa-actions-rpc.html)",
    "version": "2022-11-01"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/aaa_actions_rpc:test-aaa-command": {
      "post": {
        "summary": "To test particular user credentials for a particular server group.\n       The device sends a test authentication packet to the servers under\n       the server group. The rpc returns with a 'id' if the operation\n       was started successfully. Subscribe to the stream:test-aaa-authentication-update\n       to receive the final authentication result.",
        "description": "To test particular user credentials for a particular server group.\n       The device sends a test authentication packet to the servers under\n       the server group. The rpc returns with a 'id' if the operation\n       was started successfully. Subscribe to the stream:test-aaa-authentication-update\n       to receive the final authentication result.\n\n**Endpoint:** `POST /restconf/operations/aaa_actions_rpc:test-aaa-command`",
        "operationId": "test-aaa-command",
        "tags": [
          "Cisco-IOS-XE-aaa-actions-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "aaa_actions_rpc:test-aaa-command": {
                    "type": "object",
                    "properties": {
                      "group-name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "description": "Server group name"
                      },
                      "username": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "description": "Username to be tested"
                      },
                      "password": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "description": "Password to be tested"
                      },
                      "mode": {
                        "type": "string",
                        "description": "Mode type to be used for testing"
                      }
                    },
                    "required": [
                      "group-name",
                      "username",
                      "password",
                      "mode"
                    ]
                  }
                }
              },
              "example": {
                "aaa_actions_rpc:test-aaa-command": {
                  "group-name": "example-string",
                  "username": "admin",
                  "password": "Cisco123!",
                  "mode": "example-string"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "The ID is unique identifier generated per request. This is used\n         in combination with event model, where event notification provides\n         request specific ID in it. This is useful in matching a request\n         with event notification."
                    }
                  }
                },
                "example": {
                  "id": "example-string"
                }
              }
            }
          },
          "400": {
            "description": "Bad request — invalid input or constraint violation",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — authentication required (HTTP Basic)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": false,
            "description": "RESTCONF request body media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          }
        ]
      }
    }
  },
