{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco IOS-XE RPC - Cisco-IOS-XE-ucse-rpc",
    "description": "RPC operations from `Cisco-IOS-XE-ucse-rpc` module.\n\n**RPCs:** 1 (ucse)\n\nAll endpoints use POST on `/operations/`.",
    "version": "17.18.1",
    "contact": {
      "name": "Cisco IOS-XE RESTCONF API",
      "url": "https://developer.cisco.com/iosxe/"
    },
    "x-yang-module": "Cisco-IOS-XE-ucse-rpc",
    "x-model-type": "rpc"
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        },
        "port": {
          "default": "443"
        }
      }
    }
  ],
  "paths": {
    "/operations/Cisco-IOS-XE-ucse-rpc:ucse": {
      "post": {
        "summary": "Execute ucse",
        "operationId": "post-Cisco-IOS-XE-ucse-rpc-ucse",
        "tags": [
          "Cisco-IOS-XE-ucse-rpc"
        ],
        "responses": {
          "204": {
            "description": "Success (no output)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          },
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "Cisco-IOS-XE-ucse-rpc:output": {
                    "result": "example"
                  }
                }
              }
            }
          }
        },
        "requestBody": {
