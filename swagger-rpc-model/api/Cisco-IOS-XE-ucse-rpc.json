                    "type": "object",
                    "properties": {
                      "imc": {
                        "type": "object",
                        "properties": {
                          "password-reset": {
                            "type": "boolean",
                            "description": "Presence flag"
                          }
                        }
                      },
                      "server": {
                        "type": "object",
                        "properties": {
                          "(server-command-choice)": {
                            "type": "object",
                            "properties": {
                              "cmos-reset": {
                                "type": "boolean",
                                "description": "Presence flag"
                              },
                              "password-reset": {
                                "type": "object",
                                "properties": {
                                  "BIOS": {
                                    "type": "object"
                                  }
                                }
                              },
                              "reload": {
                                "type": "boolean",
                                "description": "Presence flag"
                              },
                              "reset": {
                                "type": "boolean",
                                "description": "Presence flag"
                              },
                              "start": {
                                "type": "boolean",
                                "description": "Presence flag"
                              },
                              "stop": {
                                "type": "boolean",
                                "description": "Presence flag"
                              }
                            }
                          }
                        }
                      },
                      "shutdown": {
                        "type": "boolean",
                        "description": "Presence flag"
                      },
                      "statistics": {
                        "type": "object",
                        "properties": {
                          "clear": {
                            "type": "boolean",
                            "description": "Presence flag"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "Cisco-IOS-XE-ucse-rpc:input": {
                  "subslot": "example",
                  "(command-choice)": {
                    "imc": {
                      "password-reset": null
                    },
                    "server": {
                      "(server-command-choice)": {
                        "cmos-reset": null,
                        "password-reset": {},
                        "reload": true,
                        "reset": null,
                        "start": null,
                        "stop": null
                      }
                    },
                    "shutdown": null,
                    "statistics": {
                      "clear": null
                    }
                  }
                }
              }
            }
          }
        }
