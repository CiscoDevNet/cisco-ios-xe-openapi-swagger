{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco-IOS-XE-ucse-rpc - RPC Operations",
    "description": "NED UCSE (Unified Computing System E-Series) RPC YANG module for IOS\n     Copyright (c) 2019 by Cisco Systems, Inc.\n     All rights reserved.\n\n**Module:** `Cisco-IOS-XE-ucse-rpc`\n**Version:** 2022-11-01\n**Operations:** 1\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-ucse-rpc structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-ucse-rpc.html)",
    "version": "2022-11-01",
    "x-yang-module": "ucse-rpc",
    "x-model-type": "rpc"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/ucse_rpc:ucse": {
      "post": {
        "summary": "UCSE (Unified Computing System E-Series) commands",
        "description": "UCSE (Unified Computing System E-Series) commands\n\n**Endpoint:** `POST /restconf/operations/ucse_rpc:ucse`",
        "operationId": "ucse",
        "tags": [
          "Cisco-IOS-XE-ucse-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "ucse_rpc:ucse": {
                    "type": "object",
                    "properties": {
                      "subslot": {
                        "type": "string",
                        "pattern": "[0-2]/[0-3]",
                        "description": "UCSE (Unified Computing System E-Series) subslot"
                      },
                      "password-reset": {
                        "type": "object",
                        "properties": {
                          "BIOS": {
                            "type": "string",
                            "description": "Reset the BIOS password for the server"
                          }
                        },
                        "description": "Reset the password for the server"
                      },
                      "cmos-reset": {
                        "type": "string",
                        "description": "Reset the CMOS password for the server"
                      },
                      "BIOS": {
                        "type": "string",
                        "description": "Reset the BIOS password for the server"
                      },
                      "reload": {
                        "type": "string",
                        "description": "Reload the server"
                      },
                      "reset": {
                        "type": "string",
                        "description": "Reset the server"
                      },
                      "start": {
                        "type": "string",
                        "description": "Start the server"
                      },
                      "stop": {
                        "type": "string",
                        "description": "Stop the server"
                      },
                      "shutdown": {
                        "type": "string",
                        "description": "Shutdown the UCSE (Unified Computing System E-Series) module"
                      },
                      "clear": {
                        "type": "string",
                        "description": "Clear the statistics"
                      },
                      "imc": {
                        "type": "object",
                        "properties": {
                          "password-reset": {
                            "type": "string",
                            "description": "Reset the password for IMC (Integrated Management Controller)"
                          }
                        },
                        "description": "IMC (Integrated Management Controller) command"
                      },
                      "server": {
                        "type": "object",
                        "properties": {
                          "cmos-reset": {
                            "type": "string",
                            "description": "Reset the CMOS password for the server"
                          },
                          "BIOS": {
                            "type": "string",
                            "description": "Reset the BIOS password for the server"
                          },
                          "reload": {
                            "type": "string",
                            "description": "Reload the server"
                          },
                          "reset": {
                            "type": "string",
                            "description": "Reset the server"
                          },
                          "start": {
                            "type": "string",
                            "description": "Start the server"
                          },
                          "stop": {
                            "type": "string",
                            "description": "Stop the server"
                          },
                          "password-reset": {
                            "type": "object",
                            "properties": {
                              "BIOS": {
                                "type": "string",
                                "description": "Reset the BIOS password for the server"
                              }
                            },
                            "description": "Reset the password for the server"
                          }
                        },
                        "description": "Server commands"
                      },
                      "statistics": {
                        "type": "object",
                        "properties": {
                          "clear": {
                            "type": "string",
                            "description": "Clear the statistics"
                          }
                        },
                        "description": "Statistics command"
                      }
                    },
                    "required": [
                      "subslot"
                    ]
                  }
                }
              },
              "example": {
                "ucse_rpc:ucse": {
                  "subslot": "example-string",
                  "password-reset": {
                    "BIOS": "example-string"
                  },
                  "cmos-reset": "example-string",
                  "BIOS": "example-string",
                  "reload": "example-string",
                  "reset": "example-string",
                  "start": "example-string",
                  "stop": "example-string",
                  "shutdown": "example-string",
                  "clear": "example-string",
                  "imc": {
                    "password-reset": "Cisco123!"
                  },
                  "server": {
                    "cmos-reset": "example-string",
                    "BIOS": "example-string",
                    "reload": "example-string",
                    "reset": "example-string",
                    "start": "example-string",
                    "stop": "example-string",
                    "password-reset": {
                      "BIOS": "example-string"
                    }
                  },
                  "statistics": {
                    "clear": "example-string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object"
                },
                "example": {}
              }
            }
          },
          "400": {
            "description": "Bad request — invalid input or constraint violation",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — authentication required (HTTP Basic)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": false,
            "description": "RESTCONF request body media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          }
        ]
      },
      "x-yang-path": "/ucse",
      "x-restconf-kind": "rpc"
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "restconf-error": {
        "type": "object",
        "description": "Standard RESTCONF error response (RFC 8040 Section 7.1)",
        "properties": {
          "ietf-restconf:errors": {
            "type": "object",
            "properties": {
              "error": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "error-type": {
                      "type": "string",
                      "enum": [
                        "transport",
                        "rpc",
                        "protocol",
                        "application"
                      ],
                      "description": "Layer where the error occurred"
                    },
                    "error-tag": {
                      "type": "string",
                      "description": "Enumerated error tag (e.g. invalid-value, data-missing, access-denied)"
                    },
                    "error-severity": {
                      "type": "string",
                      "enum": [
                        "error",
                        "warning"
                      ],
                      "description": "Error severity"
                    },
                    "error-app-tag": {
                      "type": "string",
                      "description": "Application-specific error tag"
                    },
                    "error-path": {
                      "type": "string",
                      "description": "YANG instance-identifier of the error node"
                    },
                    "error-message": {
                      "type": "string",
                      "description": "Human-readable error description"
                    }
                  },
                  "required": [
                    "error-type",
                    "error-tag"
                  ]
                }
              }
            }
          }
        },
        "example": {
          "ietf-restconf:errors": {
            "error": [
              {
                "error-type": "protocol",
                "error-tag": "invalid-value",
                "error-severity": "error",
                "error-message": "Invalid input parameter"
              }
            ]
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
    {
      "name": "Cisco-IOS-XE-ucse-rpc",
      "description": "RPC operations for Cisco-IOS-XE-ucse-rpc"
    }
  ],
