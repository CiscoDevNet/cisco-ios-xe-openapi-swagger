      "url": "https://developer.cisco.com/iosxe/"
    },
    "x-yang-module": "Cisco-IOS-XE-stack-power-rpc",
    "x-model-type": "rpc"
  },
  "servers": [
    {
      "url": "https://{device}:{port}/restconf",
      "description": "IOS-XE Device RESTCONF API",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        },
        "port": {
          "default": "443"
        }
      }
    }
  ],
  "paths": {
    "/operations/Cisco-IOS-XE-stack-power-rpc:set-stkpwr-port-state": {
      "post": {
        "summary": "Execute set-stkpwr-port-state",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-stack-power-rpc"
        ],
        "responses": {
          "204": {
            "description": "Success (no output)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "Cisco-IOS-XE-stack-power-rpc:input": {
                    "type": "object",
                    "properties": {
                      "switch-number": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255,
                        "example": 10
                      },
                      "port-number": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255,
                        "example": 443
                      },
                      "stkpwr-state": {
                        "type": "string",
                        "example": "active"
                      }
                    },
                    "example": "configured-value"
                  }
                },
                "example": "active"
              },
              "example": {
                "Cisco-IOS-XE-stack-power-rpc:input": {
                  "switch-number": 10,
                  "port-number": 443,
                  "stkpwr-state": "disable"
                }
              }
            }
          }
        },
        "description": "Execute the **set-stkpwr-port-state** RPC operation.\n\nSends a POST request to invoke this action on the device. The request body contains input parameters; the response contains any output values."
      }
    }
  },
