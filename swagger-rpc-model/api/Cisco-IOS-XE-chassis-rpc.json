          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "chassis_rpc:set-chassis-priority": {
                    "type": "object",
                    "properties": {
                      "number": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2,
                        "description": "Chassis number"
                      },
                      "priority": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2,
                        "description": "Chassis priority"
                      }
                    },
                    "required": [
                      "number",
                      "priority"
                    ]
                  }
                }
              },
              "example": {
                "chassis_rpc:set-chassis-priority": {
                  "number": 2,
                  "priority": 2
                }
              }
