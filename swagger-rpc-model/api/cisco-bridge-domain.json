    "/operations/cisco_bridge_domain:clear-bridge-domain": {
      "post": {
        "summary": "Clear mac-address table for bridge-domain and allows a bridge\n       to forward again after it was put in shutdown state as a\n       result of exceeding the configured MAC limit.",
        "description": "Clear mac-address table for bridge-domain and allows a bridge\n       to forward again after it was put in shutdown state as a\n       result of exceeding the configured MAC limit.\n\n**Endpoint:** `POST /restconf/operations/cisco_bridge_domain:clear-bridge-domain`",
        "operationId": "clear-bridge-domain",
        "tags": [
          "cisco-bridge-domain"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cisco_bridge_domain:clear-bridge-domain": {
                    "type": "object",
                    "properties": {
                      "all": {
                        "type": "string",
                        "description": "Clear all bridge-domains configured on the device."
                      },
                      "bd-id": {
                        "type": "string",
                        "description": "Clear a single bridge-domain"
                      },
                      "bg-id": {
                        "type": "string",
                        "description": "Clears all bridge-domains under this bridge-group."
                      }
                    }
                  }
                }
              },
              "example": {
                "cisco_bridge_domain:clear-bridge-domain": {
                  "all": "example-string",
