{
  "openapi": "3.0.0",
  "info": {
    "title": "Cisco-IOS-XE-xcopy-rpc - RPC Operations",
    "description": "Copyright (c) 2020-2025 by Cisco Systems, Inc.\n     All rights reserved.\n\n**Module:** `Cisco-IOS-XE-xcopy-rpc`\n**Version:** 2025-07-01\n**Operations:** 1\n\n**📊 YANG Tree:** [View Cisco-IOS-XE-xcopy-rpc structure](https://jeremycohoe.github.io/cisco-ios-xe-openapi-swagger/yang-trees/Cisco-IOS-XE-xcopy-rpc.html)",
    "version": "2025-07-01"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/xcopy_rpc:xcopy": {
      "post": {
        "summary": "Express copy action command",
        "description": "Express copy action command\n\n**Endpoint:** `POST /restconf/operations/xcopy_rpc:xcopy`",
        "operationId": "xcopy",
        "tags": [
          "Cisco-IOS-XE-xcopy-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "xcopy_rpc:xcopy": {
                    "type": "object",
                    "properties": {
                      "uuid": {
                        "type": "string",
                        "description": "The UUID (universally unique identifier) is a string and is a textual\n         representation of a UUID.\n         UUID is used to uniquely identify the express copy action invoked via RPC\n         and it is replayed back in the copy progress notifications to correlate\n         them back to the original express copy operation."
                      },
                      "source-path": {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 4096,
                        "pattern": "[\\\\] A-Za-z0-9!\\",
                        "description": "Source path:\n         for download to device: scp://user:password@ipv4 address:/path/to/file\n         or https://ipv4 address/path/to/file\n         or http://ipv4 address/path/to/file\n         or ftp://user:password@ipv4 address:/path/to/file\n         for copy from device: /path/to/file in bootflash"
                      },
                      "destination-path": {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 4096,
                        "pattern": "[\\\\] A-Za-z0-9!\\",
                        "description": "Destination path:\n         for copy to device: /path/to/file in bootflash"
                      },
                      "username": {
                        "type": "string",
                        "description": "Username to be used for remote device"
                      },
                      "password": {
                        "type": "string",
                        "description": "Password to be used for remote device"
                      },
                      "vrf": {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 32,
                        "description": "VRF name instance to reach remote device.\n         For management or global VRF leave this field blank other wise\n         specify the IOS configured VRF name."
                      },
                      "trustpoint": {
                        "type": "string",
                        "minLength": 0,
                        "maxLength": 40,
                        "description": "Trust point of remote device configured in IOS.\n         This is used to get the public key and provided to copy so that\n         copy is more secured."
                      },
                      "timeout": {
                        "type": "string",
                        "description": "Timeout period guarding express copy operation.\n         If operation not completed, download will be aborted after this time."
                      },
                      "scheduled-start": {
                        "type": "string",
                        "description": "Scheduled download start time"
                      },
                      "scheduled-end": {
                        "type": "string",
                        "description": "Scheduled download end time"
                      }
                    }
                  }
                }
              },
              "example": {
                "xcopy_rpc:xcopy": {
                  "uuid": "example-string",
                  "source-path": "flash:/config.txt",
                  "destination-path": "flash:/config.txt",
                  "username": "admin",
                  "password": "Cisco123!",
                  "vrf": "Mgmt-vrf",
                  "trustpoint": "example-string",
                  "timeout": "example-string",
                  "scheduled-start": "example-string",
                  "scheduled-end": "example-string"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "uuid": {
                      "type": "string",
                      "description": "The UUID (universally unique identifier) is a string and is a textual\n         representation of a UUID."
                    }
                  }
                },
                "example": {
                  "uuid": "example-string"
                }
              }
            }
          },
          "400": {
            "description": "Bad request — invalid input or constraint violation",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — authentication required (HTTP Basic)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": false,
            "description": "RESTCONF request body media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    },
    "schemas": {
      "restconf-error": {
        "type": "object",
        "description": "Standard RESTCONF error response (RFC 8040 Section 7.1)",
        "properties": {
          "ietf-restconf:errors": {
            "type": "object",
            "properties": {
              "error": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "error-type": {
                      "type": "string",
                      "enum": [
                        "transport",
                        "rpc",
                        "protocol",
                        "application"
                      ],
                      "description": "Layer where the error occurred"
                    },
                    "error-tag": {
                      "type": "string",
                      "description": "Enumerated error tag (e.g. invalid-value, data-missing, access-denied)"
                    },
                    "error-severity": {
                      "type": "string",
                      "enum": [
                        "error",
                        "warning"
                      ],
                      "description": "Error severity"
                    },
                    "error-app-tag": {
                      "type": "string",
                      "description": "Application-specific error tag"
                    },
                    "error-path": {
                      "type": "string",
                      "description": "YANG instance-identifier of the error node"
                    },
                    "error-message": {
                      "type": "string",
                      "description": "Human-readable error description"
                    }
                  },
                  "required": [
                    "error-type",
                    "error-tag"
                  ]
                }
              }
            }
          }
        },
        "example": {
          "ietf-restconf:errors": {
            "error": [
              {
                "error-type": "protocol",
                "error-tag": "invalid-value",
                "error-severity": "error",
                "error-message": "Invalid input parameter"
              }
            ]
          }
        }
      }
    }
  },
  "security": [
    {
      "basicAuth": []
    }
  ],
  "tags": [
