    "/operations/Cisco-IOS-XE-install-rpc:install": {
      "post": {
        "summary": "Execute install",
        "operationId": "post-Cisco-IOS-XE-install-rpc-install",
        "tags": [
          "Cisco-IOS-XE-install-rpc"
        ],
        "responses": {
          "204": {
            "description": "Success (no output)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "Cisco-IOS-XE-install-rpc:input": {
                    "type": "object",
                    "properties": {
                      "uuid": {
                        "type": "string"
                      },
                      "one-shot": {
                        "type": "boolean"
                      },
                      "reloadfast": {
                        "type": "boolean"
                      },
                      "issu": {
                        "type": "boolean"
                      },
                      "controller-mode-options": {
                        "type": "object",
                        "properties": {
                          "vpn": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 4294967295
                          }
                        }
                      },
                      "download-timeout": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "xfsu": {
                        "type": "boolean"
                      },
                      "scheduled-start": {
                        "type": "string"
                      },
                      "scheduled-end": {
                        "type": "string"
                      },
                      "(install-type-by-choice)": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "Cisco-IOS-XE-install-rpc:input": {
                  "uuid": "00000000-0000-0000-0000-000000000000",
                  "one-shot": false,
                  "reloadfast": true,
                  "issu": true,
                  "controller-mode-options": {
                    "vpn": 1
                  },
                  "download-timeout": 1,
                  "xfsu": true,
                  "scheduled-start": "example",
                  "scheduled-end": "example",
                  "(install-type-by-choice)": {
                    "path": false,
                    "name": "example"
                  }
                }
              }
            }
          }
        }
      }
    },
