    "/operations/Cisco-IOS-XE-cwan-fw-rpc:trigger-upgrade": {
      "post": {
        "summary": "Execute trigger-upgrade",
        "operationId": "post-root-2",
        "tags": [
          "Cisco-IOS-XE-cwan-fw-rpc"
        ],
        "responses": {
          "204": {
            "description": "Success (no output)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          },
          "200": {
            "description": "Successful response",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "fw-tid": {
                      "type": "string",
                      "example": "1"
                    }
                  },
                  "example": "configured-value"
                },
                "example": {
                  "Cisco-IOS-XE-cwan-fw-rpc:output": {
                    "fw-tid": "1"
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fw-tid": {
                    "type": "string",
                    "example": "1"
                  },
                  "src-path": {
                    "type": "string",
                    "example": "/data/example"
                  },
                  "uname": {
                    "type": "string",
                    "example": "example-1"
                  },
                  "passwd": {
                    "type": "string",
                    "example": "***"
                  },
                  "vpn": {
                    "type": "string",
                    "example": "configured-value"
                  },
                  "dnld-timeout": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295,
                    "example": 1
                  },
                  "schd-start": {
                    "type": "string",
                    "example": "configured-value"
                  },
                  "schd-end": {
                    "type": "string",
                    "example": "configured-value"
                  },
                  "fwtype": {
                    "type": "string",
                    "example": "configured-value"
                  },
                  "img-name": {
                    "type": "string",
                    "example": "example-1"
                  }
                },
                "example": "configured-value"
              },
              "example": {
                "Cisco-IOS-XE-cwan-fw-rpc:input": {
                  "fw-tid": "1",
                  "src-path": "/data/example",
                  "uname": "example-1",
                  "passwd": "***",
                  "vpn": "configured-value",
                  "dnld-timeout": 1,
                  "schd-start": "configured-value",
                  "schd-end": "configured-value",
                  "fwtype": "configured-value",
                  "img-name": "example-1"
                }
              }
            }
          }
        },
        "description": "Execute the **trigger-upgrade** RPC operation.\n\nSends a POST request to invoke this action on the device. The request body contains input parameters; the response contains any output values."
      }
    },
