    "version": "2025-03-01",
    "x-yang-module": "port-bounce-rpc",
    "x-model-type": "rpc"
  },
  "servers": [
    {
      "url": "https://{device}/restconf",
      "variables": {
        "device": {
          "default": "devnetsandboxiosxec9k.cisco.com"
        }
      }
    }
  ],
  "paths": {
    "/operations/port_bounce_rpc:port-bounce": {
      "post": {
        "summary": "RPC request message for port bounce",
        "description": "RPC request message for port bounce\n\n**Endpoint:** `POST /restconf/operations/port_bounce_rpc:port-bounce`",
        "operationId": "port-bounce",
        "tags": [
          "Cisco-IOS-XE-port-bounce-rpc"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "port_bounce_rpc:port-bounce": {
                    "type": "object",
                    "properties": {
                      "if-name": {
                        "type": "string",
                        "pattern": "(((((Ten|Forty|Two|Five|Four|App|Fifty)?Gigabit)|Fast)?Ethernet(0|[1-9][0-9]*)(/(0|[1-9][0-9]*))*)|(((TwentyFive|Hundred|TwoHundred)GigE)(0|[1-9][0-9]*)(/(0|[1-9][0-9]*))*))",
                        "description": "Name of the interface that is to be bounced. Port bounce can\n         be performed only on the following interface -\n          Ethernet, Fast Ethernet, Gigabit Ethernet,\n          Two Gigabit Ethernet, Four Gigabit Ethernet,\n          Five Gigabit Ethernet, Ten Gigabit Ethernet,\n          Twenty Five Gigabit Ethernet, Forty Gigabit Ethernet,\n          Fifty Gigabit Ethernet, Hundred Gigabit Ethernet,\n          Two Hundred Gigabit Ethernet and App Gigabit Ethernet"
                      }
                    },
                    "required": [
                      "if-name"
                    ]
                  }
                }
              },
              "example": {
                "port_bounce_rpc:port-bounce": {
                  "if-name": "GigabitEthernet1/0/1"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "RPC executed successfully",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "if-name": {
                      "type": "string",
                      "description": "Name of the interface which the user requested to be bounced."
                    },
                    "status": {
                      "type": "string",
                      "description": "Status of port bounce operation"
                    },
                    "reason": {
                      "type": "string",
                      "description": "Reason for port-bounce to fail, if there is any failure."
                    }
                  }
                },
                "example": {
                  "if-name": "GigabitEthernet1/0/1",
                  "status": "example-string",
                  "reason": "example-string"
                }
              }
            }
          },
          "400": {
            "description": "Bad request — invalid input or constraint violation",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized — authentication required (HTTP Basic)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          },
          "403": {
            "description": "Forbidden — insufficient access rights (NACM)",
            "content": {
              "application/yang-data+json": {
                "schema": {
                  "$ref": "#/components/schemas/restconf-error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Accept",
            "in": "header",
            "required": false,
            "description": "RESTCONF response media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          },
          {
            "name": "Content-Type",
            "in": "header",
            "required": false,
            "description": "RESTCONF request body media type (RFC 8040)",
            "schema": {
              "type": "string",
              "default": "application/yang-data+json",
              "enum": [
                "application/yang-data+json",
                "application/yang-data+xml"
              ]
            }
          }
        ]
      },
      "x-yang-path": "/port-bounce",
      "x-restconf-kind": "rpc"
    }
  },
