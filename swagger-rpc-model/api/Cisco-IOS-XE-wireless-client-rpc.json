    "/operations/wireless_client_rpc:apf-ms-delete-all": {
      "post": {
        "summary": "Delete wireless client based on client MAC or IP address or username",
        "description": "Delete wireless client based on client MAC or IP address or username\n\n**Endpoint:** `POST /restconf/operations/wireless_client_rpc:apf-ms-delete-all`",
