              "application/yang-data+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Cisco-IOS-XE-cli-rpc:output": {
                      "type": "object",
                      "properties": {
                        "result": {
                          "type": "string"
                        },
                        "lineno": {
