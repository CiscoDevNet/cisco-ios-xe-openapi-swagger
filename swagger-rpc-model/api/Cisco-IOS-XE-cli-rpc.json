                    "type": "object",
                    "properties": {
                      "config-clis": {
                        "type": "string"
                      },
                      "timeout": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      "error-patterns": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "error-tag": {
                              "type": "string"
                            },
                            "error-pattern": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "Cisco-IOS-XE-cli-rpc:input": {
                  "config-clis": "example",
                  "timeout": 1,
                  "error-patterns": [
                    {
                      "error-tag": "example",
                      "error-pattern": "example"
                    }
                  ]
                }
              }
