                    "result": "example",
                    "lineno": 1,
                    "error-code": "error code of 'no-error' is returned to the user.",
                    "error-string": "example",
                    "error-tag": "example"
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
