  "paths": {
    "/operations/Cisco-IOS-XE-power-supply-rpc:set-pwr-supply-slot-state": {
      "post": {
        "summary": "Execute set-pwr-supply-slot-state",
        "operationId": "post-root",
        "tags": [
          "Cisco-IOS-XE-power-supply-rpc"
        ],
        "responses": {
          "204": {
            "description": "Success (no output)"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not found"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/yang-data+json": {
              "schema": {
                "type": "object",
                "properties": {
                  "Cisco-IOS-XE-power-supply-rpc:input": {
                    "type": "object",
                    "properties": {
                      "supply": {
                        "type": "object",
                        "properties": {
                          "switch-number": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 255,
                            "example": 10
                          },
                          "slot": {
                            "type": "string",
                            "example": "configured-value"
                          },
                          "state": {
                            "type": "string",
                            "example": "active",
                            "description": "Current operational state"
                          }
                        },
                        "example": "configured-value"
                      }
                    },
                    "example": "configured-value"
                  }
                },
                "example": "active"
              },
              "example": {
                "Cisco-IOS-XE-power-supply-rpc:input": {
                  "supply": {
                    "switch-number": 10,
                    "slot": 0,
                    "state": "any"
                  }
                }
              }
            }
          }
        },
        "description": "Execute the **set-pwr-supply-slot-state** RPC operation.\n\nSends a POST request to invoke this action on the device. The request body contains input parameters; the response contains any output values."
      }
    }
